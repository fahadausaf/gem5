output decoder {{
namespace Aarch64
{
    // Forward declarations for FTMOPA (TMOP) matchers
    static inline bool isFtmopaNonWideningF16(uint32_t insn);
    static inline bool isFtmopaNonWideningF32(uint32_t insn);
    static inline bool isFtmopaWideningF16ToF32(uint32_t insn);
    static inline bool isFtmopaWideningF8ToF16(uint32_t insn);
    static inline bool isFtmopaWidening4WayF8ToF32(uint32_t insn);
    static inline bool isFmop4aWidening(uint32_t insn);
    static inline bool isFmop4aWideningF16(uint32_t insn);
    static inline bool isFmop4aWideningF8ToF16(uint32_t insn);

    static inline bool isMova2B(uint32_t insn);
    static inline bool isMova2H(uint32_t insn);
    static inline bool isMova2S(uint32_t insn);
    static inline bool isMova2D(uint32_t insn);

    static inline bool isSme2Scvtf2(uint32_t insn);
    static inline bool isSme2Scvtf4(uint32_t insn);
    static inline bool isSme2Ucvtf2(uint32_t insn);
    static inline bool isSme2Ucvtf4(uint32_t insn);
    static inline bool isSme2FcvtFp16Fp8(uint32_t insn);
    static inline bool isSme2FcvtFp32Fp16(uint32_t insn);
    static inline bool isSme2FcvtFp32Fp8(uint32_t insn);
    static inline bool isSme2FcvtnFp32Fp8(uint32_t insn);
    static inline bool isSme2FcvtnFp32Fp16(uint32_t insn);
    static inline bool isSme2Bfcvt(uint32_t insn);
    static inline bool isSme2BfcvtFp32Bf16(uint32_t insn);
    static inline bool isSme2Bfcvtn(uint32_t insn);
    static inline bool isSme2Fcvtl(uint32_t insn);
    static inline bool isSme2F1cvtl(uint32_t insn);
    static inline bool isSme2F2cvtl(uint32_t insn);
    static inline bool isSme2Bf1cvtl(uint32_t insn);
    static inline bool isSme2Bf2cvtl(uint32_t insn);
    static inline bool isSme2Bf1cvt(uint32_t insn);
    static inline bool isSme2Bf2cvt(uint32_t insn);
    static inline bool isSme2F1cvt(uint32_t insn);
    static inline bool isSme2F2cvt(uint32_t insn);
    static inline bool isSme2Sqcvt(uint32_t insn);
    static inline bool isSme2Sqcvtu(uint32_t insn);
    static inline bool isSme2Uqcvt(uint32_t insn);
    static inline bool isSme2Sqcvt2(uint32_t insn);
    static inline bool isSme2Uqcvt2(uint32_t insn);
    static inline bool isSme2Sqcvtu2(uint32_t insn);
    static inline bool isSme2Sqcvtn(uint32_t insn);
    static inline bool isSme2Sqcvtun(uint32_t insn);
    static inline bool isSme2Uqcvtn(uint32_t insn);

    static inline bool isFmop4a(uint32_t insn);
    static inline bool isBfmop4a(uint32_t insn);
    static inline bool isBfmop4aWidening(uint32_t insn);
    static inline bool isBfmop4sWidening(uint32_t insn);
    static inline bool isBfmop4s(uint32_t insn);
    static inline bool isBftmopa(uint32_t insn);
    static inline bool isBftmopaWidening(uint32_t insn);
    static inline bool isFmop4sNonWidening(uint32_t insn);
    static inline bool isFmop4sWidening(uint32_t insn);
    static inline bool isBmopa(uint32_t insn);
    static inline bool isBmops(uint32_t insn);
    static inline bool isUmopa(uint32_t insn);
    static inline bool isUmops(uint32_t insn);
    static inline bool isUmopa4way(uint32_t insn);
    static inline bool isUmops4way(uint32_t insn);
    static inline bool isUtmopa(uint32_t insn);
    static inline bool isUtmopa4way(uint32_t insn);
    static inline bool isSmopa2way(uint32_t insn);
    static inline bool isSmops2way(uint32_t insn);
    static inline bool isSmop4a(uint32_t insn);
    static inline bool isSmop4s(uint32_t insn);
    static inline bool isSmop4a4way(uint32_t insn);
    static inline bool isSmop4s4way(uint32_t insn);
    static inline bool isSumop4a4way(uint32_t insn);
    static inline bool isSumop4s4way(uint32_t insn);
    static inline bool isUmop4a(uint32_t insn);
    static inline bool isUmop4s(uint32_t insn);
    static inline bool isUmop4a4way(uint32_t insn);
    static inline bool isUmop4s4way(uint32_t insn);
    static inline bool isUsmop4a(uint32_t insn);
    static inline bool isUsmop4s(uint32_t insn);
    static inline bool isStmopa2way(uint32_t insn);
    static inline bool isStmopa4way(uint32_t insn);
    static inline bool isSutmopa(uint32_t insn);
    static inline bool isUstmopa(uint32_t insn);

    static inline bool isMovaTileToVec2reg(uint32_t insn);
    static inline bool isMovaTileToVec4reg(uint32_t insn);
    static inline bool isMovaArrayToVec4reg(uint32_t insn);
    static inline bool isMovaArrayToVec2reg(uint32_t insn);
    static inline bool isMovaVecToArray4reg(uint32_t insn);
    static inline bool isMovaVecToArray2reg(uint32_t insn);
    static inline bool isMovaVecToTile4reg(uint32_t insn);
    static inline bool isMovazArrayToVec4reg(uint32_t insn);
    

    StaticInstPtr decodeSmeMovaVecToTile2Regs(ExtMachInst);
    // NOTE: This is called from a different decode tree (aarch64.isa).
    // For neatness and clarity we keep the code here order to keep all
    // SME things together.
    StaticInstPtr
    decodeSmeMgmt(ExtMachInst machInst)
    {
        const uint8_t imm = (uint8_t)bits(machInst, 10, 8);
        if (bits(machInst, 8)) {
            return new SmeSmstart(machInst, imm);
        } else {
            return new SmeSmstop(machInst, imm);
        }
    }

    StaticInstPtr
    decodeSmeInst(ExtMachInst machInst)
    {
        // Starting point for decoding: bits 31:25=1xx0000

        // Check for MOVA (tile to vector, 2-reg)
        if (Aarch64::isMovaTileToVec2reg(machInst)) {
            const uint8_t size = bits(machInst, 23, 22);
            const uint8_t V    = bits(machInst, 15, 15);
            const uint8_t Rs   = bits(machInst, 14, 13);
            const uint8_t Zd_group = bits(machInst, 4, 1);
            
            uint8_t ZAn_raw = 0;
            uint8_t off_raw = 0;
            
            // Parse size-dependent fields
            switch (size) {
                case 0: // 8-bit 
                    ZAn_raw = 0; 
                    off_raw = bits(machInst, 7, 5); 
                    break;
                case 1: // 16-bit 
                    ZAn_raw = bits(machInst, 7, 7);
                    off_raw = bits(machInst, 6, 5);
                    break;
                case 2: // 32-bit 
                    ZAn_raw = bits(machInst, 8, 7);
                    off_raw = bits(machInst, 6, 6);
                    break;
                case 3: // 64-bit 
                    ZAn_raw = bits(machInst, 9, 7);
                    off_raw = 0; 
                    break;
            }
            
            // Pack immediate exactly as expected by insts/sme.isa:
            // [2:0] ZAn_raw, [7:3] Zd_group, [10:8] off_raw, [12:11] size code
            const uint32_t imm_packed = (ZAn_raw & 0x7) | 
                                        ((Zd_group & 0x1F) << 3) | 
                                        ((off_raw & 0x7) << 8) | 
                                        ((size & 0x3) << 11);
                                        
            // The base class SmeMovaVecToTile2RegsOp expects (machInst, imm, v, Rs)
            return new SmeMovaTileToVec2Regs(machInst, imm_packed, V, Rs);
        }

        if (Aarch64::isMovaTileToVec4reg(machInst)) {
            const uint8_t size = bits(machInst, 23, 22);
            const uint8_t V    = bits(machInst, 15, 15);
            const uint8_t Rs   = bits(machInst, 14, 13);
            const uint8_t Zd_group = bits(machInst, 4, 2); // 4-reg group
            
            uint8_t ZAn_raw = 0;
            uint8_t off_raw = 0;
            
            // Parse size-dependent fields
            switch (size) {
                case 0: // 8-bit
                    ZAn_raw = 0; 
                    off_raw = bits(machInst, 6, 5); 
                    break;
                case 1: // 16-bit
                    ZAn_raw = bits(machInst, 7, 7);
                    off_raw = bits(machInst, 6, 6);
                    break;
                case 2: // 32-bit
                    ZAn_raw = bits(machInst, 7, 7);
                    off_raw = 0;
                    break;
                case 3: // 64-bit
                    ZAn_raw = bits(machInst, 7, 7);
                    off_raw = 0; 
                    break;
            }
            
            // Pack immediate exactly as expected by insts/sme.isa
            const uint32_t imm_packed = (ZAn_raw & 0x7) | 
                                        ((Zd_group & 0x1F) << 3) | 
                                        ((off_raw & 0x7) << 8) | 
                                        ((size & 0x3) << 11);
                                        
            // Reuses the identical base parsing class as the 2-reg variant!
            return new SmeMovaTileToVec4Regs(machInst, imm_packed, V, Rs);
        }

        if (Aarch64::isMovaArrayToVec4reg(machInst)) {
            const uint8_t Rv = bits(machInst, 14, 13);
            const uint8_t off3 = bits(machInst, 7, 5);
            const uint8_t Zd_group = bits(machInst, 4, 2);

            // Rv maps to general purpose index registers W8-W11
            const uint8_t Rs = 8 + Rv; 

            // Pack the offset and destination group into our immediate
            const uint32_t imm_packed = (Zd_group & 0x7) | ((off3 & 0x7) << 3);

            // Pass 0 for the V bit since array-to-vector treats ZA entirely as 1D horizontal vectors
            return new SmeMovaArrayToVec4Regs(machInst, imm_packed, 0, Rs);
        }

        if (Aarch64::isMovaArrayToVec2reg(machInst)) {
            const uint8_t Rv = bits(machInst, 14, 13);
            const uint8_t off3 = bits(machInst, 7, 5);
            const uint8_t Zd_group = bits(machInst, 4, 1); // 4-bit group

            // Rv maps to general purpose index registers W8-W11
            const uint8_t Rs = 8 + Rv; 

            // Pack the offset and destination group into our immediate
            // Zd_group is 4 bits, so we shift off3 by 4
            const uint32_t imm_packed = (Zd_group & 0xF) | ((off3 & 0x7) << 4);

            // Reuse the safe base class
            return new SmeMovaArrayToVec2Regs(machInst, imm_packed, 0, Rs);
        }

        if (Aarch64::isMovaVecToArray4reg(machInst)) {
            const uint8_t Rv   = bits(machInst, 14, 13);
            const uint8_t Zn_group = bits(machInst, 7, 5); // Source group
            const uint8_t off3 = bits(machInst, 2, 0);     // Offset

            // Rv maps to general purpose index registers W8-W11
            const uint8_t Rs = 8 + Rv; 

            // Pack the offset and source group into our immediate
            const uint32_t imm_packed = (Zn_group & 0x7) | ((off3 & 0x7) << 3);

            // Reuse the safe base class
            return new SmeMovaVecToArray4Regs(machInst, imm_packed, 0, Rs);
        }

        if (Aarch64::isMovaVecToArray2reg(machInst)) {
            const uint8_t Rv   = bits(machInst, 14, 13);
            const uint8_t Zn_group = bits(machInst, 7, 4); // Source group (now 4 bits)
            const uint8_t off3 = bits(machInst, 2, 0);     // Offset

            // Rv maps to general purpose index registers W8-W11
            const uint8_t Rs = 8 + Rv; 

            // Pack the offset and source group into our immediate
            // Zn_group is 4 bits, so we shift off3 by 4
            const uint32_t imm_packed = (Zn_group & 0xF) | ((off3 & 0x7) << 4);

            // Reuse your safe base class
            return new SmeMovaVecToArray2Regs(machInst, imm_packed, 0, Rs);
        }

        if (Aarch64::isMovaVecToTile4reg(machInst)) {
            const uint8_t size = bits(machInst, 23, 22);
            const uint8_t V    = bits(machInst, 15, 15);
            const uint8_t Rs   = bits(machInst, 14, 13);
            const uint8_t Zn_group = bits(machInst, 7, 5); // Source vector group
            
            uint8_t ZAd_raw = 0;
            uint8_t off_raw = 0;
            
            // Parse size-dependent fields
            switch (size) {
                case 0: // 8-bit
                    ZAd_raw = 0; 
                    off_raw = bits(machInst, 1, 0); // off2
                    break;
                case 1: // 16-bit
                    ZAd_raw = bits(machInst, 1, 1);
                    off_raw = bits(machInst, 0, 0); // o1
                    break;
                case 2: // 32-bit
                    ZAd_raw = bits(machInst, 1, 0);
                    off_raw = 0;
                    break;
                case 3: // 64-bit
                    ZAd_raw = bits(machInst, 2, 0);
                    off_raw = 0; 
                    break;
            }
            
            // Pack immediate (reusing the exact format we used for tile-to-vector)
            const uint32_t imm_packed = (ZAd_raw & 0x7) | 
                                        ((Zn_group & 0x1F) << 3) | 
                                        ((off_raw & 0x7) << 8) | 
                                        ((size & 0x3) << 11);
                                        
            // Reuses the identical base parsing class as all our other working instructions!
            return new SmeMovaVecToTile4Regs(machInst, imm_packed, V, Rs);
        }

        // Check for MOVAZ Array To Vector 4-reg       
        if (Aarch64::isMovazArrayToVec4reg(machInst)) {
            const uint8_t Rv = bits(machInst, 14, 13);
            const uint8_t off3 = bits(machInst, 7, 5);
            const uint8_t Zd_group = bits(machInst, 4, 2);

            // Rv maps to general purpose index registers W8-W11
            const uint8_t Rs = 8 + Rv; 

            // Pack the offset and destination group into our immediate
            const uint32_t imm_packed = (Zd_group & 0x7) | ((off3 & 0x7) << 3);

            // Reuse the safe base class
            return new SmeMovazArrayToVec4Regs(machInst, imm_packed, 0, Rs);
        }
        
        const uint32_t insn = (uint32_t)machInst;
        
        // Route *all* FTMOPA TMOP encodings (non-widening + widening)
        // straight to the TMOP decoder.
        if (Aarch64::isFtmopaNonWideningF16(insn) ||
            Aarch64::isFtmopaNonWideningF32(insn) ||
            Aarch64::isFtmopaWideningF16ToF32(insn) ||
            Aarch64::isFtmopaWideningF8ToF16(insn)  ||
            Aarch64::isFtmopaWidening4WayF8ToF32(insn)) {

            return Aarch64::decodeSmeTmop(machInst);
        }

        // Check for FMOP4A
        if (Aarch64::isFmop4a(insn)) {
            const RegIndex Zm = (RegIndex)(uint32_t)bits(machInst, 20, 16);
            const RegIndex Zn = (RegIndex)(uint32_t)bits(machInst, 9, 5);
            const RegIndex ZAda = (RegIndex)(uint32_t)bits(machInst, 1, 0);
            // 2 bits for .S tile
            
            // Call the new instruction
            return new SmeFmop4a<uint32_t, uint32_t>(machInst, ZAda, Zn, Zm);
        }

        // Check for FMOP4A (Widening, 4-way, FP8 -> FP32)
        if (Aarch64::isFmop4aWidening(insn)) {
            const RegIndex Zm = (RegIndex)(uint32_t)bits(machInst, 20, 16);
            const RegIndex Zn = (RegIndex)(uint32_t)bits(machInst, 9, 5);
            const RegIndex ZAda = (RegIndex)(uint32_t)bits(machInst, 1, 0);
            // Instantiate Widening version: Input uint8_t, Output uint32_t
            return new SmeFmop4aWidening<uint8_t, uint32_t>(machInst, ZAda, Zn, Zm);
        }

        // Check for FMOP4A (Widening, 2-way, FP16 -> FP32)
        if (Aarch64::isFmop4aWideningF16(insn)) {
             const RegIndex Zm = (RegIndex)(uint32_t)bits(machInst, 20, 16);
             const RegIndex Zn = (RegIndex)(uint32_t)bits(machInst, 9, 5);
             const RegIndex ZAda = (RegIndex)(uint32_t)bits(machInst, 1, 0); // 2 bits for .S tile
             return new SmeFmop4aWideningF16<uint16_t, uint32_t>(machInst, ZAda, Zn, Zm);
        }

        // Check for FMOP4A (Widening, 2-way, FP8 -> FP16)
        if (Aarch64::isFmop4aWideningF8ToF16(insn)) {
             const RegIndex Zm = (RegIndex)(uint32_t)bits(machInst, 20, 16);
             const RegIndex Zn = (RegIndex)(uint32_t)bits(machInst, 9, 5);
             // For FP16 (.H) destination, ZAda is usually bit [0] (ZA0-ZA1)
             const RegIndex ZAda = (RegIndex)(uint32_t)bits(machInst, 0, 0);

             // Instantiate Widening version: Input uint8_t, Output uint16_t
             return new SmeFmop4aWideningF8ToF16<uint8_t, uint16_t>(machInst, ZAda, Zn, Zm);
        }

        // Check for BFMOP4A (Widening)
        if (Aarch64::isBfmop4aWidening(insn)) {
            const uint32_t zm3  = bits(machInst, 19, 17);
            const uint32_t zn3  = bits(machInst, 8, 6);
            const uint32_t da   = bits(machInst, 1, 0);
            const bool M = bits(machInst, 20);
            const bool N = bits(machInst, 10);

            const uint32_t nreg = M ? 2 : 1;
            const uint32_t mreg = N ? 1 : 2;

            const RegIndex n_base = (RegIndex)(zn3 << 1);          // Z0–Z15, even
            const RegIndex m_base = (RegIndex)(16 + (zm3 << 1));   // Z16–Z31, even

            // Pack extra decode info into imm:
            // bits [1:0]  = da
            // bits [3:2]  = nreg
            // bits [5:4]  = mreg
            const uint64_t imm_packed = (da & 0x3)
                                    | ((nreg & 0x3) << 2)
                                    | ((mreg & 0x3) << 4);

            return new SmeBfmop4aWidening<uint16_t, uint32_t>(
                machInst, imm_packed, n_base, m_base);
        }

        
        // Check for BFMOP4A (Non-widening, BFloat16)
        if (Aarch64::isBfmop4a(insn)) {
            // Zm: bits 19-17 (3 bits)
            const RegIndex Zm = (RegIndex)(uint32_t)bits(machInst, 19, 17);
            // Zn: bits 8-6 (3 bits)
            const RegIndex Zn = (RegIndex)(uint32_t)bits(machInst, 8, 6);
            // ZAda: bit 0 (1 bit, but instruction uses 2 bits logic usually, here restricted to ZA0/ZA1/etc depending on mask)
            // Spec says ZAda is bit 0. This implies targeting specific tiles. 
            // However, usually ZAda is passed as the tile index.
            const RegIndex ZAda = (RegIndex)(uint32_t)bits(machInst, 0, 0);

            // Instantiate BFMOP4A: Input uint16_t (BF16), Output uint32_t (FP32)
            return new SmeBfmop4a<uint16_t, uint32_t>(machInst, ZAda, Zn, Zm);
        }

        // Check for BFMOP4S (Widening)
        if (Aarch64::isBfmop4sWidening(insn)) {
            const uint32_t zm3  = bits(machInst, 19, 17);
            const uint32_t zn3  = bits(machInst, 8, 6);
            const uint32_t da   = bits(machInst, 1, 0);
            
            const bool M = bits(machInst, 20);
            const bool N = bits(machInst, 10);

            // M controls mreg (Zm), N controls nreg (Zn)
            const uint32_t mreg = M ? 2 : 1;
            const uint32_t nreg = N ? 2 : 1;

            const RegIndex n_base = (RegIndex)(zn3 << 1);
            const RegIndex m_base = (RegIndex)(16 + (zm3 << 1));

            // Pack extra decode info into imm exactly like BFMOP4A
            const uint64_t imm_packed = (da & 0x3) | ((nreg & 0x3) << 2) | ((mreg & 0x3) << 4);

            return new SmeBfmop4sWidening<uint16_t, uint32_t>(
                machInst, imm_packed, n_base, m_base);
        }

        // Check for BFMOP4S (Non-widening, BFloat16)
        if (Aarch64::isBfmop4s(insn)) {
            const uint32_t zm3  = bits(machInst, 19, 17);
            const uint32_t zn3  = bits(machInst, 8, 6);
            const uint32_t da   = bits(machInst, 0, 0); 
            
            const bool M = bits(machInst, 20);
            const bool N = bits(machInst, 9); // N is at bit 9 for this variant

            const uint32_t mreg = M ? 2 : 1;
            const uint32_t nreg = N ? 2 : 1;

            const RegIndex n_base = (RegIndex)(zn3 << 1);
            const RegIndex m_base = (RegIndex)(16 + (zm3 << 1));

            // Pack da, nreg, and mreg into imm
            const uint64_t imm_packed = (da & 0x1) | ((nreg & 0x3) << 2) | ((mreg & 0x3) << 4);

            return new SmeBfmop4s<uint16_t, uint32_t>(machInst, imm_packed, n_base, m_base);
        }

        // Check for BFTMOPA (Non-widening, Sparse)
        if (Aarch64::isBftmopa(insn)) {
            const RegIndex Zm  = (RegIndex)(uint32_t)bits(machInst, 20, 16);
            const uint32_t Zn4 = bits(machInst, 9, 6);
            const uint32_t K   = bits(machInst, 12, 12);
            const uint32_t Zk2 = bits(machInst, 11, 10);
            const uint32_t i2  = bits(machInst, 5, 4);
            const uint32_t da  = bits(machInst, 0, 0);

            // Zn is encoded as "Zn field * 2"
            const RegIndex Zn_base = (RegIndex)(Zn4 << 1);
            
            // Zk logic: '1':K:'1':Zk 
            // If K=0: 101xx -> 20 + Zk2 (Z20-Z23)
            // If K=1: 111xx -> 28 + Zk2 (Z28-Z31)
            const RegIndex Zk = (RegIndex)(20 + (K << 3) + Zk2);

            // Pack ZAda, index (i2), and Zk into the immediate for execution
            // [0]: da, [2:1]: index, [7:3]: Zk
            const uint64_t imm_packed = (da & 0x1) | ((i2 & 0x3) << 1) | ((Zk & 0x1f) << 3);

            return new SmeBftmopa<uint16_t, uint16_t>(machInst, imm_packed, Zn_base, Zm);
        }

        // Check for BFTMOPA (Widening, Sparse, BFloat16 to FP32)
        if (Aarch64::isBftmopaWidening(insn)) {
            const RegIndex Zm  = (RegIndex)(uint32_t)bits(machInst, 20, 16);
            const uint32_t Zn4 = bits(machInst, 9, 6);
            const uint32_t K   = bits(machInst, 12, 12);
            const uint32_t Zk2 = bits(machInst, 11, 10);
            const uint32_t i2  = bits(machInst, 5, 4);
            const uint32_t da  = bits(machInst, 1, 0); // 2 bits

            const RegIndex Zn_base = (RegIndex)(Zn4 << 1);
            const RegIndex Zk = (RegIndex)(20 + (K << 3) + Zk2);

            // Pack da, i2, and zk into the immediate payload
            // [1:0] da, [3:2] i2, [8:4] zk
            const uint64_t imm_packed = (da & 0x3) | ((i2 & 0x3) << 2) | ((Zk & 0x1f) << 4);

            // Inputs are BF16 (uint16_t), Output is FP32 (uint32_t)
            return new SmeBftmopaWidening<uint16_t, uint32_t>(machInst, imm_packed, Zn_base, Zm);
        }

        // Check for FMOP4S (Non-widening)
        if (Aarch64::isFmop4sNonWidening(machInst)) {
            const uint8_t sz  = bits(machInst, 24, 24); 
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;

            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            // Pack: [1:0] da, [3:2] nreg-1, [5:4] mreg-1
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((nreg - 1) << 2) | 
                                        ((mreg - 1) << 4);

            if (sz == 1) { // FP16
                return new SmeFmop4sNonWidening<uint16_t, uint16_t>(machInst, imm_packed, Zn_base, Zm_base);
            } else {       // FP32
                return new SmeFmop4sNonWidening<uint32_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
            }
        }

        // Check for FMOP4S (Widening FP16 -> FP32)
        if (Aarch64::isFmop4sWidening(machInst)) {
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;

            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            // Pack Immediate: [1:0] da, [3:2] nreg-1, [5:4] mreg-1
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((nreg - 1) << 2) | 
                                        ((mreg - 1) << 4);

            return new SmeFmop4sWidening<uint16_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
        }

        // Check for BMOPA
        if (Aarch64::isBmopa(machInst)) {
            const uint8_t Zm = bits(machInst, 20, 16);
            const uint8_t Pm = bits(machInst, 15, 13);
            const uint8_t Pn = bits(machInst, 12, 10);
            const uint8_t Zn = bits(machInst, 9, 5);
            const uint8_t ZAda = bits(machInst, 1, 0);

            // Pack Immediate: [1:0] da, [4:2] pn, [7:5] pm
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((Pn & 0x7) << 2) | 
                                        ((Pm & 0x7) << 5);

            // We pass uint32_t since BMOPA is a 32-bit element instruction.
            return new SmeBmopa<uint32_t, uint32_t>(machInst, imm_packed, Zn, Zm);
        }

        // Check for BMOPS
        if (Aarch64::isBmops(machInst)) {
            const uint8_t Zm = bits(machInst, 20, 16);
            const uint8_t Pm = bits(machInst, 15, 13);
            const uint8_t Pn = bits(machInst, 12, 10);
            const uint8_t Zn = bits(machInst, 9, 5);
            const uint8_t ZAda = bits(machInst, 1, 0);

            // Pack Immediate: [1:0] da, [4:2] pn, [7:5] pm
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((Pn & 0x7) << 2) | 
                                        ((Pm & 0x7) << 5);

            // Pass 'Bmops' to the generator so it matches
            return new SmeBmops<uint32_t, uint32_t>(machInst, imm_packed, Zn, Zm);
        }

        // Check for UMOPA - 2-way
        if (Aarch64::isUmopa(machInst)) {
            const uint8_t Zm = bits(machInst, 20, 16);
            const uint8_t Pm = bits(machInst, 15, 13);
            const uint8_t Pn = bits(machInst, 12, 10);
            const uint8_t Zn = bits(machInst, 9, 5);
            const uint8_t ZAda = bits(machInst, 1, 0);

            // Pack Immediate: [1:0] da, [4:2] pn, [7:5] pm
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((Pn & 0x7) << 2) | 
                                        ((Pm & 0x7) << 5);

            // Pass 'Umopa' to match generator, using <uint16_t, uint32_t> for the widening
            return new SmeUmopa2way<uint16_t, uint32_t>(machInst, imm_packed, Zn, Zm);
        }

        // Check for UMOPS (2-way)
        if (Aarch64::isUmops(machInst)) {
            const uint8_t Zm = bits(machInst, 20, 16);
            const uint8_t Pm = bits(machInst, 15, 13);
            const uint8_t Pn = bits(machInst, 12, 10);
            const uint8_t Zn = bits(machInst, 9, 5);
            const uint8_t ZAda = bits(machInst, 1, 0);

            // Pack Immediate: [1:0] da, [4:2] pn, [7:5] pm
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((Pn & 0x7) << 2) | 
                                        ((Pm & 0x7) << 5);

            // Pass 'Umops2way' to generate SmeUmops2way and avoid collisions
            return new SmeUmops2way<uint16_t, uint32_t>(machInst, imm_packed, Zn, Zm);
        }

        // Check for UMOPA (4-way)
        if (Aarch64::isUmopa4way(machInst)) {
            const uint8_t sz = bits(machInst, 22, 22);
            const uint8_t Zm = bits(machInst, 20, 16);
            const uint8_t Pm = bits(machInst, 15, 13);
            const uint8_t Pn = bits(machInst, 12, 10);
            const uint8_t Zn = bits(machInst, 9, 5);
            const uint8_t ZAda = bits(machInst, 1, 0);

            // Pack Immediate: [1:0] da, [4:2] pn, [7:5] pm
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((Pn & 0x7) << 2) | 
                                        ((Pm & 0x7) << 5);

            if (sz == 0) {
                // 32-bit variant: 8-bit sources to 32-bit destination
                return new SmeUmopa4way<uint8_t, uint32_t>(machInst, imm_packed, Zn, Zm);
            } else {
                // 64-bit variant: 16-bit sources to 64-bit destination
                return new SmeUmopa4way<uint16_t, uint64_t>(machInst, imm_packed, Zn, Zm);
            }
        }

        // Check for UMOPS (4-way)
        if (Aarch64::isUmops4way(machInst)) {
            const uint8_t sz = bits(machInst, 22, 22);
            const uint8_t Zm = bits(machInst, 20, 16);
            const uint8_t Pm = bits(machInst, 15, 13);
            const uint8_t Pn = bits(machInst, 12, 10);
            const uint8_t Zn = bits(machInst, 9, 5);
            const uint8_t ZAda = bits(machInst, 1, 0);

            // Pack Immediate: [1:0] da, [4:2] pn, [7:5] pm
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((Pn & 0x7) << 2) | 
                                        ((Pm & 0x7) << 5);

            if (sz == 0) {
                // 32-bit variant: 8-bit sources to 32-bit destination
                return new SmeUmops4way<uint8_t, uint32_t>(machInst, imm_packed, Zn, Zm);
            } else {
                // 64-bit variant: 16-bit sources to 64-bit destination
                return new SmeUmops4way<uint16_t, uint64_t>(machInst, imm_packed, Zn, Zm);
            }
        }

        // Check for UTMOPA (2-way Sparse)
        if (Aarch64::isUtmopa(machInst)) {
            const uint8_t Zm  = bits(machInst, 20, 16);
            const uint8_t K   = bits(machInst, 12, 12);
            const uint8_t Zk2 = bits(machInst, 11, 10);
            const uint8_t Zn4 = bits(machInst, 9, 6);
            const uint8_t i2  = bits(machInst, 5, 4);
            const uint8_t ZAda = bits(machInst, 1, 0);

            // Calculate base register for the Zn multi-vector (Zn * 2)
            const RegIndex Zn_base = (RegIndex)(Zn4 << 1);

            // Calculate Zk control register (Z20-Z23 or Z28-Z31)
            // K=0 -> 101xx -> 20 + Zk2
            // K=1 -> 111xx -> 28 + Zk2
            const RegIndex Zk_base = (RegIndex)(20 + (K << 3) + Zk2);

            // Pack Immediate: [1:0] da, [3:2] i2 index, [8:4] Zk
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((i2 & 0x3) << 2) | 
                                        ((Zk_base & 0x1F) << 4);

            return new SmeUtmopa2way<uint16_t, uint32_t>(machInst, imm_packed, Zn_base, Zm);
        }

        // Check for UTMOPA (4-way Sparse)
        if (Aarch64::isUtmopa4way(machInst)) {
            const uint8_t Zm  = bits(machInst, 20, 16);
            const uint8_t K   = bits(machInst, 12, 12);
            const uint8_t Zk2 = bits(machInst, 11, 10);
            const uint8_t Zn4 = bits(machInst, 9, 6);
            const uint8_t i2  = bits(machInst, 5, 4);
            const uint8_t ZAda = bits(machInst, 1, 0);

            // Zn is encoded as Zn4 * 2
            const RegIndex Zn_base = (RegIndex)(Zn4 << 1);

            // Zk control register
            const RegIndex Zk_base = (RegIndex)(20 + (K << 3) + Zk2);

            // Pack Immediate: [1:0] da, [3:2] i2 index, [8:4] Zk
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((i2 & 0x3) << 2) | 
                                        ((Zk_base & 0x1F) << 4);

            // Generate SmeUtmopa4way (uint8_t to uint32_t)
            return new SmeUtmopa4way<uint8_t, uint32_t>(machInst, imm_packed, Zn_base, Zm);
        }

        // Check for SMOPA (2-way)
        if (Aarch64::isSmopa2way(machInst)) {
            const uint8_t Zm = bits(machInst, 20, 16);
            const uint8_t Pm = bits(machInst, 15, 13);
            const uint8_t Pn = bits(machInst, 12, 10);
            const uint8_t Zn = bits(machInst, 9, 5);
            const uint8_t ZAda = bits(machInst, 1, 0);

            // Pack Immediate: [1:0] da, [4:2] pn, [7:5] pm
            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((Pn & 0x7) << 2) | 
                                        ((Pm & 0x7) << 5);

            // Notice we use signed integer templates (int16_t, int32_t) to ensure correct sign extension
            return new SmeSmopa2way<int16_t, int32_t>(machInst, imm_packed, Zn, Zm);
        }

        // Check for SMOPS (2-way)
        if (Aarch64::isSmops2way(machInst)) {
            const uint8_t Zm = bits(machInst, 20, 16);
            const uint8_t Pm = bits(machInst, 15, 13);
            const uint8_t Pn = bits(machInst, 12, 10);
            const uint8_t Zn = bits(machInst, 9, 5);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint64_t imm_packed = (ZAda & 0x3) | 
                                        ((Pn & 0x7) << 2) | 
                                        ((Pm & 0x7) << 5);

            // Instantiate Smops2way
            return new SmeSmops2way<int16_t, int32_t>(machInst, imm_packed, Zn, Zm);
        }

        // Check for SMOP4A
        if (Aarch64::isSmop4a(machInst)) {
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            return new SmeSmop4a<int16_t, int32_t>(machInst, imm_packed, Zn_base, Zm_base);
        }

        // Check for SMOP4S
        if (Aarch64::isSmop4s(machInst)) {
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            return new SmeSmop4s<int16_t, int32_t>(machInst, imm_packed, Zn_base, Zm_base);
        }

        // Check for SMOP4A (4-way)
        if (Aarch64::isSmop4a4way(machInst)) {
            const uint8_t sz  = bits(machInst, 22, 22);
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            if (sz == 0) {
                return new SmeSmop4a4way<int8_t, int32_t>(machInst, imm_packed, Zn_base, Zm_base);
            } else {
                return new SmeSmop4a4way<int16_t, int64_t>(machInst, imm_packed, Zn_base, Zm_base);
            }
        }

        // Check for SMOP4S (4-way)
        if (Aarch64::isSmop4s4way(machInst)) {
            const uint8_t sz  = bits(machInst, 22, 22);
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            if (sz == 0) {
                return new SmeSmop4s4way<int8_t, int32_t>(machInst, imm_packed, Zn_base, Zm_base);
            } else {
                return new SmeSmop4s4way<int16_t, int64_t>(machInst, imm_packed, Zn_base, Zm_base);
            }
        }

        // Check for SUMOP4A (4-way, Signed x Unsigned)
        if (Aarch64::isSumop4a4way(machInst)) {
            const uint8_t sz  = bits(machInst, 22, 22);
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            if (sz == 0) {
                // We can pass uint8_t as the base type; the C++ code will cast appropriately.
                return new SmeSumop4a4way<uint8_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
            } else {
                return new SmeSumop4a4way<uint16_t, uint64_t>(machInst, imm_packed, Zn_base, Zm_base);
            }
        }

        // Check for SUMOP4S (4-way, Signed x Unsigned)
        if (Aarch64::isSumop4s4way(machInst)) {
            const uint8_t sz  = bits(machInst, 22, 22);
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            if (sz == 0) {
                return new SmeSumop4s4way<uint8_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
            } else {
                return new SmeSumop4s4way<uint16_t, uint64_t>(machInst, imm_packed, Zn_base, Zm_base);
            }
        }

        // Check for UMOP4A (2-way, Unsigned)
        if (Aarch64::isUmop4a(machInst)) {
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            return new SmeUmop4a<uint16_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
        }

        // Check for UMOP4S (2-way, Unsigned)
        if (Aarch64::isUmop4s(machInst)) {
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            return new SmeUmop4s<uint16_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
        }

        // Check for UMOP4A (4-way, Unsigned)
        if (Aarch64::isUmop4a4way(machInst)) {
            const uint8_t sz  = bits(machInst, 22, 22);
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            if (sz == 0) {
                return new SmeUmop4a4way<uint8_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
            } else {
                return new SmeUmop4a4way<uint16_t, uint64_t>(machInst, imm_packed, Zn_base, Zm_base);
            }
        }

        // Check for UMOP4S (4-way, Unsigned)
        if (Aarch64::isUmop4s4way(machInst)) {
            const uint8_t sz  = bits(machInst, 22, 22);
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            if (sz == 0) {
                return new SmeUmop4s4way<uint8_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
            } else {
                return new SmeUmop4s4way<uint16_t, uint64_t>(machInst, imm_packed, Zn_base, Zm_base);
            }
        }

        // Check for USMOP4A (4-way, Unsigned x Signed)
        if (Aarch64::isUsmop4a(machInst)) {
            const uint8_t sz  = bits(machInst, 22, 22);
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            if (sz == 0) {
                return new SmeUsmop4a<uint8_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
            } else {
                return new SmeUsmop4a<uint16_t, uint64_t>(machInst, imm_packed, Zn_base, Zm_base);
            }
        }

        // Check for USMOP4S (4-way, Unsigned x Signed)
        if (Aarch64::isUsmop4s(machInst)) {
            const uint8_t sz  = bits(machInst, 22, 22);
            const uint8_t M   = bits(machInst, 20, 20);
            const uint8_t Zm3 = bits(machInst, 18, 16);
            const uint8_t N   = bits(machInst, 9, 9);
            const uint8_t Zn3 = bits(machInst, 8, 6);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const uint8_t nreg = N ? 2 : 1;
            const uint8_t mreg = M ? 2 : 1;
            const RegIndex Zn_base = (RegIndex)(Zn3 << 1);
            const RegIndex Zm_base = (RegIndex)(16 + (Zm3 << 1));

            const uint64_t imm_packed = (ZAda & 0x3) | ((nreg - 1) << 2) | ((mreg - 1) << 4);

            if (sz == 0) {
                return new SmeUsmop4s<uint8_t, uint32_t>(machInst, imm_packed, Zn_base, Zm_base);
            } else {
                return new SmeUsmop4s<uint16_t, uint64_t>(machInst, imm_packed, Zn_base, Zm_base);
            }
        }

        // Check for STMOPA (2-way Sparse, Signed)
        if (Aarch64::isStmopa2way(machInst)) {
            const uint8_t Zm  = bits(machInst, 20, 16);
            const uint8_t K   = bits(machInst, 12, 12);
            const uint8_t Zk2 = bits(machInst, 11, 10);
            const uint8_t Zn4 = bits(machInst, 9, 6);
            const uint8_t i2  = bits(machInst, 5, 4);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const RegIndex Zn_base = (RegIndex)(Zn4 << 1);
            const RegIndex Zk_base = (RegIndex)(20 + (K << 3) + Zk2);

            const uint64_t imm_packed = (ZAda & 0x3) | ((i2 & 0x3) << 2) | ((Zk_base & 0x1F) << 4);

            // Instantiate with signed types (int16_t -> int32_t) to ensure correct sign extension
            return new SmeStmopa2way<int16_t, int32_t>(machInst, imm_packed, Zn_base, Zm);
        }

        // Check for STMOPA (4-way Sparse, Signed)
        if (Aarch64::isStmopa4way(machInst)) {
            const uint8_t Zm  = bits(machInst, 20, 16);
            const uint8_t K   = bits(machInst, 12, 12);
            const uint8_t Zk2 = bits(machInst, 11, 10);
            const uint8_t Zn4 = bits(machInst, 9, 6);
            const uint8_t i2  = bits(machInst, 5, 4);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const RegIndex Zn_base = (RegIndex)(Zn4 << 1);
            const RegIndex Zk_base = (RegIndex)(20 + (K << 3) + Zk2);

            const uint64_t imm_packed = (ZAda & 0x3) | ((i2 & 0x3) << 2) | ((Zk_base & 0x1F) << 4);

            // Pass int8_t -> int32_t to natively enforce the SInt() architecture constraint
            return new SmeStmopa4way<int8_t, int32_t>(machInst, imm_packed, Zn_base, Zm);
        }

        // Check for SUTMOPA (4-way Sparse, Signed x Unsigned)
        if (Aarch64::isSutmopa(machInst)) {
            const uint8_t Zm  = bits(machInst, 20, 16);
            const uint8_t K   = bits(machInst, 12, 12);
            const uint8_t Zk2 = bits(machInst, 11, 10);
            const uint8_t Zn4 = bits(machInst, 9, 6);
            const uint8_t i2  = bits(machInst, 5, 4);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const RegIndex Zn_base = (RegIndex)(Zn4 << 1);
            const RegIndex Zk_base = (RegIndex)(20 + (K << 3) + Zk2);

            const uint64_t imm_packed = (ZAda & 0x3) | ((i2 & 0x3) << 2) | ((Zk_base & 0x1F) << 4);

            return new SmeSutmopa<uint8_t, uint32_t>(machInst, imm_packed, Zn_base, Zm);
        }

        // Check for USTMOPA (4-way Sparse, Unsigned x Signed)
        if (Aarch64::isUstmopa(machInst)) {
            const uint8_t Zm  = bits(machInst, 20, 16);
            const uint8_t K   = bits(machInst, 12, 12);
            const uint8_t Zk2 = bits(machInst, 11, 10);
            const uint8_t Zn4 = bits(machInst, 9, 6);
            const uint8_t i2  = bits(machInst, 5, 4);
            const uint8_t ZAda = bits(machInst, 1, 0);

            const RegIndex Zn_base = (RegIndex)(Zn4 << 1);
            const RegIndex Zk_base = (RegIndex)(20 + (K << 3) + Zk2);

            const uint64_t imm_packed = (ZAda & 0x3) | ((i2 & 0x3) << 2) | ((Zk_base & 0x1F) << 4);

            return new SmeUstmopa<uint8_t, uint32_t>(machInst, imm_packed, Zn_base, Zm);
        }

        // ------------------------------------------------------------
        // 2) MOVA (vector -> tile, TWO regs) — FEAT_SME2
        //    Must be checked BEFORE the generic MOVA insert/extract routes
        //    or it can be mis-decoded and crash in matrix.hh (tile index).
        //
        // From objdump:
        //   0xC004xxxx : mov za?h.b[...], {z?.b, z?.b}
        //   0xC044xxxx : mov za?h.h[...], {z?.h, z?.h}
        //   0xC084xxxx : mov za?h.s[...], {z?.s, z?.s}
        //   0xC0C4xxxx : mov za?h.d[...], {z?.d, z?.d}
        // We match on the high 16 bits.
        // ------------------------------------------------------------
        // Note: Lambdas inside methods might not need qualification if generic,
        // but explicit methods called below do.
        auto isMova2B = [](uint32_t x) -> bool { return (uint16_t)(x >> 16) == 0xC004u; };
        auto isMova2H = [](uint32_t x) -> bool { return (uint16_t)(x >> 16) == 0xC044u; };
        auto isMova2S = [](uint32_t x) -> bool { return (uint16_t)(x >> 16) == 0xC084u; };
        auto isMova2D = [](uint32_t x) -> bool { return (uint16_t)(x >> 16) == 0xC0C4u; };
        
        if (isMova2B(insn) || isMova2H(insn) || isMova2S(insn) || isMova2D(insn)) {
            return Aarch64::decodeSmeMovaVecToTile2Regs(machInst);
        }


        if (Aarch64::isSme2Scvtf2(insn) || Aarch64::isSme2Scvtf4(insn) ||
            Aarch64::isSme2Ucvtf2(insn) || Aarch64::isSme2Ucvtf4(insn) ||
            Aarch64::isSme2FcvtFp16Fp8(insn) || Aarch64::isSme2FcvtFp32Fp16(insn) || 
            Aarch64::isSme2FcvtFp32Fp8(insn) || Aarch64::isSme2Bfcvt(insn) ||
            Aarch64::isSme2BfcvtFp32Bf16(insn) || Aarch64::isSme2Bfcvtn(insn) ||
            Aarch64::isSme2Fcvtl(insn) ||
            Aarch64::isSme2F1cvtl(insn) || Aarch64::isSme2F2cvtl(insn) ||
            Aarch64::isSme2Bf1cvtl(insn) || Aarch64::isSme2Bf2cvtl(insn) ||
            Aarch64::isSme2Bf1cvt(insn) || Aarch64::isSme2Bf2cvt(insn) ||
            Aarch64::isSme2F1cvt(insn) || Aarch64::isSme2F2cvt(insn) ||
            Aarch64::isSme2Sqcvt(insn) || Aarch64::isSme2Sqcvtu(insn) ||
            Aarch64::isSme2Uqcvt(insn) || Aarch64::isSme2Sqcvt2(insn) ||
            Aarch64::isSme2Uqcvt2(insn) || Aarch64::isSme2Sqcvtu2(insn) ||
            Aarch64::isSme2Sqcvtn(insn) || Aarch64::isSme2Sqcvtun(insn) ||
            Aarch64::isSme2Uqcvtn(insn)) {   
            
            return Aarch64::decodeSmeCvt(machInst);
        }

        const uint8_t op0 = (uint8_t)bits(machInst, 30, 29);
        const uint8_t op1 = (uint8_t)bits(machInst, 24, 19);
        const uint8_t op2 = (uint8_t)bits(machInst, 17);
        const uint8_t op3 = (uint8_t)bits(machInst, 4, 2);
        
        if ((op0 & 0b10) == 0b00) {
            if ((op1 & 0b011000) == 0b010000) {
                if ((op3 & 0b001) == 0b000) {
                    return Aarch64::decodeSmeOp32(machInst);
                }
            }

            if ((op1 & 0b011000) == 0b011000) {
                if ((op3 & 0b010) == 0b000) {
                    return Aarch64::decodeSmeOp64(machInst);
                }
            }
        }

        if (op0 == 0b10) {
            if ((op1 & 0b100111) == 0b000000) {
                if (op2 == 0b0) {
                    if ((op3 & 0b100) == 0b000) {
                        return Aarch64::decodeSmeMovaInsert(machInst);
                    }
                }

                if (op2 ==0b1) {
                    return Aarch64::decodeSmeMovaExtract(machInst);
                }
            }

            if ((op1 & 0b100111) == 0b000001) {
                return Aarch64::decodeSmeMisc(machInst);
            }

            if ((op1 & 0b100111) == 0b000010) {
                if ((op3 & 0b010) == 0b000) {
                    return Aarch64::decodeSmeAddArray(machInst);
                }
            }
        }

        if (op0 == 0b11) {
            return Aarch64::decodeSmeMemory(machInst);
        }

        // We should not get here
        return new Unknown64(machInst);
    }


    /// FTMOPA (non-widening) matcher for .H (half-precision)
    static inline bool
    isFtmopaNonWideningF16(uint32_t insn)
    {
        // Operand fields in the FTMOPA .H encoding:
        //
        //   Zm       : bits 20..16
        //   Zk / K   : bits 12..10
        //   Zn group : bits  9..6   (base of {Zn1, Zn2})
        //   i2       : bits  5..4   (control segment index)
        //   ZAda     : bit   0      (ZA0..ZA1 for .H)
        //
        constexpr uint32_t ftmopa_h_operand_mask =
              (0x1Fu << 16)   // Zm
            | (0x7u  << 10)   // Zk / K
            | (0xFu  <<  6)   // Zn group
            | (0x3u  <<  4)   // index (i2)
            | (0x1u  <<  0);  // ZAda (.H uses only bit 0)


        constexpr uint32_t ftmopa_h_base_encoding = 0x81A12018u;
        constexpr uint32_t ftmopa_h_opcode_key =
            ftmopa_h_base_encoding & ~ftmopa_h_operand_mask;
        // Match: mask out operand bits from 'insn' and compare only the
        // fixed opcode pattern against the key.
        return (insn & ~ftmopa_h_operand_mask) == ftmopa_h_opcode_key;
    }

    /// FTMOPA (non-widening) matcher for .S (single-precision)
    static inline bool
    isFtmopaNonWideningF32(uint32_t insn)
    {
        // Operand fields as per FTMOPA .S encoding in the ARM ARM.
        constexpr uint32_t ftmopa_s_operand_mask =
              (0x1Fu << 16)   // Zm
            | (0x7u  << 10)   // Zk/K
            | (0xFu  <<  6)   // Zn group
            | (0x3u  <<  4)   // index (i2)
            | (0x3u  <<  0);  // ZAda (.S uses bits [1:0])

        constexpr uint32_t ftmopa_s_base_encoding = 0x80A02008u;
        // ^ This is 0x80A12018 with all operand bits zeroed;
        constexpr uint32_t ftmopa_s_opcode_key =
            ftmopa_s_base_encoding & ~ftmopa_s_operand_mask;
        // Compare only the fixed opcode bits
        return (insn & ~ftmopa_s_operand_mask) == ftmopa_s_opcode_key;
    }

    /// FTMOPA (widening, 2-way, FP16 to FP32) matcher
    static inline bool
    isFtmopaWideningF16ToF32(uint32_t insn)
    {
        // Operand fields for the widening .S form:
        //   Zm   : bits 20..16
        //   K:Zk : bits 12..10
        //   Zn   : bits  9..6
        //   i2   : bits  5..4
        //   ZAda : bits  1..0
        constexpr uint32_t operand_mask =
              (0x1Fu << 16)   // Zm
            | (0x7u  << 10)   // K:Zk
            | (0xFu  <<  6)   // Zn
            | (0x3u  <<  4)   // i2
            | (0x3u  <<  0);  // ZAda

        // Fixed opcode pattern from the ARM ARM bit diagram:
        // bits[31:0] with all operand fields zero =>
        //   bits 31,24,22,21 = 1, all others (outside operands) = 0
        constexpr uint32_t base_encoding =
              (1u << 31)
            | (1u << 24)
            | (1u << 22)
            | (1u << 21);
        // 0x81600000

        constexpr uint32_t opcode_key = base_encoding & ~operand_mask;
        // Match only on the fixed opcode bits.
        return (insn & ~operand_mask) == opcode_key;
    }

    /// FTMOPA (widening, 2-way, FP8 to FP16) matcher
    static inline bool
    isFtmopaWideningF8ToF16(uint32_t insn)
    {
        // Operand fields for the widening .H FP8->FP16 form:
        //   Zm   : bits 20..16
        //   K:Zk : bits 12..10
        //   Zn   : bits  9..6   (multi-vector pair base)
        //   i2   : bits  5..4
        //   ZAda : bit   0      (ZA0..ZA1 for .H)
        constexpr uint32_t operand_mask =
              (0x1Fu << 16)   // Zm
            | (0x7u  << 10)   // K:Zk
            | (0xFu  <<  6)   // Zn group
            | (0x3u  <<  4)   // i2
            | (0x1u  <<  0);  // ZAda (.H: only bit 0)

        // TODO: set base_encoding to the FP8->FP16 FTMOPA opcode with all
        // operand fields zeroed.
        // You can get this by assembling e.g.:
        //
        //   ftmopa za0.h, {z0.b-z1.b}, z0.b, z20.b[0]
        //
        // and masking off the operand bits using operand_mask (same method
        // you used for the other FTMOPA matchers).
        constexpr uint32_t base_encoding = 0x80600008u;

        constexpr uint32_t opcode_key = base_encoding & ~operand_mask;

        // Match only on the fixed opcode bits.
        return (insn & ~operand_mask) == opcode_key;
    }

    /// FTMOPA (widening, 4-way, FP8 to FP32) matcher
    static inline bool
    isFtmopaWidening4WayF8ToF32(uint32_t insn)
    {
        // Operand fields are the same as the other .S TMOP forms:
        //   Zm   : bits 20..16
        //   K:Zk : bits 12..10
        //   Zn   : bits  9..6   (multi-vector pair base)
        //   i2   : bits  5..4
        //   ZAda : bits  1..0
        constexpr uint32_t operand_mask =
              (0x1Fu << 16)   // Zm
            | (0x7u  << 10)   // K:Zk
            | (0xFu  <<  6)   // Zn group
            | (0x3u  <<  4)   // i2
            | (0x3u  <<  0);  // ZAda

        constexpr uint32_t base_encoding = 0x80600008u;
        constexpr uint32_t opcode_key = base_encoding & ~operand_mask;

        return (insn & ~operand_mask) == opcode_key;
    }

    /// FMOP4A (non-widening) matcher
    static inline bool
    isFmop4a(uint32_t insn)
    {
        // FMOP4A (non-widening) .S encoding: 
        // 31..21 = 1100 0000 100
        // Zm(20-16), Zn(9-5), ZAda(1-0) are variables.
        // Bit 15=0, 14-10=0, 4-2=0. 
        // Verify this hex mask against your specific SME2 opcode spec.
        constexpr uint32_t operand_mask = 
            (0x1F << 16) |
            (0x1F << 5) | (0x3 << 0);
            
        // Assuming base encoding is roughly 0xC0800000 
        constexpr uint32_t base_encoding = 0xC0800000;
        return (insn & ~operand_mask) == base_encoding;
    }

    // FMOP4A (Widening)
    static inline bool
    isFmop4aWidening(uint32_t insn)
    {
        // Operands: Zm(20-16), Zn(9-5), ZAda(1-0) are masked out.
        // We also check bits [15:10] and [4] as our unique signature.
        constexpr uint32_t mask = 
            (0x1F << 16) |
            (0x1F << 5) | (0x3 << 0);
            
        // Opcode: 0xC000FC10
        // Top 11 bits (31-21): 0xC00 (Matches SmeControl/Zero range)
        // Bits 15-10: 0x3F (All 1s, distinct from MOVA)
        // Bit 4: 1
        return (insn & ~mask) == 0xC000FC10;
    }
    
    // FMOP4A (Widening, 2-way, FP16 to FP32)
    static inline bool
    isFmop4aWideningF16(uint32_t insn)
    {
        // 31-21: 1100 0000 100 (0xC08)
        // 15-10: 0011 11 (0x0F)
        // 4: 0
        // 3-2: 10
        // Mask excludes Zm(20-16), Zn(9-5), ZAda(1-0)
        constexpr uint32_t mask = 0xFFE0FC1C;
        constexpr uint32_t base = 0xC0803C08;
        return (insn & mask) == base;
    }

    // FMOP4A (Widening, 2-way, FP8 to FP16)
    static inline bool
    isFmop4aWideningF8ToF16(uint32_t insn)
    {
        // Encoding Pattern
        // 31-21: 1100 0000 100 (0xC08)
        // 15-10: 0011 11 (0x0F)
        // 4: 0
        // 3-2: 01 (Distinct from FP16->FP32 which is 10)
        
        // Mask excludes Zm(20-16), Zn(9-5), ZAda(0)
        constexpr uint32_t mask = 0xFFE0FC1C; 
        // Base encoding to match (Example: 0xC0803C04)
        constexpr uint32_t base = 0xC0803C04; 
        
        return (insn & mask) == base;
    }

    // BFMOP4A (Non-widening) Matcher
    static inline bool
    isBfmop4a(uint32_t insn)
    {
        // BFMOP4A Encoding
        // Fixed bits (based on user spec + standard SME2 prefix):
        //   31-20: 1100 0000 1001 (0xC09) -> Assuming standard SME2 prefix
        //   16-9:  0000 0000
        //   5-1:   0000 0
        // Variable bits:
        //   Zm: 19-17
        //   Zn: 8-6
        //   ZAda: 0
        
        // Mask excludes Zm(19-17), Zn(8-6), ZAda(0)
        constexpr uint32_t operand_mask = 
            (0x7 << 17) | // Zm
            (0x7 << 6)  | // Zn
            (0x1 << 0);   // ZAda

        constexpr uint32_t base_encoding = 0xC0A00000; 

        return (insn & ~operand_mask) == base_encoding;
    }

    // BFMOP4A (Widening, FEAT_SME_MOP4) Matcher
    static inline bool
    isBfmop4aWidening(uint32_t insn)
    {
        // Variable fields:
        //   Zm   : bits 19..17
        //   Zn   : bits  8.. 6
        //   ZAda : bits  1.. 0
        //   M    : bit  20   (selects mreg/nreg class)
        //   N    : bit  10
        constexpr uint32_t operand_mask =
            (0x7u << 17) |   // Zm
            (0x1u << 20) |   // M
            (0x1u << 10) |   // N
            (0x7u << 6)  |   // Zn
            (0x3u << 0);     // ZAda

        // Base for these encodings is 0b1000_0001........ = 0x81000000
        constexpr uint32_t base_encoding = 0x81000000u;

        return (insn & ~operand_mask) == base_encoding;
    }

    // BFMOP4S (Widening) Matcher
    static inline bool
    isBfmop4sWidening(uint32_t insn)
    {
        constexpr uint32_t operand_mask =
            (0x7u << 17) | // Zm
            (0x1u << 20) | // M
            (0x1u << 10) | // N
            (0x7u << 6)  | // Zn
            (0x3u << 0);   // ZAda

        // Base encoding has Bit 4 set to 1
        constexpr uint32_t base_encoding = 0x81000010u;
        return (insn & ~operand_mask) == base_encoding;
    }

    // BFMOP4S (Non-widening) Matcher
    static inline bool
    isBfmop4s(uint32_t insn)
    {
        constexpr uint32_t operand_mask = 
            (0x1u << 20) | // M (Bit 20)
            (0x7u << 17) | // Zm (Bits 19-17)
            (0x1u << 9)  | // N (Bit 9) - Note: Bit 9 for this instruction
            (0x7u << 6)  | // Zn (Bits 8-6)
            (0x1u << 0);   // ZAda (Bit 0)

        // Base encoding: 1000 0001 0010 0000 0000 0000 0001 1000
        constexpr uint32_t base_encoding = 0x81200018u; 

        return (insn & ~operand_mask) == base_encoding;
    }

    // BFTMOPA (Non-widening, Sparse) Matcher
    static inline bool
    isBftmopa(uint32_t insn)
    {
        constexpr uint32_t operand_mask =
            (0x1fu << 16) | // Zm  (5 bits)
            (0x1u  << 12) | // K   (1 bit)
            (0x3u  << 10) | // Zk  (2 bits)
            (0xfu  << 6)  | // Zn  (4 bits)
            (0x3u  << 4)  | // i2  (2 bits)
            (0x1u  << 0);   // ZAda(1 bit)

        // Base encoding: 1000 0001 0110 0000 0000 0000 0000 1000
        constexpr uint32_t base_encoding = 0x81600008u;

        return (insn & ~operand_mask) == base_encoding;
    }

    // BFTMOPA (Widening, Sparse) Matcher
    static inline bool
    isBftmopaWidening(uint32_t insn)
    {
        constexpr uint32_t operand_mask =
            (0x1fu << 16) | // Zm
            (0x1u  << 12) | // K
            (0x3u  << 10) | // Zk
            (0xfu  << 6)  | // Zn
            (0x3u  << 4)  | // i2
            (0x3u  << 0);   // ZAda (2 bits for FP32 tile)

        // Base encoding: 1000 0001 0100 0000 0000 0000 0000 0000
        constexpr uint32_t base_encoding = 0x81400000u;

        return (insn & ~operand_mask) == base_encoding;
    }

    static inline bool
    isFmop4sNonWidening(uint32_t insn)
    {
        constexpr uint32_t operand_mask =
            (1u << 24) |    // sz (1 bit)
            (1u << 20) |    // M (1 bit)
            (0x7u << 16) |  // Zm (3 bits)
            (1u << 9)  |    // N (1 bit)
            (0x7u << 6)  |  // Zn (3 bits)
            (1u << 3)  |    // sz (1 bit)
            (0x3u << 0);    // ZAda (2 bits)

        // Base encoding: 1000 0000 0000 0000 0000 0000 0001 0000
        // Fixes bits 31:25 to 1000000 and bit 4 to 1
        constexpr uint32_t base_encoding = 0x80000010u;

        if ((insn & ~operand_mask) != base_encoding)
            return false;

        // Validate that both 'sz' bits match to confirm this is a valid encoding
        bool sz24 = (insn >> 24) & 1;
        bool sz3  = (insn >> 3) & 1;
        return sz24 == sz3;
    }

    static inline bool
    isFmop4sWidening(uint32_t insn)
    {
        // Matches FMOP4S Widening (FP16 -> FP32)
        // Fixed bits from spec: 31=1, 24=1, 19=1, 4=1 (S-bit)
        // Mask covers: fixed bits, M(20), Zm(18-16), N(9), Zn(8-6), ZAda(1-0)
        constexpr uint32_t rigid_mask = 0xFFE8FC3Cu;
        constexpr uint32_t rigid_val  = 0x81280010u;

        return (insn & rigid_mask) == rigid_val;
    }

    static inline bool
    isBmopa(uint32_t insn)
    {
        // Matches BMOPA (32-bit integer predicated XNOR popcount)
        // Fixed bits from spec: 31=1, 23=1, 4=0 (S-bit is 0 for ADD, 1 would be SUB), 3=1, 2=0
        // Mask covers: 31-24, 23-21, and 4-2
        constexpr uint32_t rigid_mask = 0xFFE0001Cu;
        constexpr uint32_t rigid_val  = 0x80800008u;

        return (insn & rigid_mask) == rigid_val;
    }

    static inline bool
    isBmops(uint32_t insn)
    {
        // Matches BMOPS (32-bit integer predicated XNOR popcount, subtracting)
        // Fixed bits from Arm spec: [31:24]=10000000, [23:21]=100, [4:2]=110 (Bit 4 is 1 for BMOPS)
        constexpr uint32_t operand_mask = 
            (0xFFu << 24) | 
            (0x7u  << 21) | 
            (0x7u  << 2);

        // Bit 4 is '1', so the lower byte is 0001 1000 -> 0x18
        constexpr uint32_t base_encoding = 0x80800018u;

        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUmopa(uint32_t insn)
    {
        // Matches UMOPA (2-way Unsigned 16-bit to 32-bit, accumulating)
        // Fixed bits from Arm spec: 
        // [31:24] = 10100001 (0xA1, where bit 24 '1' means Unsigned)
        // [23:21] = 100      (0x4)
        // [4:2]   = 010      (Bit 4 '0' means Accumulate)
        constexpr uint32_t operand_mask = 
            (0xFFu << 24) | 
            (0x7u  << 21) | 
            (0x7u  << 2);

        constexpr uint32_t base_encoding = 0xA1800008u;

        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUmops(uint32_t insn)
    {
        // Matches UMOPS (2-way Unsigned 16-bit to 32-bit, subtracting)
        // Fixed bits from Arm spec: 
        // [31:24] = 10100001 (0xA1, bit 24 '1' means Unsigned)
        // [23:21] = 100      (0x4)
        // [4:2]   = 110      (Bit 4 '1' means Subtract)
        constexpr uint32_t operand_mask = 
            (0xFFu << 24) | 
            (0x7u  << 21) | 
            (0x7u  << 2);

        constexpr uint32_t base_encoding = 0xA1800018u;

        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUmopa4way(uint32_t insn)
    {
        // Matches UMOPA (4-way Unsigned 8/16-bit to 32/64-bit, accumulating)
        // Fixed bits from Arm spec: 
        // [31:24] = 10100001 (0xA1, bit 24 '1' means Unsigned u0)
        // [23]    = 1
        // [21]    = 1        (Unsigned u1)
        // [4:2]   = 000      (Bit 4 '0' means Accumulate)
        // Note: Bit 22 is 'sz' (0=32-bit, 1=64-bit) so we leave it out of the mask.
        constexpr uint32_t operand_mask = 
            (0xFFu << 24) | 
            (1u << 23) | 
            (1u << 21) | 
            (0x7u << 2);

        constexpr uint32_t base_encoding = 
            (0xA1u << 24) | 
            (1u << 23) | 
            (1u << 21) | 
            (0x0u << 2); // 0xA1A00000

        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUmops4way(uint32_t insn)
    {
        // Matches UMOPS (4-way Unsigned 8/16-bit to 32/64-bit, subtracting)
        // Fixed bits from Arm spec: 
        // [31:24] = 10100001 (0xA1, bit 24 '1' means Unsigned u0)
        // [23]    = 1
        // [21]    = 1        (Unsigned u1)
        // [4:2]   = 100      (Bit 4 '1' means Subtract)
        constexpr uint32_t operand_mask = 
            (0xFFu << 24) | 
            (1u << 23) | 
            (1u << 21) | 
            (0x7u << 2);

        // 0xA1A00000 + 0x10 (Bit 4) = 0xA1A00010
        constexpr uint32_t base_encoding = 
            (0xA1u << 24) | 
            (1u << 23) | 
            (1u << 21) | 
            (0x4u << 2); 

        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUtmopa(uint32_t insn)
    {
        // Matches UTMOPA (2-way Unsigned 16-bit sparse to 32-bit, accumulating)
        // Fixed bits from Arm spec:
        // [31:25] = 1000000
        // [24]    = 0 (Unsigned u0)
        // [23:21] = 010
        // [15:13] = 100
        // [3:2]   = 10
        constexpr uint32_t operand_mask = 
            (0x7Fu << 25) | 
            (1u << 24) | 
            (0x7u << 21) | 
            (0x7u << 13) | 
            (0x3u << 2);

        constexpr uint32_t base_encoding = 
            (0x40u << 25) | 
            (0x1u << 24) | 
            (0x2u << 21) | 
            (0x4u << 13) | 
            (0x2u << 2); // 0x80408008

        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUtmopa4way(uint32_t insn)
    {
        // Matches UTMOPA (4-way Unsigned 8-bit sparse to 32-bit, accumulating)
        // Fixed bits from Arm spec:
        // [31:25] = 1000000
        // [24]    = 1 (Unsigned u0)
        // [23:22] = 01
        // [21]    = 1 (Unsigned u1)
        // [15:13] = 100
        // [3:2]   = 00
        constexpr uint32_t operand_mask = 
            (0x7Fu << 25) | 
            (1u << 24) | 
            (0x3u << 22) | 
            (1u << 21) | 
            (0x7u << 13) | 
            (0x3u << 2);

        constexpr uint32_t base_encoding = 
            (0x40u << 25) | 
            (0x1u << 24) | 
            (0x1u << 22) | 
            (0x1u << 21) | 
            (0x4u << 13) | 
            (0x0u << 2); // 0x83608000

        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isSmopa2way(uint32_t insn)
    {
        // Matches SMOPA (2-way Signed 16-bit to 32-bit, accumulating)
        // Fixed bits from Arm spec: 
        // [31:24] = 10100000 (0xA0, bit 24 '0' means Signed u0)
        // [23:21] = 100      (0x4)
        // [4:2]   = 010      (Bit 4 '0' means Accumulate)
        constexpr uint32_t operand_mask = 
            (0xFFu << 24) | 
            (0x7u  << 21) | 
            (0x7u  << 2);

        constexpr uint32_t base_encoding = 0xA0800008u;

        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isSmops2way(uint32_t insn)
    {
        // Matches SMOPS (2-way Signed 16-bit to 32-bit, subtracting)
        // Same mask as SMOPA, but Bit 4 ('S' bit) is 1
        constexpr uint32_t operand_mask = 
            (0xFFu << 24) | 
            (0x7u  << 21) | 
            (0x7u  << 2);

        constexpr uint32_t base_encoding = 0xA0800018u;

        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isSmop4a(uint32_t insn)
    {
        // Matches SMOP4A (Quarter-tile Signed 16-bit to 32-bit, accumulating)
        // Fixed bits: [31:24]=0x80, [23:21]=000, [15:10]=010000, [5]=0, [4]=0 (S bit), [3:2]=10
        constexpr uint32_t operand_mask = 0xFFE0FC3Cu;
        constexpr uint32_t base_encoding = 0x80004008u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isSmop4s(uint32_t insn)
    {
        // Matches SMOP4S (Quarter-tile Signed 16-bit to 32-bit, subtracting)
        // Bit 4 ('S' bit) is 1
        constexpr uint32_t operand_mask = 0xFFE0FC3Cu;
        constexpr uint32_t base_encoding = 0x80004018u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isSmop4a4way(uint32_t insn)
    {
        // Matches SMOP4A (Quarter-tile Signed 8/16-bit to 32/64-bit, 4-way accumulating)
        // Fixed bits: 
        // [31:24]=0x80, [23]=0, [21]=0, [15:10]=010000 (0x10), [5]=0, [4]=0 (S bit), [3:2]=00
        // Note: Bit 22 is 'sz', excluded from mask.
        constexpr uint32_t operand_mask = 0xFFA0FC2Cu;
        constexpr uint32_t base_encoding = 0x80004000u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isSmop4s4way(uint32_t insn)
    {
        // Matches SMOP4S (Quarter-tile Signed 8/16-bit to 32/64-bit, 4-way subtracting)
        // Bit 4 ('S' bit) is 1, adding 0x10 to the base
        constexpr uint32_t operand_mask = 0xFFA0FC2Cu;
        constexpr uint32_t base_encoding = 0x80004010u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isSumop4a4way(uint32_t insn)
    {
        // Matches SUMOP4A (Quarter-tile Signed x Unsigned 8/16-bit to 32/64-bit, 4-way accumulating)
        // Fixed bits: 
        // [31:24]=0x80, [23]=0, [21]=1 (u1=1), [15:10]=000000, [5]=0, [4]=0 (S bit), [3:2]=00
        constexpr uint32_t operand_mask = 0xFFA0FC3Cu;
        constexpr uint32_t base_encoding = 0x80200000u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isSumop4s4way(uint32_t insn)
    {
        // Matches SUMOP4S (Quarter-tile Signed x Unsigned 8/16-bit to 32/64-bit, 4-way subtracting)
        // Bit 4 ('S' bit) is 1, adding 0x10 to the base
        constexpr uint32_t operand_mask = 0xFFA0FC3Cu;
        constexpr uint32_t base_encoding = 0x80200010u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUmop4a(uint32_t insn)
    {
        // Matches UMOP4A (Quarter-tile Unsigned 16-bit to 32-bit, accumulating)
        // Fixed bits: 
        // [31:24]=0x81 (u0=1), [23:21]=001 (u1=1), [15:10]=010000 (0x10), [5]=0, [4]=0 (S bit), [3:2]=10
        constexpr uint32_t operand_mask = 0xFFE0FC3Cu;
        constexpr uint32_t base_encoding = 0x81204008u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUmop4s(uint32_t insn)
    {
        // Matches UMOP4S (Quarter-tile Unsigned 16-bit to 32-bit, subtracting)
        // Bit 4 ('S' bit) is 1, adding 0x10 to the base
        constexpr uint32_t operand_mask = 0xFFE0FC3Cu;
        constexpr uint32_t base_encoding = 0x81204018u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUmop4a4way(uint32_t insn)
    {
        constexpr uint32_t operand_mask = 0xFFA0FC3Cu;
        constexpr uint32_t base_encoding = 0x81204000u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUmop4s4way(uint32_t insn)
    {
        constexpr uint32_t operand_mask = 0xFFA0FC3Cu;
        constexpr uint32_t base_encoding = 0x81204010u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUsmop4a(uint32_t insn)
    {
        // Matches USMOP4A (Quarter-tile Unsigned x Signed 8/16-bit to 32/64-bit, 4-way accumulating)
        // Fixed bits: 
        // [31:24]=0x81 (u0=1), [23]=0, [21]=0 (u1=0), [15:10]=000000, [5]=0, [4]=0 (S bit), [3:2]=00
        constexpr uint32_t operand_mask = 0xFFA0FC3Cu;
        constexpr uint32_t base_encoding = 0x81000000u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUsmop4s(uint32_t insn)
    {
        // Matches USMOP4S (Quarter-tile Unsigned x Signed 8/16-bit to 32/64-bit, 4-way subtracting)
        // Bit 4 ('S' bit) is 1, adding 0x10 to the base
        constexpr uint32_t operand_mask = 0xFFA0FC3Cu;
        constexpr uint32_t base_encoding = 0x81000010u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isStmopa2way(uint32_t insn)
    {
        // Matches STMOPA (2-way Signed 16-bit sparse to 32-bit, accumulating)
        // Fixed bits: 
        // [31:24]=0x80 (u0=0), [23:21]=010, [15:13]=100, [5]=0, [4]=0, [3:2]=10
        constexpr uint32_t operand_mask = 0xFFE0E03Cu;
        constexpr uint32_t base_encoding = 0x80408008u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isStmopa4way(uint32_t insn)
    {
        // Matches STMOPA (4-way Signed 8-bit sparse to 32-bit, accumulating)
        // Fixed bits: 
        // [31:24]=0x80 (u0=0), [23:21]=010 (u1=0), [15:13]=100, [3:2]=00
        constexpr uint32_t operand_mask = 0xFFE0E00Cu;
        constexpr uint32_t base_encoding = 0x80408000u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isSutmopa(uint32_t insn)
    {
        // Matches SUTMOPA (4-way Signed x Unsigned 8-bit sparse to 32-bit, accumulating)
        // Fixed bits: 
        // [31:25]=1000000, [24]=0 (u0=0), [23:22]=01, [21]=1 (u1=1), [15:13]=100, [3:2]=00
        // Notice we use 0x0C in the mask to safely ignore the i2 index at [5:4]!
        constexpr uint32_t operand_mask = 0xFFE0E00Cu;
        constexpr uint32_t base_encoding = 0x80608000u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isUstmopa(uint32_t insn)
    {
        // Matches USTMOPA (4-way Unsigned x Signed 8-bit sparse to 32-bit, accumulating)
        // Fixed bits: 
        // [31:25]=1000000, [24]=1 (u0=1), [23:22]=01, [21]=0 (u1=0), [15:13]=100, [3:2]=00
        // Mask uses 0x0C to correctly permit dynamic i2 index selection at bits [5:4]
        constexpr uint32_t operand_mask = 0xFFE0E00Cu;
        constexpr uint32_t base_encoding = 0x81408000u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isMovaTileToVec2reg(uint32_t insn)
    {
        // Matches MOVA (tile to vector, two registers)
        constexpr uint32_t operand_mask = 0xFF3F1C01u;
        constexpr uint32_t base_encoding = 0xC0060000u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isMovaTileToVec4reg(uint32_t insn)
    {
        // Matches MOVA (tile to vector, four registers)
        // Fixed bits: 
        // [31:24]=0xC0, [21:16]=0x06, [12:10]=001, [1:0]=00
        constexpr uint32_t operand_mask = 0xFF3F1C03u;
        constexpr uint32_t base_encoding = 0xC0060400u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool 
    isMovaArrayToVec4reg(uint32_t insn) {
        // Matches MOVA (array to vector, four registers)
        // Fixed bits: [31:24]=0xC0, [23:15]=0x00C, [12:8]=0x0C, [1:0]=00
        constexpr uint32_t operand_mask = 0xFFFF9F03u;
        constexpr uint32_t base_encoding = 0xC0060C00u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool 
    isMovaArrayToVec2reg(uint32_t insn) {
        // Matches MOVA (array to vector, two registers)
        // Fixed bits: [31:24]=0xC0, [23:15]=0x003, [12:8]=0x08, [0]=0
        constexpr uint32_t operand_mask = 0xFFFF9F01u;
        constexpr uint32_t base_encoding = 0xC0018800u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool 
    isMovaVecToArray4reg(uint32_t insn) {
        // Matches MOVA (vector to array, four registers)
        // Fixed bits: [31:24]=0xC0, [23:15]=0x000, [12:8]=0x0E, [4:3]=00
        constexpr uint32_t operand_mask = 0xFFFF9F18u;
        constexpr uint32_t base_encoding = 0xC0000E00u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool 
    isMovaVecToArray2reg(uint32_t insn) {
        // Matches MOVA (vector to array, two registers)
        // Fixed bits: [31:24]=0xC0, [23:15]=0x008 (bit 18 is 1), [12:8]=0x08, [3]=0
        constexpr uint32_t operand_mask = 0xFFFF9F08u;
        constexpr uint32_t base_encoding = 0xC0040800u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool 
    isMovaVecToTile4reg(uint32_t insn) {
        // Matches MOVA (vector to tile, four registers)
        // Fixed bits: [31:24]=0xC0, [21:17]=00001, [16]=0, [12:10]=001, [9:8]=00
        // Masking [4:3]=00 covers fixed 0s across all size variants safely.
        constexpr uint32_t operand_mask = 0xFF3F1F18u;
        constexpr uint32_t base_encoding = 0xC0020400u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool 
    isMovazArrayToVec4reg(uint32_t insn) {
        // Matches MOVAZ (array to vector, four registers)
        // Fixed bits: [31:24]=0xC0, [23:15]=0x00C, [12:8]=0x0E, [1:0]=00
        constexpr uint32_t operand_mask = 0xFFFF9F03u;
        constexpr uint32_t base_encoding = 0xC0060E00u;
        return (insn & operand_mask) == base_encoding;
    }

    static inline bool
    isMova2B(uint32_t insn)
    {
        // operands: V(15), Rs(14-13), Zn(9-6), off3(2-0)
        constexpr uint32_t operand_mask =
            (1u << 15) |
            (0x3u << 13) | (0xFu << 6) | (0x7u << 0);
        // From objdump: mov za0h.b[w12,0:1],{z0,z1} == 0xC0040000
        constexpr uint32_t base = 0xC0040000u;
        constexpr uint32_t key  = base & ~operand_mask;

        return (insn & ~operand_mask) == key;
    }

    static inline bool
    isMova2H(uint32_t insn)
    {
        // operands: V(15), Rs(14-13), Zn(9-6), ZAd(2), off2(1-0)
        constexpr uint32_t operand_mask =
            (1u << 15) |
            (0x3u << 13) | (0xFu << 6) | (1u << 2) | (0x3u << 0);
        // From objdump: mov za0h.h[w12,0:1],{z2,z3} == 0xC0440040
        constexpr uint32_t base = 0xC0440040u;
        constexpr uint32_t key  = base & ~operand_mask;

        return (insn & ~operand_mask) == key;
    }

    static inline bool
    isMova2S(uint32_t insn)
    {
        // operands: V(15), Rs(14-13), Zn(9-6), ZAd(2-1), o1(0)
        constexpr uint32_t operand_mask =
            (1u << 15) |
            (0x3u << 13) | (0xFu << 6) | (0x3u << 1) | (1u << 0);
        // From objdump: mov za0h.s[w12,0:1],{z4,z5} == 0xC0840080
        constexpr uint32_t base = 0xC0840080u;
        constexpr uint32_t key  = base & ~operand_mask;

        return (insn & ~operand_mask) == key;
    }

    static inline bool
    isMova2D(uint32_t insn)
    {
        // operands: V(15), Rs(14-13), Zn(9-6), ZAd(2-0) ; offset is implicit
        constexpr uint32_t operand_mask =
            (1u << 15) |
            (0x3u << 13) | (0xFu << 6) | (0x7u << 0);
        // From objdump: mov za0h.d[w12,0:1],{z6,z7} == 0xC0C400C0
        constexpr uint32_t base = 0xC0C400C0u;
        constexpr uint32_t key  = base & ~operand_mask;

        return (insn & ~operand_mask) == key;
    }

    static inline bool
    isSme2Scvtf2(uint32_t insn)
    {
        // Matches encodings like 0xC122E002 (2-reg form)
        // Only low 10 bits vary with register selection (Zd[4:0], Zn[9:5]).
        return (insn & 0xfffffc00u) == 0xC122E000u;
    }

    static inline bool
    isSme2Scvtf4(uint32_t insn)
    {
        // Matches encodings like 0xC132E088 (4-reg form)
        return (insn & 0xfffffc00u) == 0xC132E000u;
    }

    static inline bool
    isSme2Ucvtf2(uint32_t insn)
    {
        // Matches 2-reg UCVTF (Bit 10 set)
        return (insn & 0xfffffc00u) == 0xC122E400u;
    }

    static inline bool
    isSme2Ucvtf4(uint32_t insn)
    {
        // Matches 4-reg UCVTF (Bit 10 set)
        return (insn & 0xfffffc00u) == 0xC132E400u;
    }

    // FCVT (Narrowing FP16 -> FP8) matcher
    static inline bool
    isSme2FcvtFp16Fp8(uint32_t insn)
    {
        // Matches encoding 0xC120E000
        // Key bits: 
        //   [31:21] = 11000001001 (SME2 Cvt prefix)
        //   [20]    = 0 (Not 4-reg)
        //   [16]    = 0 (Not FCVTZ)
        //   [10]    = 0 (Size bit 0 -> FP16->FP8)
        return (insn & 0xfffffc00u) == 0xC120E000u;
    }

    // FCVT (Narrowing FP32 -> FP16) matcher
    static inline bool
    isSme2FcvtFp32Fp16(uint32_t insn)
    {
        // 0xC120E400: Same base as narrowing, but bit 10 is set (size bit)
        return (insn & 0xfffffc00u) == 0xC120E400u;
    }

    // FCVT (Narrowing FP32 -> FP8) matcher
    static inline bool
    isSme2FcvtFp32Fp8(uint32_t insn)
    {
        // Matches 0xC130E000
        // Key bits:
        //   [31:21] = 11000001001 (Prefix)
        //   [20]    = 1 (4-register variant)
        //   [17]    = 0 (FCVT)
        return (insn & 0xfffffc00u) == 0xC130E000u;
    }

    // FCVTN (Narrowing FP32 -> FP8) matcher
    static inline bool
    isSme2FcvtnFp32Fp8(uint32_t insn)
    {
        return (insn & 0xfffffc20u) == 0xC130E020u;
    }

    // FCVTN (Narrowing FP32 -> FP16) matcher
    static inline bool
    isSme2FcvtnFp32Fp16(uint32_t insn)
    {
        // 0xC120E420: Bits 31-10 match, Bit 5 is 1
        return (insn & 0xfffffc20u) == 0xC120E420u;
    }

    // BFCVT (BFloat16 -> FP8) matcher
    static inline bool
    isSme2Bfcvt(uint32_t insn)
    {
        // 0xC140E000: Bit 21 is 1
        return (insn & 0xffdffc00u) == 0xC140E000u;
    }

    // BFCVT (FP32 -> BFloat16) matcher
    static inline bool
    isSme2BfcvtFp32Bf16(uint32_t insn)
    {
        return (insn & 0xfffffc00u) == 0xC124E000u;
    }

    // BFCVTN
    static inline bool
    isSme2Bfcvtn(uint32_t insn)
    {
        return (insn & 0xfffffc20u) == 0xC160E020u;
    }

    // FCVTL (Widening, FP16 -> De-interleaved FP32)
    static inline bool
    isSme2Fcvtl(uint32_t insn)
    {
        // Base: 1100 0001 1000 0000 1110 00nn nnn0 dddd 1  (0xC180E001)
        // Mask: 1111 1111 1110 0000 1111 1100 0000 0001  (0xFFE0FC01)
        return (insn & 0xffe0fc01u) == 0xC180E001u;
    }

    // F1CVTL (FP8 -> FP16, Bottom)
    // Base: 0xC126E001
    // Mask: 0xFFFFFC01 (Checks all bits except 9:1)
    static inline bool
    isSme2F1cvtl(uint32_t insn)
    {
        return (insn & 0xfffffc01u) == 0xC126E001u;
    }

    // F2CVTL (FP8 -> FP16, Bottom)
    // Base: 0xC1A6E001
    // Mask: 0xFFFFFC01
    static inline bool
    isSme2F2cvtl(uint32_t insn)
    {
        return (insn & 0xfffffc01u) == 0xC1A6E001u;
    }

    // BF1CVTL (FP8 to BFloat16, Bottom, Format 1)
    static inline bool
    isSme2Bf1cvtl(uint32_t insn)
    {
        return (insn & 0xfffffc01u) == 0xC166E001u;
    }

    // BF2CVTL (FP8 to BFloat16, Bottom, Format 2)
    static inline bool
    isSme2Bf2cvtl(uint32_t insn)
    {
        return (insn & 0xfffffc01u) == 0xC1E6E001u;
    }

    // BF1CVT (FP8 to BFloat16, Format 1)
    // Base: 0xC166E000 (Bit 0 is 0)
    static inline bool
    isSme2Bf1cvt(uint32_t insn)
    {
        return (insn & 0xfffffc01u) == 0xC166E000u;
    }

    // BF2CVT (FP8 to BFloat16, Format 2)
    // Base: 0xC1E6E000 (Bit 0 is 0)
    static inline bool
    isSme2Bf2cvt(uint32_t insn)
    {
        return (insn & 0xfffffc01u) == 0xC1E6E000u;
    }

    // F1CVT (FP8 to FP16, Format 1)
    // Base: 0xC126E000
    static inline bool
    isSme2F1cvt(uint32_t insn)
    {
        return (insn & 0xfffffc01u) == 0xC126E000u;
    }

    // F2CVT (FP8 to FP16, Format 2)
    // Base: 0xC1A6E000
    static inline bool
    isSme2F2cvt(uint32_t insn)
    {
        return (insn & 0xfffffc01u) == 0xC1A6E000u;
    }

    // SQCVT (Four registers)
    static inline bool
    isSme2Sqcvt(uint32_t insn)
    {
        // Base: 1100 0001 x011 0011 1110 00nn n00d dddd
        // Hex Base (sz=0): 0xC133E000
        // Mask: 0xFF7FFC60 (Ignores sz, Zn, Zd)
        return (insn & 0xff7ffc60u) == 0xc133e000u;
    }

    // SQCVTU (Four registers, Unsigned Saturation)
    static inline bool
    isSme2Sqcvtu(uint32_t insn)
    {
        // Base: 1100 0001 x111 0011 ... -> 0xC173E000
        // Mask: 0xFF7FFC60
        return (insn & 0xff7ffc60u) == 0xc173e000u;
    }

    // UQCVT (Four registers, Unsigned Input -> Unsigned Output)
    // Base: 1100 0001 x011 0011 ... 0010 0000
    // Hex: 0xC133E020
    static inline bool
    isSme2Uqcvt(uint32_t insn)
    {
        return (insn & 0xff7ffc60u) == 0xc133e020u;
    }

    // SQCVT (Two registers, S -> H)
    static inline bool
    isSme2Sqcvt2(uint32_t insn)
    {
        return (insn & 0xfffffc20u) == 0xc123e000u;
    }

    // UQCVT (Two registers, U32 -> U16)
    // Base: 1100 0001 0010 0011 1110 00nn nn1d dddd
    // Hex: 0xC123E020
    // Mask: 0xFFFFFC20
    static inline bool
    isSme2Uqcvt2(uint32_t insn)
    {
        return (insn & 0xfffffc20u) == 0xc123e020u;
    }

    // SQCVTU (Two registers, S32 -> U16)
    // Base: 1100 0001 0110 0011 ... -> 0xC163E000
    // Mask: 0xFFFFFC20
    static inline bool
    isSme2Sqcvtu2(uint32_t insn)
    {
        return (insn & 0xfffffc20u) == 0xc163e000u;
    }

    // SQCVTN (Four registers, Interleaved)
    // Base: 1100 0001 x011 0011 ... 00nn n10d dddd
    // Hex: 0xC133E040
    // Mask: 0xFF7FFC60
    static inline bool
    isSme2Sqcvtn(uint32_t insn)
    {
        return (insn & 0xff7ffc60u) == 0xc133e040u;
    }

    // SQCVTUN (Four registers, Signed -> Unsigned Interleaved)
    // Base: 1100 0001 x111 0011 ... 00nn n10d dddd
    // Hex: 0xC173E040
    static inline bool
    isSme2Sqcvtun(uint32_t insn)
    {
        return (insn & 0xff7ffc60u) == 0xc173e040u;
    }

    // UQCVTN (Four registers, Unsigned -> Unsigned Interleaved)
    // Base: 1100 0001 x011 0011 ... 00nn n11d dddd
    // Hex: 0xC133E060
    static inline bool
    isSme2Uqcvtn(uint32_t insn)
    {
        return (insn & 0xff7ffc60u) == 0xc133e060u;
    }

    StaticInstPtr
    decodeSmeOp32(ExtMachInst machInst)
    {
        const uint8_t op0 = (uint8_t)bits(machInst, 29);
        const uint8_t op1 = (uint8_t)bits(machInst, 24);
        const uint8_t op2 = (uint8_t)bits(machInst, 21);
        const uint8_t op3 = (uint8_t)bits(machInst, 3);
        // ---- TEMP DEBUG fast-path: fmopa za0.h, p0/m, p1/m, z0.b, z1.b ----
        // encoding bytes: [0x08, 0x20, 0xA1, 0x80] => 0x80A12008
        const uint32_t insn = (uint32_t)machInst;
        if (Aarch64::isSme2Scvtf2(insn) || Aarch64::isSme2Scvtf4(insn) ||
            Aarch64::isSme2Ucvtf2(insn) || Aarch64::isSme2Ucvtf4(insn)) {
            return Aarch64::decodeSmeCvt(machInst);
        }

        if (insn == 0x80A12008) {
            DPRINTF(Decode, "SME.F8 fastpath hit: insn=%#010x\n", insn);
            return Aarch64::decodeSmeOpF8(machInst);
        }
        
        if (Aarch64::isFtmopaNonWideningF16(insn) || Aarch64::isFtmopaNonWideningF32(insn)) {
            return Aarch64::decodeSmeTmop(machInst);
        }   

        if (op0 == 0) {
            if (op1 == 0) {
                if (op2 == 0) {
                    if (op3 == 0) {
                        return Aarch64::decodeSmeOpFp32(machInst);
                    }
                }

                // FP8 family (both 2-way (op3==1) and 4-way (op3==0) variants)
                if (op2 == 1) {
                    if (op3 == 1 || op3 == 0) {
                        return Aarch64::decodeSmeOpF8(machInst);
                    }
                }
            }

            if (op1 == 1) {
                if (op2 == 0) {
                    if (op3 == 0) {
                        return Aarch64::decodeSmeOpBf16(machInst);
                    }
                }

                if (op2 == 1) {
                    if (op3 == 0) {
                        return Aarch64::decodeSmeOpFp16(machInst);
                    }
                }
            }
        }

        if (op0 == 1) {
            if (op3 == 0) {
                return Aarch64::decodeSmeOpInt8(machInst);
            }
        }

        return new Unknown64(machInst);
    }



    StaticInstPtr
    decodeSmeOpFp32(ExtMachInst machInst)
    {
        const uint32_t S = (uint32_t)bits(machInst, 4, 4);
        const RegIndex Zm = (RegIndex)(uint32_t)(bits(machInst, 20, 16));
        const RegIndex Zn = (RegIndex)(uint32_t)(bits(machInst, 9, 5));
        const RegIndex Pn = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        const RegIndex Pm = (RegIndex)(uint32_t)(bits(machInst, 15, 13));
        const RegIndex ZAda = (RegIndex)(uint32_t)(bits(machInst, 1, 0));

        if (S == 0) {
            return new SmeFmopa<uint32_t, uint32_t>(machInst, ZAda, Zn,
                                                    Pn, Pm, Zm);
        } else {
            return new SmeFmops<uint32_t, uint32_t>(machInst, ZAda, Zn,
                                                    Pn, Pm, Zm);
        }
        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeOpBf16(ExtMachInst machInst)
    {
        // The following code is functionally correct for decode, but
        // remains commented out as the current gem5 fplib implementation
        // doesn't support BF16, and hence the instructions themselves
        // remain unimplemented.
        // Once these have been implemented, this code
        // can be safely uncommented to enable decode for the two BF16 Outer
        // Product instructions added by FEAT_SME.
        // const uint32_t S = (uint32_t)bits(machInst, 4, 4);

        // const RegIndex Zm = (RegIndex)(uint32_t)(
        //     bits(machInst, 20, 16));
        // const RegIndex Zn = (RegIndex)(uint32_t)(
        //     bits(machInst, 9, 5));
        // const RegIndex Pn = (RegIndex)(uint32_t)(
        //     bits(machInst, 12, 10));
        // const RegIndex Pm = (RegIndex)(uint32_t)(
        //     bits(machInst, 15, 13));
        // const RegIndex ZAda = (RegIndex)(uint32_t)(
        //     bits(machInst, 1, 0));
        // if (S == 0) {
        //     return new SmeBmopa(machInst);
        // } else {
        //     return new SmeBmops(machInst);
        // }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeOpF8(ExtMachInst machInst)
    {
        const uint32_t S    = (uint32_t)bits(machInst, 4, 4);
        const RegIndex Zm   = (RegIndex)(uint32_t)bits(machInst, 20, 16);
        const RegIndex Zn   = (RegIndex)(uint32_t)bits(machInst,  9,  5);
        const RegIndex Pn   = (RegIndex)(uint32_t)bits(machInst, 12, 10);
        const RegIndex Pm   = (RegIndex)(uint32_t)bits(machInst, 15, 13);
        const RegIndex ZAda = (RegIndex)(uint32_t)bits(machInst,  1,  0);

        if (S == 0) {
            // FMOPA (widening, 2-way, FP8 -> FP16)
            return new SmeFmopaWideningF8<std::uint8_t, std::uint16_t>(
                machInst, ZAda, Zn, Pn, Pm, Zm);
        } else {
            // FMOPA (widening, 4-way, FP8 -> FP32)
            return new SmeFmopaWidening4WayF8F32<std::uint8_t, std::uint32_t>(
                machInst, ZAda, Zn, Pn, Pm, Zm);
        }
    }



    StaticInstPtr
    decodeSmeOpFp16(ExtMachInst machInst)
    {
        const uint32_t S = (uint32_t)bits(machInst, 4, 4);
        const RegIndex Zm = (RegIndex)(uint32_t)(bits(machInst, 20, 16));
        const RegIndex Zn = (RegIndex)(uint32_t)(bits(machInst, 9, 5));
        const RegIndex Pn = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        const RegIndex Pm = (RegIndex)(uint32_t)(bits(machInst, 15, 13));
        const RegIndex ZAda = (RegIndex)(uint32_t)(bits(machInst, 1, 0));

        if (S == 0) {
            return new SmeFmopaWidening<uint16_t, uint32_t>(machInst, ZAda, Zn,
                                                            Pn, Pm, Zm);
        } else {
            return new SmeFmopsWidening<uint16_t, uint32_t>(machInst, ZAda, Zn,
                                                            Pn, Pm, Zm);
        }
        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeTmop(ExtMachInst machInst)
    {
        const uint32_t insn = (uint32_t)machInst;
        DPRINTF(Decode, "decodeSmeTmop: insn=%#010x\n", insn);

        if (Aarch64::isFtmopaWideningF16ToF32(insn)) {
            // Zm: bits 20-16
            const RegIndex Zm = (RegIndex)(uint32_t)bits(machInst, 20, 16);
            // Zn group: Inst{9-6} -> pair {Zn1, Zn1+1}
            const uint32_t zn_group = (uint32_t)bits(machInst, 9, 6);
            const RegIndex Zn1 = (RegIndex)(zn_group << 1);

            // Zk control reg: field {12-10} maps to Z20-Z23 or Z28-Z31
            const uint32_t zk_field = (uint32_t)bits(machInst, 12, 10);
            RegIndex Zk;
            if (zk_field < 4) {
                Zk = (RegIndex)(20 + zk_field);
            } else {
                Zk = (RegIndex)(24 + zk_field);
                // 4..7 -> 28..31
            }

            // Control segment index from Inst{5-4}
            const uint32_t index = (uint32_t)bits(machInst, 5, 4);
            // Widening FTMOPA writes ZA.s (FP32), so we use bits [1:0] for ZAda.
            const RegIndex ZAda = (RegIndex)(uint32_t)bits(machInst, 1, 0);
            // Build imm exactly like non-widening FTMOPA
            //
            // imm layout:
            //   [ 2:0]  ZAda
            //   [ 4:3]  index
            //   [ 9:5]  Zn group (base)
            //   [14:10] Zm
            //   [19:15] Zk
            //
            uint64_t imm = 0;
            imm |= (uint64_t)(ZAda & 0x7);                 // 2:0
            imm |= (uint64_t)((index    & 0x3)  << 3);     // 4:3
            imm |= (uint64_t)((zn_group & 0x1F) << 5);     // 9:5
            imm |= (uint64_t)((Zm       & 0x1F) << 10);    // 14:10
            imm |= (uint64_t)((Zk       & 0x1F) << 15);    // 19:15

            // FTMOPA widening: TPSElem = uint16_t (FP16), TPDElem = uint32_t (FP32)
            return new SmeFtmopaWidening<uint16_t, uint32_t>(
                machInst, imm, Zn1, Zk, Zm, index);
        } else if (Aarch64::isFtmopaWidening4WayF8ToF32(insn)) {
            // --- FTMOPA widening FP8->FP32 (4-way) decode ---

            // Zm: bits 20-16
            const RegIndex Zm = (RegIndex)(uint32_t)bits(machInst, 20, 16);
            // Zn group: Inst{9-6} -> pair {Zn1, Zn1+1}
            const uint32_t zn_group = (uint32_t)bits(machInst, 9, 6);
            const RegIndex Zn1 = (RegIndex)(zn_group << 1);

            // Zk control reg: field {12-10} maps to Z20-Z23 or Z28-Z31
            const uint32_t zk_field = (uint32_t)bits(machInst, 12, 10);
            RegIndex Zk;
            if (zk_field < 4) {
                Zk = (RegIndex)(20 + zk_field);
            } else {
                Zk = (RegIndex)(24 + zk_field);
                // 4..7 -> 28..31
            }

            // Control segment index from Inst{5-4}
            const uint32_t index = (uint32_t)bits(machInst, 5, 4);
            // ZA.s destination tile, bits [1:0]
            const RegIndex ZAda = (RegIndex)(uint32_t)bits(machInst, 1, 0);
            // imm layout shared with other FTMOPA forms:
            //   [ 2:0]  ZAda
            //   [ 4:3]  index
            //   [ 9:5]  Zn group (base)
            //   [14:10] Zm
            //   [19:15] Zk
            
            uint64_t imm = 0;
            imm |= (uint64_t)(ZAda & 0x7);                 // 2:0
            imm |= (uint64_t)((index    & 0x3)  << 3);     // 4:3
            imm |= (uint64_t)((zn_group & 0x1F) << 5);     // 9:5
            imm |= (uint64_t)((Zm       & 0x1F) << 10);    // 14:10
            imm |= (uint64_t)((Zk       & 0x1F) << 15);    // 19:15

            // FTMOPA widening FP8->FP32 (4-way):
            //   TPSElem = uint8_t (FP8), TPDElem = uint32_t (FP32)
            return new SmeFtmopaWidening4WayF8F32<uint8_t, uint32_t>(
                machInst, imm, Zn1, Zk, Zm, index);
        } else if (Aarch64::isFtmopaWideningF8ToF16(insn)) {
            // --- FTMOPA widening FP8->FP16 decodes ---

            // Zm: bits 20-16
            const RegIndex Zm = (RegIndex)(uint32_t)bits(machInst, 20, 16);
            // Zn group: Inst{9-6} -> pair {Zn1, Zn1+1}
            const uint32_t zn_group = (uint32_t)bits(machInst, 9, 6);
            const RegIndex Zn1 = (RegIndex)(zn_group << 1);

            // Zk control reg: field {12-10} maps to Z20-Z23 or Z28-Z31
            const uint32_t zk_field = (uint32_t)bits(machInst, 12, 10);
            RegIndex Zk;
            if (zk_field < 4) {
                Zk = (RegIndex)(20 + zk_field);
            } else {
                Zk = (RegIndex)(24 + zk_field);
                // 4..7 -> 28..31
            }

            // Control segment index from Inst{5-4}
            const uint32_t index = (uint32_t)bits(machInst, 5, 4);
            // FTMOPA FP8->FP16 writes ZA.h, so ZAda uses bit 0 (ZA0..ZA1)
            const RegIndex ZAda = (RegIndex)(uint32_t)bits(machInst, 0, 0);
            // imm layout:
            //   [ 2:0]  ZAda
            //   [ 4:3]  index
            //   [ 9:5]  Zn group (base)
            //   [14:10] Zm
            //   [19:15] Zk
            
            uint64_t imm = 0;
            imm |= (uint64_t)(ZAda & 0x7);                 // 2:0
            imm |= (uint64_t)((index    & 0x3)  << 3);     // 4:3
            imm |= (uint64_t)((zn_group & 0x1F) << 5);     // 9:5
            imm |= (uint64_t)((Zm       & 0x1F) << 10);    // 14:10
            imm |= (uint64_t)((Zk       & 0x1F) << 15);    // 19:15

            // FTMOPA widening FP8->FP16:
            //   TPSElem = uint8_t (FP8), TPDElem = uint16_t (FP16)
            return new SmeFtmopaWideningF8<uint8_t, uint16_t>(
                machInst, imm, Zn1, Zk, Zm, index);
        }


        // Decide element size from encoding
        const bool isF16 = Aarch64::isFtmopaNonWideningF16(insn);
        const bool isF32 = Aarch64::isFtmopaNonWideningF32(insn);

        if (!isF16 && !isF32) {
            DPRINTF(Decode, "decodeSmeTmop: predicate miss (insn=%#010x)\n", insn);
            return new Unknown64(machInst);
        }

        // Zm: bits 20-16
        const RegIndex Zm = (RegIndex)(uint32_t)bits(machInst, 20, 16);
        // Zn group: Inst{9-6} -> pair {Zn1, Zn1+1}
        const uint32_t zn_group = (uint32_t)bits(machInst, 9, 6);
        const RegIndex Zn1 = (RegIndex)(zn_group << 1);

        // Zk control reg: field {12-10} maps to Z20-Z23 or Z28-Z31
        const uint32_t zk_field = (uint32_t)bits(machInst, 12, 10);
        RegIndex Zk;
        if (zk_field < 4) {
            Zk = (RegIndex)(20 + zk_field);
        } else {
            Zk = (RegIndex)(24 + zk_field);
            // 4..7 -> 28..31
        }

        // Control segment index from Inst{5-4}
        const uint32_t index = (uint32_t)bits(machInst, 5, 4);
        // ZA tile index:
        //   - half-precision:  bit 0 (ZA0–ZA1)
        //   - single-precision: bits 1–0 (ZA0–ZA3)
        RegIndex ZAda;
        if (isF16) {
            ZAda = (RegIndex)(uint32_t)bits(machInst, 0, 0);
        } else {
            ZAda = (RegIndex)(uint32_t)bits(machInst, 1, 0);
        }

        // ----- Build the IMM field ftmopaCode expects -----
        //
        // imm layout used in execute code:
        //
        //   [ 2:0]  ZAda
        //   [ 4:3]  index
        //   [ 9:5]  Zn group (base)
        //   [14:10] Zm
        //   [19:15] Zk
        //
        uint64_t imm = 0;
        imm |= (uint64_t)(ZAda & 0x7);                // 2:0
        imm |= (uint64_t)((index & 0x3)   << 3);      // 4:3
        imm |= (uint64_t)((zn_group & 0x1F) << 5);    // 9:5
        imm |= (uint64_t)((Zm       & 0x1F) << 10);   // 14:10
        imm |= (uint64_t)((Zk       & 0x1F) << 15);   // 19:15

        // ----- Instantiate the correct template form -----
        if (isF16) {
            // FTMOPA .H: TPSElem = uint16_t, TPDElem = uint16_t
            return new SmeFtmopa<uint16_t, uint16_t>(
                machInst, imm, Zn1, Zk, Zm, index);
        } else {
            // FTMOPA .S: TPSElem = uint32_t, TPDElem = uint32_t
            return new SmeFtmopa<uint32_t, uint32_t>(
                machInst, imm, Zn1, Zk, Zm, index);
        }
    }



    StaticInstPtr
    decodeSmeOpInt8(ExtMachInst machInst)
    {
        const uint32_t u0 = (uint32_t)bits(machInst, 24);
        const uint32_t u1 = (uint32_t)bits(machInst, 21);
        const uint32_t S = (uint32_t)bits(machInst, 4);

        const RegIndex Zm = (RegIndex)(uint32_t)(bits(machInst, 20, 16));
        const RegIndex Zn = (RegIndex)(uint32_t)(bits(machInst, 9, 5));
        const RegIndex Pn = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        const RegIndex Pm = (RegIndex)(uint32_t)(bits(machInst, 15, 13));
        const RegIndex ZAda = (RegIndex)(uint32_t)(bits(machInst, 1, 0));
        if (u0 == 0) {
            if (u1 == 0) {
                if (S == 0) {
                    return new SmeSmopa<int8_t, int8_t, int32_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                } else {
                    return new SmeSmops<int8_t, int8_t, int32_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                }
            } else {
                if (S == 0) {
                    return new SmeSumopa<int8_t, uint8_t, int32_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                } else {
                    return new SmeSumops<int8_t, uint8_t, int32_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                }
            }
        } else {
            if (u1 == 0) {
                if (S == 0) {
                    return new SmeUsmopa<uint8_t, int8_t, int32_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                } else {
                    return new SmeUsmops<uint8_t, int8_t, int32_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                }
            } else {
                if (S == 0) {
                    return new SmeUmopa<uint8_t, uint8_t, int32_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                } else {
                    return new SmeUmops<uint8_t, uint8_t, int32_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                }
            }
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeOp64(ExtMachInst machInst)
    {
        const uint8_t op0 = (uint8_t)bits(machInst, 29);
        const uint8_t op1 = (uint8_t)bits(machInst, 24);
        const uint8_t op2 = (uint8_t)bits(machInst, 21);
        if (op0 == 0) {
            if (op1 == 0) {
                if (op2 == 0) {
                    return Aarch64::decodeSmeOpFp64(machInst);
                }
            }
        }

        if (op0 == 1) {
            return Aarch64::decodeSmeOpInt16(machInst);
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeOpFp64(ExtMachInst machInst)
    {
        const uint32_t S = (uint32_t)bits(machInst, 4, 4);
        const RegIndex Zm = (RegIndex)(uint32_t)(bits(machInst, 20, 16));
        const RegIndex Zn = (RegIndex)(uint32_t)(bits(machInst, 9, 5));
        const RegIndex Pn = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        const RegIndex Pm = (RegIndex)(uint32_t)(bits(machInst, 15, 13));
        const RegIndex ZAda = (RegIndex)(uint32_t)(bits(machInst, 2, 0));

        if (S == 0) {
            return new SmeFmopa<uint64_t, uint64_t>(machInst, ZAda, Zn,
                                                    Pn, Pm, Zm);
        } else {
            return new SmeFmops<uint64_t, uint64_t>(machInst, ZAda, Zn,
                                                    Pn, Pm, Zm);
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeOpInt16(ExtMachInst machInst)
    {
        const uint32_t u0 = (uint32_t)bits(machInst, 24);
        const uint32_t u1 = (uint32_t)bits(machInst, 21);
        const uint32_t S = (uint32_t)bits(machInst, 4);

        const RegIndex Zm = (RegIndex)(uint32_t)(bits(machInst, 20, 16));
        const RegIndex Zn = (RegIndex)(uint32_t)(bits(machInst, 9, 5));
        const RegIndex Pn = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        const RegIndex Pm = (RegIndex)(uint32_t)(bits(machInst, 15, 13));
        const RegIndex ZAda = (RegIndex)(uint32_t)(bits(machInst, 2, 0));
        if (u0 == 0) {
            if (u1 == 0) {
                if (S == 0) {
                    return new SmeSmopa<int16_t, int16_t, int64_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                } else {
                    return new SmeSmops<int16_t, int16_t, int64_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                }
            } else {
                if (S == 0) {
                    return new SmeSumopa<int16_t, uint16_t, int64_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                } else {
                    return new SmeSumops<int16_t, uint16_t, int64_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                }
            }
        } else {
            if (u1 == 0) {
                if (S == 0) {
                    return new SmeUsmopa<uint16_t, int16_t, int64_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                } else {
                    return new SmeUsmops<uint16_t, int16_t, int64_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                }
            } else {
                if (S == 0) {
                    return new SmeUmopa<uint16_t, uint16_t, int64_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                } else {
                    return new SmeUmops<uint16_t, uint16_t, int64_t>(
                        machInst, ZAda, Zn, Pn, Pm, Zm);
                }
            }
        }
        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeMovaInsert(ExtMachInst machInst)
    {
        const uint8_t op0 = (uint8_t)bits(machInst, 18);
        if (op0 == 1) {
            return new Unknown64(machInst);
        }

        const uint32_t size = (uint32_t)bits(machInst, 23, 22);
        const uint32_t Q = (uint32_t)bits(machInst, 16, 16);

        const RegIndex Zn = (RegIndex)(uint32_t)(bits(machInst, 9, 5));
        const RegIndex Ws = (RegIndex)(uint32_t)(
            bits(machInst, 14, 13) + 12);
        const RegIndex Pg = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        const RegIndex ZAd_imm = (RegIndex)(uint32_t)(
            bits(machInst, 3, 0));
        const bool V = (bool)bits(machInst, 15);

        if (Q == 0) {
            switch (size) {
              case 0b00:
                return new SmeMovaInsert<uint8_t>(machInst, ZAd_imm,
                                                  Zn, Pg, Ws, V);
              case 0b01:
                return new SmeMovaInsert<uint16_t>(machInst, ZAd_imm,
                                                   Zn, Pg, Ws, V);
              case 0b10:
                return new SmeMovaInsert<uint32_t>(machInst, ZAd_imm,
                                                   Zn, Pg, Ws, V);
              case 0b11:
                return new SmeMovaInsert<uint64_t>(machInst, ZAd_imm,
                                                   Zn, Pg, Ws, V);
              default:
                break;
            }
        }

        if ((Q == 1) && (size == 0b11)) {
            return new SmeMovaInsert<__uint128_t>(machInst, ZAd_imm,
                                                  Zn, Pg, Ws, V);
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeMovaExtract(ExtMachInst machInst)
    {
        const uint8_t op0 = (uint8_t)bits(machInst, 18);
        const uint8_t op1 = (uint8_t)bits(machInst, 9);

        if ((op0 == 1) || (op1 == 1)) {
            return new Unknown64(machInst);
        }

        const uint32_t size = (uint32_t)bits(machInst, 23, 22);
        const uint32_t Q = (uint32_t)bits(machInst, 16, 16);

        const RegIndex Zd = (RegIndex)(uint32_t)(bits(machInst, 4, 0));
        const RegIndex Ws = (RegIndex)(uint32_t)(
            bits(machInst, 14, 13) + 12);
        const RegIndex Pg = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        const RegIndex ZAn_imm = (RegIndex)(uint32_t)(
            bits(machInst, 8, 5));
        const bool V = (bool)bits(machInst, 15);

        if (Q == 0) {
            switch (size) {
              case 0b00:
                return new SmeMovaExtract<uint8_t>(machInst, Zd,
                                                   ZAn_imm, Pg, Ws, V);
              case 0b01:
                return new SmeMovaExtract<uint16_t>(machInst, Zd,
                                                    ZAn_imm, Pg, Ws, V);
              case 0b10:
                return new SmeMovaExtract<uint32_t>(machInst, Zd,
                                                    ZAn_imm, Pg, Ws, V);
              case 0b11:
                return new SmeMovaExtract<uint64_t>(machInst, Zd,
                                                    ZAn_imm, Pg, Ws, V);
              default:
                break;
            }
        }

        if ((Q == 1) && (size == 0b11)) {
           return new SmeMovaExtract<__uint128_t>(machInst, Zd,
                                                  ZAn_imm, Pg, Ws, V);
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeMovaVecToTile2Regs(ExtMachInst machInst)
    {
        const uint32_t insn = (uint32_t)machInst;
        const bool V = (bool)bits(machInst, 15);
        const RegIndex Ws = (RegIndex)(uint32_t)(bits(machInst, 14, 13) + 12);
        // Zn group in encoding is bits[9:6]
        const uint32_t zn_group = (uint32_t)bits(machInst, 9, 6);
        // Pack imm for execute side (as your smeMovaVecToTile2RegsInst expects):
        //   [ 2:0]  ZAd_raw
        //   [ 7:3]  zn_group
        //   [10:8]  off_field  (raw; execute expands to even by <<1)
        //   [12:11] esize_code (0=B,1=H,2=S,3=D)
        uint32_t ZAd_raw  = 0;
        uint32_t off_raw  = 0;
        uint32_t esz_code = 0;

        if (Aarch64::isMova2B(insn)) {
            // B: ZAd is implicitly 0, off3 is bits[2:0]
            ZAd_raw  = 0;
            off_raw  = (uint32_t)bits(machInst, 2, 0); // raw off_field
            esz_code = 0; // B
        } else if (Aarch64::isMova2H(insn)) {
            // H: ZAd is bit[2], off2 is bits[1:0]
            ZAd_raw  = (uint32_t)bits(machInst, 2, 2);
            off_raw  = (uint32_t)bits(machInst, 1, 0);
            esz_code = 1; // H
        } else if (Aarch64::isMova2S(insn)) {
            // S: ZAd is bits[2:1], off1 is bit[0]
            ZAd_raw  = (uint32_t)bits(machInst, 2, 1);
            off_raw  = (uint32_t)bits(machInst, 0, 0);
            esz_code = 2; // S
        } else if (Aarch64::isMova2D(insn)) {
            // D: ZAd is bits[2:0], no offset field in encoding
            ZAd_raw  = (uint32_t)bits(machInst, 2, 0);
            off_raw  = 0;
            esz_code = 3; // D
        } else {
            return new Unknown64(machInst);
        }

        const uint64_t immPacked =
            ((uint64_t)(ZAd_raw  & 0x7)  << 0)  |
            ((uint64_t)(zn_group & 0x1F) << 3)  |
            ((uint64_t)(off_raw  & 0x7)  << 8)  |
            ((uint64_t)(esz_code & 0x3)  << 11);

        // Option B: ISA-parser generated instruction; constructor is (machInst, imm, op2, v)
        return new SmeMovaVecToTile2Regs(machInst, immPacked, Ws, V);
    }

    StaticInstPtr
    decodeSmeCvt(ExtMachInst machInst)
    {
        
        // Check for FCVT (Narrowing FP16 -> FP8)
        if (Aarch64::isSme2FcvtFp16Fp8(machInst)) {
             const uint32_t n_base = (uint32_t)bits(machInst, 9, 6);
             const uint32_t d_base = (uint32_t)bits(machInst, 4, 0);

             // Pack immediate: [4:0]=Zd, [9:5]=Zn
             uint64_t imm = 0;
             imm |= (uint64_t)(d_base & 0x1F);       
             imm |= (uint64_t)((n_base & 0xF) << 5); 
            
             return new SmeFcvtFp16Fp8(machInst, imm);
        }

        // Check for FCVT (Narrowing FP32 -> FP16)
        if (Aarch64::isSme2FcvtFp32Fp16(machInst)) {
             const uint32_t n_base = (uint32_t)bits(machInst, 9, 6);
             const uint32_t d_base = (uint32_t)bits(machInst, 4, 0);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_base & 0x1F);       // 4:0
             imm |= (uint64_t)((n_base & 0xF) << 5); // 9:5
            
             return new SmeFcvtFp32Fp16(machInst, imm);
        }

        // Check for FCVTN (Narrowing FP32 -> FP8, 4-reg)
        if (Aarch64::isSme2FcvtnFp32Fp8(machInst)) {
             const uint32_t n_base = (uint32_t)bits(machInst, 9, 6);
             const uint32_t d_base = (uint32_t)bits(machInst, 4, 0);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_base & 0x1F);        
             imm |= (uint64_t)((n_base & 0xF) << 5); 
            
             // Create the new instruction class (registered in inst/sme.isa)
             return new SmeFcvtnFp32Fp8(machInst, imm);
        }

        // Check for FCVT (Narrowing FP32 -> FP8, 4-reg)
        if (Aarch64::isSme2FcvtFp32Fp8(machInst)) {
             const uint32_t n_base = (uint32_t)bits(machInst, 9, 6);
             const uint32_t d_base = (uint32_t)bits(machInst, 4, 0);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_base & 0x1F);       
             imm |= (uint64_t)((n_base & 0xF) << 5); 
            
             return new SmeFcvtFp32Fp8(machInst, imm);
        }

        // Check for FCVTN (Narrowing FP32 -> FP16)
        if (Aarch64::isSme2FcvtnFp32Fp16(machInst)) {
             const uint32_t n_base = (uint32_t)bits(machInst, 9, 6);
             const uint32_t d_base = (uint32_t)bits(machInst, 4, 0);

             // Reuse same immediate packing as FCVT
             uint64_t imm = 0;
             imm |= (uint64_t)(d_base & 0x1F);       
             imm |= (uint64_t)((n_base & 0xF) << 5); 
            
             return new SmeFcvtnFp32Fp16(machInst, imm);
        }

        // Check for BFCVTN (Narrowing FP32 -> BFloat16)
        if (Aarch64::isSme2Bfcvtn(machInst)) {
             const uint32_t n_base = (uint32_t)bits(machInst, 9, 6);
             const uint32_t d_base = (uint32_t)bits(machInst, 4, 0);

             // Reuse same immediate packing as FCVTN
             uint64_t imm = 0;
             imm |= (uint64_t)(d_base & 0x1F);
             imm |= (uint64_t)((n_base & 0xF) << 5);

             return new SmeBfcvtn(machInst, imm);
        }

        // Check for BFCVT (BFloat16 -> FP8)
        if (Aarch64::isSme2Bfcvt(machInst)) {
             const uint32_t n_base = (uint32_t)bits(machInst, 9, 6);
             const uint32_t d_base = (uint32_t)bits(machInst, 4, 0);

             // Pack immediate exactly like FCVT
             uint64_t imm = 0;
             imm |= (uint64_t)(d_base & 0x1F);       
             imm |= (uint64_t)((n_base & 0xF) << 5); 
            
             return new SmeBfcvt(machInst, imm);
        }

        // Check for BFCVT (FP32 -> BFloat16)
        if (Aarch64::isSme2BfcvtFp32Bf16(machInst)) {
             const uint32_t n_base = (uint32_t)bits(machInst, 9, 6);
             const uint32_t d_base = (uint32_t)bits(machInst, 4, 0);

             // Standard 2-reg narrowing packing
             uint64_t imm = 0;
             imm |= (uint64_t)(d_base & 0x1F);       
             imm |= (uint64_t)((n_base & 0xF) << 5); 
            
             return new SmeBfcvtFp32Bf16(machInst, imm);
        }

        // Check for FCVTL (Widening FP16 -> FP32)
        if (Aarch64::isSme2Fcvtl((uint32_t)machInst)) {
             const uint32_t n_group = (uint32_t)bits(machInst, 9, 6);
             const uint32_t d_group = (uint32_t)bits(machInst, 4, 1);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_group & 0xF);       
             imm |= (uint64_t)((n_group & 0x1F) << 4);

             return new SmeFcvtl(machInst, imm);
        }

        // F1CVTL (FP8 -> FP16 Bottom)
        if (Aarch64::isSme2F1cvtl((uint32_t)machInst)) {
             const uint32_t d_pair = (uint32_t)bits(machInst, 4, 1);
             const uint32_t n_reg  = (uint32_t)bits(machInst, 9, 5);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_pair & 0xF);       
             imm |= (uint64_t)((n_reg & 0x1F) << 4); 

             return new SmeF1cvtl(machInst, imm);
        }

        // F2CVTL (FP8 -> FP16 Bottom)
        if (Aarch64::isSme2F2cvtl((uint32_t)machInst)) {
             const uint32_t d_pair = (uint32_t)bits(machInst, 4, 1);
             const uint32_t n_reg  = (uint32_t)bits(machInst, 9, 5);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_pair & 0xF);       
             imm |= (uint64_t)((n_reg & 0x1F) << 4); 

             return new SmeF2cvtl(machInst, imm);
        }

        // BF1CVTL (FP8 -> BF16 Bottom)
        if (Aarch64::isSme2Bf1cvtl((uint32_t)machInst)) {
             const uint32_t d_pair = (uint32_t)bits(machInst, 4, 1);
             const uint32_t n_reg  = (uint32_t)bits(machInst, 9, 5);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_pair & 0xF);       
             imm |= (uint64_t)((n_reg & 0x1F) << 4); 

             return new SmeBf1cvtl(machInst, imm);
        }

        // BF2CVTL (FP8 -> BF16 Bottom)
        if (Aarch64::isSme2Bf2cvtl((uint32_t)machInst)) {
             const uint32_t d_pair = (uint32_t)bits(machInst, 4, 1);
             const uint32_t n_reg  = (uint32_t)bits(machInst, 9, 5);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_pair & 0xF);       
             imm |= (uint64_t)((n_reg & 0x1F) << 4); 

             return new SmeBf2cvtl(machInst, imm);
        }

        if (Aarch64::isSme2Bf1cvt((uint32_t)machInst)) {
             const uint32_t d_pair = (uint32_t)bits(machInst, 4, 1);
             const uint32_t n_reg  = (uint32_t)bits(machInst, 9, 5);
             
             uint64_t imm = 0;
             imm |= (uint64_t)(d_pair & 0xF);       
             imm |= (uint64_t)((n_reg & 0x1F) << 4); 

             return new SmeBf1cvt(machInst, imm);
        }

        if (Aarch64::isSme2Bf2cvt((uint32_t)machInst)) {
             const uint32_t d_pair = (uint32_t)bits(machInst, 4, 1);
             const uint32_t n_reg  = (uint32_t)bits(machInst, 9, 5);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_pair & 0xF);       
             imm |= (uint64_t)((n_reg & 0x1F) << 4); 

             return new SmeBf2cvt(machInst, imm);
        }

        if (Aarch64::isSme2F1cvt((uint32_t)machInst)) {
             const uint32_t d_pair = (uint32_t)bits(machInst, 4, 1);
             const uint32_t n_reg  = (uint32_t)bits(machInst, 9, 5);
             
             uint64_t imm = 0;
             imm |= (uint64_t)(d_pair & 0xF);       
             imm |= (uint64_t)((n_reg & 0x1F) << 4); 

             return new SmeF1cvt(machInst, imm);
        }

        if (Aarch64::isSme2F2cvt((uint32_t)machInst)) {
             const uint32_t d_pair = (uint32_t)bits(machInst, 4, 1);
             const uint32_t n_reg  = (uint32_t)bits(machInst, 9, 5);

             uint64_t imm = 0;
             imm |= (uint64_t)(d_pair & 0xF);       
             imm |= (uint64_t)((n_reg & 0x1F) << 4); 

             return new SmeF2cvt(machInst, imm);
        }

        // SQCVT (Four registers)
        if (Aarch64::isSme2Sqcvt((uint32_t)machInst)) {
             const uint32_t sz = (uint32_t)bits(machInst, 23);
             const uint32_t zn_field = (uint32_t)bits(machInst, 9, 7);
             const uint32_t zd = (uint32_t)bits(machInst, 4, 0);

             // Zn denotes a group of 4 registers (Zn*4)
             const uint32_t n_start = zn_field * 4;

             uint64_t imm = 0;
             // Pack args: [4:0]=Zd, [9:5]=Zn_start, [10]=sz
             imm |= (uint64_t)(zd & 0x1F);
             imm |= (uint64_t)((n_start & 0x1F) << 5); 
             imm |= (uint64_t)((sz & 0x1) << 10);

             return new SmeSqcvt(machInst, imm);
        }

        // SQCVTU (Four registers)
        if (Aarch64::isSme2Sqcvtu((uint32_t)machInst)) {
             const uint32_t sz = (uint32_t)bits(machInst, 23);
             const uint32_t zn_field = (uint32_t)bits(machInst, 9, 7);
             const uint32_t zd = (uint32_t)bits(machInst, 4, 0);

             const uint32_t n_start = zn_field * 4;

             uint64_t imm = 0;
             imm |= (uint64_t)(zd & 0x1F);
             imm |= (uint64_t)((n_start & 0x1F) << 5); 
             imm |= (uint64_t)((sz & 0x1) << 10);

             return new SmeSqcvtu(machInst, imm);
        }

        // UQCVT (Four registers)
        if (Aarch64::isSme2Uqcvt((uint32_t)machInst)) {
             const uint32_t sz = (uint32_t)bits(machInst, 23);
             const uint32_t zn_field = (uint32_t)bits(machInst, 9, 7);
             const uint32_t zd = (uint32_t)bits(machInst, 4, 0);

             const uint32_t n_start = zn_field * 4;

             uint64_t imm = 0;
             imm |= (uint64_t)(zd & 0x1F);
             imm |= (uint64_t)((n_start & 0x1F) << 5); 
             imm |= (uint64_t)((sz & 0x1) << 10);

             return new SmeUqcvt(machInst, imm);
        }

        // SQCVT (Two registers)
        if (Aarch64::isSme2Sqcvt2((uint32_t)machInst)) {
             const uint32_t zn_field = (uint32_t)bits(machInst, 9, 6);
             const uint32_t zd = (uint32_t)bits(machInst, 4, 0);

             // Zn denotes a group of 2 registers (Zn*2)
             const uint32_t n_start = zn_field * 2;

             uint64_t imm = 0;
             imm |= (uint64_t)(zd & 0x1F);
             imm |= (uint64_t)((n_start & 0x1F) << 5); 

             return new SmeSqcvt2(machInst, imm);
        }

        // UQCVT (Two registers)
        if (Aarch64::isSme2Uqcvt2((uint32_t)machInst)) {
             const uint32_t zn_field = (uint32_t)bits(machInst, 9, 6);
             const uint32_t zd = (uint32_t)bits(machInst, 4, 0);

             // Zn denotes a group of 2 registers (Zn*2)
             const uint32_t n_start = zn_field * 2;

             uint64_t imm = 0;
             imm |= (uint64_t)(zd & 0x1F);
             imm |= (uint64_t)((n_start & 0x1F) << 5); 

             return new SmeUqcvt2(machInst, imm);
        }

        // SQCVTU (Two registers)
        if (Aarch64::isSme2Sqcvtu2((uint32_t)machInst)) {
             const uint32_t zn_field = (uint32_t)bits(machInst, 9, 6);
             const uint32_t zd = (uint32_t)bits(machInst, 4, 0);

             // Zn denotes a group of 2 registers
             const uint32_t n_start = zn_field * 2;

             uint64_t imm = 0;
             imm |= (uint64_t)(zd & 0x1F);
             imm |= (uint64_t)((n_start & 0x1F) << 5); 

             return new SmeSqcvtu2(machInst, imm);
        }

        // SQCVTN (Four registers, Interleaved)
        if (Aarch64::isSme2Sqcvtn((uint32_t)machInst)) {
             const uint32_t sz = (uint32_t)bits(machInst, 23);
             const uint32_t zn_field = (uint32_t)bits(machInst, 9, 7);
             const uint32_t zd = (uint32_t)bits(machInst, 4, 0);

             const uint32_t n_start = zn_field * 4;

             uint64_t imm = 0;
             imm |= (uint64_t)(zd & 0x1F);
             imm |= (uint64_t)((n_start & 0x1F) << 5); 
             imm |= (uint64_t)((sz & 0x1) << 10);

             return new SmeSqcvtn(machInst, imm);
        }

        // SQCVTUN (Four registers, Interleaved)
        if (Aarch64::isSme2Sqcvtun((uint32_t)machInst)) {
             const uint32_t sz = (uint32_t)bits(machInst, 23);
             const uint32_t zn_field = (uint32_t)bits(machInst, 9, 7);
             const uint32_t zd = (uint32_t)bits(machInst, 4, 0);

             const uint32_t n_start = zn_field * 4;

             uint64_t imm = 0;
             imm |= (uint64_t)(zd & 0x1F);
             imm |= (uint64_t)((n_start & 0x1F) << 5); 
             imm |= (uint64_t)((sz & 0x1) << 10);

             return new SmeSqcvtun(machInst, imm);
        }

        // UQCVTN (Four registers, Interleaved)
        if (Aarch64::isSme2Uqcvtn((uint32_t)machInst)) {
             const uint32_t sz = (uint32_t)bits(machInst, 23);
             const uint32_t zn_field = (uint32_t)bits(machInst, 9, 7);
             const uint32_t zd = (uint32_t)bits(machInst, 4, 0);

             const uint32_t n_start = zn_field * 4;

             uint64_t imm = 0;
             imm |= (uint64_t)(zd & 0x1F);
             imm |= (uint64_t)((n_start & 0x1F) << 5); 
             imm |= (uint64_t)((sz & 0x1) << 10);

             return new SmeUqcvtn(machInst, imm);
        }
        
        
        // 1. Detect 4-register variant (Bits 21 and 20 pattern)
        //    SCVTF/UCVTF 4-reg: 0xC132...
        //    FCVTZU      4-reg: 0xC131...
        //    Common feature: Bit 20 is 1.
        const bool is4_reg = (bool)bits(machInst, 20);

        // 2. Detect Instruction Type
        //    Bit 16 is the differentiator:
        //    0 = SCVTF / UCVTF
        //    1 = FCVTZU
        const bool is_fcvtz = (bool)bits(machInst, 16);

        // 3. Detect Unsigned bit (Bit 5)
        const bool isUnsigned = (bool)bits(machInst, 5);

        // 4. Extract Registers (Same for all)
        //    Zn is bits 9-6 (4 bits)
        //    Zd is bits 4-0 (5 bits)
        const uint32_t n_base = (uint32_t)bits(machInst, 9, 6);
        const uint32_t d_base = (uint32_t)bits(machInst, 4, 0);

        // 5. Pack immediate
        uint64_t imm = 0;
        imm |= (uint64_t)(d_base & 0x1F);            // 4:0
        imm |= (uint64_t)((n_base & 0xF) << 5);      // 9:5
        imm |= (uint64_t)((is4_reg ? 1 : 0) << 10);  // 10

        // 6. Dispatch
        if (is_fcvtz) {
            // FCVTZU (Float -> Unsigned Int)
            if (isUnsigned) {
                return new SmeFcvtzuMv(machInst, imm);
            } else {
                return new SmeFcvtzsMv(machInst, imm); 
            }
        } else {
            // SCVTF / UCVTF (Int -> Float)
            if (isUnsigned) {
                return new SmeUcvtfMv(machInst, imm);
            } else {
                return new SmeScvtfMv(machInst, imm);
            }
        }
    }

    StaticInstPtr
    decodeSmeMisc(ExtMachInst machInst)
    {
        const uint32_t op0 = (uint32_t)bits(machInst, 23, 22);
        const uint32_t op1 = (uint32_t)bits(machInst, 18, 8);

        if (op0 == 0b00) {
            if (op1 == 0b00000000000) {
                return Aarch64::decodeSmeZero(machInst);
            }
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeZero(ExtMachInst machInst)
    {
        const uint8_t imm8 = (uint8_t)bits(machInst, 7, 0);
        return new SmeZero<uint64_t>(machInst, imm8);
    }

    StaticInstPtr
    decodeSmeAddArray(ExtMachInst machInst)
    {
        const uint32_t op0 = (uint32_t)bits(machInst, 23);
        const uint32_t op1 = (uint32_t)bits(machInst, 18, 17);
        const uint32_t op2 = (uint32_t)bits(machInst, 4);
        if (op0 == 1) {
            if (op1 == 0b00) {
                if (op2 == 0) {
                    return Aarch64::decodeSmeAddhv(machInst);
                }
            }
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeAddhv(ExtMachInst machInst)
    {
        const uint32_t V = (uint32_t)bits(machInst, 16, 16);
        const uint32_t op = (uint32_t)bits(machInst, 22, 22);
        const uint32_t op2 = (uint32_t)bits(machInst, 2, 0);
        const RegIndex Zn = (RegIndex)(uint32_t)(bits(machInst, 9, 5));
        const RegIndex Pn = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        const RegIndex Pm = (RegIndex)(uint32_t)(bits(machInst, 15, 13));
        const RegIndex ZAda = (RegIndex)(uint32_t)(bits(machInst, 2, 0));
        if (op == 0) { // 32-bit
            if (V == 0) {
                if ((op2 & 0b100) == 0b000) {
                    return new SmeAddha<int32_t>(machInst, ZAda, Zn, Pn, Pm);
                }
            } else {
                if ((op2 & 0b100) == 0b000) {
                    return new SmeAddva<int32_t>(machInst, ZAda, Zn, Pn, Pm);
                }
            }
        } else {
            if (V == 0) {
                return new SmeAddha<int64_t>(machInst, ZAda, Zn, Pn, Pm);
            } else {
                return new SmeAddva<int64_t>(machInst, ZAda, Zn, Pn, Pm);
            }
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeMemory(ExtMachInst machInst)
    {
        const uint8_t op0 = (uint8_t)bits(machInst, 24, 21);
        const uint8_t op1 = (uint8_t)bits(machInst, 20, 15);
        const uint8_t op2 = (uint8_t)bits(machInst, 12, 10);
        const uint8_t op3 = (uint8_t)bits(machInst, 4);
        if ((op0 & 0b1001) == 0b0000) {
            if (op3 == 0b0) {
                return Aarch64::decodeSmeLoad(machInst);
            }
        }

        if ((op0 & 0b1001) == 0b0001) {
            if (op3 == 0b0) {
                return Aarch64::decodeSmeStore(machInst);
            }
        }

        if ((op0 & 0b1110) == 0b1000) {
            if (op1 == 0b000000) {
                if (op2 == 0b000) {
                    if (op3 == 0b0) {
                        return Aarch64::decodeSmeLoadStoreArray(machInst);
                    }
                }
            }
        }

        if (op0 == 0b1110) {
            if (op3 == 0b0) {
                return Aarch64::decodeSmeLoadQuadWord(machInst);
            }
        }

        if (op0 == 0b1111) {
            if (op3 == 0b0) {
                return Aarch64::decodeSmeStoreQuadWord(machInst);
            }
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeLoad(ExtMachInst machInst)
    {
        const uint8_t msz = (uint8_t)bits(machInst, 23, 22);
        const bool V = (bool)bits(machInst, 15);

        const RegIndex Rn = makeSP(
                                (RegIndex)(uint32_t)bits(machInst, 9, 5));
        const RegIndex Rm = (RegIndex)(uint32_t)(bits(machInst, 20, 16));
        const RegIndex Rs = (RegIndex)(uint32_t)(
            bits(machInst, 14, 13) + 12);
        const uint32_t ZAt_imm = (uint32_t)bits(machInst, 3, 0);
        const RegIndex Pg = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        switch(msz)
        {
          case 0b00:
            return new SmeLd1b<uint8_t>(machInst, ZAt_imm, Rn, Pg, Rs, Rm, V);
          case 0b01:
            return new SmeLd1h<uint16_t>(machInst, ZAt_imm, Rn, Pg, Rs, Rm, V);
          case 0b10:
            return new SmeLd1w<uint32_t>(machInst, ZAt_imm, Rn, Pg, Rs, Rm, V);
          case 0b11:
            return new SmeLd1d<uint64_t>(machInst, ZAt_imm, Rn, Pg, Rs, Rm, V);
          default:
            break;
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeStore(ExtMachInst machInst)
    {
        const uint8_t msz = (uint8_t)bits(machInst, 23, 22);
        const bool V = (bool)bits(machInst, 15);

        const RegIndex Rn = makeSP(
                                (RegIndex)(uint32_t)bits(machInst, 9, 5));
        const RegIndex Rm = (RegIndex)(uint32_t)(bits(machInst, 20, 16));
        const RegIndex Rs = (RegIndex)(uint32_t)(
            bits(machInst, 14, 13) + 12);
        const uint32_t ZAt_imm = (uint32_t)bits(machInst, 3, 0);
        const RegIndex Pg = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        switch(msz)
        {
          case 0b00:
            return new SmeSt1b<uint8_t>(machInst, ZAt_imm, Rn, Pg, Rs, Rm, V);
          case 0b01:
            return new SmeSt1h<uint16_t>(machInst, ZAt_imm, Rn, Pg, Rs, Rm, V);
          case 0b10:
            return new SmeSt1w<uint32_t>(machInst, ZAt_imm, Rn, Pg, Rs, Rm, V);
          case 0b11:
            return new SmeSt1d<uint64_t>(machInst, ZAt_imm, Rn, Pg, Rs, Rm, V);
          default:
            break;
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeLoadStoreArray(ExtMachInst machInst)
    {
        const uint8_t op = (uint8_t)bits(machInst, 21);
        const RegIndex Rn = makeSP(
                                (RegIndex)(uint32_t)bits(machInst, 9, 5));
        const RegIndex Rv = (RegIndex)(uint32_t)(
            bits(machInst, 14, 13) + 12);
        const uint32_t imm4 = (uint32_t)bits(machInst, 3, 0);

        if (op == 0) {
            return new SmeLdr(machInst, imm4, Rn, Rv);
        } else {
            return new SmeStr(machInst, imm4, Rn, Rv);
        }

        return new Unknown64(machInst);
    }

    StaticInstPtr
    decodeSmeLoadQuadWord(ExtMachInst machInst)
    {
        const bool V = (bool)bits(machInst, 15);
        const RegIndex Rn = makeSP(
                                (RegIndex)(uint32_t)bits(machInst, 9, 5));
        const RegIndex Rm = (RegIndex)(uint32_t)(bits(machInst, 20, 16));
        const RegIndex Rs = (RegIndex)(uint32_t)(
            bits(machInst, 14, 13) + 12);
        const uint32_t ZAt = (uint32_t)bits(machInst, 3, 0);
        const RegIndex Pg = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        return new SmeLd1q<__uint128_t>(machInst, ZAt, Rn, Pg, Rs, Rm, V);
    }

    StaticInstPtr
    decodeSmeStoreQuadWord(ExtMachInst machInst)
    {
        const bool V = (bool)bits(machInst, 15);
        const RegIndex Rn = makeSP(
                                (RegIndex)(uint32_t)bits(machInst, 9, 5));
        const RegIndex Rm = (RegIndex)(uint32_t)(bits(machInst, 20, 16));
        const RegIndex Rs = (RegIndex)(uint32_t)(
            bits(machInst, 14, 13) + 12);
        const uint32_t ZAt = (uint32_t)bits(machInst, 3, 0);
        const RegIndex Pg = (RegIndex)(uint32_t)(bits(machInst, 12, 10));
        return new SmeSt1q<__uint128_t>(machInst, ZAt, Rn, Pg, Rs, Rm, V);
    }
}
}};