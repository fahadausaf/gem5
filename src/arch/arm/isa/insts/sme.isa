        ArmISA::VecPredRegContainer pn_reg, pm_reg;
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pn], &pn_reg);
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pm], &pm_reg);

        // SVE Predicate logic for 16-bit elements (2 bytes per element)
        auto is_active = [](const ArmISA::VecPredRegContainer& preg, int index) -> bool {
            int bit_idx = index * 2; 
            int byte_idx = bit_idx / 8;
            int bit_offset = bit_idx % 8;
            return (preg.as<uint8_t>()[byte_idx] >> bit_offset) & 1;
        };

        // 4. 2-Way Outer Product Execution
        for (int row = 0; row < dim; ++row) {
            for (int col = 0; col < dim; ++col) {
                
                // Read initial accumulator value
                TPDElem sum = tile[row][col];
                
                // 2-Way dot product inner loop
                for (int k = 0; k < 2; ++k) {
                    int idx_n = 2 * row + k;
                    int idx_m = 2 * col + k;

                    bool active1 = is_active(pn_reg, idx_n);
                    bool active2 = is_active(pm_reg, idx_m);

                    if (active1 && active2) {
                        // Widen the 16-bit unsigned ints to 32-bit, multiply, and SUBTRACT
                        TPDElem val1 = static_cast<TPDElem>(zn_ptr[idx_n]);
                        TPDElem val2 = static_cast<TPDElem>(zm_ptr[idx_m]);
                        sum -= (val1 * val2);
                    }
                }
                
                // Writeback to tile
                tile[row][col] = sum;
                
                // Debug corner cases
                if ((row == 0       && col == 0)       ||
                    (row == 0       && col == dim - 1) ||
                    (row == dim - 1 && col == 0)       ||
                    (row == dim - 1 && col == dim - 1)) {
                    DPRINTF(Arm, "SmeUmops2way[%d][%d] NewZA=%u\n", row, col, tile[row][col]);
                }
            }
        }
    '''

