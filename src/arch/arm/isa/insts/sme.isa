    def smeMovaVecToTile4RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + r'''
            const uint32_t ZAd_raw  = (imm >> 0) & 0x7;
            const uint32_t zn_group = (imm >> 3) & 0x1F;
            const uint32_t off_raw  = (imm >> 8) & 0x7;
            const uint32_t esz_code = (imm >> 11) & 0x3;

            const bool vertical = v; 
            const uint32_t esize = 1u << esz_code; 

            uint32_t ZAd = ZAd_raw;
            if (esz_code == 0)      ZAd &= 0u;
            else if (esz_code == 1) ZAd &= 1u;
            else if (esz_code == 2) ZAd &= 3u;
            else                    ZAd &= 7u;

            // Slice arithmetic
            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t slices   = (VL_bytes / esize);
            const uint32_t index = (uint32_t)WOp2;
            
            const uint32_t offset_mult4 = (off_raw << 2);
            const uint32_t base_aligned = index - (index % 4);

            const uint32_t slice0 = (base_aligned + offset_mult4) % slices;
            const uint32_t slice1 = (slice0 + 1u) % slices;
            const uint32_t slice2 = (slice0 + 2u) % slices;
            const uint32_t slice3 = (slice0 + 3u) % slices;

            // Source Z registers (4 * zn_group)
            const uint32_t z0_idx = (zn_group << 2) + 0u;
            const uint32_t z1_idx = (zn_group << 2) + 1u;
            const uint32_t z2_idx = (zn_group << 2) + 2u;
            const uint32_t z3_idx = (zn_group << 2) + 3u;

            // Fetch source vector data
            ArmISA::VecRegContainer z0, z1, z2, z3;
            xc->tcBase()->getReg(ArmISA::vecRegClass[z0_idx], &z0);
            xc->tcBase()->getReg(ArmISA::vecRegClass[z1_idx], &z1);
            xc->tcBase()->getReg(ArmISA::vecRegClass[z2_idx], &z2);
            xc->tcBase()->getReg(ArmISA::vecRegClass[z3_idx], &z3);

            auto writeSlice = [&](uint32_t slice, const ArmISA::VecRegContainer &zsrc) {
                const uint8_t *zb = zsrc.as<uint8_t>();
                if (!vertical) {
                    if (esize == 1) {
                        auto row = getTileHSlice<uint8_t>(ZA, ZAd, slice);
                        for (uint32_t i = 0; i < slices; ++i) row[i] = zb[i];
                    } else if (esize == 2) {
                        auto row = getTileHSlice<uint16_t>(ZA, ZAd, slice);
                        const uint16_t *p = (const uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) row[i] = p[i];
                    } else if (esize == 4) {
                        auto row = getTileHSlice<uint32_t>(ZA, ZAd, slice);
                        const uint32_t *p = (const uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) row[i] = p[i];
                    } else {
                        auto row = getTileHSlice<uint64_t>(ZA, ZAd, slice);
                        const uint64_t *p = (const uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) row[i] = p[i];
                    }
                } else {
                    if (esize == 1) {
                        auto col = getTileVSlice<uint8_t>(ZA, ZAd, slice);
                        for (uint32_t i = 0; i < slices; ++i) col[i] = zb[i];
                    } else if (esize == 2) {
                        auto col = getTileVSlice<uint16_t>(ZA, ZAd, slice);
                        const uint16_t *p = (const uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) col[i] = p[i];
                    } else if (esize == 4) {
                        auto col = getTileVSlice<uint32_t>(ZA, ZAd, slice);
                        const uint32_t *p = (const uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) col[i] = p[i];
                    } else {
                        auto col = getTileVSlice<uint64_t>(ZA, ZAd, slice);
                        const uint64_t *p = (const uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) col[i] = p[i];
                    }
                }
            };

            // Push data back to the matrix
            writeSlice(slice0, z0);
            writeSlice(slice1, z1);
            writeSlice(slice2, z2);
            writeSlice(slice3, z3);

            DPRINTF(Arm, "SmeMovaVecToTile4Regs: WOp2(idx)=%u offset=%u -> slices={%u,%u,%u,%u} | Pushed Z%u-Z%u to ZA%u\n",
                    index, offset_mult4, slice0, slice1, slice2, slice3, z0_idx, z3_idx, ZAd);
        '''

        iop = InstObjParams(
            name,
            "Sme" + Name,
            "SmeMovaVecToTile2RegsOp", # Safely inherit the base class
            {'code': code, 'op_class': opClass},
            ['IsNonSpeculative']
        )

        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)

    def smeMovazArrayToVec4RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + r'''
            const uint32_t zd_group = imm & 0x7;
            const uint32_t off3     = (imm >> 3) & 0x7;

            // VL DIV 8 gives us the total number of vectors (equal to SVL in bytes)
            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t vectors  = VL_bytes; 
            
            // Stride is vectors DIV 4
            const uint32_t vstride  = vectors / 4; 

            // Read vector select register W8-W11 (mapped to WOp2 by base class)
            const uint32_t vbase = (uint32_t)WOp2;
            
            // Initial vector calculation
            uint32_t vec = (vbase + off3) % vstride;

            // Calculate the 4 sequential destination Z registers
            const uint32_t z0_idx = (zd_group << 2) + 0u;
            const uint32_t z1_idx = (zd_group << 2) + 1u;
            const uint32_t z2_idx = (zd_group << 2) + 2u;
            const uint32_t z3_idx = (zd_group << 2) + 3u;

            ArmISA::VecRegContainer z0, z1, z2, z3;

            // Helper to extract a 1D vector from the ZA array AND zero it
            auto readAndZeroZAVector = [&](uint32_t v_idx, ArmISA::VecRegContainer &zdest) {
                uint8_t *zb = zdest.as<uint8_t>();
                
                // getTileHSlice returns a mutable span to the ZA array
                auto row = getTileHSlice<uint8_t>(ZA, 0, v_idx);
                for (uint32_t i = 0; i < VL_bytes; ++i) {
                    zb[i] = row[i];
                    row[i] = 0; // Zero the ZA vector
                }
            };

            // Extract and zero the 4 vectors separated by vstride
            uint32_t vec0 = vec;
            readAndZeroZAVector(vec0, z0);
            
            uint32_t vec1 = vec0 + vstride;
            readAndZeroZAVector(vec1, z1);
            
            uint32_t vec2 = vec1 + vstride;
            readAndZeroZAVector(vec2, z2);
            
            uint32_t vec3 = vec2 + vstride;
            readAndZeroZAVector(vec3, z3);

            DPRINTF(Arm, "SmeMovazArrayToVec4Regs: WOp2(idx)=%u offset=%u -> vectors={%u,%u,%u,%u} | Moved to Z%u-Z%u & Zeroed ZA\n",
                    vbase, off3, vec0, vec1, vec2, vec3, z0_idx, z3_idx);

            // Write directly to architectural state
            xc->tcBase()->setReg(ArmISA::vecRegClass[z0_idx], &z0);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z1_idx], &z1);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z2_idx], &z2);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z3_idx], &z3);
        '''

        iop = InstObjParams(
            name,
            "Sme" + Name,
            "SmeMovaVecToTile2RegsOp", 
            {'code': code, 'op_class': opClass},
            ['IsNonSpeculative']
        )

        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)

    def smeMovazArrayToVec2RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + r'''
            const uint32_t zd_group = imm & 0xF;
            const uint32_t off3     = (imm >> 4) & 0x7;

            // VL DIV 8 gives us the total number of vectors (equal to SVL in bytes)
            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t vectors  = VL_bytes; 
            
            // Stride is vectors DIV 2 for the 2-register variant
            const uint32_t vstride  = vectors / 2; 

            // Read vector select register W8-W11 (mapped to WOp2 by base class)
