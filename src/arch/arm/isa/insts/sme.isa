                        (row_idx == dim && col_idx == dim)) {
                        DPRINTF(Arm, "Sme<NAME>[%d][%d] outprod=%d zn=z%u zm=z%u NewZA=%llu\n",
                                row_idx, col_idx, outprod, (unsigned)zn_sel, (unsigned)zm_sel, (unsigned long long)sum);
                    }
                }
            }
        }
    '''

    #UMOP4A 4-way
    smeFmop4aInst('umop4a4way', 'Umop4a4way', 'MatrixOPOp', 
                ['uint8_t, uint32_t', 'uint16_t, uint64_t'], 
                umop4_4wayCode.replace('<OP>', '+').replace('<NAME>', 'Umop4a4way'))

    # UMOP4S 4-way
    smeFmop4aInst('umop4s4way', 'Umop4s4way', 'MatrixOPOp', 
                ['uint8_t, uint32_t', 'uint16_t, uint64_t'], 
                umop4_4wayCode.replace('<OP>', '-').replace('<NAME>', 'Umop4s4way'))

    usmop4Code = r'''
        #include <type_traits> // Ensure type_traits is available for mixed sign casting

        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = ((imm >> 2) & 0x3) + 1;
        const uint8_t mreg = ((imm >> 4) & 0x3) + 1;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount / 2;

        DPRINTF(Arm, "Sme<NAME>: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u sizeof(src)=%lu\n",
                da, nreg, mreg, eCount, dim, (unsigned)this->op1, (unsigned)this->op2, sizeof(TPSElem));

        for (int outprod = 0; outprod < 4; ++outprod) {
            const int row_hv = outprod / 2;
            const int col_hv = outprod % 2;
            const int row_base = row_hv * dim;
            const int col_base = col_hv * dim;

            const RegIndex zn_sel = this->op1 + (nreg - 1) * col_hv;
            const RegIndex zm_sel = this->op2 + (mreg - 1) * row_hv;

            ArmISA::VecRegContainer zn, zm;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_sel], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zm_sel], &zm);

            const TPSElem *zn_ptr = zn.as<TPSElem>();
            const TPSElem *zm_ptr = zm.as<TPSElem>();

            // Establish explicit casting traits
            using TUnsigned = typename std::make_unsigned<TPSElem>::type;
            using TSigned = typename std::make_signed<TPSElem>::type;

            for (int row = 0; row < dim; ++row) {
                for (int col = 0; col < dim; ++col) {
                    const int row_idx = row_base + row;
                    const int col_idx = col_base + col;

                    TPDElem sum = tile[row_idx][col_idx];

                    // 4-Way Mixed Unsigned x Signed Dot Product
                    for (int k = 0; k < 4; ++k) {
                        // Zn (op1) is explicitly Unsigned
                        TPDElem val1 = static_cast<TPDElem>( static_cast<TUnsigned>(zn_ptr[4 * row_idx + k]) );
                        // Zm (op2) is explicitly Signed
                        TPDElem val2 = static_cast<TPDElem>( static_cast<TSigned>(zm_ptr[4 * col_idx + k]) );
                        
                        sum <OP>= (val1 * val2);
                    }

                    tile[row_idx][col_idx] = sum;

                    if ((row_idx == 0   && col_idx == 0)   ||
                        (row_idx == 0   && col_idx == dim) ||
                        (row_idx == dim && col_idx == 0)   ||
                        (row_idx == dim && col_idx == dim)) {
                        DPRINTF(Arm, "Sme<NAME>[%d][%d] outprod=%d zn=z%u zm=z%u NewZA=%lld\n",
                                row_idx, col_idx, outprod, (unsigned)zn_sel, (unsigned)zm_sel, (long long)sum);
                    }
                }
            }
        }
    '''

    # USMOP4A
    smeFmop4aInst('usmop4a', 'Usmop4a', 'MatrixOPOp', 
                ['uint8_t, uint32_t', 'uint16_t, uint64_t'], 
                usmop4Code.replace('<OP>', '+').replace('<NAME>', 'Usmop4a'))

    # USMOP4S
    smeFmop4aInst('usmop4s', 'Usmop4s', 'MatrixOPOp', 
                ['uint8_t, uint32_t', 'uint16_t, uint64_t'], 
                usmop4Code.replace('<OP>', '-').replace('<NAME>', 'Usmop4s'))

    stmopa2wayCode = r'''
        const uint8_t da = imm & 0x3;
        const uint8_t index = (imm >> 2) & 0x3;
        const uint8_t zk_idx = (imm >> 4) & 0x1F;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount;

        DPRINTF(Arm, "SmeStmopa2way: da=%u index=%u zk=z%u dim=%d Zn1=z%u Zn2=z%u Zm=z%u\n",
                da, index, zk_idx, dim, (unsigned)this->op1, (unsigned)(this->op1 + 1), (unsigned)this->op2);

        ArmISA::VecRegContainer zn1, zn2, zm, zk;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1 + 1], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zk_idx], &zk);

        const TPSElem *zn1_ptr = zn1.as<TPSElem>();
        const TPSElem *zn2_ptr = zn2.as<TPSElem>();
        const TPSElem *zm_ptr  = zm.as<TPSElem>();
        const uint8_t *zk_ptr  = zk.as<uint8_t>();

        // 2-in-4 Sparse Outer Product
        for (int col = 0; col < dim; ++col) {
            int bit_offset = index * dim * 4 + col * 4;
            int byte_offset = bit_offset / 8;
            int bit_shift = bit_offset % 8;
            uint8_t ctrl_4bit = (zk_ptr[byte_offset] >> bit_shift) & 0xF;

            TPDElem ecol[2];
            ecol[0] = static_cast<TPDElem>(zm_ptr[2 * col + 0]);
            ecol[1] = static_cast<TPDElem>(zm_ptr[2 * col + 1]);

            for (int row = 0; row < dim; ++row) {
                TPDElem erow[2] = {0, 0};
                int active_count = 0;

                // Scan Zn1
                if (active_count < 2 && (ctrl_4bit & (1 << 0))) erow[active_count++] = zn1_ptr[2 * row + 0];
                if (active_count < 2 && (ctrl_4bit & (1 << 1))) erow[active_count++] = zn1_ptr[2 * row + 1];
                
                // Scan Zn2
                if (active_count < 2 && (ctrl_4bit & (1 << 2))) erow[active_count++] = zn2_ptr[2 * row + 0];
                if (active_count < 2 && (ctrl_4bit & (1 << 3))) erow[active_count++] = zn2_ptr[2 * row + 1];

                TPDElem sum = tile[row][col];
                sum += (erow[0] * ecol[0]);
                sum += (erow[1] * ecol[1]);
                tile[row][col] = sum;

                if ((row == 0       && col == 0)       ||
                    (row == 0       && col == dim - 1) ||
                    (row == dim - 1 && col == 0)       ||
                    (row == dim - 1 && col == dim - 1)) {
                    DPRINTF(Arm, "SmeStmopa2way[%d][%d] ctrl=0x%x erow={%d, %d} ecol={%d, %d} NewZA=%d\n",
                            row, col, ctrl_4bit, (int)erow[0], (int)erow[1], (int)ecol[0], (int)ecol[1], (int)tile[row][col]);
                }
            }
        }
    '''

    # STMOPA 2-way 
    smeFmop4aInst('stmopa2way', 'Stmopa2way', 'MatrixOPOp', ['int16_t, int32_t'], stmopa2wayCode)

    stmopa4wayCode = r'''
        const uint8_t da = imm & 0x3;
        const uint8_t index = (imm >> 2) & 0x3;
        const uint8_t zk_idx = (imm >> 4) & 0x1F;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount;

        DPRINTF(Arm, "SmeStmopa4way: da=%u index=%u zk=z%u dim=%d Zn1=z%u Zn2=z%u Zm=z%u\n",
                da, index, zk_idx, dim, (unsigned)this->op1, (unsigned)(this->op1 + 1), (unsigned)this->op2);

        ArmISA::VecRegContainer zn1, zn2, zm, zk;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1 + 1], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zk_idx], &zk);

        const TPSElem *zn1_ptr = zn1.as<TPSElem>();
        const TPSElem *zn2_ptr = zn2.as<TPSElem>();
        const TPSElem *zm_ptr  = zm.as<TPSElem>();
        const uint8_t *zk_ptr  = zk.as<uint8_t>();

        // 4-Way Sparse Outer Product Execution
        for (int col = 0; col < dim; ++col) {
            
            // 8-bit control read
            int byte_offset = index * dim + col;
            uint8_t ctrl_8bit = zk_ptr[byte_offset];

            TPDElem ecol[4];
            ecol[0] = static_cast<TPDElem>(zm_ptr[4 * col + 0]);
            ecol[1] = static_cast<TPDElem>(zm_ptr[4 * col + 1]);
            ecol[2] = static_cast<TPDElem>(zm_ptr[4 * col + 2]);
            ecol[3] = static_cast<TPDElem>(zm_ptr[4 * col + 3]);

            for (int row = 0; row < dim; ++row) {
                
                TPDElem erow[4] = {0, 0, 0, 0};
                int active1 = 0;
                int active2 = 0;

                // Scan Zn1
                for (int e = 0; e < 4; ++e) {
                    if (active1 < 2 && (ctrl_8bit & (1 << e))) {
                        erow[active1++] = static_cast<TPDElem>(zn1_ptr[4 * row + e]);
                    }
                }
                
                // Scan Zn2
                for (int e = 0; e < 4; ++e) {
                    if (active2 < 2 && (ctrl_8bit & (1 << (e + 4)))) {
                        erow[2 + active2++] = static_cast<TPDElem>(zn2_ptr[4 * row + e]);
                    }
                }

                TPDElem sum = tile[row][col];
                sum += (erow[0] * ecol[0]);
                sum += (erow[1] * ecol[1]);
                sum += (erow[2] * ecol[2]);
                sum += (erow[3] * ecol[3]);
                tile[row][col] = sum;

                if ((row == 0       && col == 0)       ||
                    (row == 0       && col == dim - 1) ||
                    (row == dim - 1 && col == 0)       ||
                    (row == dim - 1 && col == dim - 1)) {
                    DPRINTF(Arm, "SmeStmopa4way[%d][%d] ctrl=0x%x erow={%d,%d,%d,%d} ecol={%d,%d,%d,%d} NewZA=%d\n",
                            row, col, ctrl_8bit, 
                            (int)erow[0], (int)erow[1], (int)erow[2], (int)erow[3],
                            (int)ecol[0], (int)ecol[1], (int)ecol[2], (int)ecol[3],
                            (int)tile[row][col]);
                }
            }
        }
    '''

    # STMOPA 4-way
    smeFmop4aInst('stmopa4way', 'Stmopa4way', 'MatrixOPOp', ['int8_t, int32_t'], stmopa4wayCode)

    sutmopaCode = r'''
        #include <type_traits>

        const uint8_t da = imm & 0x3;
        const uint8_t index = (imm >> 2) & 0x3;
        const uint8_t zk_idx = (imm >> 4) & 0x1F;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount;

        DPRINTF(Arm, "SmeSutmopa: da=%u index=%u zk=z%u dim=%d Zn1=z%u Zn2=z%u Zm=z%u\n",
                da, index, zk_idx, dim, (unsigned)this->op1, (unsigned)(this->op1 + 1), (unsigned)this->op2);

        ArmISA::VecRegContainer zn1, zn2, zm, zk;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1 + 1], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zk_idx], &zk);

        const TPSElem *zn1_ptr = zn1.as<TPSElem>();
        const TPSElem *zn2_ptr = zn2.as<TPSElem>();
        const TPSElem *zm_ptr  = zm.as<TPSElem>();
        const uint8_t *zk_ptr  = zk.as<uint8_t>();

        // Mixed-Sign Casts
        using TSigned = typename std::make_signed<TPSElem>::type;
        using TUnsigned = typename std::make_unsigned<TPSElem>::type;

        // 4-Way Sparse Outer Product Execution
        for (int col = 0; col < dim; ++col) {
            
            int byte_offset = index * dim + col;
            uint8_t ctrl_8bit = zk_ptr[byte_offset];

            TPDElem ecol[4];
            // Zm is Unsigned
            ecol[0] = static_cast<TPDElem>( static_cast<TUnsigned>(zm_ptr[4 * col + 0]) );
            ecol[1] = static_cast<TPDElem>( static_cast<TUnsigned>(zm_ptr[4 * col + 1]) );
            ecol[2] = static_cast<TPDElem>( static_cast<TUnsigned>(zm_ptr[4 * col + 2]) );
            ecol[3] = static_cast<TPDElem>( static_cast<TUnsigned>(zm_ptr[4 * col + 3]) );

            for (int row = 0; row < dim; ++row) {
                
                TPDElem erow[4] = {0, 0, 0, 0};
                int active1 = 0;
                int active2 = 0;

                // Zn1 is Signed
                for (int e = 0; e < 4; ++e) {
                    if (active1 < 2 && (ctrl_8bit & (1 << e))) {
                        erow[active1++] = static_cast<TPDElem>( static_cast<TSigned>(zn1_ptr[4 * row + e]) );
                    }
                }
                
                // Zn2 is Signed
                for (int e = 0; e < 4; ++e) {
                    if (active2 < 2 && (ctrl_8bit & (1 << (e + 4)))) {
                        erow[2 + active2++] = static_cast<TPDElem>( static_cast<TSigned>(zn2_ptr[4 * row + e]) );
                    }
                }

                TPDElem sum = tile[row][col];
                sum += (erow[0] * ecol[0]);
                sum += (erow[1] * ecol[1]);
                sum += (erow[2] * ecol[2]);
                sum += (erow[3] * ecol[3]);
                tile[row][col] = sum;

                if ((row == 0       && col == 0)       ||
                    (row == 0       && col == dim - 1) ||
                    (row == dim - 1 && col == 0)       ||
                    (row == dim - 1 && col == dim - 1)) {
                    DPRINTF(Arm, "SmeSutmopa[%d][%d] ctrl=0x%x erow={%d,%d,%d,%d} ecol={%u,%u,%u,%u} NewZA=%lld\n",
                            row, col, ctrl_8bit, 
                            (int)erow[0], (int)erow[1], (int)erow[2], (int)erow[3],
                            (unsigned)ecol[0], (unsigned)ecol[1], (unsigned)ecol[2], (unsigned)ecol[3],
                            (long long)tile[row][col]);
                }
            }
        }
    '''

    smeFmop4aInst('sutmopa', 'Sutmopa', 'MatrixOPOp', ['uint8_t, uint32_t'], sutmopaCode)

    ustmopaCode = r'''
        #include <type_traits>

        const uint8_t da = imm & 0x3;
        const uint8_t index = (imm >> 2) & 0x3;
        const uint8_t zk_idx = (imm >> 4) & 0x1F;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount;

        DPRINTF(Arm, "SmeUstmopa: da=%u index=%u zk=z%u dim=%d Zn1=z%u Zn2=z%u Zm=z%u\n",
                da, index, zk_idx, dim, (unsigned)this->op1, (unsigned)(this->op1 + 1), (unsigned)this->op2);

        ArmISA::VecRegContainer zn1, zn2, zm, zk;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1 + 1], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zk_idx], &zk);

        const TPSElem *zn1_ptr = zn1.as<TPSElem>();
        const TPSElem *zn2_ptr = zn2.as<TPSElem>();
        const TPSElem *zm_ptr  = zm.as<TPSElem>();
        const uint8_t *zk_ptr  = zk.as<uint8_t>();

        // Mixed-Sign Casts 
        using TSigned = typename std::make_signed<TPSElem>::type;
        using TUnsigned = typename std::make_unsigned<TPSElem>::type;

        // 4-Way Sparse Outer Product Execution
        for (int col = 0; col < dim; ++col) {
            
            int byte_offset = index * dim + col;
            uint8_t ctrl_8bit = zk_ptr[byte_offset];

            TPDElem ecol[4];
            // Zm is explicitly Signed
            ecol[0] = static_cast<TPDElem>( static_cast<TSigned>(zm_ptr[4 * col + 0]) );
            ecol[1] = static_cast<TPDElem>( static_cast<TSigned>(zm_ptr[4 * col + 1]) );
            ecol[2] = static_cast<TPDElem>( static_cast<TSigned>(zm_ptr[4 * col + 2]) );
            ecol[3] = static_cast<TPDElem>( static_cast<TSigned>(zm_ptr[4 * col + 3]) );

            for (int row = 0; row < dim; ++row) {
                
                TPDElem erow[4] = {0, 0, 0, 0};
                int active1 = 0;
                int active2 = 0;

                // Zn1 is explicitly Unsigned
                for (int e = 0; e < 4; ++e) {
                    if (active1 < 2 && (ctrl_8bit & (1 << e))) {
                        erow[active1++] = static_cast<TPDElem>( static_cast<TUnsigned>(zn1_ptr[4 * row + e]) );
                    }
                }
                
                // Zn2 is explicitly Unsigned
                for (int e = 0; e < 4; ++e) {
                    if (active2 < 2 && (ctrl_8bit & (1 << (e + 4)))) {
                        erow[2 + active2++] = static_cast<TPDElem>( static_cast<TUnsigned>(zn2_ptr[4 * row + e]) );
                    }
                }

                TPDElem sum = tile[row][col];
                sum += (erow[0] * ecol[0]);
                sum += (erow[1] * ecol[1]);
                sum += (erow[2] * ecol[2]);
                sum += (erow[3] * ecol[3]);
                tile[row][col] = sum;

                if ((row == 0       && col == 0)       ||
                    (row == 0       && col == dim - 1) ||
                    (row == dim - 1 && col == 0)       ||
                    (row == dim - 1 && col == dim - 1)) {
                    DPRINTF(Arm, "SmeUstmopa[%d][%d] ctrl=0x%x erow={%u,%u,%u,%u} ecol={%d,%d,%d,%d} NewZA=%lld\n",
                            row, col, ctrl_8bit, 
                            (unsigned)erow[0], (unsigned)erow[1], (unsigned)erow[2], (unsigned)erow[3],
                            (int)ecol[0], (int)ecol[1], (int)ecol[2], (int)ecol[3],
                            (long long)tile[row][col]);
                }
            }
        }
    '''

    # USTMOPA
    smeFmop4aInst('ustmopa', 'Ustmopa', 'MatrixOPOp', ['uint8_t, uint32_t'], ustmopaCode)


    # SMSTART
    smstartSmstopCode = '''
        // Bit 0 of imm determines if we are setting or clearing
        // (smstart vs smstop)
        // Bit 1 means that we are applying this to SM
        // Bit 2 means that we are applying this to ZA
        bool new_state    = imm & 0x1;
        bool sm_affected  = imm & 0x2;
        bool za_affected  = imm & 0x4;
        bool old_sm_state = Svcr & 0x1;
        bool old_za_state = Svcr & 0x2;

        bool sm_changed = sm_affected && old_sm_state != new_state;
        bool za_changed = za_affected && old_za_state != new_state;

        if (sm_changed) {
            // We need to zero the SVE Z, P, FFR registers on SM change. Also,
            // set FPSR to a default value. Note that we use the max SVE len
            // instead of the actual vector length.
            //
            // For the Z, P registers we are directly setting these to zero
            // without going through the ISA parser (which generates the
            // dependencies) as otherwise the O3 CPU can deadlock when there
            // are too few free physical registers. We therefore rely on this
            // instruction being a barrier (IsSerialiseAfter).

            // Z Registers, including special and interleave registers
            ArmISA::VecRegContainer zeroed_z_reg;
            zeroed_z_reg.zero();

            for (int reg_idx = 0; reg_idx < NumVecRegs; ++reg_idx) {
                auto reg_id = ArmISA::vecRegClass[reg_idx];
                xc->tcBase()->setReg(reg_id, &zeroed_z_reg);
            }

            // P Registers, including the FFR
            ArmISA::VecPredRegContainer zeroed_p_reg;
            zeroed_p_reg.reset();

            for (int reg_idx = 0; reg_idx < NumVecPredRegs; ++reg_idx) {
                auto reg_id = ArmISA::vecPredRegClass[reg_idx];
                xc->tcBase()->setReg(reg_id, &zeroed_p_reg);
            }

            // FPSR
            Fpsr = 0x0800009f;
        }

        if (za_changed) {
            // ZA write
            ZA = ZA;
            ZA.zero();
        }

        // Now that we've handled the zeroing of the appropriate registers,
        // we update the pstate accordingly.

        if (sm_changed) {
            if (new_state == 1) {
                Svcr = Svcr | 0x1; // Set SM
            } else {
                Svcr = Svcr & ~(uint64_t)0x1; // Clear SM
            }
        }

        if (za_changed) {
            if (new_state == 1) {
                Svcr = Svcr | 0x2; // Set ZA
            } else {
                Svcr = Svcr & ~(uint64_t)0x2; // Clear ZA
            }
        }
    '''

    smeMsrInst('smstart', 'Smstart', 'IntAluOp',
               smstartSmstopCode)

    # SMSTOP
    smeMsrInst('smstop', 'Smstop', 'IntAluOp',
               smstartSmstopCode)

    # ST1B
    smeSt1xInst('st1b', 'St1b', 'MemWriteOp', ['uint8_t'])

    # ST1D
    smeSt1xInst('st1d', 'St1d', 'MemWriteOp', ['uint64_t'])

    # ST1H
    smeSt1xInst('st1h', 'St1h', 'MemWriteOp', ['uint16_t'])

    # ST1Q
    smeSt1xInst('st1q', 'St1q', 'MemWriteOp', ['__uint128_t'])

    # ST1W
    smeSt1xInst('st1w', 'St1w', 'MemWriteOp', ['uint32_t'])

    # STR
    smeStrInst("str", "Str", "MemWriteOp")

    # SUMOPA
    smeIntOPInst('sumopa', 'Sumopa', 'MatrixOPOp', ['int8_t', 'int16_t'],
                 ['uint8_t', 'uint16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "+")

    # SUMOPS
    smeIntOPInst('sumops', 'Sumops', 'MatrixOPOp', ['int8_t', 'int16_t'],
                 ['uint8_t', 'uint16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "-")

    # UMOPA
    smeIntOPInst('umopa', 'Umopa', 'MatrixOPOp', ['uint8_t', 'uint16_t'],
                 ['uint8_t', 'uint16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "+")

    # UMOPS
    smeIntOPInst('umops', 'Umops', 'MatrixOPOp', ['uint8_t', 'uint16_t'],
                 ['uint8_t', 'uint16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "-")

    # USMOPA
    smeIntOPInst('usmopa', 'Usmopa', 'MatrixOPOp', ['uint8_t', 'uint16_t'],
                 ['int8_t', 'int16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "+")

    # USMOPS
    smeIntOPInst('usmops', 'Usmops', 'MatrixOPOp', ['uint8_t', 'uint16_t'],
                 ['int8_t', 'int16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "-")

    # ZERO
    smeZeroInst("zero", "Zero", "MatrixOp", ["uint64_t"])

}};