    # UTMOPA 2-way
    utmopaCode = r'''
        // 1. Unpack metadata
        const uint8_t da = imm & 0x3;
        const uint8_t index = (imm >> 2) & 0x3;
        const uint8_t zk_idx = (imm >> 4) & 0x1F;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount; // dim is the number of 32-bit elements

        DPRINTF(Arm, "SmeUtmopa2way: da=%u index=%u zk=z%u dim=%d Zn1=z%u Zn2=z%u Zm=z%u\n",
                da, index, zk_idx, dim, (unsigned)this->op1, (unsigned)(this->op1 + 1), (unsigned)this->op2);

        // 2. Fetch Vectors
        ArmISA::VecRegContainer zn1, zn2, zm, zk;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1 + 1], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zk_idx], &zk);

        const TPSElem *zn1_ptr = zn1.as<TPSElem>();
        const TPSElem *zn2_ptr = zn2.as<TPSElem>();
        const TPSElem *zm_ptr  = zm.as<TPSElem>();
        const uint8_t *zk_ptr  = zk.as<uint8_t>();

        // 3. 2-in-4 Sparse Outer Product Execution
        for (int col = 0; col < dim; ++col) {
            // Read the 4-bit control segment for this specific column
            int bit_offset = index * dim * 4 + col * 4;
            int byte_offset = bit_offset / 8;
            int bit_shift = bit_offset % 8;
            uint8_t ctrl_4bit = (zk_ptr[byte_offset] >> bit_shift) & 0xF;

            // Fetch the 2 column elements from Zm
            TPDElem ecol[2];
            ecol[0] = static_cast<TPDElem>(zm_ptr[2 * col + 0]);
            ecol[1] = static_cast<TPDElem>(zm_ptr[2 * col + 1]);

            for (int row = 0; row < dim; ++row) {
                // Scan the 4-bit control to select up to 2 active row elements
                TPDElem erow[2] = {0, 0};
                int active_count = 0;

                // r = 0 (Check Zn1)
                if (active_count < 2 && (ctrl_4bit & (1 << 0))) erow[active_count++] = zn1_ptr[2 * row + 0];
                if (active_count < 2 && (ctrl_4bit & (1 << 1))) erow[active_count++] = zn1_ptr[2 * row + 1];
                
                // r = 1 (Check Zn2)
                if (active_count < 2 && (ctrl_4bit & (1 << 2))) erow[active_count++] = zn2_ptr[2 * row + 0];
                if (active_count < 2 && (ctrl_4bit & (1 << 3))) erow[active_count++] = zn2_ptr[2 * row + 1];

                // 2-Way Dot Product Accumulate
                TPDElem sum = tile[row][col];
                sum += (erow[0] * ecol[0]);
                sum += (erow[1] * ecol[1]);
                tile[row][col] = sum;

                // Debug Print
                if ((row == 0       && col == 0)       ||
                    (row == 0       && col == dim - 1) ||
                    (row == dim - 1 && col == 0)       ||
                    (row == dim - 1 && col == dim - 1)) {
                    DPRINTF(Arm, "SmeUtmopa2way[%d][%d] ctrl=0x%x erow={%u, %u} ecol={%u, %u} NewZA=%u\n",
                            row, col, ctrl_4bit, erow[0], erow[1], ecol[0], ecol[1], tile[row][col]);
                }
            }
        }
    '''

    smeFmop4aInst('utmopa2way', 'Utmopa2way', 'MatrixOPOp', ['uint16_t, uint32_t'], utmopaCode)

    # UTMOPA 4-way
    utmopa4wayCode = r'''
        // 1. Unpack metadata
        const uint8_t da = imm & 0x3;
        const uint8_t index = (imm >> 2) & 0x3;
        const uint8_t zk_idx = (imm >> 4) & 0x1F;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount; // Number of 32-bit elements

        DPRINTF(Arm, "SmeUtmopa4way: da=%u index=%u zk=z%u dim=%d Zn1=z%u Zn2=z%u Zm=z%u\n",
                da, index, zk_idx, dim, (unsigned)this->op1, (unsigned)(this->op1 + 1), (unsigned)this->op2);

        // 2. Fetch Vectors
        ArmISA::VecRegContainer zn1, zn2, zm, zk;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1 + 1], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zk_idx], &zk);

        const TPSElem *zn1_ptr = zn1.as<TPSElem>();
        const TPSElem *zn2_ptr = zn2.as<TPSElem>();
        const TPSElem *zm_ptr  = zm.as<TPSElem>();
        const uint8_t *zk_ptr  = zk.as<uint8_t>();

        // 3. 4-Way Sparse Outer Product Execution
        for (int col = 0; col < dim; ++col) {
            
            // Read the 8-bit control segment for this specific column
            // Since it's exactly 8 bits per column, the byte offset is natively direct
            int byte_offset = index * dim + col;
            uint8_t ctrl_8bit = zk_ptr[byte_offset];

            // Fetch the 4 column elements from Zm
            TPDElem ecol[4];
            ecol[0] = static_cast<TPDElem>(zm_ptr[4 * col + 0]);
            ecol[1] = static_cast<TPDElem>(zm_ptr[4 * col + 1]);
            ecol[2] = static_cast<TPDElem>(zm_ptr[4 * col + 2]);
            ecol[3] = static_cast<TPDElem>(zm_ptr[4 * col + 3]);

            for (int row = 0; row < dim; ++row) {
                
                // Populate the 4 row elements
                TPDElem erow[4] = {0, 0, 0, 0};
                int active1 = 0;
                int active2 = 0;

                // Scan bits 0-3 for Zn1 (max 2 active)
                for (int e = 0; e < 4; ++e) {
                    if (active1 < 2 && (ctrl_8bit & (1 << e))) {
                        erow[active1++] = static_cast<TPDElem>(zn1_ptr[4 * row + e]);
                    }
                }
                
                // Scan bits 4-7 for Zn2 (max 2 active)
                for (int e = 0; e < 4; ++e) {
                    if (active2 < 2 && (ctrl_8bit & (1 << (e + 4)))) {
                        erow[2 + active2++] = static_cast<TPDElem>(zn2_ptr[4 * row + e]);
                    }
                }

                // 4-Way Dot Product Accumulate
                TPDElem sum = tile[row][col];
                sum += (erow[0] * ecol[0]);
                sum += (erow[1] * ecol[1]);
                sum += (erow[2] * ecol[2]);
                sum += (erow[3] * ecol[3]);
                tile[row][col] = sum;

                // Debug Print
                if ((row == 0       && col == 0)       ||
                    (row == 0       && col == dim - 1) ||
                    (row == dim - 1 && col == 0)       ||
                    (row == dim - 1 && col == dim - 1)) {
                    DPRINTF(Arm, "SmeUtmopa4way[%d][%d] ctrl=0x%x erow={%u,%u,%u,%u} NewZA=%u\n",
                            row, col, ctrl_8bit, erow[0], erow[1], erow[2], erow[3], tile[row][col]);
                }
            }
        }
    '''

    smeFmop4aInst('utmopa4way', 'Utmopa4way', 'MatrixOPOp', ['uint8_t, uint32_t'], utmopa4wayCode)

    umop4_2wayCode = r'''
        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = ((imm >> 2) & 0x3) + 1;
        const uint8_t mreg = ((imm >> 4) & 0x3) + 1;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount / 2;

        DPRINTF(Arm, "Sme<NAME>: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u\n",
                da, nreg, mreg, eCount, dim, (unsigned)this->op1, (unsigned)this->op2);

        for (int outprod = 0; outprod < 4; ++outprod) {
            const int row_hv = outprod / 2;
            const int col_hv = outprod % 2;
            const int row_base = row_hv * dim;
            const int col_base = col_hv * dim;

            const RegIndex zn_sel = this->op1 + (nreg - 1) * col_hv;
            const RegIndex zm_sel = this->op2 + (mreg - 1) * row_hv;

            ArmISA::VecRegContainer zn, zm;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_sel], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zm_sel], &zm);

            const TPSElem *zn_ptr = zn.as<TPSElem>();
            const TPSElem *zm_ptr = zm.as<TPSElem>();

            for (int row = 0; row < dim; ++row) {
                for (int col = 0; col < dim; ++col) {
                    const int row_idx = row_base + row;
                    const int col_idx = col_base + col;

                    TPDElem sum = tile[row_idx][col_idx];

                    // 2-Way Unsigned Dot Product
                    for (int k = 0; k < 2; ++k) {
                        TPDElem val1 = static_cast<TPDElem>(zn_ptr[2 * row_idx + k]);
                        TPDElem val2 = static_cast<TPDElem>(zm_ptr[2 * col_idx + k]);
                        sum <OP>= (val1 * val2);
                    }

                    tile[row_idx][col_idx] = sum;

                    if ((row_idx == 0   && col_idx == 0)   ||
                        (row_idx == 0   && col_idx == dim) ||
                        (row_idx == dim && col_idx == 0)   ||
                        (row_idx == dim && col_idx == dim)) {
                        DPRINTF(Arm, "Sme<NAME>[%d][%d] outprod=%d zn=z%u zm=z%u NewZA=%u\n",
                                row_idx, col_idx, outprod, (unsigned)zn_sel, (unsigned)zm_sel, (unsigned)sum);
                    }
                }
            }
        }
    '''

