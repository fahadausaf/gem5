        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)
    
    def smeCvtMvInst(name, Name, opClass, custom_code=None):
        global header_output, decoder_output, exec_output

        # If caller supplies code, use it; otherwise use default stub.
        if custom_code is None:
            custom_code = r'''
                panic("smeCvtMvInst used without custom_code");
            '''

        code = smEnCheckCodeNoZA + custom_code

        iop = InstObjParams(name, "Sme" + Name, "SmeCvtMvOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])

        header_output += SmeCvtMvDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)


    def smeMsrInst(name, Name, opClass, op):
        global header_output, decoder_output, exec_output
        code = '''
            if (FullSystem) {
                fault = this->checkSmeAccess(xc->tcBase(), Cpsr, Cpacr64);
                if (fault != NoFault) {
                    return fault;
                }
            }
        ''' + op

        iop = InstObjParams(name, "Sme" + Name, "ImmOp64",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative', 'IsSerializeAfter'])
        header_output += SMEMgmtDeclare.subst(iop)
        exec_output += SmeExecute.subst(iop)

    def smeFPOPInst(name, Name, opClass, srcTypes, dstTypes, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index
            // op1 is the first SVE vector register
            // gp1 is the predecate register corresponding to the first
            //      SVE vector register
            // gp2 is the predecate register corresponding to the second
            //      SVE vector register
            // op2 is the second SVE vector register

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPDElem>(
                xc->tcBase());
            '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeOPOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeFPOPDeclare.subst(iop)
        exec_output += SmeDualTemplatedExecute.subst(iop)
        for src, dst in zip(srcTypes, dstTypes):
            substDict = {'targs' : "{}, {}".format(src, dst),
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeIntOPInst(name, Name, opClass, src1Types, src2Types, dstTypes, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index
            // op1 is the first SVE vector register
            // gp1 is the predecate register corresponding to the first
            //      SVE vector register
            // gp2 is the predecate register corresponding to the second
            //      SVE vector register
            // op2 is the second SVE vector register

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPDElem>(
                xc->tcBase());
            '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeOPOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeIntOPDeclare.subst(iop)
        exec_output += SmeTripleTemplatedExecute.subst(iop)
        for src1, src2, dst in zip(src1Types, src2Types, dstTypes):
            substDict = {'targs' : "{}, {}, {}".format(src1, src2, dst),
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeRdsvlInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoPstate + '''
            // dest is the 64-bit destination register
            // imm is a signed multiplier

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<uint8_t>(
                xc->tcBase());

            Dest64 = eCount * imm;
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeRdsvlOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeRdsvlDeclare.subst(iop)
        exec_output += SmeExecute.subst(iop)

    def smeSt1xInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + '''
            // imm stores the tile number as well as the vector offset. The
            // size of the fields changes based on the data type being used.
            // XOp1 stores Rn
            // GpOp stores the governing predicate register
            // WOp2 stores Rs - the vector index register
            // XOp3 stores Rm - the offset register (applied to Rn)


            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                            xc->tcBase());

            uint8_t offset = imm & (0xf >> (findMsbSet(sizeof(TPElem))));
            [[maybe_unused]] uint8_t tile_idx =
                imm >> (4 - findMsbSet(sizeof(TPElem)));
            [[maybe_unused]] uint8_t vec_idx = (WOp2 + offset) % eCount;

            // Calculate the address
            [[maybe_unused]] Addr EA = XOp1 + XOp3 * sizeof(TPElem);

            // Calculate the write predicate. One boolean per byte,
            // initialised to all true.
            auto wrEn = std::vector<bool>(eCount * sizeof(TPElem), true);
            for (int i = 0; i < eCount; ++i) {
                if (GpOp_x[i]) {
                    continue;
                }

                // Mark each byte of the corresponding elem as false
                for (int j = 0; j < sizeof(TPElem); ++j) {
                    wrEn[i * sizeof(TPElem) + j] = false;
                }
            }

            // Extract the data to be stored from the tile. We don't worry
            // about the predicate here as that's already handled by wrEn.
            TPElem data[MaxSmeVecLenInBytes / sizeof(TPElem)];
            if(V) {
                auto col = getTileVSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    data[i] = col[i];
                }
            } else {
                auto row = getTileHSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    data[i] = row[i];
                }
            }
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeLd1xSt1xOp",
                            {'code': code, 'op_class': opClass},
                            ['IsStore', 'IsNonSpeculative'])
        header_output += SmeSt1xDeclare.subst(iop)
        exec_output += SmeSt1xExecute.subst(iop)
        exec_output += SmeSt1xInitiateAcc.subst(iop)
        exec_output += SmeSt1xCompleteAcc.subst(iop)
        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeSt1xExecDeclare.subst(substDict)

    def smeStrInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoSM + '''
            // imm stores the vector offset. We do not have a tile number
            // as we target the whole accumulator array.
            // imm also stores the offset applied to the base memory access
            // register.
            // Op1 stores Rn, which is the base memory access register
            // Op2 stores Rv, which is the vector select register


            unsigned eCount = ArmStaticInst::getCurSmeVecLen<uint8_t>(
                            xc->tcBase());

            uint8_t vec_index = (WOp2 + imm) % eCount;

            auto row = getTileHSlice<uint8_t>(ZA, 0, vec_index);

            // Calculate the address
            [[maybe_unused]] Addr EA = XOp1 + imm;

            uint8_t data[MaxSmeVecLenInBytes];

            // Update data which will then by used to store the row to memory
            for (int i = 0; i < eCount; ++i) {
                data[i] = row[i];
            }
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeLdrStrOp",
                            {'code': code, 'op_class': opClass},
                            ['IsStore', 'IsNonSpeculative'])
        header_output += SmeStrDeclare.subst(iop)
        exec_output += SmeStrExecute.subst(iop)
        exec_output += SmeStrInitiateAcc.subst(iop)
        exec_output += SmeStrCompleteAcc.subst(iop)

    def smeZeroInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoSM + smeZaWrite + '''
            // When zeroing tiles, we use  64-bit elements. This means
            // that we have up to eight subtiles to clear in the ZA tile.

            ZA = ZA;

            for (int i = 0; i < 8; ++i) {
                if (((imm >> i) & 0x1) == 0x1) {
                    getTile<TPElem>(ZA, i).zero();
                }
            }'''

        iop = InstObjParams(name, "Sme" + Name, "SmeZeroOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeZeroDeclare.subst(iop)
        exec_output += SmeTemplatedExecute.subst(iop)

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    # ADDHA
    addCode = '''
        for (int col = 0; col < eCount; ++col) {
            TPElem val = AA64FpOp1_x[col];

            for (int row = 0; row < eCount; ++row) {
                if (!(GpOp1_x[row] && GpOp2_x[col])) {
                    continue;
                }

                tile[col][row] += val;
            }
        }
        '''
    smeAddInst('addha', "Addha", "SimdAddOp", ['int32_t', 'int64_t'], addCode)

    # ADDSPL
    addSplCode = '''
        Dest64 = imm * ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        // Divide down to get the predicate length in bytes
        Dest64 /= 8;
        Dest64 += XOp1;
    '''
    smeAddVlInst('addspl', "Addspl", "SimdAddOp", addSplCode)

    # ADDSVL
    addSvlCode = '''
        Dest64 = imm * ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        Dest64 += XOp1;
    '''
    smeAddVlInst('addsvl', "Addsvl", "SimdAddOp", addSvlCode)

    # ADDVA
    addCode = '''
        for (int row = 0; row < eCount; ++row) {
            TPElem val = AA64FpOp1_x[row];

            for (int col = 0; col < eCount; ++col) {
                if (!(GpOp1_x[row] && GpOp2_x[col])) {
                    continue;
                }

                tile[col][row] += val;
            }
        }
        '''
    smeAddInst('addva', "Addva", "SimdAddOp", ['int32_t', 'int64_t'], addCode)

    # BFMOPA
    # BFMOPS

    # FMOPA (non-widening)
    fmopxCode = '''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        for (int j = 0; j < eCount; ++j) {
            if (!GpOp1_xd[j]) {
                continue;
            }

            TPDElem val1 = AA64FpOp1_xd[j];

            for (int i = 0; i < eCount; ++i) {
                if (!GpOp2_xd[i]) {
                    continue;
                }

                TPDElem val2 = AA64FpOp2_xd[i];

        #if %s
                val2 = fplibNeg(val2);
        #endif

                TPDElem res = fplibMul(val1, val2, fpscr);

                tile[j][i] = fplibAdd(tile[j][i],
                                      res, fpscr);
            }
        }
        '''
    smeFPOPInst('fmopa', 'Fmopa', 'MatrixOPOp', ['uint32_t', 'uint64_t'],
              ['uint32_t', 'uint64_t'], fmopxCode % "0")

    # FMOPA (widening)
    wideningFmopxCode = '''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        for (int j = 0; j < eCount; ++j) {
            if (!GpOp1_xd[j]) {
                continue;
            }
            for (int i = 0; i < eCount; ++i) {
                if (!GpOp2_xd[i]) {
                    continue;
                }

                for (int k = 0; k < 2; ++k) {
                    TPSElem temp1 = (AA64FpOp1_xd[j] >> (16 * k)) & 0xFFFF;
                    TPSElem temp2 = (AA64FpOp2_xd[j] >> (16 * k)) & 0xFFFF;
                    TPDElem val1 = fplibConvert<TPSElem, TPDElem>(temp1,
                        FPCRRounding(fpscr), fpscr);
                    TPDElem val2 = fplibConvert<TPSElem, TPDElem>(temp2,
                        FPCRRounding(fpscr), fpscr);

        #if %s
                    val2 = fplibNeg(val2);
        #endif

                    TPDElem res = fplibMul(val1, val2, fpscr);
                    tile[j][i] = fplibAdd(tile[j][i], res, fpscr);
                }
            }
        }
        '''
    smeFPOPInst('fmopa', 'FmopaWidening', 'MatrixOPOp',
              ['uint16_t'], ['uint32_t'], wideningFmopxCode % "0")

    # FMOPS (non-widening)
    smeFPOPInst('fmops', 'Fmops', 'MatrixOPOp', ['uint32_t', 'uint64_t'],
              ['uint32_t', 'uint64_t'], fmopxCode % "1")

    # FMOPS (widening)
    smeFPOPInst('fmops', 'FmopsWidening', 'MatrixOPOp',
              ['uint16_t'], ['uint32_t'], wideningFmopxCode % "1")

    
    # FTMOPA (non-widening, TMOP sparse outer product)
    #
    # Types:
    #   - Half-precision variant:  TPDElem = uint16_t
    #   - Single-precision variant: TPDElem = uint32_t
    #
    # imm layout (from decode):
    #   [ 2:0]  za_tile   (ZAda)
    #   [ 4:3]  index     (i2)
    #   [ 9:5]  zn_base   (multi-vector group index)
    #   [14:10] zm
    #   [19:15] zk
    #
    ftmopaCode = r'''
        FPSCR fpscr = (FPSCR)Fpscr;

        // Unpack imm
        const uint64_t raw   = imm;
        const uint8_t zaTile = (raw >> 0) & 0x7;
        const uint8_t index  = (raw >> 3) & 0x3;
        const uint8_t znBase = (raw >> 5) & 0x1F;  // multi-vector group index
        const uint8_t zmIdx  = (raw >> 10) & 0x1F;
        const uint8_t zkIdx  = (raw >> 15) & 0x1F;

        // View ZA tile as TPDElem
        auto tile = getTile<TPDElem>(ZA, zaTile);

        // dim = VL / esize  (eCount already gives us VL / sizeof(TPDElem))
        const unsigned dim    = eCount;
        const unsigned csize  = 2 * dim;          // (VL*2)/esize
        const unsigned segBase = index * csize;   // starting bit of ctrl segment

        // --- Debug trace for FTMOPA execution ---
        DPRINTF(Arm,
            "SmeFtmopa: zaTile=%u index=%u znBase=%u zmIdx=%u zkIdx=%u "
            "dim=%u segBase=%u\n",
            (unsigned)zaTile,
            (unsigned)index,
            (unsigned)znBase,
            (unsigned)zmIdx,
            (unsigned)zkIdx,
            (unsigned)dim,
            (unsigned)segBase);

        // --- Read Zk (control vector) ---
        ArmISA::VecRegContainer zk;
        auto zkRegId = ArmISA::vecRegClass[zkIdx];
        xc->tcBase()->getReg(zkRegId, &zk);
        const uint8_t *zkBytes = zk.as<uint8_t>();

        auto ctrlBit = [&](unsigned bitIdx) -> bool {
            unsigned byte = bitIdx / 8;
            unsigned bit  = bitIdx % 8;
            return (zkBytes[byte] >> bit) & 0x1;
        };

        // --- Read Zn1, Zn2, Zm as TPDElem arrays ---
        const uint8_t zn1Idx = (uint8_t)(2 * znBase);
        const uint8_t zn2Idx = (uint8_t)(2 * znBase + 1);

        ArmISA::VecRegContainer zn1, zn2, zm;
        auto zn1RegId = ArmISA::vecRegClass[zn1Idx];
        auto zn2RegId = ArmISA::vecRegClass[zn2Idx];
        auto zmRegId  = ArmISA::vecRegClass[zmIdx];

        xc->tcBase()->getReg(zn1RegId, &zn1);
        xc->tcBase()->getReg(zn2RegId, &zn2);
        xc->tcBase()->getReg(zmRegId,  &zm);

        const TPDElem *zn1Elems = zn1.as<TPDElem>();
        const TPDElem *zn2Elems = zn2.as<TPDElem>();
        const TPDElem *zmElems  = zm.as<TPDElem>();

        // --- Main sparse outer product loop ---
        for (unsigned row = 0; row < dim; ++row) {
            for (unsigned col = 0; col < dim; ++col) {
                // Select 1-in-2 element from {Zn1[row], Zn2[row]}
                TPDElem elem1 = (TPDElem)0;
                unsigned picked = 0;

                for (unsigned r = 0; r < 2; ++r) {
                    const unsigned bitIndex = segBase + 2 * col + r;

                    if (!picked && ctrlBit(bitIndex)) {
                        elem1 = (r == 0) ? zn1Elems[row] : zn2Elems[row];
                        picked = 1;
                    }
                }

                const TPDElem elem2 = zmElems[col];
                TPDElem sum = tile[col][row]; // same layout as FMOPA

                // ZA-targeting FP behavior: FPMulAdd_ZA(sum, elem1, elem2, FPCR)
                TPDElem prod = fplibMul(elem1, elem2, fpscr);
                TPDElem res  = fplibAdd(sum, prod, fpscr);

                // Optional fine-grain debug for first few rows/cols
                if (row < 2 && col < 2) {
                    DPRINTF(Arm,
                        "FTMOPA ZA[%u,%u]: elem1=%#x elem2=%#x "
                        "sum=%#x -> res=%#x\n",
                        (unsigned)row,
                        (unsigned)col,
                        (unsigned)elem1,
                        (unsigned)elem2,
                        (unsigned)sum,
                        (unsigned)res);
                }

                tile[col][row] = res;
            }
        }
    '''

    # Instantiate for half-precision and single-precision (non-widening)
    smeFPOPInst('ftmopa', 'Ftmopa', 'MatrixOPOp',
                ['uint16_t', 'uint32_t'],   # TPSElem (unused, but must match)
                ['uint16_t', 'uint32_t'],   # TPDElem
                ftmopaCode)

    
        # FTMOPA (widening, 2-way, FP16 -> FP32, TMOP sparse outer product)
    #
    #  - Sources: FP16 lanes in {Zn1.h, Zn2.h} and Zm.h
    #  - Destination: ZA.s (FP32)
    #  - Semantics (per element ZA[row,col]):
    #
    #        ZA[row,col] += dot( erow[0..1], ecol[0..1] )
    #
    #    where erow[0..1] come from {Zn1, Zn2} and ecol[0..1] from Zm,
    #    and 2-in-4 structure is defined by TMOP control bits in Zk.
    #
    ftmopaWideningCode = r'''
        FPSCR fpscr = (FPSCR)Fpscr;

        // --- Unpack imm (same layout as non-widening FTMOPA) ---
        const uint64_t raw    = imm;
        const uint8_t  zaTile = (raw >> 0) & 0x7;
        const uint8_t  index  = (raw >> 3) & 0x3;
        const uint8_t  znBase = (raw >> 5) & 0x1F;   // multi-vector group
        const uint8_t  zmIdx  = (raw >> 10) & 0x1F;
        const uint8_t  zkIdx  = (raw >> 15) & 0x1F;

        // ZA tile as FP32 (TPDElem is uint32_t for this widening variant)
        auto tile = getTile<TPDElem>(ZA, zaTile);

        // For widening FTMOPA:
        //
        //   - ZA is ZA.s (32-bit elements)
        //   - dim = VL / 32  (matrix is dim x dim)
        //
        // eCount is computed by smeFPOPInst as the number of TPDElem
        // elements in a vector, so here eCount == dim.
        const unsigned dim = eCount;

        // Each TMOP control segment has 4*dim bits
        // (4 bits per column: 2 positions × 2 source vectors).
        const unsigned csize   = 4 * dim;
        const unsigned segBase = index * csize;

        // --- Debug trace to confirm decode/execute wiring ---
        DPRINTF(Arm,
            "SmeFtmopaWidening: zaTile=%u index=%u znBase=%u zmIdx=%u "
            "zkIdx=%u dim=%u segBase=%u\n",
            (unsigned)zaTile,
            (unsigned)index,
            (unsigned)znBase,
            (unsigned)zmIdx,
            (unsigned)zkIdx,
            (unsigned)dim,
            (unsigned)segBase);

        // --- Read Zk (TMOP control) as bytes ---
        ArmISA::VecRegContainer zk;
        auto zkRegId = ArmISA::vecRegClass[zkIdx];
        xc->tcBase()->getReg(zkRegId, &zk);
        const uint8_t *zkBytes = zk.as<uint8_t>();

        auto ctrlBit = [&](unsigned bitIdx) -> bool {
            unsigned byte = bitIdx / 8;
            unsigned bit  = bitIdx % 8;
            return (zkBytes[byte] >> bit) & 0x1;
        };

        // --- Read Zn1, Zn2, Zm as FP16 lanes (TPSElem = uint16_t) ---
        const uint8_t zn1Idx = (uint8_t)(2 * znBase);
        const uint8_t zn2Idx = (uint8_t)(2 * znBase + 1);

        ArmISA::VecRegContainer zn1, zn2, zm;
        auto zn1RegId = ArmISA::vecRegClass[zn1Idx];
        auto zn2RegId = ArmISA::vecRegClass[zn2Idx];
        auto zmRegId  = ArmISA::vecRegClass[zmIdx];

        xc->tcBase()->getReg(zn1RegId, &zn1);
        xc->tcBase()->getReg(zn2RegId, &zn2);
        xc->tcBase()->getReg(zmRegId,  &zm);

        const TPSElem *zn1Elems = zn1.as<TPSElem>();   // FP16 bits
        const TPSElem *zn2Elems = zn2.as<TPSElem>();   // FP16 bits
        const TPSElem *zmElems  = zm.as<TPSElem>();    // FP16 bits

        // We also need FPCR rounding mode for widening conversions
        const auto rnd = FPCRRounding(fpscr);

        // --- Main sparse outer-product loop (widening) ---
        for (unsigned row = 0; row < dim; ++row) {
            // For a given row, we use two FP16 lanes per source vector:
            //   lane indices: 2*row and 2*row + 1
            const unsigned lane0 = 2 * row;
            const unsigned lane1 = 2 * row + 1;

            for (unsigned col = 0; col < dim; ++col) {
                // Columns: two FP16 lanes from Zm
                const unsigned colLane0 = 2 * col;
                const unsigned colLane1 = 2 * col + 1;

                // --- Select two FP32 row values (erow[0], erow[1]) ---
                TPDElem erow[2];

                for (unsigned e = 0; e < 2; ++e) {
                    const unsigned lane = (e == 0) ? lane0 : lane1;

                    // Pick which source vector supplies this lane:
                    //   v = 0 -> Zn1
                    //   v = 1 -> Zn2
                    //
                    // Control bits in selected segment:
                    //   bitOffset = segBase + 4*col + 2*e + v
                    TPSElem src_bits = (TPSElem)0;

                    for (unsigned v = 0; v < 2; ++v) {
                        const unsigned bitOffset =
                            segBase + 4 * col + 2 * e + v;

                        if (ctrlBit(bitOffset)) {
                            src_bits = (v == 0)
                                     ? zn1Elems[lane]
                                     : zn2Elems[lane];
                            break; // 1-in-2 for this position
                        }
                    }

                    // Widen FP16 -> FP32
                    erow[e] = fplibConvert<TPSElem, TPDElem>(
                        src_bits, rnd, fpscr);
                }

                // --- Dense column values from Zm (widened) ---
                TPSElem col_bits0 = zmElems[colLane0];
                TPSElem col_bits1 = zmElems[colLane1];

                TPDElem ecol0 = fplibConvert<TPSElem, TPDElem>(
                    col_bits0, rnd, fpscr);
                TPDElem ecol1 = fplibConvert<TPSElem, TPDElem>(
                    col_bits1, rnd, fpscr);

                // --- Accumulate dot product into ZA.s ---
                TPDElem acc = tile[col][row];

                TPDElem prod0 = fplibMul(erow[0], ecol0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                TPDElem prod1 = fplibMul(erow[1], ecol1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Optional fine trace for top-left few cells
                if (row < 2 && col < 2) {
                    DPRINTF(Arm,
                        "FTMOPA-WIDEN row=%u col=%u:\n"
                        "    FP16 src:    zn1[%u]=0x%x zn2[%u]=0x%x   zm[%u]=0x%x zm[%u]=0x%x\n"
                        "    FP32 widened: erow={0x%x,0x%x}  ecol={0x%x,0x%x}\n"
                        "    acc(before)=0x%x  acc(after)=0x%x\n",
                        row, col,
                        lane0, (unsigned)zn1Elems[lane0],
                        lane0, (unsigned)zn2Elems[lane0],
                        colLane0, (unsigned)zmElems[colLane0],
                        colLane1, (unsigned)zmElems[colLane1],
                        (unsigned)erow[0], (unsigned)erow[1],
                        (unsigned)ecol0, (unsigned)ecol1,
                        (unsigned)tile[col][row],      // BEFORE update
                        (unsigned)acc                  // AFTER update
                    );
                }

                tile[col][row] = acc;
            }
        }
    '''

    # Instantiate *widening* FTMOPA: TPSElem = uint16_t (FP16 bits),
    # TPDElem = uint32_t (FP32 bits).
    smeFPOPInst('ftmopa', 'FtmopaWidening', 'MatrixOPOp',
                ['uint16_t'], ['uint32_t'],
                ftmopaWideningCode)

    # FTMOPA (widening, 2-way, FP8 -> FP16, TMOP sparse outer product)
    #
    #   FTMOPA <ZAda>.H, {<Zn1>.B-<Zn2>.B}, <Zm>.B, <Zk>[<index>]
    #
    # Semantics (per tile element ZA[row,col].h):
    #   - Gather two FP8 row values from {Zn1, Zn2} according to TMOP control Zk
    #   - Gather two FP8 column values from Zm
    #   - Widen FP8 -> FP16, form a 2-way dot product, add to ZA[row,col]
    #
    ftmopaWideningF8Code = r'''
        FPSCR fpscr = (FPSCR)Fpscr;

        // --- Unpack imm (same layout as other FTMOPA forms) ---
        const uint64_t raw    = imm;
        const uint8_t  zaTile = (raw >> 0) & 0x7;
        const uint8_t  index  = (raw >> 3) & 0x3;
        const uint8_t  znBase = (raw >> 5) & 0x1F;   // multi-vector group
        const uint8_t  zmIdx  = (raw >> 10) & 0x1F;
        const uint8_t  zkIdx  = (raw >> 15) & 0x1F;

        // ZA tile as FP16 (TPDElem is uint16_t for this widening variant)
        auto tile = getTile<TPDElem>(ZA, zaTile);

        // For FP8->FP16 widening:
        //   - ZA is ZA.h (16-bit elements)
        //   - dim = VL / 16  (matrix is dim x dim)
        //
        // eCount is computed by smeFPOPInst as the number of TPDElem
        // elements in a vector, so here eCount == dim.
        const unsigned dim = eCount;

        // Each TMOP control segment has 4*dim bits
        // (4 bits per column: 2 source vectors x 2 row-positions)
        const unsigned csize   = 4 * dim;
        const unsigned segBase = index * csize;

        // --- Debug trace to confirm decode/execute wiring ---
        DPRINTF(Arm,
            "SmeFtmopaWideningF8: zaTile=%u index=%u znBase=%u zmIdx=%u "
            "zkIdx=%u dim=%u segBase=%u\n",
            (unsigned)zaTile,
            (unsigned)index,
            (unsigned)znBase,
            (unsigned)zmIdx,
            (unsigned)zkIdx,
            (unsigned)dim,
            (unsigned)segBase);

        // --- Read Zk (TMOP control) as bytes ---
        ArmISA::VecRegContainer zk;
        auto zkRegId = ArmISA::vecRegClass[zkIdx];
        xc->tcBase()->getReg(zkRegId, &zk);
        const uint8_t *zkBytes = zk.as<uint8_t>();

        auto ctrlBit = [&](unsigned bitIdx) -> bool {
            unsigned byte = bitIdx / 8;
            unsigned bit  = bitIdx % 8;
            return (zkBytes[byte] >> bit) & 0x1;
        };

        // --- Read Zn1, Zn2, Zm as FP8 lanes (bytes) ---
        const uint8_t zn1Idx = (uint8_t)(2 * znBase);
        const uint8_t zn2Idx = (uint8_t)(2 * znBase + 1);

        ArmISA::VecRegContainer zn1, zn2, zm;
        auto zn1RegId = ArmISA::vecRegClass[zn1Idx];
        auto zn2RegId = ArmISA::vecRegClass[zn2Idx];
        auto zmRegId  = ArmISA::vecRegClass[zmIdx];

        xc->tcBase()->getReg(zn1RegId, &zn1);
        xc->tcBase()->getReg(zn2RegId, &zn2);
        xc->tcBase()->getReg(zmRegId,  &zm);

        const uint8_t *zn1Bytes = zn1.as<uint8_t>();
        const uint8_t *zn2Bytes = zn2.as<uint8_t>();
        const uint8_t *zmBytes  = zm.as<uint8_t>();

        // Simple FP8 (byte) -> FP16 bits mapping stub:
        //   sign = 0, exponent = 15 (bias), mantissa from 8-bit code.
        // This is deliberately consistent with SmeFmopaWideningF8 so
        // tests see the same numeric behaviour.
        auto fp8_to_fp16_bits = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0;                 // preserve zero
            uint16_t mant = static_cast<uint16_t>(b & 0xFF) << 2; // 10-bit mantissa
            uint16_t exp  = 15;                   // normal exponent (not subnormal)
            return static_cast<uint16_t>((exp << 10) | mant);
        };

        auto widen = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp16_bits(b));
        };

        // --- Main sparse outer-product loop (FP8->FP16) ---
        for (unsigned row = 0; row < dim; ++row) {
            // For a given row, the FP8 layout in Zn1/2 is:
            //   lane indices: 2*row and 2*row + 1
            const unsigned lane0 = 2 * row;
            const unsigned lane1 = 2 * row + 1;

            for (unsigned col = 0; col < dim; ++col) {
                // Column-side FP8 lanes from Zm:
                //   lane indices: 2*col and 2*col + 1
                const unsigned colLane0 = 2 * col;
                const unsigned colLane1 = 2 * col + 1;

                // --- Gather two FP8 row values according to TMOP control ---
                uint8_t rowop[2] = {0, 0};
                unsigned i_sel = 0;

                for (unsigned r = 0; r < 2; ++r) {
                    const uint8_t *srcBytes = (r == 0) ? zn1Bytes : zn2Bytes;

                    for (unsigned e = 0; e < 2; ++e) {
                        const unsigned bitIndex =
                            segBase + 4 * col + 2 * r + e;
                        if (i_sel < 2 && ctrlBit(bitIndex)) {
                            unsigned lane = (e == 0) ? lane0 : lane1;
                            rowop[i_sel] = srcBytes[lane];
                            ++i_sel;
                        }
                    }
                }

                // --- Gather dense FP8 column values from Zm ---
                uint8_t colop[2];
                colop[0] = zmBytes[colLane0];
                colop[1] = zmBytes[colLane1];

                // --- Widen FP8 -> FP16 and compute 2-way dot product ---
                TPDElem acc_before = tile[col][row];
                TPDElem acc = acc_before;

                TPDElem r0 = widen(rowop[0]);
                TPDElem r1 = widen(rowop[1]);
                TPDElem c0 = widen(colop[0]);
                TPDElem c1 = widen(colop[1]);

                TPDElem prod0 = fplibMul(r0, c0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                TPDElem prod1 = fplibMul(r1, c1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Optional fine trace for top-left few cells
                if (row < 2 && col < 2) {
                    DPRINTF(Arm,
                        "FTMOPA-WIDEN-F8 row=%u col=%u:\n"
                        "    FP8 src:  rowop={0x%02x,0x%02x}  "
                        "colop={0x%02x,0x%02x}\n"
                        "    FP16 widened: r={0x%04x,0x%04x}  "
                        "c={0x%04x,0x%04x}\n"
                        "    acc(before)=0x%04x  acc(after)=0x%04x\n",
                        row, col,
                        (unsigned)rowop[0], (unsigned)rowop[1],
                        (unsigned)colop[0], (unsigned)colop[1],
                        (unsigned)r0, (unsigned)r1,
                        (unsigned)c0, (unsigned)c1,
                        (unsigned)acc_before,
                        (unsigned)acc);
                }

                tile[col][row] = acc;
            }
        }
    ''';

    # Instantiate widening FTMOPA FP8->FP16:
    #   TPSElem = uint8_t (FP8 bits), TPDElem = uint16_t (FP16 bits).
    smeFPOPInst("ftmopa", "FtmopaWideningF8", "MatrixOPOp",
                ["uint8_t"], ["uint16_t"],
                ftmopaWideningF8Code);

    # FTMOPA (widening, 4-way, FP8 -> FP32, TMOP sparse outer product)
    # FTMOPA <ZAda>.S, {<Zn1>.B-<Zn2>.B}, <Zm>.B, <Zk>[<index>]
    ftmopaWidening4WayF8F32Code = r'''
        FPSCR fpscr = (FPSCR)Fpscr;

        // --- Unpack imm (same layout as other FTMOPA forms) ---
        const uint64_t raw    = imm;
        const uint8_t  zaTile = (raw >> 0) & 0x7;
        const uint8_t  index  = (raw >> 3) & 0x3;
        const uint8_t  znBase = (raw >> 5) & 0x1F;   // multi-vector group
        const uint8_t  zmIdx  = (raw >> 10) & 0x1F;
        const uint8_t  zkIdx  = (raw >> 15) & 0x1F;

        // ZA tile as FP32 (TPDElem is uint32_t for this widening variant)
        auto tile = getTile<TPDElem>(ZA, zaTile);

        // dim = VL / 32  (matrix is dim x dim)
        // eCount (from smeFPOPInst) is exactly VL / 32 for TPDElem = uint32_t.
        const unsigned dim = eCount;

        // TMOP control:
        //   csize = VL / 4 = 8 * dim  (bits per segment)
        //   ctrl segment start = index * csize
        const unsigned csize   = 8 * dim;
        const unsigned segBase = index * csize;

        DPRINTF(Arm,
            "SmeFtmopaWidening4WayF8F32: zaTile=%u index=%u znBase=%u "
            "zmIdx=%u zkIdx=%u dim=%u segBase=%u\n",
            (unsigned)zaTile,
            (unsigned)index,
            (unsigned)znBase,
            (unsigned)zmIdx,
            (unsigned)zkIdx,
            (unsigned)dim,
            (unsigned)segBase);

        // --- Read Zk (TMOP control) as bytes ---
        ArmISA::VecRegContainer zk;
        auto zkRegId = ArmISA::vecRegClass[zkIdx];
        xc->tcBase()->getReg(zkRegId, &zk);
        const uint8_t *zkBytes = zk.as<uint8_t>();

        auto ctrlBit = [&](unsigned bitIdx) -> bool {
            unsigned byte = bitIdx / 8;
            unsigned bit  = bitIdx % 8;
            return (zkBytes[byte] >> bit) & 0x1;
        };

        // --- Read Zn1, Zn2, Zm as FP8 lanes (bytes) ---
        const uint8_t zn1Idx = (uint8_t)(2 * znBase);
        const uint8_t zn2Idx = (uint8_t)(2 * znBase + 1);

        ArmISA::VecRegContainer zn1, zn2, zm;
        auto zn1RegId = ArmISA::vecRegClass[zn1Idx];
        auto zn2RegId = ArmISA::vecRegClass[zn2Idx];
        auto zmRegId  = ArmISA::vecRegClass[zmIdx];

        xc->tcBase()->getReg(zn1RegId, &zn1);
        xc->tcBase()->getReg(zn2RegId, &zn2);
        xc->tcBase()->getReg(zmRegId,  &zm);

        const uint8_t *zn1Bytes = zn1.as<uint8_t>();
        const uint8_t *zn2Bytes = zn2.as<uint8_t>();
        const uint8_t *zmBytes  = zm.as<uint8_t>();

        // Same FP8->FP32 mapping stub as SmeFmopaWidening4WayF8F32 so
        // tests see consistent numeric behaviour.
        //
        //   sign = 0, exponent = 127 (bias), mantissa uses the 8 FP8 bits
        //   shifted into the high part of the 23-bit mantissa.
        auto fp8_to_fp32_bits = [](uint8_t b) -> uint32_t {
            if (b == 0) return 0u; // preserve zero exactly
            uint32_t mant = static_cast<uint32_t>(b & 0xFFu) << 15;
            uint32_t exp  = 127u;
            return (exp << 23) | mant;
        };

        auto widen32 = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp32_bits(b));
        };

        // --- Main sparse outer-product loop (FP8->FP32, 4-way) ---
        for (unsigned row = 0; row < dim; ++row) {

            for (unsigned col = 0; col < dim; ++col) {
                // Row and column byte indices in Zn1/2 and Zm:
                // As per ARM ASL:
                //   row bytes:   4*row + e, e=0..3
                //   column bytes:4*col + j, j=0..3
                uint8_t rowop[4] = {0, 0, 0, 0};
                uint8_t colop[4] = {0, 0, 0, 0};

                // ---- Build rowop[0..3] under TMOP 2-in-4 control ----
                //
                // For each r in {0,1} (Zn1, Zn2):
                //   Scan 4 candidates e=0..3 from bytes (4*row+e).
                //   Control bits for these are at:
                //       bitIndex = segBase + 8*col + 4*r + e
                //   Copy up to 2 bytes per r into rowop[2*r + i_sel].
                //
                for (unsigned r = 0; r < 2; ++r) {
                    const uint8_t *srcBytes = (r == 0) ? zn1Bytes : zn2Bytes;
                    unsigned i_sel = 0;

                    for (unsigned e = 0; e < 4; ++e) {
                        const unsigned bitIndex =
                            segBase + 8 * col + 4 * r + e;

                        if (i_sel < 2 && ctrlBit(bitIndex)) {
                            const unsigned lane = 4 * row + e;
                            rowop[2 * r + i_sel] = srcBytes[lane];
                            ++i_sel;
                        }
                    }
                }

                // ---- Build colop[0..3] (dense) from Zm ----
                for (unsigned j = 0; j < 4; ++j) {
                    const unsigned lane = 4 * col + j;
                    colop[j] = zmBytes[lane];
                }

                // ---- Widen FP8 -> FP32 and accumulate 4-way dot product ----
                TPDElem acc_before = tile[col][row];
                TPDElem acc = acc_before;

                for (unsigned k = 0; k < 4; ++k) {
                    TPDElem vrow = widen32(rowop[k]);
                    TPDElem vcol = widen32(colop[k]);
                    TPDElem prod = fplibMul(vrow, vcol, fpscr);
                    acc = fplibAdd(acc, prod, fpscr);
                }

                if (row < 2 && col < 2) {
                    DPRINTF(Arm,
                        "FTMOPA-WIDEN-4WAY row=%u col=%u:\n"
                        "    FP8 rowop={0x%02x,0x%02x,0x%02x,0x%02x}  "
                        "colop={0x%02x,0x%02x,0x%02x,0x%02x}\n"
                        "    acc(before)=0x%08x  acc(after)=0x%08x\n",
                        row, col,
                        (unsigned)rowop[0], (unsigned)rowop[1],
                        (unsigned)rowop[2], (unsigned)rowop[3],
                        (unsigned)colop[0], (unsigned)colop[1],
                        (unsigned)colop[2], (unsigned)colop[3],
                        (unsigned)acc_before,
                        (unsigned)acc);
                }

                tile[col][row] = acc;
            }
        }
    ''';

    # Instantiate widening FTMOPA FP8->FP32 (4-way):
    #   TPSElem = uint8_t (FP8 bits), TPDElem = uint32_t (FP32 bits).
    smeFPOPInst("ftmopa", "FtmopaWidening4WayF8F32", "MatrixOPOp",
                ["uint8_t"], ["uint32_t"],
                ftmopaWidening4WayF8F32Code);


    
    # FMOPA (widening, 2-way, FP8 -> FP16)
    # - Per-BYTE predication (p?.b)
    # - Two 8-bit lanes feed one ZA.h half (tile[j][i])
    wideningFmopxF8Code = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        // Trace once per execute so we can spot this in --debug-flags=Arm
        DPRINTF(Arm, "SmeFmopaWideningF8: ZA.h slice=%%u, eCount=%%d (fp8->fp16, 2-way)\n",
                (unsigned)imm, (int)eCount);

        // Map 0..255 -> normal FP16 in ~[1.0, ~2.0)
        // sign = 0, exponent = 15 (bias 15), mantissa = top 10 bits from the 8-bit value
        auto fp8_to_fp16_bits = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0;                 // preserve zero
            uint16_t mant = static_cast<uint16_t>(b & 0xFF) << 2; // 10-bit mantissa
            uint16_t exp  = 15;                   // normal exponent (not subnormal)
            return static_cast<uint16_t>((exp << 10) | mant);
        };

        auto mk_fp16 = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp16_bits(b));
        };

        for (int j = 0; j < eCount; ++j) {
            // NOTE: Using half-word predicate (ZA.h row) until p?.b is exposed
            if (!GpOp1_xd[j]) continue;

            for (int i = 0; i < eCount; ++i) {
                // NOTE: Using half-word predicate (ZA.h col) until p?.b is exposed
                if (!GpOp2_xd[i]) continue;

                TPDElem acc = tile[j][i];

                // Two 8-bit lanes per ZA.h half: bytes packed in AA64FpOp?_xd[*]
                for (int k = 0; k < 2; ++k) {
                    uint8_t s1 = (AA64FpOp1_xd[j] >> (8 * k)) & 0xFF; // from Zn.b
                    uint8_t s2 = (AA64FpOp2_xd[i] >> (8 * k)) & 0xFF; // from Zm.b

                    TPDElem v1 = mk_fp16(s1);
                    TPDElem v2 = mk_fp16(s2);

            #if %s
                    v2 = fplibNeg(v2);
            #endif
                    TPDElem prod = fplibMul(v1, v2, fpscr);
                    acc = fplibAdd(acc, prod, fpscr);
                }

                tile[j][i] = acc;

                // Light verification: dump a couple of cells so we see accumulation
                if (j < 2 && i < 2) {
                    DPRINTF(Arm, "ZA.h[%%d,%%d] = 0x%%04x\n", j, i, (unsigned)acc);
                }
            }
        }
    '''
    smeFPOPInst("fmopa", "FmopaWideningF8", "MatrixOPOp",
                ["uint8_t"], ["uint16_t"],
                wideningFmopxF8Code % "0")


    wideningFmopx4WayF8Code = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        // Trace once per execute so we can spot this with --debug-flags=Arm
        DPRINTF(Arm, "SmeFmopaWidening4WayF8: ZA.s slice=%u, eCount=%d (fp8->fp32, 4-way)\n",
                (unsigned)imm, (int)eCount);

        // Simple FP8 (byte) -> FP32 bits mapping stub:
        //   sign = 0, exponent = 127 (bias), mantissa places the 8 FP8 bits high in 23-bit field.
        auto fp8_to_fp32_bits = [](uint8_t b) -> uint32_t {
            if (b == 0) return 0u; // preserve zero
            uint32_t mant = static_cast<uint32_t>(b & 0xFFu) << 15; // 8 bits into high mantissa
            uint32_t exp  = 127u;                                   // normal exponent
            return (exp << 23) | mant;
        };

        auto mk_fp32 = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp32_bits(b));
        };

        for (int j = 0; j < eCount; ++j) {
            // Row gate (until per-byte p?.b exposure)
            if (!GpOp1_xd[j]) continue;

            for (int i = 0; i < eCount; ++i) {
                // Col gate (until per-byte p?.b exposure)
                if (!GpOp2_xd[i]) continue;

                TPDElem acc = tile[j][i];

                // 4-way dot product: 4 bytes from Zn.b and Zm.b form one ZA.s accumulation
                for (int k = 0; k < 4; ++k) {
                    uint8_t s1 = (AA64FpOp1_xd[j] >> (8 * k)) & 0xFF; // Zn.b
                    uint8_t s2 = (AA64FpOp2_xd[i] >> (8 * k)) & 0xFF; // Zm.b

                    TPDElem v1 = mk_fp32(s1);
                    TPDElem v2 = mk_fp32(s2);

            #if 0
                    v2 = fplibNeg(v2);
            #endif
                    TPDElem prod = fplibMul(v1, v2, fpscr);
                    acc = fplibAdd(acc, prod, fpscr);
                }

                tile[j][i] = acc;

                // Light verification
                if (j < 2 && i < 2) {
                    DPRINTF(Arm, "ZA.s[%d,%d] = 0x%08x\n", j, i, (unsigned)acc);
                }
            }
        }
    ''';

    smeFPOPInst("fmopa", "FmopaWidening4WayF8F32", "MatrixOPOp",
            ["uint8_t"], ["uint32_t"], wideningFmopx4WayF8Code)

    # FMOP4A (non-widening) Handler
    def smeFmop4aInst(name, Name, opClass, types, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index (ZAda)
            // op1 is Zn (Source 1)
            // op2 is Zm (Source 2)

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPDElem>(
                xc->tcBase());
        '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeFmop4aOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeFmop4aDeclare.subst(iop)
        exec_output += SmeDualTemplatedExecute.subst(iop) 

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    # FMOP4A (non-widening) Implementation with Debug Traces
    fmop4aCode = '''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        // Debug trace (using double backslash for safety)
        DPRINTF(Arm, "SmeFmop4a: Executing over SVL elements (eCount=%d)\\n", eCount);

        for (int j = 0; j < eCount; ++j) {
            TPDElem val1 = AA64FpOp1_xd[j]; // Zn[j]

            for (int i = 0; i < eCount; ++i) {
                TPDElem val2 = AA64FpOp2_xd[i]; // Zm[i]

                // Read current ZA value for debug
                TPDElem old_za = tile[j][i];

                // Perform Math: ZA += Zn * Zm
                TPDElem res = fplibMul(val1, val2, fpscr);
                tile[j][i] = fplibAdd(tile[j][i], res, fpscr);

                // Trace the first element (0,0) specifically
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeFmop4a[0][0]: Zn=0x%x, Zm=0x%x, OldZA=0x%x -> NewZA=0x%x\\n", val1, val2, old_za, tile[j][i]);
                }
            }
        }
    '''
    
    # Instantiate FMOP4A for float32 (TPDElem = uint32_t)
    # Note: SME2 usually treats inputs/outputs as same type for non-widening
    smeFmop4aInst('fmop4a', 'Fmop4a', 'MatrixOPOp', ['uint32_t, uint32_t'], fmop4aCode)


    # FMOP4A (widening, 4-way) Implementation
    # FMOP4A <ZAda>.S, <Zn>.B, <Zm>.B
    fmop4aWideningCode = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        // FP8 (byte) -> FP32 bits conversion stub (Reuse of existing logic)
        //   sign = 0, exponent = 127 (bias), mantissa places the 8 FP8 bits high in 23-bit field.
        auto fp8_to_fp32_bits = [](uint8_t b) -> uint32_t {
            if (b == 0) return 0u; // preserve zero
            uint32_t mant = static_cast<uint32_t>(b & 0xFFu) << 15; // 8 bits into high mantissa
            uint32_t exp  = 127u; // normal exponent
            return (exp << 23) | mant;
        };

        auto widen = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp32_bits(b));
        };

        DPRINTF(Arm, "SmeFmop4aWidening: Executing over SVL elements (eCount=%d)\n", eCount);

        // eCount is the number of 32-bit (TPDElem) elements in the vector (SVL / 4).
        // Each 32-bit element in Zn/Zm contains 4 packed FP8 values.
        for (int j = 0; j < eCount; ++j) {
            // Retrieve the j-th 32-bit container from Zn (containing 4 FP8 bytes)
            uint32_t zn_chunk = AA64FpOp1_xd[j];

            for (int i = 0; i < eCount; ++i) {
                // Retrieve the i-th 32-bit container from Zm (containing 4 FP8 bytes)
                uint32_t zm_chunk = AA64FpOp2_xd[i];

                TPDElem acc = tile[j][i];

                // 4-way accumulation
                for (int k = 0; k < 4; ++k) {
                    // Extract byte k from the 32-bit chunk
                    uint8_t n_byte = (zn_chunk >> (8 * k)) & 0xFF;
                    uint8_t m_byte = (zm_chunk >> (8 * k)) & 0xFF;

                    // Widen to FP32
                    TPDElem val1 = widen(n_byte);
                    TPDElem val2 = widen(m_byte);

                    // Multiply and Accumulate
                    TPDElem res = fplibMul(val1, val2, fpscr);
                    acc = fplibAdd(acc, res, fpscr);
                }
                
                // Write back accumulator
                tile[j][i] = acc;
                
                // Optional Debug Trace
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeFmop4aWidening[0][0]: Zn_chunk=0x%x, Zm_chunk=0x%x, NewZA=0x%x\n", 
                             zn_chunk, zm_chunk, acc);
                }
            }
        }
    '''

    # Instantiate FMOP4A Widening: FP8 (uint8_t) -> FP32 (uint32_t)
    smeFmop4aInst('fmop4a_widening', 'Fmop4aWidening', 'MatrixOPOp', ['uint8_t, uint32_t'], fmop4aWideningCode)

    # FMOP4A (widening, 2-way, FP16 -> FP32) Implementation
    # FMOP4A <ZAda>.S, <Zn>.H, <Zm>.H
    fmop4aWideningF16Code = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        DPRINTF(Arm, "SmeFmop4aWideningF16: Executing over SVL elements (eCount=%d)\n", eCount);

        // Access Source Registers (Zn, Zm) as FP16 (uint16_t)
        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[op2], &zm);
        const TPSElem *zn_ptr = zn.as<TPSElem>();
        const TPSElem *zm_ptr = zm.as<TPSElem>();

        // eCount is the number of 32-bit (TPDElem) elements in the vector (SVL / 4).
        // The loop iterates over the destination tile dimensions (FP32).
        for (int j = 0; j < eCount; ++j) {
            // For 2-way widening, we consume 2 FP16 elements for every 1 FP32 row.
            // Row j corresponds to Zn indices [2*j] and [2*j + 1].
            TPSElem zn0 = zn_ptr[2 * j];
            TPSElem zn1 = zn_ptr[2 * j + 1];

            // Convert inputs to FP32
            TPDElem val_n0 = fplibConvert<TPSElem, TPDElem>(zn0, rnd, fpscr);
            TPDElem val_n1 = fplibConvert<TPSElem, TPDElem>(zn1, rnd, fpscr);

            for (int i = 0; i < eCount; ++i) {
                // Column i corresponds to Zm indices [2*i] and [2*i + 1].
                TPSElem zm0 = zm_ptr[2 * i];
                TPSElem zm1 = zm_ptr[2 * i + 1];

                // Convert inputs to FP32
                TPDElem val_m0 = fplibConvert<TPSElem, TPDElem>(zm0, rnd, fpscr);
                TPDElem val_m1 = fplibConvert<TPSElem, TPDElem>(zm1, rnd, fpscr);

                TPDElem acc = tile[j][i];

                // Accumulate first product
                TPDElem prod0 = fplibMul(val_n0, val_m0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                // Accumulate second product
                TPDElem prod1 = fplibMul(val_n1, val_m1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Write back
                tile[j][i] = acc;

                // Optional Debug Trace for top-left element
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeFmop4aWideningF16[0][0]: Zn={0x%x, 0x%x}, Zm={0x%x, 0x%x}, NewZA=0x%x\n", 
                             zn0, zn1, zm0, zm1, acc);
                }
            }
        }
    '''

    # Instantiate FMOP4A Widening: FP16 (uint16_t) -> FP32 (uint32_t)
    # Note: We pass the template types explicitly as a single string pair for the targs substitution
    smeFmop4aInst('fmop4a_widening_f16', 'Fmop4aWideningF16', 'MatrixOPOp', ['uint16_t, uint32_t'], fmop4aWideningF16Code)


    # FMOP4A (widening, 2-way, FP8 -> FP16) Implementation
    # FMOP4A <ZAda>.H, <Zn>.B, <Zm>.B
    fmop4aWideningF8ToF16Code = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;
        
        // Debug Trace
        DPRINTF(Arm, "SmeFmop4aWideningF8ToF16: Executing over SVL/2 elements (eCount=%d)\n", eCount);

        // FP8 (byte) -> FP16 bits conversion stub (Reuse of existing logic)
        // sign = 0, exponent = 15 (bias), mantissa from 8-bit code.
        auto fp8_to_fp16_bits = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0; // preserve zero
            uint16_t mant = static_cast<uint16_t>(b & 0xFF) << 2; // 10-bit mantissa
            uint16_t exp  = 15; // normal exponent (not subnormal)
            return static_cast<uint16_t>((exp << 10) | mant);
        };

        auto widen = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp16_bits(b));
        };

        // Access Source Registers (Zn, Zm) as FP8 (uint8_t)
        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[op2], &zm);
        const uint8_t *zn_ptr = zn.as<uint8_t>();
        const uint8_t *zm_ptr = zm.as<uint8_t>();

        // eCount is the number of 16-bit (TPDElem) elements in the vector (SVL / 2).
        // The loop iterates over the destination tile dimensions (FP16).
        for (int j = 0; j < eCount; ++j) {
            // For 2-way widening, we consume 2 FP8 elements for every 1 FP16 row.
            // Row j corresponds to Zn indices [2*j] and [2*j + 1].
            uint8_t n0 = zn_ptr[2 * j];
            uint8_t n1 = zn_ptr[2 * j + 1];

            // Convert inputs to FP16
            TPDElem val_n0 = widen(n0);
            TPDElem val_n1 = widen(n1);

            for (int i = 0; i < eCount; ++i) {
                // Column i corresponds to Zm indices [2*i] and [2*i + 1].
                uint8_t m0 = zm_ptr[2 * i];
                uint8_t m1 = zm_ptr[2 * i + 1];

                // Convert inputs to FP16
                TPDElem val_m0 = widen(m0);
                TPDElem val_m1 = widen(m1);

                TPDElem acc = tile[j][i];

                // Accumulate first product (n0 * m0)
                TPDElem prod0 = fplibMul(val_n0, val_m0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                // Accumulate second product (n1 * m1)
                TPDElem prod1 = fplibMul(val_n1, val_m1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Write back
                tile[j][i] = acc;

                // Optional Debug Trace for top-left element
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeFmop4aWideningF8ToF16[0][0]: Zn={0x%x, 0x%x}, Zm={0x%x, 0x%x}, NewZA=0x%x\n", 
                             n0, n1, m0, m1, acc);
                }
            }
        }
    '''

    # Instantiate FMOP4A Widening: FP8 (uint8_t) -> FP16 (uint16_t)
    smeFmop4aInst('fmop4a_widening_f8_f16', 'Fmop4aWideningF8ToF16', 'MatrixOPOp', 
                  ['uint8_t, uint16_t'], fmop4aWideningF8ToF16Code)


    # BFMOP4A (Non-widening / BFloat16) Implementation
    # BFMOP4A <ZAda>.S, <Zn>.H, <Zm>.H
    # Zm: 3 bits, Zn: 3 bits, ZAda: 1 bit
    bfmop4aCode = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        DPRINTF(Arm, "SmeBfmop4a: Executing over SVL elements (eCount=%d)\n", eCount);

        // Helper: Convert BFloat16 (uint16_t) to FP32 (uint32_t)
        // BF16 is top 16 bits of FP32.
        auto bf16_to_fp32 = [](uint16_t b) -> uint32_t {
            return static_cast<uint32_t>(b) << 16;
        };

        // Access Source Registers (Zn, Zm) as uint16_t (BF16)
        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[op2], &zm);
        const uint16_t *zn_ptr = zn.as<uint16_t>();
        const uint16_t *zm_ptr = zm.as<uint16_t>();

        // eCount is the dimension of the FP32 tile (SVL / 4).
        // Since input is BF16 (16-bit) and output is FP32 (32-bit),
        // we perform a 2-way dot product.
        // One FP32 row 'j' consumes two BF16 rows: [2*j] and [2*j+1]

        for (int j = 0; j < eCount; ++j) {
            // Get inputs for Row j from Zn (2 elements)
            uint32_t n0 = bf16_to_fp32(zn_ptr[2 * j]);
            uint32_t n1 = bf16_to_fp32(zn_ptr[2 * j + 1]);

            for (int i = 0; i < eCount; ++i) {
                // Get inputs for Column i from Zm (2 elements)
                uint32_t m0 = bf16_to_fp32(zm_ptr[2 * i]);
                uint32_t m1 = bf16_to_fp32(zm_ptr[2 * i + 1]);

                TPDElem acc = tile[j][i];

                // 2-way Dot Product Accumulation
                // acc += n0 * m0
                TPDElem prod0 = fplibMul(n0, m0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                // acc += n1 * m1
                TPDElem prod1 = fplibMul(n1, m1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Write back
                tile[j][i] = acc;

                // Optional Debug Trace
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeBfmop4a[0][0]: Zn_bf16={0x%x, 0x%x}, Zm_bf16={0x%x, 0x%x}, NewZA=0x%x\n",
                             zn_ptr[2*j], zn_ptr[2*j+1],
                             zm_ptr[2*i], zm_ptr[2*i+1], acc);
                }
            }
        }
    '''

    # Instantiate BFMOP4A:
    #   TPSElem (Source) = uint16_t (representing BF16)
    #   TPDElem (Dest)   = uint32_t (FP32)
    smeFmop4aInst('bfmop4a', 'Bfmop4a', 'MatrixOPOp', ['uint16_t, uint32_t'], bfmop4aCode)

    bfmop4aWideningCode = r'''
        // imm packing:
        // [1:0] da, [3:2] nreg, [5:4] mreg
        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = (imm >> 2) & 0x3;
        const uint8_t mreg = (imm >> 4) & 0x3;

        auto tile = getTile<TPDElem>(ZA, da);
        FPSCR fpscr = (FPSCR) Fpscr;

        // BF16 -> FP32 bits (top 16 bits)
        auto bf16_to_fp32 = [](uint16_t b) -> uint32_t {
            return static_cast<uint32_t>(b) << 16;
        };

        // eCount = number of FP32 elements per vector (SVL/4 bytes)
        // Widening algorithm uses half-vectors, so dim = eCount/2
        const int dim = eCount / 2;

        DPRINTF(Arm, "SmeBfmop4aWidening: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u\n",
                da, nreg, mreg, eCount, dim, (unsigned)op1, (unsigned)op2);

        for (int outprod = 0; outprod < 4; ++outprod) {
            const int row_hv = outprod / 2;   // 0 or 1
            const int col_hv = outprod % 2;   // 0 or 1
            const int row_base = row_hv * dim;
            const int col_base = col_hv * dim;

            const RegIndex zn_sel = op1 + (nreg - 1) * col_hv;
            const RegIndex zm_sel = op2 + (mreg - 1) * row_hv;

            ArmISA::VecRegContainer zn, zm;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_sel], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zm_sel], &zm);

            const uint16_t *zn_ptr = zn.as<uint16_t>();
            const uint16_t *zm_ptr = zm.as<uint16_t>();

            for (int row = 0; row < dim; ++row) {
                for (int col = 0; col < dim; ++col) {
                    const int row_idx = row_base + row;
                    const int col_idx = col_base + col;

                    // Read BF16 pairs
                    const uint32_t erow_0 = bf16_to_fp32(zn_ptr[2 * row_idx + 0]);
                    const uint32_t erow_1 = bf16_to_fp32(zn_ptr[2 * row_idx + 1]);
                    const uint32_t ecol_0 = bf16_to_fp32(zm_ptr[2 * col_idx + 0]);
                    const uint32_t ecol_1 = bf16_to_fp32(zm_ptr[2 * col_idx + 1]);

                    TPDElem acc = tile[row_idx][col_idx];

                    TPDElem prod0 = fplibMul(erow_0, ecol_0, fpscr);
                    acc = fplibAdd(acc, prod0, fpscr);

                    TPDElem prod1 = fplibMul(erow_1, ecol_1, fpscr);
                    acc = fplibAdd(acc, prod1, fpscr);

                    tile[row_idx][col_idx] = acc;

                    // Print one element from each quadrant:
                    // (0,0), (0,dim), (dim,0), (dim,dim)
                    if ((row_idx == 0   && col_idx == 0)   ||
                        (row_idx == 0   && col_idx == dim) ||
                        (row_idx == dim && col_idx == 0)   ||
                        (row_idx == dim && col_idx == dim)) {

                        DPRINTF(Arm,
                            "SmeBfmop4aWidening[%d][%d] outprod=%d zn=z%u zm=z%u "
                            "Zn_bf16={0x%x,0x%x} Zm_bf16={0x%x,0x%x} NewZA=0x%x\n",
                            row_idx, col_idx, outprod, (unsigned)zn_sel, (unsigned)zm_sel,
                            zn_ptr[2*row_idx + 0], zn_ptr[2*row_idx + 1],
                            zm_ptr[2*col_idx + 0], zm_ptr[2*col_idx + 1],
                            acc);
                    }
                }
            }
        }
    '''

    smeFmop4aInst('bfmop4a_widening', 'Bfmop4aWidening',
              'MatrixOPOp', ['uint16_t, uint32_t'], bfmop4aWideningCode)



    # LD1B
    smeLd1xInst('ld1b', 'Ld1b', 'MemReadOp', ['uint8_t'])

    # LD1D
    smeLd1xInst('ld1d', 'Ld1d', 'MemReadOp', ['uint64_t'])

    # LD1H
    smeLd1xInst('ld1h', 'Ld1h', 'MemReadOp', ['uint16_t'])

    # LD1Q
    smeLd1xInst('ld1q', 'Ld1q', 'MemReadOp', ['__uint128_t'])

    # LD1W
    smeLd1xInst('ld1w', 'Ld1w', 'MemReadOp', ['uint32_t'])

    # LDR
    smeLdrInst("ldr", "Ldr", 'MemReadOp')

    # MOV (tile to vector) - ALIAS; see MOVA
    # MOV (vector to tile) - ALIAS; see MOVA
    # MOVA (tile to vector)
    smeMovaExtractInst("mova", "MovaExtract", 'MatrixMovOp',
                      ["uint8_t", "uint16_t", "uint32_t", "uint64_t",
                      "__uint128_t"])

    # MOVA (vector to tile)
    smeMovaInsertInst("mova", "MovaInsert", 'MatrixMovOp',
                      ["uint8_t", "uint16_t", "uint32_t", "uint64_t",
                      "__uint128_t"])

    # MOVA (vector to tile, two registers) — FEAT_SME2
    smeMovaVecToTile2RegsInst("mova", "MovaVecToTile2Regs", "MatrixMovOp")

    # MOVA (tile to vector, two registers) — FEAT_SME2
    smeMovaTileToVec2RegsInst("mova", "MovaTileToVec2Regs", "MatrixMovOp")

    # MOVA (tile to vector, four registers)
    smeMovaTileToVec4RegsInst("mova", "MovaTileToVec4Regs", "MatrixMovOp")

    # MOVA (array to vector, four registers)
    smeMovaArrayToVec4RegsInst("mova_arr", "MovaArrayToVec4Regs", "MatrixMovOp")

    # MOVA (array to vector, two registers)
    smeMovaArrayToVec2RegsInst("mova_arr_2reg", "MovaArrayToVec2Regs", "MatrixMovOp")

    # MOVA (vector to array, four registers)
    smeMovaVecToArray4RegsInst("mova_vec2arr", "MovaVecToArray4Regs", "MatrixMovOp")

    # MOVA (vector to array, two registers)
    smeMovaVecToArray2RegsInst("mova_vec2arr_2reg", "MovaVecToArray2Regs", "MatrixMovOp")

    # MOVA (vector to tile, four registers)
    smeMovaVecToTile4RegsInst("mova_v2t", "MovaVecToTile4Regs", "MatrixMovOp")

    # MOVAZ (array to vector, four registers)
    smeMovazArrayToVec4RegsInst("movaz_arr", "MovazArrayToVec4Regs", "MatrixMovOp")

    # MOVAZ (array to vector, two registers)
    smeMovazArrayToVec2RegsInst("movaz_arr_2reg", "MovazArrayToVec2Regs", "MatrixMovOp")

    # UCVTF (multi-vector, 2-reg and 4-reg) — FEAT_SME2
    ucvtfCode = r'''
        // SME2 multi-vector UCVTF: unsigned int32 lanes -> FP32 (result bits in Z regs)
        FPSCR fpscr = (FPSCR)Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        // Imm layout:
        //   [ 4:0]  d_group (Zd)
        //   [ 8:5]  n_group (Zn - 4 bits)
        //   [10]    nreg_code
        const uint32_t raw = (uint32_t)imm;
        const uint32_t d_group   = (raw >> 0) & 0x1F;
        
        // --- CHANGE HERE: Mask must be 0x0F (4 bits), not 0x1F ---
        const uint32_t n_group   = (raw >> 5) & 0x0F; 
        
        // --- CHANGE HERE: Mask should be 0x1 (1 bit) to match decoder ---
        const uint32_t nreg_code = (raw >> 10) & 0x1; 
        
        const uint32_t nreg      = (nreg_code == 0) ? 2 : 4;

        // Calculate base register indices
        // Logic: The instruction field contains GroupIndex.
        // For 2-reg, Register = Field * 2. For 4-reg, Register = Field * 4.
        const uint32_t zd_base = d_group * nreg;
        const uint32_t zn_base = n_group * nreg;

        const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements = VL_bytes / 4;

        for (uint32_t r = 0; r < nreg; ++r) {
            const uint32_t zn_idx = zn_base + r;
            const uint32_t zd_idx = zd_base + r;

            ArmISA::VecRegContainer zn, zd;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_idx], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);
            
            // Treat input as unsigned 32-bit integers
            const uint32_t *in  = (const uint32_t*)zn.as<uint8_t>();
            uint32_t *out       = (uint32_t*)zd.as<uint8_t>();

            for (uint32_t e = 0; e < elements; ++e) {
                // Zero-extend 32-bit unsigned to 64-bit for conversion
                uint64_t op = (uint64_t)in[e];
                
                // fplibFixedToFP: 3rd arg 'unsigned' = true
                out[e] = ArmISA::fplibFixedToFP<uint32_t>(op, 0, true, rnd, fpscr);
            }

            xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
        }
    '''
    smeCvtMvInst("ucvtf", "UcvtfMv", "SimdFloatCvtOp", ucvtfCode)

    # SCVTF (multi-vector, 2-reg and 4-reg) — FEAT_SME2
    scvtfCode = r'''
        // SME2 multi-vector SCVTF: signed int32 lanes -> FP32
        FPSCR fpscr = (FPSCR)Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        // Imm layout (Same as UCVTF):
        //   [ 4:0]  d_group (Zd)
        //   [ 8:5]  n_group (Zn - 4 bits)
        //   [10]    nreg_code
        const uint32_t raw = (uint32_t)imm;
        const uint32_t d_group   = (raw >> 0) & 0x1F;
        const uint32_t n_group   = (raw >> 5) & 0x0F; 
        const uint32_t nreg_code = (raw >> 10) & 0x1; 
        const uint32_t nreg      = (nreg_code == 0) ? 2 : 4;

        const uint32_t zd_base = d_group * nreg;
        const uint32_t zn_base = n_group * nreg;

        const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements = VL_bytes / 4;

        for (uint32_t r = 0; r < nreg; ++r) {
            const uint32_t zn_idx = zn_base + r;
            const uint32_t zd_idx = zd_base + r;

            ArmISA::VecRegContainer zn, zd;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_idx], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);
            
            // Read input as raw 32-bit values
            const uint32_t *in  = (const uint32_t*)zn.as<uint8_t>();
            uint32_t *out       = (uint32_t*)zd.as<uint8_t>();

            for (uint32_t e = 0; e < elements; ++e) {
                uint64_t op = (uint64_t)in[e];
                
                // CHANGE FOR SCVTF:
                // 3rd argument 'unsigned' set to FALSE.
                // This tells the library to treat the input 'op' bits as signed int32.
                out[e] = ArmISA::fplibFixedToFP<uint32_t>(op, 0, false, rnd, fpscr);
            }

            xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
        }
    '''

    smeCvtMvInst("scvtf", "ScvtfMv", "SimdFloatCvtOp", scvtfCode)

    # FCVTZU (multi-vector, 2-reg and 4-reg) — FEAT_SME2
    fcvtzuCode = r'''
        // SME2 multi-vector FCVTZU: FP32 -> unsigned int32 (Rounding toward zero)
        FPSCR fpscr = (FPSCR)Fpscr;

        const uint32_t raw = (uint32_t)imm;
        const uint32_t d_group   = (raw >> 0) & 0x1F;
        const uint32_t n_group   = (raw >> 5) & 0x0F; 
        const uint32_t nreg_code = (raw >> 10) & 0x1; 
        const uint32_t nreg      = (nreg_code == 0) ? 2 : 4;

        const uint32_t zd_base = d_group * nreg;
        const uint32_t zn_base = n_group * nreg;

        const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements = VL_bytes / 4;

        for (uint32_t r = 0; r < nreg; ++r) {
            const uint32_t zn_idx = zn_base + r;
            const uint32_t zd_idx = zd_base + r;

            ArmISA::VecRegContainer zn, zd;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_idx], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);
            
            const uint32_t *in  = (const uint32_t*)zn.as<uint8_t>();
            uint32_t *out       = (uint32_t*)zd.as<uint8_t>();

            for (uint32_t e = 0; e < elements; ++e) {
                uint32_t op = in[e];
                
                // FIX: Specify <InputType, OutputType> explicitly
                // <uint32_t (float bits), uint32_t (dest integer)>
                out[e] = ArmISA::fplibFPToFixed<uint32_t, uint32_t>(
                    op, 0, true, FPRounding_ZERO, fpscr);
            }

            xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
        }
    '''
    
    smeCvtMvInst("fcvtzu", "FcvtzuMv", "SimdFloatCvtOp", fcvtzuCode)

    
    # FCVTZS (multi-vector, 2-reg and 4-reg) — FEAT_SME2
    fcvtzsCode = r'''
        // SME2 multi-vector FCVTZS: FP32 -> signed int32 (Rounding toward zero)
        FPSCR fpscr = (FPSCR)Fpscr;

        // Imm layout:
        //   [ 4:0]  d_group (Zd)
        //   [ 8:5]  n_group (Zn)
        //   [10]    nreg_code
        const uint32_t raw = (uint32_t)imm;
        const uint32_t d_group   = (raw >> 0) & 0x1F;
        const uint32_t n_group   = (raw >> 5) & 0x0F; 
        const uint32_t nreg_code = (raw >> 10) & 0x1; 
        const uint32_t nreg      = (nreg_code == 0) ? 2 : 4;

        const uint32_t zd_base = d_group * nreg;
        const uint32_t zn_base = n_group * nreg;

        const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements = VL_bytes / 4;

        for (uint32_t r = 0; r < nreg; ++r) {
            const uint32_t zn_idx = zn_base + r;
            const uint32_t zd_idx = zd_base + r;

            ArmISA::VecRegContainer zn, zd;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_idx], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);
            
            // Input:  Float (treated as uint32_t bits)
            // Output: SIGNED Int32
            const uint32_t *in  = (const uint32_t*)zn.as<uint8_t>();
            int32_t *out        = (int32_t*)zd.as<uint8_t>();

            for (uint32_t e = 0; e < elements; ++e) {
                uint32_t op = in[e];
                
                // fplibFPToFixed args: (op, fbits, unsigned, rounding, fpscr)
                // We use <uint32_t, int32_t> to specify Input=RawBits, Output=Signed
                out[e] = ArmISA::fplibFPToFixed<uint32_t, int32_t>(
                    op, 0, false, FPRounding_ZERO, fpscr);
            }

            xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
        }
    '''

    smeCvtMvInst("fcvtzs", "FcvtzsMv", "SimdFloatCvtOp", fcvtzsCode)


    # FCVT (Narrowing, FP16 to FP8) — FEAT_SME2 + FEAT_FP8
    #
    # Instruction: FCVT <Zd>.B, { <Zn1>.H - <Zn2>.H }
    # Behavior: Converts two FP16 vectors (Zn, Zn+1) into one FP8 vector (Zd).
    #           Results from Zn1 go to the lower half of Zd.
    #           Results from Zn2 go to the upper half of Zd.
    
    fcvtNarrowingFp16Fp8Code = r'''
        FPSCR fpscr = (FPSCR)Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        // Immediate Unpacking:
        // [4:0] Zd (Destination)
        // [9:5] Zn (Source Base)
        // Note: The decoder packs these fields into 'imm' for us.
        const uint32_t raw    = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F; 
        const uint32_t zn_idx = (raw >> 5) & 0x1F; 

        // Source registers: Pair (Zn, Zn+1)
        const uint32_t zn1_idx = zn_idx;
        const uint32_t zn2_idx = zn_idx + 1;

        // Calculate Vector Length
        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        // Source is FP16 (2 bytes per element)
        // We process 'elements' number of items from EACH source vector.
        const uint32_t elements = VL_bytes / 2;

        // Access Registers
        ArmISA::VecRegContainer zn1, zn2, zd;
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn1_idx], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn2_idx], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);

        // Pointers to data (Input=uint16_t, Output=uint8_t)
        const uint16_t *in1 = (const uint16_t*)zn1.as<uint8_t>();
        const uint16_t *in2 = (const uint16_t*)zn2.as<uint8_t>();
        uint8_t *out = (uint8_t*)zd.as<uint8_t>();

        // Execution Loop
        for (uint32_t e = 0; e < elements; ++e) {
            uint16_t val1 = in1[e];
            uint16_t val2 = in2[e];

            // Convert FP16 -> FP8
            // Using fplibConvert helper (Specialized for uint16->uint8 in fplib.cc)
            uint8_t res1 = ArmISA::fplibConvert<uint16_t, uint8_t>(val1, rnd, fpscr);
            uint8_t res2 = ArmISA::fplibConvert<uint16_t, uint8_t>(val2, rnd, fpscr);

            // Pack into Zd:
            // Lower half [0..elements-1] gets result from Zn1
            // Upper half [elements..2*elements-1] gets result from Zn2
            out[e] = res1;
            out[elements + e] = res2;
        }

        // Write back result
        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    # Register the instruction generator
    # Name: fcvt_fp16_fp8
    # Class: FcvtFp16Fp8 (Matches the class name we used in formats/sme.isa)
    # OpClass: SimdFloatCvtOp
    smeCvtMvInst("fcvt_fp16_fp8", "FcvtFp16Fp8", "SimdFloatCvtOp", fcvtNarrowingFp16Fp8Code)

    # FCVT (narrowing, FP32 to FP16) — FEAT_SME2
    #
    # Instruction: FCVT <Zd>.H, { <Zn1>.S - <Zn2>.S }
    # Behavior: Converts two FP32 vectors (Zn, Zn+1) into one FP16 vector (Zd)
    #
    fcvtNarrowingFp32Fp16Code = r'''
        FPSCR fpscr = (FPSCR)Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        // Immediate Unpacking:
        // [4:0] Zd (Destination)
        // [9:5] Zn (Source Base)
        const uint32_t raw    = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F; 
        const uint32_t zn_idx = (raw >> 5) & 0x1F; 

        // Source registers: Pair (Zn, Zn+1)
        const uint32_t zn1_idx = zn_idx;
        const uint32_t zn2_idx = zn_idx + 1;

        // Calculate Vector Length
        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        // Source is FP32 (4 bytes per element)
        const uint32_t elements = VL_bytes / 4;

        // Access Registers
        ArmISA::VecRegContainer zn1, zn2, zd;
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn1_idx], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn2_idx], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);

        // Pointers to data (Input=uint32_t, Output=uint16_t)
        const uint32_t *in1 = (const uint32_t*)zn1.as<uint8_t>();
        const uint32_t *in2 = (const uint32_t*)zn2.as<uint8_t>();
        uint16_t *out = (uint16_t*)zd.as<uint8_t>();

        // Execution Loop
        for (uint32_t e = 0; e < elements; ++e) {
            uint32_t val1 = in1[e];
            uint32_t val2 = in2[e];

            // Convert FP32 -> FP16
            // Using standard fplibConvert helper
            uint16_t res1 = ArmISA::fplibConvert<uint32_t, uint16_t>(val1, rnd, fpscr);
            uint16_t res2 = ArmISA::fplibConvert<uint32_t, uint16_t>(val2, rnd, fpscr);

            // Pack into Zd:
            // Lower half [0..elements-1] gets result from Zn1
            // Upper half [elements..2*elements-1] gets result from Zn2
            out[e] = res1;
            out[elements + e] = res2;
        }

        // Write back result
        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("fcvt_fp32_fp16", "FcvtFp32Fp16", "SimdFloatCvtOp", fcvtNarrowingFp32Fp16Code)

    
    # FCVT (Narrowing, FP32 to FP8) — FEAT_SME2 + FEAT_FP8
    #
    # Instruction: FCVT <Zd>.B, { <Zn1>.S - <Zn4>.S }
    # Behavior: Converts four FP32 vectors (Zn..Zn+3) into one FP8 vector (Zd).
    #           This is a 4:1 compression.
    
    fcvtNarrowingFp32Fp8Code = r'''
        FPSCR fpscr = (FPSCR)Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        // Immediate Unpacking:
        // [4:0] Zd (Destination)
        // [9:5] Zn (Source Base) - 4-register group
        const uint32_t raw    = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F; 
        const uint32_t zn_idx = (raw >> 5) & 0x1F; 

        // Calculate Vector Length
        // Source is FP32 (4 bytes).
        // For VL=128 bits, Source Elements = 4 per vector.
        // Total Dest Elements (FP8) = 16.
        // 4 source vectors * 4 elements = 16 dest elements. Perfect fit.
        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements_per_vec = VL_bytes / 4; 

        // Access Destination Register
        ArmISA::VecRegContainer zd;
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);
        uint8_t *out = (uint8_t*)zd.as<uint8_t>();

        // Loop over the 4 source registers
        for (int r = 0; r < 4; ++r) {
            const uint32_t curr_zn_idx = zn_idx + r;
            
            // Access Source Register
            ArmISA::VecRegContainer zn;
            xc->tcBase()->getReg(ArmISA::vecRegClass[curr_zn_idx], &zn);
            const uint32_t *in = (const uint32_t*)zn.as<uint8_t>();

            // Process elements for this vector
            for (uint32_t e = 0; e < elements_per_vec; ++e) {
                uint32_t val = in[e];

                // Convert FP32 -> FP8
                // Using fplibConvert specialized for uint32->uint8
                uint8_t res = ArmISA::fplibConvert<uint32_t, uint8_t>(val, rnd, fpscr);

                // Pack into Zd:
                // Offset = (r * elements_per_vec) + e
                out[(r * elements_per_vec) + e] = res;
            }
        }

        // Write back result
        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    # Register the instruction generator
    # Name: fcvt_fp32_fp8
    # Class: FcvtFp32Fp8
    smeCvtMvInst("fcvt_fp32_fp8", "FcvtFp32Fp8", "SimdFloatCvtOp", fcvtNarrowingFp32Fp8Code)

    # FCVTN (Narrowing, FP32 to FP8) — FEAT_SME2 + FEAT_FP8
    # Functionally identical to FCVT (FP32->FP8), just a different mnemonic/encoding.
    # We reuse fcvtNarrowingFp32Fp8Code.
    # Resulting Class: SmeFcvtnFp32Fp8
    smeCvtMvInst("fcvtn_fp32_fp8", "FcvtnFp32Fp8", "SimdFloatCvtOp", fcvtNarrowingFp32Fp8Code)

    # FCVTN (Narrowing, FP32 to FP16)
    # Reuses the exact same logic code: fcvtNarrowingFp32Fp16Code
    smeCvtMvInst("fcvtn_fp32_fp16", "FcvtnFp32Fp16", "SimdFloatCvtOp", fcvtNarrowingFp32Fp16Code)


    # BFCVT (BFloat16 to 8-bit floating-point)
    #
    # Instruction: BFCVT <Zd>.B, { <Zn1>.H - <Zn2>.H }
    # Behavior: Converts pairs of BFloat16 vectors to one FP8 vector.
    # Logic: BFloat16 bits -> FP32 bits -> FP8 Conversion
    
    bfcvtCode = r'''
        FPSCR fpscr = (FPSCR)Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        // Immediate Unpacking (Same as FCVT)
        const uint32_t raw    = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F; 
        const uint32_t zn_idx = (raw >> 5) & 0x1F; 

        const uint32_t zn1_idx = zn_idx;
        const uint32_t zn2_idx = zn_idx + 1;

        // VL is in bytes. Elements are 16-bit (2 bytes).
        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements = VL_bytes / 2;

        ArmISA::VecRegContainer zn1, zn2, zd;
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn1_idx], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn2_idx], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);

        const uint16_t *in1 = (const uint16_t*)zn1.as<uint8_t>();
        const uint16_t *in2 = (const uint16_t*)zn2.as<uint8_t>();
        uint8_t *out = (uint8_t*)zd.as<uint8_t>();

        // Helper: BFloat16 -> FP32 (bits)
        auto bf16_to_fp32 = [](uint16_t b) -> uint32_t {
            return (uint32_t)b << 16;
        };

        for (uint32_t e = 0; e < elements; ++e) {
            // Expand BFloat16 to FP32
            uint32_t val1_32 = bf16_to_fp32(in1[e]);
            uint32_t val2_32 = bf16_to_fp32(in2[e]);

            // Convert FP32 -> FP8 (Using existing helper)
            // Note: We use <uint32_t, uint8_t> specialization
            uint8_t res1 = ArmISA::fplibConvert<uint32_t, uint8_t>(val1_32, rnd, fpscr);
            uint8_t res2 = ArmISA::fplibConvert<uint32_t, uint8_t>(val2_32, rnd, fpscr);

            // Pack interleaved
            out[e] = res1;
            out[elements + e] = res2;
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    # Register the instruction
    smeCvtMvInst("bfcvt", "Bfcvt", "SimdFloatCvtOp", bfcvtCode)

    # BFCVT (Single-precision to BFloat16)
    # Instruction: BFCVT <Zd>.H, { <Zn1>.S - <Zn2>.S }
    # Behavior: Converts two FP32 vectors to one interleaved BFloat16 vector.
    
    bfcvtFp32Bf16Code = r'''
        
        const uint32_t raw    = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F; 
        const uint32_t zn_idx = (raw >> 5) & 0x1F; 

        // Source is 2 registers (Zn, Zn+1)
        const uint32_t zn1_idx = zn_idx;
        const uint32_t zn2_idx = zn_idx + 1;

        // Source vector length (in bytes). Elements are FP32 (4 bytes).
        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements = VL_bytes / 4;

        ArmISA::VecRegContainer zn1, zn2, zd;
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn1_idx], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn2_idx], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);

        // Input: FP32 (uint32_t bits)
        const uint32_t *in1 = (const uint32_t*)zn1.as<uint8_t>();
        const uint32_t *in2 = (const uint32_t*)zn2.as<uint8_t>();
        
        // Output: BFloat16 (uint16_t bits)
        uint16_t *out = (uint16_t*)zd.as<uint8_t>();

        // Helper: FP32 -> BFloat16 Conversion
        // Standard behavior: Round to nearest even on the 16th bit position.
        auto fp32_to_bf16 = [](uint32_t val) -> uint16_t {
            if ((val & 0x7FFFFFFF) == 0) return 0; // +/- Zero
            if ((val & 0x7F800000) == 0x7F800000) return val >> 16; // Inf/NaN

            // Rounding Logic: Add 0x7FFF + (LSB & 1) to mantissa before shift
            // LSB of BF16 is bit 16 of FP32.
            uint32_t lsb = (val >> 16) & 1;
            uint32_t rounding_bias = 0x7FFF + lsb;
            return (uint16_t)((val + rounding_bias) >> 16);
        };

        for (uint32_t e = 0; e < elements; ++e) {
            uint16_t res1 = fp32_to_bf16(in1[e]);
            uint16_t res2 = fp32_to_bf16(in2[e]);

            // Pack interleaved: Lower half = Zn1, Upper half = Zn2
            out[e] = res1;
            out[elements + e] = res2;
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    # Register the instruction
    # Name: bfcvt_fp32_bf16
    # Class: SmeBfcvtFp32Bf16 (matches decoder return)
    smeCvtMvInst("bfcvt_fp32_bf16", "BfcvtFp32Bf16", "SimdFloatCvtOp", bfcvtFp32Bf16Code)

    # BFCVTN (Narrowing, FP32 to BFloat16)
    # Instruction: BFCVTN <Zd>.H, { <Zn1>.S - <Zn2>.S }
    # Behavior: Converts two FP32 vectors to one interleaved BFloat16 vector.
    # Logic: Reuses the logic from BFCVT (FP32->BF16) provided in Part 4.
    
    # BFCVTN (Narrowing, FP32 to BFloat16)
    bfcvtnCode = r'''
        
        // BFloat16 usually implies Round-to-Nearest-Even on the 16th bit

        // Immediate Unpacking
        const uint32_t raw    = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t zn_idx = (raw >> 5) & 0x1F;

        // Source is 2 registers (Zn, Zn+1)
        const uint32_t zn1_idx = zn_idx;
        const uint32_t zn2_idx = zn_idx + 1;

        // Source vector length (in bytes). Elements are FP32 (4 bytes).
        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements = VL_bytes / 4;

        ArmISA::VecRegContainer zn1, zn2, zd;
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn1_idx], &zn1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zn2_idx], &zn2);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);

        // Input: FP32 (uint32_t bits)
        const uint32_t *in1 = (const uint32_t*)zn1.as<uint8_t>();
        const uint32_t *in2 = (const uint32_t*)zn2.as<uint8_t>();

        // Output: BFloat16 (uint16_t bits)
        uint16_t *out = (uint16_t*)zd.as<uint8_t>();

        // Helper: FP32 -> BFloat16 Conversion
        auto fp32_to_bf16 = [](uint32_t val) -> uint16_t {
            if ((val & 0x7FFFFFFF) == 0) return 0; // +/- Zero
            if ((val & 0x7F800000) == 0x7F800000) return val >> 16; // Inf/NaN

            // Rounding Logic: Add 0x7FFF + (LSB & 1) to mantissa before shift
            uint32_t lsb = (val >> 16) & 1;
            uint32_t rounding_bias = 0x7FFF + lsb;
            return (uint16_t)((val + rounding_bias) >> 16);
        };

        for (uint32_t e = 0; e < elements; ++e) {
            uint16_t res1 = fp32_to_bf16(in1[e]);
            uint16_t res2 = fp32_to_bf16(in2[e]);

            // Pack interleaved: Lower half = Zn1, Upper half = Zn2
            out[e] = res1;
            out[elements + e] = res2;
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("bfcvtn", "Bfcvtn", "SimdFloatCvtOp", bfcvtnCode)

    # FCVTL (Widening, FP16 -> De-interleaved FP32)
    fcvtlCode = r'''
        FPSCR fpscr = (FPSCR)Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        // Immediate Unpacking
        const uint32_t raw     = (uint32_t)imm;
        const uint32_t d_group = (raw >> 0) & 0xF;   // 4 bits
        const uint32_t n_idx   = (raw >> 4) & 0x1F;  // 5 bits (Zn)

        // Destination registers: Pair (Zd, Zd+1)
        // d_group is the "pair index", so actual reg index is d_group * 2
        const uint32_t zd1_idx = d_group * 2;
        const uint32_t zd2_idx = zd1_idx + 1;

        // Calculate Vector Length (Output is FP32)
        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        const uint32_t eCount   = VL_bytes / 4; // Number of FP32 elements

        // Access Registers
        ArmISA::VecRegContainer zn, zd1, zd2;
        xc->tcBase()->getReg(ArmISA::vecRegClass[n_idx], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd2_idx], &zd2);

        const uint16_t *in = (const uint16_t*)zn.as<uint8_t>();
        uint32_t *out1 = (uint32_t*)zd1.as<uint8_t>();
        uint32_t *out2 = (uint32_t*)zd2.as<uint8_t>();

        // Execution Loop
        for (uint32_t e = 0; e < eCount; ++e) {
            // Source indices: 2*e (even) and 2*e+1 (odd)
            uint16_t src_even = in[2 * e];
            uint16_t src_odd  = in[2 * e + 1];

            // Convert FP16 -> FP32
            uint32_t res1 = ArmISA::fplibConvert<uint16_t, uint32_t>(src_even, rnd, fpscr);
            uint32_t res2 = ArmISA::fplibConvert<uint16_t, uint32_t>(src_odd, rnd, fpscr);

            // Write de-interleaved results
            out1[e] = res1;
            out2[e] = res2;
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->setReg(ArmISA::vecRegClass[zd2_idx], &zd2);
    '''

    smeCvtMvInst("fcvtl", "Fcvtl", "SimdFloatCvtOp", fcvtlCode)

    # F1CVTL / F2CVTL (FP8 -> FP16, Bottom/Lower)
    # Instruction: F1CVTL { <Zd1>.H, <Zd2>.H }, <Zn>.B
    # Behavior: Widens FP8 to FP16.
    #           Input: 1 Vector (Zn). Output: 2 Vectors (Zd1, Zd2).
    #           "Bottom" variant selects even-numbered bytes (0, 2, 4...).
    
    fcvtlFp8Code = r'''
        // In a full model, we would read FPMR here to check F1 vs F2 format bits.
        
        const uint32_t raw     = (uint32_t)imm;
        const uint32_t d_group = (raw >> 0) & 0xF;   // Zd pair index (4 bits)
        const uint32_t n_idx   = (raw >> 4) & 0x1F;  // Zn index (5 bits)

        // Destination registers: Pair (Zd, Zd+1)
        const uint32_t zd1_idx = d_group * 2;
        const uint32_t zd2_idx = zd1_idx + 1;

        // Vector Length (Output is FP16, so 2 bytes per element)
        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        // eCount = Number of FP16 elements per output vector.
        // For VL=128 bits (16 bytes), we output 8 FP16 elements per vector.
        // Input consumed = 16 bytes (entire Zn).
        const uint32_t eCount = VL_bytes / 2; 

        ArmISA::VecRegContainer zn, zd1, zd2;
        xc->tcBase()->getReg(ArmISA::vecRegClass[n_idx], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd2_idx], &zd2);

        const uint8_t *in = zn.as<uint8_t>();
        uint16_t *out1 = (uint16_t*)zd1.as<uint8_t>();
        uint16_t *out2 = (uint16_t*)zd2.as<uint8_t>();

        // FP8 -> FP16 Conversion Stub
        auto fp8_to_fp16 = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0;
            // E5M2/E4M3 logic would go here. Simple expansion for now:
            uint16_t mant = static_cast<uint16_t>(b) << 2; 
            uint16_t exp  = 15; 
            return (exp << 10) | (mant & 0x3FF);
        };

        for (uint32_t e = 0; e < eCount; ++e) {
            // "Bottom" / De-interleave logic:
            // The input vector Zn contains interleaved elements.
            // Even indices (0, 2, 4...) -> Dest vector 1
            // Odd indices (1, 3, 5...)  -> Dest vector 2
            
            uint8_t src_even = in[2 * e];
            uint8_t src_odd  = in[2 * e + 1];

            out1[e] = fp8_to_fp16(src_even);
            out2[e] = fp8_to_fp16(src_odd);
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->setReg(ArmISA::vecRegClass[zd2_idx], &zd2);
    '''

    smeCvtMvInst("f1cvtl", "F1cvtl", "SimdFloatCvtOp", fcvtlFp8Code)
    smeCvtMvInst("f2cvtl", "F2cvtl", "SimdFloatCvtOp", fcvtlFp8Code)

    # BF1CVTL / BF2CVTL (FP8 -> BFloat16, Bottom/Lower)
    # Instruction: BF1CVTL { <Zd1>.H, <Zd2>.H }, <Zn>.B
    # Behavior: Widens FP8 to BFloat16 (de-interleaved).
    
    bfcvtlFp8Code = r'''
        // Logic requires FPMR to determine FP8 format (E5M2 vs E4M3).
        
        const uint32_t raw     = (uint32_t)imm;
        const uint32_t d_group = (raw >> 0) & 0xF;   // Zd pair index
        const uint32_t n_idx   = (raw >> 4) & 0x1F;  // Zn index

        const uint32_t zd1_idx = d_group * 2;
        const uint32_t zd2_idx = zd1_idx + 1;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        const uint32_t eCount   = VL_bytes / 2; // Output is 16-bit elements

        ArmISA::VecRegContainer zn, zd1, zd2;
        xc->tcBase()->getReg(ArmISA::vecRegClass[n_idx], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd2_idx], &zd2);

        const uint8_t *in = zn.as<uint8_t>();
        uint16_t *out1 = (uint16_t*)zd1.as<uint8_t>();
        uint16_t *out2 = (uint16_t*)zd2.as<uint8_t>();

        // FP8 -> BFloat16 Conversion Stub
        auto fp8_to_bf16 = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0;
            
            // Stub: Treat FP8 as having a small exponent and mantissa.
            // BFloat16: 1 Sign, 8 Exp, 7 Mantissa.
            // FP8 (E5M2): 1 Sign, 5 Exp, 2 Mantissa.
            // We shift bits to align roughly with BF16 format for the test.
            
            uint16_t sign = (b & 0x80) << 8;
            uint16_t exp  = (b & 0x7C) << 8; // Shift exp to BF16 position
            uint16_t mant = (b & 0x03) << 5; // Shift mantissa
            
            // Note: Real hardware does bias adjustment here.
            return sign | exp | mant;
        };

        for (uint32_t e = 0; e < eCount; ++e) {
            // De-interleave: Even -> Zd1, Odd -> Zd2
            uint8_t src_even = in[2 * e];
            uint8_t src_odd  = in[2 * e + 1];

            out1[e] = fp8_to_bf16(src_even);
            out2[e] = fp8_to_bf16(src_odd);
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->setReg(ArmISA::vecRegClass[zd2_idx], &zd2);
    '''

    # Register Instructions
    smeCvtMvInst("bf1cvtl", "Bf1cvtl", "SimdFloatCvtOp", bfcvtlFp8Code)
    smeCvtMvInst("bf2cvtl", "Bf2cvtl", "SimdFloatCvtOp", bfcvtlFp8Code)

    # BF1CVT / BF2CVT (FP8 -> BFloat16)
    # Instruction: BF1CVT { <Zd1>.H, <Zd2>.H }, <Zn>.B
    # Behavior: Reads all bytes from Zn. Converts sequentially.
    #           First half of bytes -> Zd1. Second half -> Zd2.
    
    bfcvtFp8Code = r'''
        
        const uint32_t raw     = (uint32_t)imm;
        const uint32_t d_group = (raw >> 0) & 0xF;   // Zd pair index
        const uint32_t n_idx   = (raw >> 4) & 0x1F;  // Zn index

        const uint32_t zd1_idx = d_group * 2;
        const uint32_t zd2_idx = zd1_idx + 1;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        // Zn contains VL_bytes elements (8-bit).
        // Zd1 can hold (VL_bytes / 2) 16-bit elements.
        // Zd2 can hold (VL_bytes / 2) 16-bit elements.
        // So Zn fills both Zd1 and Zd2 exactly.
        const uint32_t elements = VL_bytes; 
        const uint32_t half_elements = elements / 2;

        ArmISA::VecRegContainer zn, zd1, zd2;
        xc->tcBase()->getReg(ArmISA::vecRegClass[n_idx], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd2_idx], &zd2);

        const uint8_t *in = zn.as<uint8_t>();
        uint16_t *out1 = (uint16_t*)zd1.as<uint8_t>();
        uint16_t *out2 = (uint16_t*)zd2.as<uint8_t>();

        // FP8 -> BFloat16 Stub (Same as before)
        auto fp8_to_bf16 = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0;
            uint16_t sign = (b & 0x80) << 8;
            uint16_t exp  = (b & 0x7C) << 8; 
            uint16_t mant = (b & 0x03) << 5; 
            return sign | exp | mant;
        };

        for (uint32_t e = 0; e < elements; ++e) {
            uint16_t res = fp8_to_bf16(in[e]);
            
            if (e < half_elements) {
                // First half goes to Zd1
                out1[e] = res;
            } else {
                // Second half goes to Zd2
                out2[e - half_elements] = res;
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->setReg(ArmISA::vecRegClass[zd2_idx], &zd2);
    '''

    # Register Instructions
    smeCvtMvInst("bf1cvt", "Bf1cvt", "SimdFloatCvtOp", bfcvtFp8Code)
    smeCvtMvInst("bf2cvt", "Bf2cvt", "SimdFloatCvtOp", bfcvtFp8Code)

    # F1CVT / F2CVT (FP8 -> FP16)
    # Instruction: F1CVT { <Zd1>.H, <Zd2>.H }, <Zn>.B
    # Behavior: Reads all bytes from Zn. Converts sequentially to FP16.
    #           First half of bytes -> Zd1. Second half -> Zd2.
    
    fcvtFp8Code = r'''
        
        const uint32_t raw     = (uint32_t)imm;
        const uint32_t d_group = (raw >> 0) & 0xF;   // Zd pair index
        const uint32_t n_idx   = (raw >> 4) & 0x1F;  // Zn index

        const uint32_t zd1_idx = d_group * 2;
        const uint32_t zd2_idx = zd1_idx + 1;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        // Zn contains VL_bytes elements (8-bit).
        // Zd1 can hold (VL_bytes / 2) 16-bit elements.
        // Zd2 can hold (VL_bytes / 2) 16-bit elements.
        const uint32_t elements = VL_bytes; 
        const uint32_t half_elements = elements / 2;

        ArmISA::VecRegContainer zn, zd1, zd2;
        xc->tcBase()->getReg(ArmISA::vecRegClass[n_idx], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->getReg(ArmISA::vecRegClass[zd2_idx], &zd2);

        const uint8_t *in = zn.as<uint8_t>();
        uint16_t *out1 = (uint16_t*)zd1.as<uint8_t>();
        uint16_t *out2 = (uint16_t*)zd2.as<uint8_t>();

        // FP8 -> FP16 Conversion Stub
        // (Assumes FP8 E5M2 for simplicity of stub)
        auto fp8_to_fp16 = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0;
            
            // Extract fields from FP8 (1-5-2)
            uint16_t sign = (b & 0x80) << 8; // Bit 7 -> Bit 15
            uint16_t exp  = (b & 0x7C) << 8; // Bits 6-2 -> Bits 14-10
            uint16_t mant = (b & 0x03) << 8; // Bits 1-0 -> Bits 9-8 (Top of mantissa)
            
            return sign | exp | mant;
        };

        for (uint32_t e = 0; e < elements; ++e) {
            uint16_t res = fp8_to_fp16(in[e]);
            
            if (e < half_elements) {
                // First half goes to Zd1
                out1[e] = res;
            } else {
                // Second half goes to Zd2
                out2[e - half_elements] = res;
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd1_idx], &zd1);
        xc->tcBase()->setReg(ArmISA::vecRegClass[zd2_idx], &zd2);
    '''

    # Register Instructions
    smeCvtMvInst("f1cvt", "F1cvt", "SimdFloatCvtOp", fcvtFp8Code)
    smeCvtMvInst("f2cvt", "F2cvt", "SimdFloatCvtOp", fcvtFp8Code)

    # SQCVT (Four registers)
    # Instruction: SQCVT <Zd>.<T>, { <Zn1>.<Tb>-<Zn4>.<Tb> }
    # Behavior: Narrowing signed saturation.
    # If sz=0: 32-bit (S) -> 8-bit (B). (4 Source vectors -> 1 Dest vector)
    # If sz=1: 64-bit (D) -> 16-bit (H). (4 Source vectors -> 1 Dest vector)

    sqcvtCode = r'''
        
        const uint32_t raw = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t n_start = (raw >> 5) & 0x1F;
        const uint32_t sz = (raw >> 10) & 0x1;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        ArmISA::VecRegContainer zd;
        // We will read 4 source registers: Zn, Zn+1, Zn+2, Zn+3
        ArmISA::VecRegContainer zns[4];
        
        for (int i = 0; i < 4; ++i) {
            xc->tcBase()->getReg(ArmISA::vecRegClass[n_start + i], &zns[i]);
        }

        // Helper for Signed Saturation
        auto saturate = [](int64_t val, int64_t min_val, int64_t max_val) -> int64_t {
            if (val < min_val) return min_val;
            if (val > max_val) return max_val;
            return val;
        };

        if (sz == 0) {
            // Case: 32-bit (S) -> 8-bit (B)
            // Destination has VL bytes (VL elements of 8-bit)
            // 4 Sources have VL/4 elements of 32-bit each. Total = VL elements.
            
            uint8_t *out = zd.as<uint8_t>();
            int dest_idx = 0;

            const int64_t min_val = -128;
            const int64_t max_val = 127;

            for (int i = 0; i < 4; ++i) {
                const int32_t *src = (const int32_t*)zns[i].as<uint8_t>();
                int elements_per_vec = VL_bytes / 4;

                for (int e = 0; e < elements_per_vec; ++e) {
                    int64_t src_val = (int64_t)src[e];
                    out[dest_idx++] = (uint8_t)saturate(src_val, min_val, max_val);
                }
            }
        } else {
            // Case: 64-bit (D) -> 16-bit (H)
            // Destination has VL/2 elements of 16-bit.
            // 4 Sources have VL/8 elements of 64-bit each.
            // 4 * (VL/8) = VL/2. Matches perfectly.
            
            uint16_t *out = (uint16_t*)zd.as<uint8_t>();
            int dest_idx = 0;
            
            const int64_t min_val = -32768;
            const int64_t max_val = 32767;

            for (int i = 0; i < 4; ++i) {
                const int64_t *src = (const int64_t*)zns[i].as<uint8_t>();
                int elements_per_vec = VL_bytes / 8;

                for (int e = 0; e < elements_per_vec; ++e) {
                    int64_t src_val = src[e];
                    out[dest_idx++] = (uint16_t)saturate(src_val, min_val, max_val);
                }
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("sqcvt", "Sqcvt", "SimdFloatCvtOp", sqcvtCode)

    # SQCVTU (Four registers)
    # Instruction: SQCVTU <Zd>.<T>, { <Zn1>.<Tb>-<Zn4>.<Tb> }
    # Behavior: Narrowing Signed -> Unsigned Saturation.
    # sz=0: 32-bit Signed -> 8-bit Unsigned (0 to 255).
    # sz=1: 64-bit Signed -> 16-bit Unsigned (0 to 65535).

    sqcvtuCode = r'''
        
        const uint32_t raw = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t n_start = (raw >> 5) & 0x1F;
        const uint32_t sz = (raw >> 10) & 0x1;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        ArmISA::VecRegContainer zd;
        ArmISA::VecRegContainer zns[4];
        
        for (int i = 0; i < 4; ++i) {
            xc->tcBase()->getReg(ArmISA::vecRegClass[n_start + i], &zns[i]);
        }

        // Helper for Unsigned Saturation
        // Input is Signed (int64_t), Output is Unsigned range.
        auto saturate_unsigned = [](int64_t val, int64_t max_u_val) -> uint64_t {
            if (val < 0) return 0;
            if (val > max_u_val) return (uint64_t)max_u_val;
            return (uint64_t)val;
        };

        if (sz == 0) {
            // Case: 32-bit Signed -> 8-bit Unsigned
            // Max 8-bit Unsigned = 255
            
            uint8_t *out = zd.as<uint8_t>();
            int dest_idx = 0;
            const int64_t max_val = 255;

            for (int i = 0; i < 4; ++i) {
                const int32_t *src = (const int32_t*)zns[i].as<uint8_t>();
                int elements_per_vec = VL_bytes / 4;

                for (int e = 0; e < elements_per_vec; ++e) {
                    int64_t src_val = (int64_t)src[e];
                    out[dest_idx++] = (uint8_t)saturate_unsigned(src_val, max_val);
                }
            }
        } else {
            // Case: 64-bit Signed -> 16-bit Unsigned
            // Max 16-bit Unsigned = 65535
            
            uint16_t *out = (uint16_t*)zd.as<uint8_t>();
            int dest_idx = 0;
            const int64_t max_val = 65535;

            for (int i = 0; i < 4; ++i) {
                const int64_t *src = (const int64_t*)zns[i].as<uint8_t>();
                int elements_per_vec = VL_bytes / 8;

                for (int e = 0; e < elements_per_vec; ++e) {
                    int64_t src_val = src[e];
                    out[dest_idx++] = (uint16_t)saturate_unsigned(src_val, max_val);
                }
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("sqcvtu", "Sqcvtu", "SimdFloatCvtOp", sqcvtuCode)

    # UQCVT (Four registers)
    # Instruction: UQCVT <Zd>.<T>, { <Zn1>.<Tb>-<Zn4>.<Tb> }
    # Behavior: Narrowing Unsigned -> Unsigned Saturation.
    # sz=0: 32-bit Unsigned -> 8-bit Unsigned (Sat > 255).
    # sz=1: 64-bit Unsigned -> 16-bit Unsigned (Sat > 65535).

    uqcvtCode = r'''
        
        const uint32_t raw = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t n_start = (raw >> 5) & 0x1F;
        const uint32_t sz = (raw >> 10) & 0x1;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        ArmISA::VecRegContainer zd;
        ArmISA::VecRegContainer zns[4];
        
        for (int i = 0; i < 4; ++i) {
            xc->tcBase()->getReg(ArmISA::vecRegClass[n_start + i], &zns[i]);
        }

        // Helper for UQCVT Saturation
        // Input is Unsigned, Output is Unsigned.
        auto saturate_u_u = [](uint64_t val, uint64_t max_val) -> uint64_t {
            if (val > max_val) return max_val;
            return val;
        };

        if (sz == 0) {
            // Case: 32-bit Unsigned -> 8-bit Unsigned
            
            uint8_t *out = zd.as<uint8_t>();
            int dest_idx = 0;
            const uint64_t max_val = 255;

            for (int i = 0; i < 4; ++i) {
                // Cast input to Unsigned 32-bit
                const uint32_t *src = (const uint32_t*)zns[i].as<uint8_t>();
                int elements_per_vec = VL_bytes / 4;

                for (int e = 0; e < elements_per_vec; ++e) {
                    uint64_t src_val = (uint64_t)src[e];
                    out[dest_idx++] = (uint8_t)saturate_u_u(src_val, max_val);
                }
            }
        } else {
            // Case: 64-bit Unsigned -> 16-bit Unsigned
            
            uint16_t *out = (uint16_t*)zd.as<uint8_t>();
            int dest_idx = 0;
            const uint64_t max_val = 65535;

            for (int i = 0; i < 4; ++i) {
                // Cast input to Unsigned 64-bit
                const uint64_t *src = (const uint64_t*)zns[i].as<uint8_t>();
                int elements_per_vec = VL_bytes / 8;

                for (int e = 0; e < elements_per_vec; ++e) {
                    uint64_t src_val = src[e];
                    out[dest_idx++] = (uint16_t)saturate_u_u(src_val, max_val);
                }
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("uqcvt", "Uqcvt", "SimdFloatCvtOp", uqcvtCode)

    # SQCVT (Two registers)
    # Instruction: SQCVT <Zd>.H, { <Zn1>.S-<Zn2>.S }
    # Behavior: Narrowing Signed 32-bit -> Signed 16-bit.
    # Input: 2 Vectors (32-bit elements). Output: 1 Vector (16-bit elements).

    sqcvt2Code = r'''
        
        const uint32_t raw = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t n_start = (raw >> 5) & 0x1F;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        ArmISA::VecRegContainer zd;
        ArmISA::VecRegContainer zns[2];
        
        for (int i = 0; i < 2; ++i) {
            xc->tcBase()->getReg(ArmISA::vecRegClass[n_start + i], &zns[i]);
        }

        // Helper for Signed Saturation (32 -> 16)
        auto saturate_s32_s16 = [](int32_t val) -> int16_t {
            const int32_t min_val = -32768;
            const int32_t max_val = 32767;
            if (val < min_val) return (int16_t)min_val;
            if (val > max_val) return (int16_t)max_val;
            return (int16_t)val;
        };

        uint16_t *out = (uint16_t*)zd.as<uint8_t>();
        int dest_idx = 0;

        for (int i = 0; i < 2; ++i) {
            const int32_t *src = (const int32_t*)zns[i].as<uint8_t>();
            // VL_bytes / 4 bytes per element = number of 32-bit elements
            int elements_per_vec = VL_bytes / 4;

            for (int e = 0; e < elements_per_vec; ++e) {
                out[dest_idx++] = saturate_s32_s16(src[e]);
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("sqcvt2", "Sqcvt2", "SimdFloatCvtOp", sqcvt2Code)

    # UQCVT (Two registers)
    # Instruction: UQCVT <Zd>.H, { <Zn1>.S-<Zn2>.S }
    # Behavior: Narrowing Unsigned 32-bit -> Unsigned 16-bit.
    
    uqcvt2Code = r'''
        
        const uint32_t raw = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t n_start = (raw >> 5) & 0x1F;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        ArmISA::VecRegContainer zd;
        ArmISA::VecRegContainer zns[2];
        
        for (int i = 0; i < 2; ++i) {
            xc->tcBase()->getReg(ArmISA::vecRegClass[n_start + i], &zns[i]);
        }

        // Helper for Unsigned Saturation (32 -> 16)
        auto saturate_u32_u16 = [](uint32_t val) -> uint16_t {
            const uint32_t max_val = 65535;
            if (val > max_val) return (uint16_t)max_val;
            return (uint16_t)val;
        };

        uint16_t *out = (uint16_t*)zd.as<uint8_t>();
        int dest_idx = 0;

        for (int i = 0; i < 2; ++i) {
            // Read as Unsigned 32-bit
            const uint32_t *src = (const uint32_t*)zns[i].as<uint8_t>();
            int elements_per_vec = VL_bytes / 4;

            for (int e = 0; e < elements_per_vec; ++e) {
                out[dest_idx++] = saturate_u32_u16(src[e]);
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("uqcvt2", "Uqcvt2", "SimdFloatCvtOp", uqcvt2Code)

    # SQCVTU (Two registers)
    # Instruction: SQCVTU <Zd>.H, { <Zn1>.S-<Zn2>.S }
    # Behavior: Narrowing Signed 32-bit -> Unsigned 16-bit.
    
    sqcvtu2Code = r'''
        
        const uint32_t raw = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t n_start = (raw >> 5) & 0x1F;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        ArmISA::VecRegContainer zd;
        ArmISA::VecRegContainer zns[2];
        
        for (int i = 0; i < 2; ++i) {
            xc->tcBase()->getReg(ArmISA::vecRegClass[n_start + i], &zns[i]);
        }

        // Helper: Signed 32 -> Unsigned 16 Saturation
        auto saturate_s32_u16 = [](int32_t val) -> uint16_t {
            if (val < 0) return 0;
            if (val > 65535) return 65535;
            return (uint16_t)val;
        };

        uint16_t *out = (uint16_t*)zd.as<uint8_t>();
        int dest_idx = 0;

        for (int i = 0; i < 2; ++i) {
            // Read as Signed 32-bit
            const int32_t *src = (const int32_t*)zns[i].as<uint8_t>();
            int elements_per_vec = VL_bytes / 4;

            for (int e = 0; e < elements_per_vec; ++e) {
                out[dest_idx++] = saturate_s32_u16(src[e]);
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("sqcvtu2", "Sqcvtu2", "SimdFloatCvtOp", sqcvtu2Code)

    # SQCVTN (Four registers)
    # Instruction: SQCVTN <Zd>.<T>, { <Zn1>.<Tb>-<Zn4>.<Tb> }
    # Behavior: Narrowing Signed Saturation with Interleaving.
    # sz=0: 32-bit (S) -> 8-bit (B).
    # sz=1: 64-bit (D) -> 16-bit (H).

    sqcvtnCode = r'''
        
        const uint32_t raw = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t n_start = (raw >> 5) & 0x1F;
        const uint32_t sz = (raw >> 10) & 0x1;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        ArmISA::VecRegContainer zd;
        ArmISA::VecRegContainer zns[4];
        
        for (int i = 0; i < 4; ++i) {
            xc->tcBase()->getReg(ArmISA::vecRegClass[n_start + i], &zns[i]);
        }

        auto saturate = [](int64_t val, int64_t min_val, int64_t max_val) -> int64_t {
            if (val < min_val) return min_val;
            if (val > max_val) return max_val;
            return val;
        };

        if (sz == 0) {
            // Case: 32-bit (S) -> 8-bit (B)
            // Destination: int8. Source: int32.
            
            uint8_t *out = zd.as<uint8_t>();
            
            // Number of source elements to process per vector = VL_bytes / 4 (size of int32)
            // Since we interleave 4 vectors, the total output elements = 4 * (VL/4) = VL.
            // This fills the destination register exactly.
            int src_elements = VL_bytes / 4; 
            
            const int64_t min_val = -128;
            const int64_t max_val = 127;

            for (int e = 0; e < src_elements; ++e) {
                for (int i = 0; i < 4; ++i) {
                    const int32_t *src = (const int32_t*)zns[i].as<uint8_t>();
                    int64_t src_val = (int64_t)src[e];
                    
                    // Interleaved Write: 4*e + i
                    out[4 * e + i] = (uint8_t)saturate(src_val, min_val, max_val);
                }
            }
        } else {
            // Case: 64-bit (D) -> 16-bit (H)
            
            uint16_t *out = (uint16_t*)zd.as<uint8_t>();
            
            // Number of source elements per vector = VL_bytes / 8 (size of int64)
            int src_elements = VL_bytes / 8;
            
            const int64_t min_val = -32768;
            const int64_t max_val = 32767;

            for (int e = 0; e < src_elements; ++e) {
                for (int i = 0; i < 4; ++i) {
                    const int64_t *src = (const int64_t*)zns[i].as<uint8_t>();
                    int64_t src_val = src[e];
                    
                    // Interleaved Write: 4*e + i
                    out[4 * e + i] = (uint16_t)saturate(src_val, min_val, max_val);
                }
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("sqcvtn", "Sqcvtn", "SimdFloatCvtOp", sqcvtnCode)

    # SQCVTUN (Four registers)
    # Instruction: SQCVTUN <Zd>.<T>, { <Zn1>.<Tb>-<Zn4>.<Tb> }
    # Behavior: Narrowing Signed -> Unsigned Saturation with Interleaving.
    
    sqcvtunCode = r'''
        
        const uint32_t raw = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t n_start = (raw >> 5) & 0x1F;
        const uint32_t sz = (raw >> 10) & 0x1;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        ArmISA::VecRegContainer zd;
        ArmISA::VecRegContainer zns[4];
        
        for (int i = 0; i < 4; ++i) {
            xc->tcBase()->getReg(ArmISA::vecRegClass[n_start + i], &zns[i]);
        }

        // Helper: Signed Input -> Unsigned Output Saturation
        auto saturate_s_u = [](int64_t val, uint64_t max_u_val) -> uint64_t {
            if (val < 0) return 0;
            if ((uint64_t)val > max_u_val) return max_u_val;
            return (uint64_t)val;
        };

        if (sz == 0) {
            // Case: 32-bit Signed -> 8-bit Unsigned
            uint8_t *out = zd.as<uint8_t>();
            int src_elements = VL_bytes / 4; 
            const uint64_t max_val = 255;

            for (int e = 0; e < src_elements; ++e) {
                for (int i = 0; i < 4; ++i) {
                    const int32_t *src = (const int32_t*)zns[i].as<uint8_t>();
                    int64_t src_val = (int64_t)src[e];
                    
                    // Interleaved Write: 4*e + i
                    out[4 * e + i] = (uint8_t)saturate_s_u(src_val, max_val);
                }
            }
        } else {
            // Case: 64-bit Signed -> 16-bit Unsigned
            uint16_t *out = (uint16_t*)zd.as<uint8_t>();
            int src_elements = VL_bytes / 8;
            const uint64_t max_val = 65535;

            for (int e = 0; e < src_elements; ++e) {
                for (int i = 0; i < 4; ++i) {
                    const int64_t *src = (const int64_t*)zns[i].as<uint8_t>();
                    int64_t src_val = src[e];
                    
                    // Interleaved Write: 4*e + i
                    out[4 * e + i] = (uint16_t)saturate_s_u(src_val, max_val);
                }
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("sqcvtun", "Sqcvtun", "SimdFloatCvtOp", sqcvtunCode)

    # UQCVTN (Four registers)
    # Instruction: UQCVTN <Zd>.<T>, { <Zn1>.<Tb>-<Zn4>.<Tb> }
    # Behavior: Narrowing Unsigned -> Unsigned Saturation with Interleaving.
    
    uqcvtnCode = r'''
        
        const uint32_t raw = (uint32_t)imm;
        const uint32_t zd_idx = (raw >> 0) & 0x1F;
        const uint32_t n_start = (raw >> 5) & 0x1F;
        const uint32_t sz = (raw >> 10) & 0x1;

        const uint32_t VL_bytes = ArmStaticInst::getCurSveVecLen<uint8_t>(xc->tcBase());
        
        ArmISA::VecRegContainer zd;
        ArmISA::VecRegContainer zns[4];
        
        for (int i = 0; i < 4; ++i) {
            xc->tcBase()->getReg(ArmISA::vecRegClass[n_start + i], &zns[i]);
        }

        // Helper: Unsigned -> Unsigned Saturation
        auto saturate_u_u = [](uint64_t val, uint64_t max_val) -> uint64_t {
            if (val > max_val) return max_val;
            return val;
        };

        if (sz == 0) {
            // Case: 32-bit Unsigned -> 8-bit Unsigned
            uint8_t *out = zd.as<uint8_t>();
            int src_elements = VL_bytes / 4; 
            const uint64_t max_val = 255;

            for (int e = 0; e < src_elements; ++e) {
                for (int i = 0; i < 4; ++i) {
                    const uint32_t *src = (const uint32_t*)zns[i].as<uint8_t>();
                    uint64_t src_val = (uint64_t)src[e];
                    
                    // Interleaved Write: 4*e + i
                    out[4 * e + i] = (uint8_t)saturate_u_u(src_val, max_val);
                }
            }
        } else {
            // Case: 64-bit Unsigned -> 16-bit Unsigned
            uint16_t *out = (uint16_t*)zd.as<uint8_t>();
            int src_elements = VL_bytes / 8;
            const uint64_t max_val = 65535;

            for (int e = 0; e < src_elements; ++e) {
                for (int i = 0; i < 4; ++i) {
                    const uint64_t *src = (const uint64_t*)zns[i].as<uint8_t>();
                    uint64_t src_val = src[e];
                    
                    // Interleaved Write: 4*e + i
                    out[4 * e + i] = (uint16_t)saturate_u_u(src_val, max_val);
                }
            }
        }

        xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
    '''

    smeCvtMvInst("uqcvtn", "Uqcvtn", "SimdFloatCvtOp", uqcvtnCode)

    # RDSVL
    smeRdsvlInst('rdsvl', 'Rdsvl', 'SimdAddOp')

    # SMOPA
    intMopxCode = '''
        auto tile = getTile<TPDElem>(ZA, imm);

        size_t shift = 8 * sizeof(TPS1Elem);
        size_t mask = (1 << shift) - 1;

        for (int j = 0; j < eCount; ++j) {
            for (int i = 0; i < eCount; ++i) {
                for (int k = 0; k < 4; ++k) {
                    if (!GpOp1_xs1[4 * j + k]) {
                        continue;
                    }

                    if (!GpOp2_xs2[4 * i + k]) {
                        continue;
                    }

                    TPS1Elem temp1 =
                        (TPS1Elem)(AA64FpOp1_xd[j] >> (shift * k)) & mask;
                    TPS2Elem temp2 =
                        (TPS2Elem)(AA64FpOp2_xd[i] >> (shift * k)) & mask;

                    tile[j][i] %s= (TPDElem)temp1 * (TPDElem)temp2;
                }
            }
        }
        '''
    smeIntOPInst('smopa', 'Smopa', 'MatrixOPOp', ['int8_t', 'int16_t'],
                 ['int8_t', 'int16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "+")

    # SMOPS
    smeIntOPInst('smops', 'Smops', 'MatrixOPOp', ['int8_t', 'int16_t'],
                 ['int8_t', 'int16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "-")

    # Shared 2-way signed integer dot product code
    smop2wayCode = r'''
        const uint8_t da = imm & 0x3;
        const uint8_t pn = (imm >> 2) & 0x7;
        const uint8_t pm = (imm >> 5) & 0x7;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount;

        DPRINTF(Arm, "Sme<NAME>2way: da=%u pn=p%u pm=p%u dim=%d Zn=z%u Zm=z%u\n",
                da, pn, pm, dim, (unsigned)this->op1, (unsigned)this->op2);

        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);
        
        const TPSElem *zn_ptr = zn.as<TPSElem>();
        const TPSElem *zm_ptr = zm.as<TPSElem>();

        ArmISA::VecPredRegContainer pn_reg, pm_reg;
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pn], &pn_reg);
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pm], &pm_reg);

        auto is_active = [](const ArmISA::VecPredRegContainer& preg, int index) -> bool {
            int bit_idx = index * 2; 
            int byte_idx = bit_idx / 8;
            int bit_offset = bit_idx % 8;
            return (preg.as<uint8_t>()[byte_idx] >> bit_offset) & 1;
        };

        for (int row = 0; row < dim; ++row) {
            for (int col = 0; col < dim; ++col) {
                
                TPDElem sum = tile[row][col];
                
                for (int k = 0; k < 2; ++k) {
                    int idx_n = 2 * row + k;
                    int idx_m = 2 * col + k;

                    if (is_active(pn_reg, idx_n) && is_active(pm_reg, idx_m)) {
                        TPDElem val1 = static_cast<TPDElem>(zn_ptr[idx_n]);
                        TPDElem val2 = static_cast<TPDElem>(zm_ptr[idx_m]);
                        
                        // Dynamic operator injected by Python!
                        sum <OP>= (val1 * val2);
                    }
                }
                
                tile[row][col] = sum;
                
                if ((row == 0       && col == 0)       ||
                    (row == 0       && col == dim - 1) ||
                    (row == dim - 1 && col == 0)       ||
                    (row == dim - 1 && col == dim - 1)) {
                    DPRINTF(Arm, "Sme<NAME>2way[%d][%d] NewZA=%d\n", row, col, (int)tile[row][col]);
                }
            }
        }
    '''

    # SMOPA 2-way 
    smeFmop4aInst('smopa2way', 'Smopa2way', 'MatrixOPOp', ['int16_t, int32_t'], 
                smop2wayCode.replace('<OP>', '+').replace('<NAME>', 'Smopa'))

    # SMOPS 2-way
    smeFmop4aInst('smops2way', 'Smops2way', 'MatrixOPOp', ['int16_t, int32_t'], 
                smop2wayCode.replace('<OP>', '-').replace('<NAME>', 'Smops'))

    smop4Code = r'''
        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = ((imm >> 2) & 0x3) + 1;
        const uint8_t mreg = ((imm >> 4) & 0x3) + 1;

        auto tile = getTile<TPDElem>(ZA, da);
        
        // Widening MOP4 algorithm uses half-vectors, so dim = eCount / 2
        const int dim = eCount / 2;

        DPRINTF(Arm, "Sme<NAME>: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u\n",
                da, nreg, mreg, eCount, dim, (unsigned)this->op1, (unsigned)this->op2);

        for (int outprod = 0; outprod < 4; ++outprod) {
            const int row_hv = outprod / 2;
            const int col_hv = outprod % 2;
            const int row_base = row_hv * dim;
            const int col_base = col_hv * dim;

            const RegIndex zn_sel = this->op1 + (nreg - 1) * col_hv;
            const RegIndex zm_sel = this->op2 + (mreg - 1) * row_hv;

            ArmISA::VecRegContainer zn, zm;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_sel], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zm_sel], &zm);

            const TPSElem *zn_ptr = zn.as<TPSElem>();
            const TPSElem *zm_ptr = zm.as<TPSElem>();

            for (int row = 0; row < dim; ++row) {
                for (int col = 0; col < dim; ++col) {
                    const int row_idx = row_base + row;
                    const int col_idx = col_base + col;

                    TPDElem sum = tile[row_idx][col_idx];

                    // 2-Way Signed Dot Product
                    for (int k = 0; k < 2; ++k) {
                        TPDElem val1 = static_cast<TPDElem>(zn_ptr[2 * row_idx + k]);
                        TPDElem val2 = static_cast<TPDElem>(zm_ptr[2 * col_idx + k]);
                        sum <OP>= (val1 * val2);
                    }

                    tile[row_idx][col_idx] = sum;

                    if ((row_idx == 0   && col_idx == 0)   ||
                        (row_idx == 0   && col_idx == dim) ||
                        (row_idx == dim && col_idx == 0)   ||
                        (row_idx == dim && col_idx == dim)) {
                        DPRINTF(Arm, "Sme<NAME>[%d][%d] outprod=%d zn=z%u zm=z%u NewZA=%d\n",
                                row_idx, col_idx, outprod, (unsigned)zn_sel, (unsigned)zm_sel, (int)sum);
                    }
                }
            }
        }
    '''

    # SMOP4A 2-way 
    smeFmop4aInst('smop4a', 'Smop4a', 'MatrixOPOp', ['int16_t, int32_t'], 
                smop4Code.replace('<OP>', '+').replace('<NAME>', 'Smop4a'))

    # SMOP4S 2-way
    smeFmop4aInst('smop4s', 'Smop4s', 'MatrixOPOp', ['int16_t, int32_t'], 
                smop4Code.replace('<OP>', '-').replace('<NAME>', 'Smop4s'))

    smop4_4wayCode = r'''
        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = ((imm >> 2) & 0x3) + 1;
        const uint8_t mreg = ((imm >> 4) & 0x3) + 1;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount / 2;

        DPRINTF(Arm, "Sme<NAME>: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u sizeof(src)=%lu\n",
                da, nreg, mreg, eCount, dim, (unsigned)this->op1, (unsigned)this->op2, sizeof(TPSElem));

        for (int outprod = 0; outprod < 4; ++outprod) {
            const int row_hv = outprod / 2;
            const int col_hv = outprod % 2;
            const int row_base = row_hv * dim;
            const int col_base = col_hv * dim;

            const RegIndex zn_sel = this->op1 + (nreg - 1) * col_hv;
            const RegIndex zm_sel = this->op2 + (mreg - 1) * row_hv;

            ArmISA::VecRegContainer zn, zm;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_sel], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zm_sel], &zm);

            const TPSElem *zn_ptr = zn.as<TPSElem>();
            const TPSElem *zm_ptr = zm.as<TPSElem>();

            for (int row = 0; row < dim; ++row) {
                for (int col = 0; col < dim; ++col) {
                    const int row_idx = row_base + row;
                    const int col_idx = col_base + col;

                    TPDElem sum = tile[row_idx][col_idx];

                    // 4-Way Signed Dot Product
                    for (int k = 0; k < 4; ++k) {
                        TPDElem val1 = static_cast<TPDElem>(zn_ptr[4 * row_idx + k]);
                        TPDElem val2 = static_cast<TPDElem>(zm_ptr[4 * col_idx + k]);
                        sum <OP>= (val1 * val2);
                    }

                    tile[row_idx][col_idx] = sum;

                    if ((row_idx == 0   && col_idx == 0)   ||
                        (row_idx == 0   && col_idx == dim) ||
                        (row_idx == dim && col_idx == 0)   ||
                        (row_idx == dim && col_idx == dim)) {
                        DPRINTF(Arm, "Sme<NAME>[%d][%d] outprod=%d zn=z%u zm=z%u NewZA=%lld\n",
                                row_idx, col_idx, outprod, (unsigned)zn_sel, (unsigned)zm_sel, (long long)sum);
                    }
                }
            }
        }
    '''

    # SMOP4A 4-way
    smeFmop4aInst('smop4a4way', 'Smop4a4way', 'MatrixOPOp', 
                ['int8_t, int32_t', 'int16_t, int64_t'], 
                smop4_4wayCode.replace('<OP>', '+').replace('<NAME>', 'Smop4a4way'))

    # SMOP4S 4-way
    smeFmop4aInst('smop4s4way', 'Smop4s4way', 'MatrixOPOp', 
                ['int8_t, int32_t', 'int16_t, int64_t'], 
                smop4_4wayCode.replace('<OP>', '-').replace('<NAME>', 'Smop4s4way'))

    sumop4_4wayCode = r'''
        #include <type_traits> // Ensure type_traits is available for mixed sign casting

        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = ((imm >> 2) & 0x3) + 1;
        const uint8_t mreg = ((imm >> 4) & 0x3) + 1;

        auto tile = getTile<TPDElem>(ZA, da);
        const int dim = eCount / 2;

        DPRINTF(Arm, "Sme<NAME>: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u sizeof(src)=%lu\n",
                da, nreg, mreg, eCount, dim, (unsigned)this->op1, (unsigned)this->op2, sizeof(TPSElem));

        for (int outprod = 0; outprod < 4; ++outprod) {
            const int row_hv = outprod / 2;
            const int col_hv = outprod % 2;
            const int row_base = row_hv * dim;
            const int col_base = col_hv * dim;

            const RegIndex zn_sel = this->op1 + (nreg - 1) * col_hv;
            const RegIndex zm_sel = this->op2 + (mreg - 1) * row_hv;

            ArmISA::VecRegContainer zn, zm;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_sel], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zm_sel], &zm);

            const TPSElem *zn_ptr = zn.as<TPSElem>();
            const TPSElem *zm_ptr = zm.as<TPSElem>();

            // Establish the explicit signed/unsigned types for casting
            using TSigned = typename std::make_signed<TPSElem>::type;
            using TUnsigned = typename std::make_unsigned<TPSElem>::type;

            for (int row = 0; row < dim; ++row) {
                for (int col = 0; col < dim; ++col) {
                    const int row_idx = row_base + row;
                    const int col_idx = col_base + col;

                    TPDElem sum = tile[row_idx][col_idx];

                    // 4-Way Mixed Signed x Unsigned Dot Product
                    for (int k = 0; k < 4; ++k) {
                        // Zn (op1) is explicitly signed
                        TPDElem val1 = static_cast<TPDElem>( static_cast<TSigned>(zn_ptr[4 * row_idx + k]) );
                        // Zm (op2) is explicitly unsigned
                        TPDElem val2 = static_cast<TPDElem>( static_cast<TUnsigned>(zm_ptr[4 * col_idx + k]) );
                        
                        sum <OP>= (val1 * val2);
                    }

                    tile[row_idx][col_idx] = sum;

                    if ((row_idx == 0   && col_idx == 0)   ||
                        (row_idx == 0   && col_idx == dim) ||
                        (row_idx == dim && col_idx == 0)   ||
                        (row_idx == dim && col_idx == dim)) {
                        DPRINTF(Arm, "Sme<NAME>[%d][%d] outprod=%d zn=z%u zm=z%u NewZA=%lld\n",
                                row_idx, col_idx, outprod, (unsigned)zn_sel, (unsigned)zm_sel, (long long)sum);
                    }
                }
            }
        }
    '''

    # SUMOP4A 4-way
    smeFmop4aInst('sumop4a4way', 'Sumop4a4way', 'MatrixOPOp', 
                ['uint8_t, uint32_t', 'uint16_t, uint64_t'], 
                sumop4_4wayCode.replace('<OP>', '+').replace('<NAME>', 'Sumop4a4way'))

    # SUMOP4S 4-way
    smeFmop4aInst('sumop4s4way', 'Sumop4s4way', 'MatrixOPOp', 
                ['uint8_t, uint32_t', 'uint16_t, uint64_t'], 
                sumop4_4wayCode.replace('<OP>', '-').replace('<NAME>', 'Sumop4s4way'))

    bfmop4sWideningCode = r'''
        // imm packing:
        // [1:0] da, [3:2] nreg, [5:4] mreg
        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = (imm >> 2) & 0x3;
        const uint8_t mreg = (imm >> 4) & 0x3;

        auto tile = getTile<TPDElem>(ZA, da);
        FPSCR fpscr = (FPSCR) Fpscr;

        // BF16 -> FP32 bits (top 16 bits)
        auto bf16_to_fp32 = [](uint16_t b) -> uint32_t {
            return static_cast<uint32_t>(b) << 16;
        };

        const int dim = eCount / 2;

        DPRINTF(Arm, "SmeBfmop4sWidening: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u\n",
                da, nreg, mreg, eCount, dim, (unsigned)op1, (unsigned)op2);

        for (int outprod = 0; outprod < 4; ++outprod) {
            const int row_hv = outprod / 2;
            const int col_hv = outprod % 2;
            const int row_base = row_hv * dim;
            const int col_base = col_hv * dim;

            const RegIndex zn_sel = op1 + (nreg - 1) * col_hv;
            const RegIndex zm_sel = op2 + (mreg - 1) * row_hv;

            ArmISA::VecRegContainer zn, zm;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_sel], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zm_sel], &zm);

            const uint16_t *zn_ptr = zn.as<uint16_t>();
            const uint16_t *zm_ptr = zm.as<uint16_t>();

            for (int row = 0; row < dim; ++row) {
                for (int col = 0; col < dim; ++col) {
                    const int row_idx = row_base + row;
                    const int col_idx = col_base + col;

                    // Read BF16 pairs and convert to FP32
                    TPDElem erow_0 = bf16_to_fp32(zn_ptr[2 * row_idx + 0]);
                    TPDElem erow_1 = bf16_to_fp32(zn_ptr[2 * row_idx + 1]);
                    
                    // --- BFMOP4S SPECIFIC: Negate erow for subtraction ---
                    erow_0 = fplibNeg(erow_0);
                    erow_1 = fplibNeg(erow_1);

                    const uint32_t ecol_0 = bf16_to_fp32(zm_ptr[2 * col_idx + 0]);
                    const uint32_t ecol_1 = bf16_to_fp32(zm_ptr[2 * col_idx + 1]);

                    TPDElem acc = tile[row_idx][col_idx];

                    TPDElem prod0 = fplibMul(erow_0, ecol_0, fpscr);
                    acc = fplibAdd(acc, prod0, fpscr);

                    TPDElem prod1 = fplibMul(erow_1, ecol_1, fpscr);
                    acc = fplibAdd(acc, prod1, fpscr);

                    tile[row_idx][col_idx] = acc;
                }
            }
        }
    '''

    smeFmop4aInst('bfmop4s_widening', 'Bfmop4sWidening',
              'MatrixOPOp', ['uint16_t, uint32_t'], bfmop4sWideningCode)

    # BFMOP4S (Non-widening / BFloat16) Implementation
    # BFMOP4S <ZAda>.S, <Zn>.H, <Zm>.H
    bfmop4sCode = r'''
        // imm packing:
        // [1:0] da, [3:2] nreg, [5:4] mreg
        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = (imm >> 2) & 0x3;
        const uint8_t mreg = (imm >> 4) & 0x3;

        auto tile = getTile<TPDElem>(ZA, da);
        FPSCR fpscr = (FPSCR) Fpscr;

        auto bf16_to_fp32 = [](uint16_t b) -> uint32_t {
            return static_cast<uint32_t>(b) << 16;
        };

        const int dim = eCount; 

        DPRINTF(Arm, "SmeBfmop4s: da=%u nreg=%u mreg=%u eCount=%u op1base=z%u op2base=z%u\n",
                da, nreg, mreg, eCount, (unsigned)op1, (unsigned)op2);

        // Iterate over the multiple registers based on M and N
        for (int r = 0; r < nreg; ++r) {
            for (int c = 0; c < mreg; ++c) {
                ArmISA::VecRegContainer zn, zm;
                
                // op1 and op2 are the base registers. Add offsets r and c.
                xc->tcBase()->getReg(ArmISA::vecRegClass[op1 + r], &zn);
                xc->tcBase()->getReg(ArmISA::vecRegClass[op2 + c], &zm);

                const uint16_t *zn_ptr = zn.as<uint16_t>();
                const uint16_t *zm_ptr = zm.as<uint16_t>();

                for (int j = 0; j < dim; ++j) {
                    
                    // Read and negate Zn (BFMOP4S subtraction)
                    uint32_t n0 = bf16_to_fp32(zn_ptr[2 * j]);
                    uint32_t n1 = bf16_to_fp32(zn_ptr[2 * j + 1]);
                    n0 = fplibNeg(n0);
                    n1 = fplibNeg(n1);

                    for (int i = 0; i < dim; ++i) {
                        uint32_t m0 = bf16_to_fp32(zm_ptr[2 * i]);
                        uint32_t m1 = bf16_to_fp32(zm_ptr[2 * i + 1]);

                        TPDElem acc = tile[j][i];
                        
                        // 2-way Dot Product Accumulation
                        TPDElem prod0 = fplibMul(n0, m0, fpscr);
                        acc = fplibAdd(acc, prod0, fpscr);
                        
                        TPDElem prod1 = fplibMul(n1, m1, fpscr);
                        acc = fplibAdd(acc, prod1, fpscr);
                        
                        tile[j][i] = acc;
                    }
                }
            }
        }
    '''

    # Instantiate BFMOP4S non-widening:
    # TPSElem (Source) = uint16_t (representing BF16), TPDElem (Dest) = uint32_t (FP32)
    smeFmop4aInst('bfmop4s', 'Bfmop4s', 'MatrixOPOp', ['uint16_t, uint32_t'], bfmop4sCode)

    # BFTMOPA (Non-widening / Sparse / BFloat16) Implementation
    # Operation: ZA[r][c] += Select(Zn_pair, Control) * Zm[c]
    bftmopaCode = r'''
        // Unpack immediate: [0] da, [2:1] index, [7:3] zk
        const uint8_t da    = imm & 0x1;
        const uint8_t index = (imm >> 1) & 0x3;
        const uint8_t zk    = (imm >> 3) & 0x1F;

        auto tile = getTile<TPDElem>(ZA, da);
        FPSCR fpscr = (FPSCR) Fpscr;

        // BFloat16 <-> FP32 conversion
        auto bf16_to_fp32 = [](uint16_t b) -> uint32_t {
            return static_cast<uint32_t>(b) << 16;
        };
        auto fp32_to_bf16 = [](uint32_t f) -> uint16_t {
            // Round to nearest even
            uint32_t lsb = (f >> 16) & 1;
            f += 0x7FFF + lsb;
            return static_cast<uint16_t>(f >> 16);
        };

        const int dim = eCount;

        // 1. Read Control Vector (Zk)
        ArmISA::VecRegContainer z_ctrl;
        xc->tcBase()->getReg(ArmISA::vecRegClass[zk], &z_ctrl);
        const uint8_t* ctrl_ptr = z_ctrl.as<uint8_t>();

        // Control bit accessor
        // The control segment is (2 * dim) bits long.
        // We select the segment using 'index'.
        auto get_ctrl_bit = [&](int bit_idx) -> bool {
            int total_bit_offset = (index * dim * 2) + bit_idx;
            return (ctrl_ptr[total_bit_offset / 8] >> (total_bit_offset % 8)) & 1;
        };

        // 2. Read Source Vectors
        ArmISA::VecRegContainer zn0, zn1, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1], &zn0);      // Zn
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1 + 1], &zn1);  // Zn+1
        xc->tcBase()->getReg(ArmISA::vecRegClass[op2], &zm);       // Zm

        const uint16_t* zn0_ptr = zn0.as<uint16_t>();
        const uint16_t* zn1_ptr = zn1.as<uint16_t>();
        const uint16_t* zm_ptr  = zm.as<uint16_t>();

        // 3. Sparse Outer Product Loop
        for (int row = 0; row < dim; ++row) {
            for (int col = 0; col < dim; ++col) {
                
                uint16_t elem1_bf16 = 0; // Default to 0.0
                
                // Sparsity Logic (1-in-2 selection):
                // For a given column (col) and row input pair (r=0, r=1):
                // We check 2 control bits per column.
                // Spec: "If both bits... are 1, only the element corresponding to the LSB is selected."
                // This implies priority: if bit 0 is set, take Zn. Else if bit 1 is set, take Zn+1.
                
                bool bit0 = get_ctrl_bit(2 * col + 0);
                bool bit1 = get_ctrl_bit(2 * col + 1);

                if (bit0) {
                    elem1_bf16 = zn0_ptr[row];
                } else if (bit1) {
                    elem1_bf16 = zn1_ptr[row];
                } 
                // else both 0 -> elem1 remains 0 (discarded)

                uint16_t elem2_bf16 = zm_ptr[col];
                uint16_t sum_bf16   = tile[row][col];

                // Convert to FP32 for calculation
                uint32_t e1  = bf16_to_fp32(elem1_bf16);
                uint32_t e2  = bf16_to_fp32(elem2_bf16);
                uint32_t sum = bf16_to_fp32(sum_bf16);

                // Multiply-Accumulate
                uint32_t prod = fplibMul(e1, e2, fpscr);
                uint32_t res  = fplibAdd(sum, prod, fpscr);

                // Store back as BFloat16
                tile[row][col] = fp32_to_bf16(res);
            }
        }
        DPRINTF(Arm, "Successfully executed BFTMOPA: da=%u, index=%u, zk=%u\\n", 
                da, index, zk);
    '''

    smeFmop4aInst('bftmopa', 'Bftmopa', 'MatrixOPOp', ['uint16_t, uint16_t'], bftmopaCode)

    # BFTMOPA (Widening / Sparse / BFloat16 -> FP32) Implementation
    bftmopaWideningCode = r'''
        // Unpack immediate
        const uint8_t da    = imm & 0x3;
        const uint8_t index = (imm >> 2) & 0x3;
        const uint8_t zk    = (imm >> 4) & 0x1F;

        // Tile elements are FP32 (uint32_t)
        auto tile = getTile<TPDElem>(ZA, da);
        FPSCR fpscr = (FPSCR) Fpscr;

        auto bf16_to_fp32 = [](uint16_t b) -> uint32_t {
            return static_cast<uint32_t>(b) << 16;
        };

        const int dim = eCount;

        // 1. Read Control Vector
        ArmISA::VecRegContainer z_ctrl;
        xc->tcBase()->getReg(ArmISA::vecRegClass[zk], &z_ctrl);
        const uint8_t* ctrl_ptr = z_ctrl.as<uint8_t>();

        // 4 control bits per column for this widening instruction
        auto get_ctrl_bit = [&](int bit_idx) -> bool {
            int total_bit_offset = (index * dim * 4) + bit_idx;
            return (ctrl_ptr[total_bit_offset / 8] >> (total_bit_offset % 8)) & 1;
        };

        // 2. Read Source Vectors
        ArmISA::VecRegContainer zn0, zn1, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1], &zn0);      // Zn
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1 + 1], &zn1);  // Zn+1
        xc->tcBase()->getReg(ArmISA::vecRegClass[op2], &zm);       // Zm

        const uint16_t* zn0_ptr = zn0.as<uint16_t>();
        const uint16_t* zn1_ptr = zn1.as<uint16_t>();
        const uint16_t* zm_ptr  = zm.as<uint16_t>();

        // 3. Perform 2-in-4 Sparse Sum of Outer Products
        for (int row = 0; row < dim; ++row) {
            for (int col = 0; col < dim; ++col) {
                
                uint16_t erow[2] = {0, 0}; // Default BFZero
                int i = 0;
                
                // Sparsity Logic: Select 2-in-4 elements
                // Iterates over Zn0 and Zn1 (r), and elements 0 and 1 (e)
                for (int r = 0; r < 2; ++r) {
                    const uint16_t* op1_ptr = (r == 0) ? zn0_ptr : zn1_ptr;
                    for (int e = 0; e < 2; ++e) {
                        int ctrl_bit_idx = 4 * col + 2 * r + e;
                        
                        // Spec: If >2 bits are 1, only the least 2 significant are taken
                        if (i < 2 && get_ctrl_bit(ctrl_bit_idx)) {
                            erow[i] = op1_ptr[2 * row + e];
                            i++;
                        }
                    }
                }

                uint16_t ecol0 = zm_ptr[2 * col + 0];
                uint16_t ecol1 = zm_ptr[2 * col + 1];

                uint32_t sum = tile[row][col];
                
                // Widen BF16 inputs to FP32
                uint32_t f_erow0 = bf16_to_fp32(erow[0]);
                uint32_t f_erow1 = bf16_to_fp32(erow[1]);
                uint32_t f_ecol0 = bf16_to_fp32(ecol0);
                uint32_t f_ecol1 = bf16_to_fp32(ecol1);

                // 2-way Dot Product Accumulation
                uint32_t prod0 = fplibMul(f_erow0, f_ecol0, fpscr);
                sum = fplibAdd(sum, prod0, fpscr);
                
                uint32_t prod1 = fplibMul(f_erow1, f_ecol1, fpscr);
                sum = fplibAdd(sum, prod1, fpscr);

                tile[row][col] = sum;
            }
        }

        DPRINTF(Arm, "Successfully executed BFTMOPA (Widening): da=%u, index=%u, zk=%u\n", da, index, zk);
    '''

    smeFmop4aInst('bftmopa_widening', 'BftmopaWidening', 'MatrixOPOp', ['uint16_t, uint32_t'], bftmopaWideningCode)

    # FMOP4S Non-Widening
    fmop4sNonWideningCode = r'''
        // imm packing:
        // [1:0] da, [3:2] nreg-1, [5:4] mreg-1
        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = ((imm >> 2) & 0x3) + 1;
        const uint8_t mreg = ((imm >> 4) & 0x3) + 1;

        // Access ZA tile using your base class API
        auto tile = getTile<TPDElem>(ZA, da);
        FPSCR fpscr = (FPSCR) Fpscr;

        // eCount = number of elements per vector
        // Non-widening operates on half-vectors, so dim = eCount / 2
        const int dim = eCount / 2;

        DPRINTF(Arm, "SmeFmop4sNonWidening: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u\n",
                da, nreg, mreg, eCount, dim, (unsigned)op1, (unsigned)op2);

        for (int outprod = 0; outprod < 4; ++outprod) {
            const int row_hv = outprod / 2;
            const int col_hv = outprod % 2;
            const int row_base = row_hv * dim;
            const int col_base = col_hv * dim;

            // Base indices are already stored in op1 and op2 by MatrixOPOp
            const RegIndex zn_sel = op1 + (nreg - 1) * col_hv;
            const RegIndex zm_sel = op2 + (mreg - 1) * row_hv;

            // Fetch vector registers
            ArmISA::VecRegContainer zn, zm;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_sel], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zm_sel], &zm);

            // Map to pointers of our template source type
            const TPSElem *zn_ptr = zn.as<TPSElem>();
            const TPSElem *zm_ptr = zm.as<TPSElem>();

            for (int row = 0; row < dim; ++row) {
                for (int col = 0; col < dim; ++col) {
                    const int row_idx = row_base + row;
                    const int col_idx = col_base + col;

                    // Read operands
                    TPSElem elem1 = zn_ptr[row_idx];
                    TPSElem elem2 = zm_ptr[col_idx];
                    TPDElem acc   = tile[row_idx][col_idx];

                    // FMOP4S Subtraction Logic: Negate elem1 (Zn)
                    // We toggle the sign bit based on the element size (FP16 or FP32)
                    if constexpr (sizeof(TPSElem) == 2) {
                        elem1 ^= 0x8000;       // FP16
                    } else if constexpr (sizeof(TPSElem) == 4) {
                        elem1 ^= 0x80000000;   // FP32
                    }

                    // Destructive Multiply-Accumulate
                    acc = fplibMulAdd<TPDElem>(acc, elem1, elem2, fpscr);
                    tile[row_idx][col_idx] = acc;
                    
                    // Debug print for quadrant corners
                    if ((row == 0       && col == 0)       ||
                        (row == 0       && col == dim - 1) ||
                        (row == dim - 1 && col == 0)       ||
                        (row == dim - 1 && col == dim - 1)) {
                        DPRINTF(Arm,
                            "SmeFmop4sNonWidening[%d][%d] outprod=%d zn=z%u zm=z%u "
                            "elem1_neg=0x%x elem2=0x%x NewZA=0x%x\n",
                            row_idx, col_idx, outprod, (unsigned)zn_sel, (unsigned)zm_sel,
                            elem1, elem2, acc);
                    }
                }
            }
        }
    '''

    # Single generator call that creates SmeFmop4sNonWidening<T1, T2>
    smeFmop4aInst('fmop4s_non_widening', 'Fmop4sNonWidening',
                'MatrixOPOp', ['uint16_t, uint16_t', 'uint32_t, uint32_t'], fmop4sNonWideningCode)

    # FMOP4S Widening
    fmop4sWideningCode = r'''
        // 1. Unpack metadata
        const uint8_t da   = imm & 0x3;
        const uint8_t nreg = ((imm >> 2) & 0x3) + 1;
        const uint8_t mreg = ((imm >> 4) & 0x3) + 1;

        auto tile = getTile<TPDElem>(ZA, da);
        FPSCR fpscr = (FPSCR) Fpscr;

        // FP16 -> FP32 Manual Widening Helper
        auto fp16_to_fp32 = [](uint16_t h) -> uint32_t {
            uint32_t sign = (h & 0x8000) << 16;
            int32_t exp = (h & 0x7c00) >> 10;
            uint32_t frac = (h & 0x03ff);

            if (exp == 0) {
                if (frac == 0) return sign; // Zero
                while ((frac & 0x0400) == 0) { // Subnormal
                    frac <<= 1;
                    exp--;
                }
                exp++;
                frac &= 0x03ff;
                exp += (-15 + 127);
            } else if (exp == 0x1f) {
                exp = 255; // Inf/NaN
            } else {
                exp += (-15 + 127); // Normal
            }
            return sign | ((uint32_t)exp << 23) | (frac << 13);
        };

        // Widening algorithm uses half-vectors, so dim = eCount/2
        const int dim = eCount / 2;

        DPRINTF(Arm, "SmeFmop4sWidening: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u\n",
                da, nreg, mreg, eCount, dim, (unsigned)op1, (unsigned)op2);

        for (int outprod = 0; outprod < 4; ++outprod) {
            const int row_hv = outprod / 2;
            const int col_hv = outprod % 2;
            const int row_base = row_hv * dim;
            const int col_base = col_hv * dim;

            const RegIndex zn_sel = op1 + (nreg - 1) * col_hv;
            const RegIndex zm_sel = op2 + (mreg - 1) * row_hv;

            ArmISA::VecRegContainer zn, zm;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_sel], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zm_sel], &zm);

            const uint16_t *zn_ptr = zn.as<uint16_t>();
            const uint16_t *zm_ptr = zm.as<uint16_t>();

            for (int row = 0; row < dim; ++row) {
                for (int col = 0; col < dim; ++col) {
                    const int row_idx = row_base + row;
                    const int col_idx = col_base + col;

                    // Read FP16 pairs
                    uint16_t erow_0 = zn_ptr[2 * row_idx + 0];
                    uint16_t erow_1 = zn_ptr[2 * row_idx + 1];
                    uint16_t ecol_0 = zm_ptr[2 * col_idx + 0];
                    uint16_t ecol_1 = zm_ptr[2 * col_idx + 1];

                    // --- FMOP4S Subtraction Logic ---
                    // Flip the sign bit (bit 15) to negate the Zn elements BEFORE widening
                    erow_0 ^= 0x8000;
                    erow_1 ^= 0x8000;

                    // Widen to FP32
                    const uint32_t erow_0_fp32 = fp16_to_fp32(erow_0);
                    const uint32_t erow_1_fp32 = fp16_to_fp32(erow_1);
                    const uint32_t ecol_0_fp32 = fp16_to_fp32(ecol_0);
                    const uint32_t ecol_1_fp32 = fp16_to_fp32(ecol_1);

                    TPDElem acc = tile[row_idx][col_idx];

                    // Execute destructive Multiply-Add using the widened 32-bit floats
                    TPDElem prod0 = fplibMul(erow_0_fp32, ecol_0_fp32, fpscr);
                    acc = fplibAdd(acc, prod0, fpscr);

                    TPDElem prod1 = fplibMul(erow_1_fp32, ecol_1_fp32, fpscr);
                    acc = fplibAdd(acc, prod1, fpscr);

                    tile[row_idx][col_idx] = acc;
                    
                    DPRINTF(Arm, "SmeFmop4sWidening: da=%u nreg=%u mreg=%u eCount=%u dim=%d op1base=z%u op2base=z%u\n",
                        da, nreg, mreg, eCount, dim, (unsigned)op1, (unsigned)op2);

                }
            }
        }
    '''

    # Generator Call (Note the 'Fmop4sWidening' name so gem5 doesn't double the 'Sme' prefix!)
    smeFmop4aInst('fmop4s_widening', 'Fmop4sWidening',
                'MatrixOPOp', ['uint16_t, uint32_t'], fmop4sWideningCode)

    # BMOPA
    bmopaCode = r'''
        // 1. Unpack metadata from the 64-bit imm field
        const uint8_t da = imm & 0x3;
        const uint8_t pn = (imm >> 2) & 0x7;
        const uint8_t pm = (imm >> 5) & 0x7;

        // Access ZA tile using your base class API
        auto tile = getTile<uint32_t>(ZA, da);

        // For single-vector 32-bit elements, dim is exactly eCount
        const int dim = eCount;

        DPRINTF(Arm, "SmeBmopa: da=%u pn=p%u pm=p%u dim=%d Zn=z%u Zm=z%u\n",
                da, pn, pm, dim, (unsigned)this->op1, (unsigned)this->op2);

        // 2. Fetch Vector Registers
        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);

        const uint32_t *zn_ptr = zn.as<uint32_t>();
        const uint32_t *zm_ptr = zm.as<uint32_t>();

        // 3. Fetch Predicate Registers
        ArmISA::VecPredRegContainer pn_reg, pm_reg;
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pn], &pn_reg);
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pm], &pm_reg);

        // SVE/SME Predicate logic: Each 32-bit element is governed by 4 predicate bits.
        // The lowest bit of those 4 bits dictates the active state.
        auto is_active = [](const ArmISA::VecPredRegContainer& preg, int index) -> bool {
            int bit_idx = index * 4; 
            int byte_idx = bit_idx / 8;
            int bit_offset = bit_idx % 8;
            return (preg.as<uint8_t>()[byte_idx] >> bit_offset) & 1;
        };

        // 4. Outer Product Execution
        for (int row = 0; row < dim; ++row) {
            uint32_t elem1 = zn_ptr[row];
            bool active1 = is_active(pn_reg, row);

            for (int col = 0; col < dim; ++col) {
                uint32_t elem2 = zm_ptr[col];
                bool active2 = is_active(pm_reg, col);

                // Only modify the tile if BOTH vector elements are actively predicated
                if (active1 && active2) {
                    // Bitwise XNOR
                    uint32_t xnor_val = ~(elem1 ^ elem2);
                    
                    // Population Count
                    uint32_t res = __builtin_popcount(xnor_val);
                    
                    // Accumulate destructively
                    tile[row][col] += res;
                    
                    // Debug out corner quadrants to verify
                    if ((row == 0       && col == 0)       ||
                        (row == 0       && col == dim - 1) ||
                        (row == dim - 1 && col == 0)       ||
                        (row == dim - 1 && col == dim - 1)) {
                        DPRINTF(Arm, "SmeBmopa[%d][%d] zn=0x%x zm=0x%x xnor=0x%x res=%u NewZA=%u\n",
                                row, col, elem1, elem2, xnor_val, res, tile[row][col]);
                    }
                }
            }
        }
    '''

    # Generator Call: We pass 'Bmopa' to avoid double-prefixing.
    # We pass uint32_t twice so MatrixOPOp maps it successfully to your T1/T2 templates.
    smeFmop4aInst('bmopa', 'Bmopa', 'MatrixOPOp', ['uint32_t, uint32_t'], bmopaCode)

    # BMOPS
    bmopsCode = r'''
        // 1. Unpack metadata from the 64-bit imm field
        const uint8_t da = imm & 0x3;
        const uint8_t pn = (imm >> 2) & 0x7;
        const uint8_t pm = (imm >> 5) & 0x7;

        auto tile = getTile<uint32_t>(ZA, da);
        const int dim = eCount;

        DPRINTF(Arm, "SmeBmops: da=%u pn=p%u pm=p%u dim=%d Zn=z%u Zm=z%u\n",
                da, pn, pm, dim, (unsigned)this->op1, (unsigned)this->op2);

        // 2. Fetch Vector Registers
        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);

        const uint32_t *zn_ptr = zn.as<uint32_t>();
        const uint32_t *zm_ptr = zm.as<uint32_t>();

        // 3. Fetch Predicate Registers
        ArmISA::VecPredRegContainer pn_reg, pm_reg;
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pn], &pn_reg);
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pm], &pm_reg);

        auto is_active = [](const ArmISA::VecPredRegContainer& preg, int index) -> bool {
            int bit_idx = index * 4; 
            int byte_idx = bit_idx / 8;
            int bit_offset = bit_idx % 8;
            return (preg.as<uint8_t>()[byte_idx] >> bit_offset) & 1;
        };

        // 4. Outer Product Execution
        for (int row = 0; row < dim; ++row) {
            uint32_t elem1 = zn_ptr[row];
            bool active1 = is_active(pn_reg, row);

            for (int col = 0; col < dim; ++col) {
                uint32_t elem2 = zm_ptr[col];
                bool active2 = is_active(pm_reg, col);

                if (active1 && active2) {
                    // Bitwise XNOR Popcount
                    uint32_t xnor_val = ~(elem1 ^ elem2);
                    uint32_t res = __builtin_popcount(xnor_val);
                    
                    // BMOPS Core Logic: Subtract destructively
                    tile[row][col] -= res;
                    
                    if ((row == 0       && col == 0)       ||
                        (row == 0       && col == dim - 1) ||
                        (row == dim - 1 && col == 0)       ||
                        (row == dim - 1 && col == dim - 1)) {
                        DPRINTF(Arm, "SmeBmops[%d][%d] zn=0x%x zm=0x%x xnor=0x%x res=%u NewZA=%u\n",
                                row, col, elem1, elem2, xnor_val, res, tile[row][col]);
                    }
                }
            }
        }
    '''

    # Generator Call for BMOPS
    smeFmop4aInst('bmops', 'Bmops', 'MatrixOPOp', ['uint32_t, uint32_t'], bmopsCode)

    # UMOPA 2-way
    umopaCode = r'''
        // 1. Unpack metadata from the 64-bit imm field
        const uint8_t da = imm & 0x3;
        const uint8_t pn = (imm >> 2) & 0x7;
        const uint8_t pm = (imm >> 5) & 0x7;

        // Tile elements are 32-bit (TPDElem)
        auto tile = getTile<TPDElem>(ZA, da);

        // FIX: MatrixOPOp automatically provides eCount (number of 32-bit elements)
        // The dimension of the tile is exactly eCount x eCount
        const int dim = eCount;

        DPRINTF(Arm, "SmeUmopa2way: da=%u pn=p%u pm=p%u dim=%d Zn=z%u Zm=z%u\n",
                da, pn, pm, dim, (unsigned)this->op1, (unsigned)this->op2);

        // 2. Fetch Vectors & Predicates
        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[this->op2], &zm);
        
        // Source elements are 16-bit (TPSElem)
        const TPSElem *zn_ptr = zn.as<TPSElem>();
        const TPSElem *zm_ptr = zm.as<TPSElem>();

        ArmISA::VecPredRegContainer pn_reg, pm_reg;
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pn], &pn_reg);
        xc->tcBase()->getReg(ArmISA::vecPredRegClass[pm], &pm_reg);

        // SVE Predicate logic for 16-bit elements (2 bytes per element)
        auto is_active = [](const ArmISA::VecPredRegContainer& preg, int index) -> bool {
            int bit_idx = index * 2; 
            int byte_idx = bit_idx / 8;
            int bit_offset = bit_idx % 8;
            return (preg.as<uint8_t>()[byte_idx] >> bit_offset) & 1;
        };

        // 4. 2-Way Outer Product Execution
        for (int row = 0; row < dim; ++row) {
            for (int col = 0; col < dim; ++col) {
                
                // Read initial accumulator value
                TPDElem sum = tile[row][col];
                
                // 2-Way dot product inner loop
                for (int k = 0; k < 2; ++k) {
                    int idx_n = 2 * row + k;
                    int idx_m = 2 * col + k;

                    bool active1 = is_active(pn_reg, idx_n);
                    bool active2 = is_active(pm_reg, idx_m);

                    if (active1 && active2) {
                        // Widen the 16-bit unsigned ints to 32-bit, multiply, and accumulate
                        TPDElem val1 = static_cast<TPDElem>(zn_ptr[idx_n]);
                        TPDElem val2 = static_cast<TPDElem>(zm_ptr[idx_m]);
                        sum += (val1 * val2);
                    }
                }
                
                // Writeback to tile
                tile[row][col] = sum;
                
                // Debug corner cases
                if ((row == 0       && col == 0)       ||
                    (row == 0       && col == dim - 1) ||
                    (row == dim - 1 && col == 0)       ||
                    (row == dim - 1 && col == dim - 1)) {
                    DPRINTF(Arm, "SmeUmopa2way[%d][%d] NewZA=%u\n", row, col, tile[row][col]);
                }
            }
        }
    '''

