// @file Definition of SME instructions.


let {{

    header_output = ""
    decoder_output = ""
    exec_output = ""

    header_output += "#include \"base/trace.hh\"\n";
    header_output += "#include \"arch/arm/insts/fplib.hh\"\n";

    def smeAddInst(name, Name, opClass, types, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index
            // op1 is the source SVE vector register
            // gp1 is the row predecate register
            // gp2 is the column predecate register

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                xc->tcBase());

            uint8_t tile_index = imm & 0x7;

            // View the tile as the correct data type, extract the sub-tile
            auto tile = getTile<TPElem>(ZA, tile_index);
            '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeAddOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeAddDeclare.subst(iop)
        exec_output += SmeTemplatedExecute.subst(iop)

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeAddVlInst(name, Name, opClass, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoPstate + '''
            // dest is the 64-bit destination register
            // op1 is the 64-bit source register
            // imm is a signed multiplier
            '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeAddVlOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeAddVlDeclare.subst(iop)
        exec_output += SmeExecute.subst(iop)

    def smeLd1xInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile number as well as the vector offset. The
            // size of the fields changes based on the data type being used.
            // XOp1 stores Rn
            // GpOp stores the governing predicate register
            // WOp2 stores Rs - the vector index register
            // XOp3 stores Rm - the offset register (applied to Rn)


            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                            xc->tcBase());

            uint8_t offset = imm & (0xf >> (findMsbSet(sizeof(TPElem))));
            [[maybe_unused]] uint8_t tile_idx =
                imm >> (4 - findMsbSet(sizeof(TPElem)));
            [[maybe_unused]] uint8_t vec_idx = (WOp2 + offset) % eCount;

            // Calculate the address
            [[maybe_unused]] Addr EA = XOp1 + XOp3 * sizeof(TPElem);

            // Calculate the read predicate. One boolean per byte,
            // initialised to all true.
            auto rdEn = std::vector<bool>(eCount * sizeof(TPElem), true);
            for (int i = 0; i < eCount; ++i) {
                if (GpOp_x[i]) {
                    continue;
                }

                // Mark each byte of the corresponding elem as false
                for (int j = 0; j < sizeof(TPElem); ++j) {
                    rdEn[i * sizeof(TPElem) + j] = false;
                }
            }
            '''

        zaWriteCode = '''
            // Here we write the data we just got from memory to the tile:
            if (V) {
                auto col = getTileVSlice<TPElem>(ZA, tile_idx, vec_idx);
                for(int i = 0; i < eCount; ++i) {
                    col[i] = GpOp_x[i] ? data[i] : 0;
                }
            } else {
                auto row = getTileHSlice<TPElem>(ZA, tile_idx, vec_idx);
                for(int i = 0; i < eCount; ++i) {
                    row[i] = GpOp_x[i] ? data[i] : 0;
                }
            }
        '''

        iop = InstObjParams(name, "Sme" + Name, "SmeLd1xSt1xOp",
                            {'code': code, 'za_write': zaWriteCode,
                             'op_class': opClass}, ['IsLoad',
                             'IsNonSpeculative'])
        header_output += SmeLd1xDeclare.subst(iop)
        exec_output += SmeLd1xExecute.subst(iop)
        exec_output += SmeLd1xInitiateAcc.subst(iop)
        exec_output += SmeLd1xCompleteAcc.subst(iop)
        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeLd1xExecDeclare.subst(substDict)

    def smeLdrInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoSM + smeZaWrite + '''
            // imm stores the vector offset. We do not have a tile number as
            // we target the whole accumulator array.
            // imm also stores the offset applied to the base memory access
            // register.
            // Op1 stores Rn, which is the base memory access register
            // Op2 stores Rv, which is the vector select register


            unsigned eCount = ArmStaticInst::getCurSmeVecLen<uint8_t>(
                            xc->tcBase());

            [[maybe_unused]] uint8_t vec_index = (WOp2 + imm) % eCount;

            // Calculate the address
            [[maybe_unused]] Addr EA = XOp1 + imm;
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeLdrStrOp",
                            {'code': code, 'op_class': opClass},
                            ['IsLoad', 'IsNonSpeculative'])
        header_output += SmeLdrDeclare.subst(iop)
        exec_output += SmeLdrExecute.subst(iop)
        exec_output += SmeLdrInitiateAcc.subst(iop)
        exec_output += SmeLdrCompleteAcc.subst(iop)

    def smeMovaExtractInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + '''
            // imm stores the tile index
            // op1 is the source SVE vector register
            // gp is the governing predecate register
            // op2 is the slice index register
            // v is the row/col select immediate - true for column accesses

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                xc->tcBase());

            uint8_t offset = imm & (0xf >> (findMsbSet(sizeof(TPElem))));
            uint8_t tile_idx = imm >> (4 - findMsbSet(sizeof(TPElem)));

            uint32_t vec_idx = (WOp2 + offset) % eCount;

            if (!v) { // Horizontal (row) access
                auto row = getTileHSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    if (!GpOp_x[i]) {
                        continue;
                    }

                    AA64FpOp1_x[i] = row[i];
                }
            } else { // Vertical (column) access
                auto col = getTileVSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    if (!GpOp_x[i]) {
                        continue;
                    }

                    AA64FpOp1_x[i] = col[i];
                }
            }
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeMovExtractOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeMovaExtractDeclare.subst(iop)
        exec_output += SmeTemplatedExecute.subst(iop)

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeMovaInsertInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index
            // op1 is the source SVE vector register
            // gp is the governing predecate register
            // op2 is the slice index register
            // v is the row/col select immediate - true for column accesses

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                xc->tcBase());

            uint8_t offset = imm & (0xf >> (findMsbSet(sizeof(TPElem))));
            uint8_t tile_idx = imm >> (4 - findMsbSet(sizeof(TPElem)));

            uint32_t vec_idx = (WOp2 + offset) % eCount;

            if (!v) { // Horizontal (row) access
                auto row = getTileHSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    if (!GpOp_x[i]) {
                        continue;
                    }

                    row[i] = AA64FpOp1_x[i];
                }
            } else { // Vertical (column) access
                auto col = getTileVSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    if (!GpOp_x[i]) {
                        continue;
                    }

                    col[i] = AA64FpOp1_x[i];
                }
            }
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeMovInsertOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeMovaInsertDeclare.subst(iop)
        exec_output += SmeTemplatedExecute.subst(iop)

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeMovaVecToTile2RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + r'''
            // Unpredicated MOVA: write two consecutive slices from two consecutive Z regs.
            // imm packed by decodeSmeMovaVecToTile2Regs as:
            //   [ 2:0]  ZAd_raw
            //   [ 7:3]  zn_group
            //   [10:8]  off_field   (raw; expand to even offset by <<1)
            //   [12:11] esize_code  (0=B,1=H,2=S,3=D)
            //
            const uint32_t ZAd_raw  = (imm >> 0) & 0x7;
            const uint32_t zn_group = (imm >> 3) & 0x1F;
            const uint32_t off_raw  = (imm >> 8) & 0x7;
            const uint32_t esz_code = (imm >> 11) & 0x3;

            const bool vertical = v; // V bit: 0=H, 1=V

            // Select element size in bytes
            const uint32_t esize = 1u << esz_code; // B=1,H=2,S=4,D=8

            // ZA tile index width depends on element size:
            //   .b -> ZA0 only
            //   .h -> ZA0..ZA1
            //   .s -> ZA0..ZA3
            //   .d -> ZA0..ZA7
            uint32_t ZAd = ZAd_raw;
            if (esz_code == 0)      ZAd &= 0u;
            else if (esz_code == 1) ZAd &= 1u;
            else if (esz_code == 2) ZAd &= 3u;
            else                    ZAd &= 7u;

            // slices = VL / esize
            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t slices   = (VL_bytes / esize);

            // Index register Ws is in WOp2 (as per your chosen op signature)
            const uint32_t index = (uint32_t)WOp2;

            // offset in spec is even: off_field * 2
            const uint32_t offset_even = (off_raw << 1);

            // Align to even slice start (nreg=2)
            const uint32_t base_even = index - (index & 1u);

            // Final slice modulo number of slices
            const uint32_t slice0 = (base_even + offset_even) % slices;
            const uint32_t slice1 = (slice0 + 1u) % slices;

            // Source Z registers: n = UInt(Zn:'0') => 2*zn_group
            const uint32_t z0_idx = (zn_group << 1);
            const uint32_t z1_idx = (zn_group << 1) + 1u;

            ArmISA::VecRegContainer z0, z1;
            xc->tcBase()->getReg(ArmISA::vecRegClass[z0_idx], &z0);
            xc->tcBase()->getReg(ArmISA::vecRegClass[z1_idx], &z1);

            auto writeSlice = [&](uint32_t slice, const ArmISA::VecRegContainer &zsrc) {
                const uint8_t *zb = zsrc.as<uint8_t>();

                if (!vertical) {
                    if (esize == 1) {
                        auto row = getTileHSlice<uint8_t>(ZA, ZAd, slice);
                        for (uint32_t i = 0; i < slices; ++i) row[i] = zb[i];
                    } else if (esize == 2) {
                        auto row = getTileHSlice<uint16_t>(ZA, ZAd, slice);
                        const uint16_t *p = (const uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) row[i] = p[i];
                    } else if (esize == 4) {
                        auto row = getTileHSlice<uint32_t>(ZA, ZAd, slice);
                        const uint32_t *p = (const uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) row[i] = p[i];
                    } else {
                        auto row = getTileHSlice<uint64_t>(ZA, ZAd, slice);
                        const uint64_t *p = (const uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) row[i] = p[i];
                    }
                } else {
                    if (esize == 1) {
                        auto col = getTileVSlice<uint8_t>(ZA, ZAd, slice);
                        for (uint32_t i = 0; i < slices; ++i) col[i] = zb[i];
                    } else if (esize == 2) {
                        auto col = getTileVSlice<uint16_t>(ZA, ZAd, slice);
                        const uint16_t *p = (const uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) col[i] = p[i];
                    } else if (esize == 4) {
                        auto col = getTileVSlice<uint32_t>(ZA, ZAd, slice);
                        const uint32_t *p = (const uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) col[i] = p[i];
                    } else {
                        auto col = getTileVSlice<uint64_t>(ZA, ZAd, slice);
                        const uint64_t *p = (const uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) col[i] = p[i];
                    }
                }
            };

            writeSlice(slice0, z0);
            writeSlice(slice1, z1);
        '''

        iop = InstObjParams(
            name,
            "Sme" + Name,
            "SmeMovaVecToTile2RegsOp",
            {'code': code, 'op_class': opClass},
            ['IsNonSpeculative']
        )

        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)

    def smeMovaTileToVec2RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + r'''
            // Unpredicated MOVA: read two consecutive slices into two consecutive Z regs.
            // imm packed identically to VecToTile:
            //   [ 2:0]  ZAn_raw
            //   [ 7:3]  zd_group
            //   [10:8]  off_field   (raw; expand to even offset by <<1)
            //   [12:11] esize_code  (0=B,1=H,2=S,3=D)
            
            const uint32_t ZAn_raw  = (imm >> 0) & 0x7;
            const uint32_t zd_group = (imm >> 3) & 0x1F;
            const uint32_t off_raw  = (imm >> 8) & 0x7;
            const uint32_t esz_code = (imm >> 11) & 0x3;

            const bool vertical = v; // V bit: 0=H, 1=V

            // Select element size in bytes
            const uint32_t esize = 1u << esz_code; // B=1,H=2,S=4,D=8

            // Mask ZA tile index based on element size
            uint32_t ZAn = ZAn_raw;
            if (esz_code == 0)      ZAn &= 0u;
            else if (esz_code == 1) ZAn &= 1u;
            else if (esz_code == 2) ZAn &= 3u;
            else                    ZAn &= 7u;

            // slices = VL / esize
            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t slices   = (VL_bytes / esize);

            // Index register Ws is in WOp2
            const uint32_t index = (uint32_t)WOp2;

            // offset in spec is even: off_field * 2
            const uint32_t offset_even = (off_raw << 1);

            // Align to even slice start (nreg=2)
            const uint32_t base_even = index - (index % 2);

            // Final slice modulo number of slices
            const uint32_t slice0 = (base_even + offset_even) % slices;
            const uint32_t slice1 = (slice0 + 1u) % slices;

            // Destination Z registers: d = UInt(Zd:'0') => 2*zd_group
            const uint32_t z0_idx = (zd_group << 1);
            const uint32_t z1_idx = (zd_group << 1) + 1u;

            ArmISA::VecRegContainer z0, z1;

            auto readSlice = [&](uint32_t slice, ArmISA::VecRegContainer &zdest) {
                uint8_t *zb = zdest.as<uint8_t>();

                if (!vertical) {
                    if (esize == 1) {
                        auto row = getTileHSlice<uint8_t>(ZA, ZAn, slice);
                        for (uint32_t i = 0; i < slices; ++i) zb[i] = row[i];
                    } else if (esize == 2) {
                        auto row = getTileHSlice<uint16_t>(ZA, ZAn, slice);
                        uint16_t *p = (uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = row[i];
                    } else if (esize == 4) {
                        auto row = getTileHSlice<uint32_t>(ZA, ZAn, slice);
                        uint32_t *p = (uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = row[i];
                    } else {
                        auto row = getTileHSlice<uint64_t>(ZA, ZAn, slice);
                        uint64_t *p = (uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = row[i];
                    }
                } else {
                    if (esize == 1) {
                        auto col = getTileVSlice<uint8_t>(ZA, ZAn, slice);
                        for (uint32_t i = 0; i < slices; ++i) zb[i] = col[i];
                    } else if (esize == 2) {
                        auto col = getTileVSlice<uint16_t>(ZA, ZAn, slice);
                        uint16_t *p = (uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = col[i];
                    } else if (esize == 4) {
                        auto col = getTileVSlice<uint32_t>(ZA, ZAn, slice);
                        uint32_t *p = (uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = col[i];
                    } else {
                        auto col = getTileVSlice<uint64_t>(ZA, ZAn, slice);
                        uint64_t *p = (uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = col[i];
                    }
                }
            };

            readSlice(slice0, z0);
            readSlice(slice1, z1);

            DPRINTF(Arm, "SmeMovaTileToVec2Regs: WOp2(idx)=%u offset=%u -> slice0=%u, slice1=%u | Moving ZA%u to Z%u and Z%u\n",
                index, offset_even, slice0, slice1, ZAn, z0_idx, z1_idx);

            xc->tcBase()->setReg(ArmISA::vecRegClass[z0_idx], &z0);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z1_idx], &z1);
        '''

        iop = InstObjParams(
            name,
            "Sme" + Name,
            "SmeMovaVecToTile2RegsOp", # Reusing the exact same base op class 
            {'code': code, 'op_class': opClass},
            ['IsNonSpeculative']
        )

        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)
    
    def smeMovaTileToVec4RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + r'''
            const uint32_t ZAn_raw  = (imm >> 0) & 0x7;
            const uint32_t zd_group = (imm >> 3) & 0x1F;
            const uint32_t off_raw  = (imm >> 8) & 0x7;
            const uint32_t esz_code = (imm >> 11) & 0x3;

            const bool vertical = v; 
            const uint32_t esize = 1u << esz_code; 

            uint32_t ZAn = ZAn_raw;
            if (esz_code == 0)      ZAn &= 0u;
            else if (esz_code == 1) ZAn &= 1u;
            else if (esz_code == 2) ZAn &= 3u;
            else                    ZAn &= 7u;

            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t slices   = (VL_bytes / esize);

            const uint32_t index = (uint32_t)WOp2;
            
            // Offset in spec is multiple of 4
            const uint32_t offset_mult4 = (off_raw << 2);
            
            // Align to base slice (nreg=4)
            const uint32_t base_aligned = index - (index % 4);

            const uint32_t slice0 = (base_aligned + offset_mult4) % slices;
            const uint32_t slice1 = (slice0 + 1u) % slices;
            const uint32_t slice2 = (slice0 + 2u) % slices;
            const uint32_t slice3 = (slice0 + 3u) % slices;

            // Destination Z registers (4 * zd_group)
            const uint32_t z0_idx = (zd_group << 2) + 0u;
            const uint32_t z1_idx = (zd_group << 2) + 1u;
            const uint32_t z2_idx = (zd_group << 2) + 2u;
            const uint32_t z3_idx = (zd_group << 2) + 3u;

            ArmISA::VecRegContainer z0, z1, z2, z3;

            auto readSlice = [&](uint32_t slice, ArmISA::VecRegContainer &zdest) {
                uint8_t *zb = zdest.as<uint8_t>();
                if (!vertical) {
                    if (esize == 1) {
                        auto row = getTileHSlice<uint8_t>(ZA, ZAn, slice);
                        for (uint32_t i = 0; i < slices; ++i) zb[i] = row[i];
                    } else if (esize == 2) {
                        auto row = getTileHSlice<uint16_t>(ZA, ZAn, slice);
                        uint16_t *p = (uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = row[i];
                    } else if (esize == 4) {
                        auto row = getTileHSlice<uint32_t>(ZA, ZAn, slice);
                        uint32_t *p = (uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = row[i];
                    } else {
                        auto row = getTileHSlice<uint64_t>(ZA, ZAn, slice);
                        uint64_t *p = (uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = row[i];
                    }
                } else {
                    if (esize == 1) {
                        auto col = getTileVSlice<uint8_t>(ZA, ZAn, slice);
                        for (uint32_t i = 0; i < slices; ++i) zb[i] = col[i];
                    } else if (esize == 2) {
                        auto col = getTileVSlice<uint16_t>(ZA, ZAn, slice);
                        uint16_t *p = (uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = col[i];
                    } else if (esize == 4) {
                        auto col = getTileVSlice<uint32_t>(ZA, ZAn, slice);
                        uint32_t *p = (uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = col[i];
                    } else {
                        auto col = getTileVSlice<uint64_t>(ZA, ZAn, slice);
                        uint64_t *p = (uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) p[i] = col[i];
                    }
                }
            };

            readSlice(slice0, z0);
            readSlice(slice1, z1);
            readSlice(slice2, z2);
            readSlice(slice3, z3);

            DPRINTF(Arm, "SmeMovaTileToVec4Regs: WOp2(idx)=%u offset=%u -> slices={%u,%u,%u,%u} | Moving ZA%u to Z%u-Z%u\n",
                    index, offset_mult4, slice0, slice1, slice2, slice3, ZAn, z0_idx, z3_idx);

            xc->tcBase()->setReg(ArmISA::vecRegClass[z0_idx], &z0);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z1_idx], &z1);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z2_idx], &z2);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z3_idx], &z3);
        '''

        iop = InstObjParams(
            name,
            "Sme" + Name,
            "SmeMovaVecToTile2RegsOp", # Safely inherit the base class used for 2-reg Rs passing
            {'code': code, 'op_class': opClass},
            ['IsNonSpeculative']
        )

        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)

    def smeMovaArrayToVec4RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + r'''
            const uint32_t zd_group = imm & 0x7;
            const uint32_t off3     = (imm >> 3) & 0x7;

            // VL DIV 8 gives us the total number of vectors (equal to SVL in bytes)
            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t vectors  = VL_bytes; 
            
            // Stride is vectors DIV 4
            const uint32_t vstride  = vectors / 4; 

            // Read vector select register W8-W11 (mapped to WOp2 by base class)
            const uint32_t vbase = (uint32_t)WOp2;
            
            // Initial vector calculation
            uint32_t vec = (vbase + off3) % vstride;

            // Calculate the 4 sequential destination Z registers
            const uint32_t z0_idx = (zd_group << 2) + 0u;
            const uint32_t z1_idx = (zd_group << 2) + 1u;
            const uint32_t z2_idx = (zd_group << 2) + 2u;
            const uint32_t z3_idx = (zd_group << 2) + 3u;

            ArmISA::VecRegContainer z0, z1, z2, z3;

            // Helper to extract a 1D vector from the ZA array
            auto readZAVector = [&](uint32_t v_idx, ArmISA::VecRegContainer &zdest) {
                uint8_t *zb = zdest.as<uint8_t>();
                // The entire ZA array acts identically to tile ZA0 when queried purely horizontally
                auto row = getTileHSlice<uint8_t>(ZA, 0, v_idx);
                for (uint32_t i = 0; i < VL_bytes; ++i) {
                    zb[i] = row[i];
                }
            };

            // Extract the 4 vectors separated by vstride
            uint32_t vec0 = vec;
            readZAVector(vec0, z0);
            
            uint32_t vec1 = vec0 + vstride;
            readZAVector(vec1, z1);
            
            uint32_t vec2 = vec1 + vstride;
            readZAVector(vec2, z2);
            
            uint32_t vec3 = vec2 + vstride;
            readZAVector(vec3, z3);

            DPRINTF(Arm, "SmeMovaArrayToVec4Regs: WOp2(idx)=%u offset=%u -> vectors={%u,%u,%u,%u} | Moving to Z%u-Z%u\n",
                    vbase, off3, vec0, vec1, vec2, vec3, z0_idx, z3_idx);

            // Write directly to architectural state
            xc->tcBase()->setReg(ArmISA::vecRegClass[z0_idx], &z0);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z1_idx], &z1);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z2_idx], &z2);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z3_idx], &z3);
        '''

        iop = InstObjParams(
            name,
            "Sme" + Name,
            "SmeMovaVecToTile2RegsOp", 
            {'code': code, 'op_class': opClass},
            ['IsNonSpeculative']
        )

        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)

    def smeMovaArrayToVec2RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + r'''
            const uint32_t zd_group = imm & 0xF;
            const uint32_t off3     = (imm >> 4) & 0x7;

            // VL DIV 8 gives us the total number of vectors (equal to SVL in bytes)
            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t vectors  = VL_bytes; 
            
            // Stride is vectors DIV 2 for the 2-register variant
            const uint32_t vstride  = vectors / 2; 

            // Read vector select register W8-W11 (mapped to WOp2 by base class)
            const uint32_t vbase = (uint32_t)WOp2;
            
            // Initial vector calculation
            uint32_t vec = (vbase + off3) % vstride;

            // Calculate the 2 sequential destination Z registers (shift by 1 because nreg=2)
            const uint32_t z0_idx = (zd_group << 1) + 0u;
            const uint32_t z1_idx = (zd_group << 1) + 1u;

            ArmISA::VecRegContainer z0, z1;

            // Helper to extract a 1D vector from the ZA array
            auto readZAVector = [&](uint32_t v_idx, ArmISA::VecRegContainer &zdest) {
                uint8_t *zb = zdest.as<uint8_t>();
                auto row = getTileHSlice<uint8_t>(ZA, 0, v_idx);
                for (uint32_t i = 0; i < VL_bytes; ++i) {
                    zb[i] = row[i];
                }
            };

            // Extract the 2 vectors separated by vstride
            uint32_t vec0 = vec;
            readZAVector(vec0, z0);
            
            uint32_t vec1 = vec0 + vstride;
            readZAVector(vec1, z1);

            DPRINTF(Arm, "SmeMovaArrayToVec2Regs: WOp2(idx)=%u offset=%u -> vectors={%u,%u} | Moving to Z%u-Z%u\n",
                    vbase, off3, vec0, vec1, z0_idx, z1_idx);

            // Write directly to architectural state
            xc->tcBase()->setReg(ArmISA::vecRegClass[z0_idx], &z0);
            xc->tcBase()->setReg(ArmISA::vecRegClass[z1_idx], &z1);
        '''

        iop = InstObjParams(
            name,
            "Sme" + Name,
            "SmeMovaVecToTile2RegsOp", 
            {'code': code, 'op_class': opClass},
            ['IsNonSpeculative']
        )

        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)

    def smeMovaVecToArray4RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + r'''
            const uint32_t zn_group = imm & 0x7;
            const uint32_t off3     = (imm >> 3) & 0x7;

            // VL DIV 8 gives us the total number of vectors (equal to SVL in bytes)
            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t vectors  = VL_bytes; 
            
            // Stride is vectors DIV 4
            const uint32_t vstride  = vectors / 4; 

            // Read vector select register W8-W11 (mapped to WOp2 by base class)
            const uint32_t vbase = (uint32_t)WOp2;
            
            // Initial vector calculation
            uint32_t vec = (vbase + off3) % vstride;

            // Calculate the 4 sequential source Z registers
            const uint32_t z0_idx = (zn_group << 2) + 0u;
            const uint32_t z1_idx = (zn_group << 2) + 1u;
            const uint32_t z2_idx = (zn_group << 2) + 2u;
            const uint32_t z3_idx = (zn_group << 2) + 3u;

            // Read from architectural Z registers into containers
            ArmISA::VecRegContainer z0, z1, z2, z3;
            xc->tcBase()->getReg(ArmISA::vecRegClass[z0_idx], &z0);
            xc->tcBase()->getReg(ArmISA::vecRegClass[z1_idx], &z1);
            xc->tcBase()->getReg(ArmISA::vecRegClass[z2_idx], &z2);
            xc->tcBase()->getReg(ArmISA::vecRegClass[z3_idx], &z3);

            // Helper to push a 1D vector directly into the ZA array
            auto writeZAVector = [&](uint32_t v_idx, const ArmISA::VecRegContainer &zsrc) {
                const uint8_t *zb = zsrc.as<uint8_t>();
                // getTileHSlice returns a mutable reference to the matrix data
                auto row = getTileHSlice<uint8_t>(ZA, 0, v_idx);
                for (uint32_t i = 0; i < VL_bytes; ++i) {
                    row[i] = zb[i];
                }
            };

            // Push the 4 vectors separated by vstride back into ZA
            uint32_t vec0 = vec;
            writeZAVector(vec0, z0);
            
            uint32_t vec1 = vec0 + vstride;
            writeZAVector(vec1, z1);
            
            uint32_t vec2 = vec1 + vstride;
            writeZAVector(vec2, z2);
            
            uint32_t vec3 = vec2 + vstride;
            writeZAVector(vec3, z3);

            DPRINTF(Arm, "SmeMovaVecToArray4Regs: WOp2(idx)=%u offset=%u -> vectors={%u,%u,%u,%u} | Pushed Z%u-Z%u into ZA\n",
                    vbase, off3, vec0, vec1, vec2, vec3, z0_idx, z3_idx);
        '''

        iop = InstObjParams(
            name,
            "Sme" + Name,
            "SmeMovaVecToTile2RegsOp", 
            {'code': code, 'op_class': opClass},
            ['IsNonSpeculative']
        )

        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)
    
    def smeMovaVecToArray2RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + r'''
