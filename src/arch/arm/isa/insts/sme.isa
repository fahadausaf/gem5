            writeZAVector(vec1, z1);

            DPRINTF(Arm, "SmeMovaVecToArray2Regs: WOp2(idx)=%u offset=%u -> vectors={%u,%u} | Pushed Z%u-Z%u into ZA\n",
                    vbase, off3, vec0, vec1, z0_idx, z1_idx);
        '''

