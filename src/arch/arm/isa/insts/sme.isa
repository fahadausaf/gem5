// @file Definition of SME instructions.


let {{

    header_output = ""
    decoder_output = ""
    exec_output = ""

    header_output += "#include \"base/trace.hh\"\n";
    header_output += "#include \"arch/arm/insts/fplib.hh\"\n";

    def smeAddInst(name, Name, opClass, types, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index
            // op1 is the source SVE vector register
            // gp1 is the row predecate register
            // gp2 is the column predecate register

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                xc->tcBase());

            uint8_t tile_index = imm & 0x7;

            // View the tile as the correct data type, extract the sub-tile
            auto tile = getTile<TPElem>(ZA, tile_index);
            '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeAddOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeAddDeclare.subst(iop)
        exec_output += SmeTemplatedExecute.subst(iop)

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeAddVlInst(name, Name, opClass, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoPstate + '''
            // dest is the 64-bit destination register
            // op1 is the 64-bit source register
            // imm is a signed multiplier
            '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeAddVlOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeAddVlDeclare.subst(iop)
        exec_output += SmeExecute.subst(iop)

    def smeLd1xInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile number as well as the vector offset. The
            // size of the fields changes based on the data type being used.
            // XOp1 stores Rn
            // GpOp stores the governing predicate register
            // WOp2 stores Rs - the vector index register
            // XOp3 stores Rm - the offset register (applied to Rn)


            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                            xc->tcBase());

            uint8_t offset = imm & (0xf >> (findMsbSet(sizeof(TPElem))));
            [[maybe_unused]] uint8_t tile_idx =
                imm >> (4 - findMsbSet(sizeof(TPElem)));
            [[maybe_unused]] uint8_t vec_idx = (WOp2 + offset) % eCount;

            // Calculate the address
            [[maybe_unused]] Addr EA = XOp1 + XOp3 * sizeof(TPElem);

            // Calculate the read predicate. One boolean per byte,
            // initialised to all true.
            auto rdEn = std::vector<bool>(eCount * sizeof(TPElem), true);
            for (int i = 0; i < eCount; ++i) {
                if (GpOp_x[i]) {
                    continue;
                }

                // Mark each byte of the corresponding elem as false
                for (int j = 0; j < sizeof(TPElem); ++j) {
                    rdEn[i * sizeof(TPElem) + j] = false;
                }
            }
            '''

        zaWriteCode = '''
            // Here we write the data we just got from memory to the tile:
            if (V) {
                auto col = getTileVSlice<TPElem>(ZA, tile_idx, vec_idx);
                for(int i = 0; i < eCount; ++i) {
                    col[i] = GpOp_x[i] ? data[i] : 0;
                }
            } else {
                auto row = getTileHSlice<TPElem>(ZA, tile_idx, vec_idx);
                for(int i = 0; i < eCount; ++i) {
                    row[i] = GpOp_x[i] ? data[i] : 0;
                }
            }
        '''

        iop = InstObjParams(name, "Sme" + Name, "SmeLd1xSt1xOp",
                            {'code': code, 'za_write': zaWriteCode,
                             'op_class': opClass}, ['IsLoad',
                             'IsNonSpeculative'])
        header_output += SmeLd1xDeclare.subst(iop)
        exec_output += SmeLd1xExecute.subst(iop)
        exec_output += SmeLd1xInitiateAcc.subst(iop)
        exec_output += SmeLd1xCompleteAcc.subst(iop)
        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeLd1xExecDeclare.subst(substDict)

    def smeLdrInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoSM + smeZaWrite + '''
            // imm stores the vector offset. We do not have a tile number as
            // we target the whole accumulator array.
            // imm also stores the offset applied to the base memory access
            // register.
            // Op1 stores Rn, which is the base memory access register
            // Op2 stores Rv, which is the vector select register


            unsigned eCount = ArmStaticInst::getCurSmeVecLen<uint8_t>(
                            xc->tcBase());

            [[maybe_unused]] uint8_t vec_index = (WOp2 + imm) % eCount;

            // Calculate the address
            [[maybe_unused]] Addr EA = XOp1 + imm;
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeLdrStrOp",
                            {'code': code, 'op_class': opClass},
                            ['IsLoad', 'IsNonSpeculative'])
        header_output += SmeLdrDeclare.subst(iop)
        exec_output += SmeLdrExecute.subst(iop)
        exec_output += SmeLdrInitiateAcc.subst(iop)
        exec_output += SmeLdrCompleteAcc.subst(iop)

    def smeMovaExtractInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + '''
            // imm stores the tile index
            // op1 is the source SVE vector register
            // gp is the governing predecate register
            // op2 is the slice index register
            // v is the row/col select immediate - true for column accesses

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                xc->tcBase());

            uint8_t offset = imm & (0xf >> (findMsbSet(sizeof(TPElem))));
            uint8_t tile_idx = imm >> (4 - findMsbSet(sizeof(TPElem)));

            uint32_t vec_idx = (WOp2 + offset) % eCount;

            if (!v) { // Horizontal (row) access
                auto row = getTileHSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    if (!GpOp_x[i]) {
                        continue;
                    }

                    AA64FpOp1_x[i] = row[i];
                }
            } else { // Vertical (column) access
                auto col = getTileVSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    if (!GpOp_x[i]) {
                        continue;
                    }

                    AA64FpOp1_x[i] = col[i];
                }
            }
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeMovExtractOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeMovaExtractDeclare.subst(iop)
        exec_output += SmeTemplatedExecute.subst(iop)

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeMovaInsertInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index
            // op1 is the source SVE vector register
            // gp is the governing predecate register
            // op2 is the slice index register
            // v is the row/col select immediate - true for column accesses

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                xc->tcBase());

            uint8_t offset = imm & (0xf >> (findMsbSet(sizeof(TPElem))));
            uint8_t tile_idx = imm >> (4 - findMsbSet(sizeof(TPElem)));

            uint32_t vec_idx = (WOp2 + offset) % eCount;

            if (!v) { // Horizontal (row) access
                auto row = getTileHSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    if (!GpOp_x[i]) {
                        continue;
                    }

                    row[i] = AA64FpOp1_x[i];
                }
            } else { // Vertical (column) access
                auto col = getTileVSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    if (!GpOp_x[i]) {
                        continue;
                    }

                    col[i] = AA64FpOp1_x[i];
                }
            }
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeMovInsertOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeMovaInsertDeclare.subst(iop)
        exec_output += SmeTemplatedExecute.subst(iop)

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeMovaVecToTile2RegsInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + r'''
            // Unpredicated MOVA: write two consecutive slices from two consecutive Z regs.
            // imm packed by decodeSmeMovaVecToTile2Regs as:
            //   [ 2:0]  ZAd_raw
            //   [ 7:3]  zn_group
            //   [10:8]  off_field   (raw; expand to even offset by <<1)
            //   [12:11] esize_code  (0=B,1=H,2=S,3=D)
            //
            const uint32_t ZAd_raw  = (imm >> 0) & 0x7;
            const uint32_t zn_group = (imm >> 3) & 0x1F;
            const uint32_t off_raw  = (imm >> 8) & 0x7;
            const uint32_t esz_code = (imm >> 11) & 0x3;

            const bool vertical = v; // V bit: 0=H, 1=V

            // Select element size in bytes
            const uint32_t esize = 1u << esz_code; // B=1,H=2,S=4,D=8

            // ZA tile index width depends on element size:
            //   .b -> ZA0 only
            //   .h -> ZA0..ZA1
            //   .s -> ZA0..ZA3
            //   .d -> ZA0..ZA7
            uint32_t ZAd = ZAd_raw;
            if (esz_code == 0)      ZAd &= 0u;
            else if (esz_code == 1) ZAd &= 1u;
            else if (esz_code == 2) ZAd &= 3u;
            else                    ZAd &= 7u;

            // slices = VL / esize
            const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
            const uint32_t slices   = (VL_bytes / esize);

            // Index register Ws is in WOp2 (as per your chosen op signature)
            const uint32_t index = (uint32_t)WOp2;

            // offset in spec is even: off_field * 2
            const uint32_t offset_even = (off_raw << 1);

            // Align to even slice start (nreg=2)
            const uint32_t base_even = index - (index & 1u);

            // Final slice modulo number of slices
            const uint32_t slice0 = (base_even + offset_even) % slices;
            const uint32_t slice1 = (slice0 + 1u) % slices;

            // Source Z registers: n = UInt(Zn:'0') => 2*zn_group
            const uint32_t z0_idx = (zn_group << 1);
            const uint32_t z1_idx = (zn_group << 1) + 1u;

            ArmISA::VecRegContainer z0, z1;
            xc->tcBase()->getReg(ArmISA::vecRegClass[z0_idx], &z0);
            xc->tcBase()->getReg(ArmISA::vecRegClass[z1_idx], &z1);

            auto writeSlice = [&](uint32_t slice, const ArmISA::VecRegContainer &zsrc) {
                const uint8_t *zb = zsrc.as<uint8_t>();

                if (!vertical) {
                    if (esize == 1) {
                        auto row = getTileHSlice<uint8_t>(ZA, ZAd, slice);
                        for (uint32_t i = 0; i < slices; ++i) row[i] = zb[i];
                    } else if (esize == 2) {
                        auto row = getTileHSlice<uint16_t>(ZA, ZAd, slice);
                        const uint16_t *p = (const uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) row[i] = p[i];
                    } else if (esize == 4) {
                        auto row = getTileHSlice<uint32_t>(ZA, ZAd, slice);
                        const uint32_t *p = (const uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) row[i] = p[i];
                    } else {
                        auto row = getTileHSlice<uint64_t>(ZA, ZAd, slice);
                        const uint64_t *p = (const uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) row[i] = p[i];
                    }
                } else {
                    if (esize == 1) {
                        auto col = getTileVSlice<uint8_t>(ZA, ZAd, slice);
                        for (uint32_t i = 0; i < slices; ++i) col[i] = zb[i];
                    } else if (esize == 2) {
                        auto col = getTileVSlice<uint16_t>(ZA, ZAd, slice);
                        const uint16_t *p = (const uint16_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) col[i] = p[i];
                    } else if (esize == 4) {
                        auto col = getTileVSlice<uint32_t>(ZA, ZAd, slice);
                        const uint32_t *p = (const uint32_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) col[i] = p[i];
                    } else {
                        auto col = getTileVSlice<uint64_t>(ZA, ZAd, slice);
                        const uint64_t *p = (const uint64_t*)zb;
                        for (uint32_t i = 0; i < slices; ++i) col[i] = p[i];
                    }
                }
            };

            writeSlice(slice0, z0);
            writeSlice(slice1, z1);
        '''

        iop = InstObjParams(
            name,
            "Sme" + Name,
            "SmeMovaVecToTile2RegsOp",
            {'code': code, 'op_class': opClass},
            ['IsNonSpeculative']
        )

        header_output += SmeMovaVecToTile2RegsDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)

    def smeCvtMvInst(name, Name, opClass, custom_code=None):
        global header_output, decoder_output, exec_output

        # If caller supplies code, use it; otherwise use default stub.
        if custom_code is None:
            custom_code = r'''
                panic("smeCvtMvInst used without custom_code");
            '''

        code = smEnCheckCodeNoZA + custom_code

        iop = InstObjParams(name, "Sme" + Name, "SmeCvtMvOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])

        header_output += SmeCvtMvDeclare.subst(iop)
        exec_output   += SmeExecute.subst(iop)


    def smeMsrInst(name, Name, opClass, op):
        global header_output, decoder_output, exec_output
        code = '''
            if (FullSystem) {
                fault = this->checkSmeAccess(xc->tcBase(), Cpsr, Cpacr64);
                if (fault != NoFault) {
                    return fault;
                }
            }
        ''' + op

        iop = InstObjParams(name, "Sme" + Name, "ImmOp64",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative', 'IsSerializeAfter'])
        header_output += SMEMgmtDeclare.subst(iop)
        exec_output += SmeExecute.subst(iop)

    def smeFPOPInst(name, Name, opClass, srcTypes, dstTypes, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index
            // op1 is the first SVE vector register
            // gp1 is the predecate register corresponding to the first
            //      SVE vector register
            // gp2 is the predecate register corresponding to the second
            //      SVE vector register
            // op2 is the second SVE vector register

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPDElem>(
                xc->tcBase());
            '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeOPOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeFPOPDeclare.subst(iop)
        exec_output += SmeDualTemplatedExecute.subst(iop)
        for src, dst in zip(srcTypes, dstTypes):
            substDict = {'targs' : "{}, {}".format(src, dst),
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeIntOPInst(name, Name, opClass, src1Types, src2Types, dstTypes, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index
            // op1 is the first SVE vector register
            // gp1 is the predecate register corresponding to the first
            //      SVE vector register
            // gp2 is the predecate register corresponding to the second
            //      SVE vector register
            // op2 is the second SVE vector register

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPDElem>(
                xc->tcBase());
            '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeOPOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeIntOPDeclare.subst(iop)
        exec_output += SmeTripleTemplatedExecute.subst(iop)
        for src1, src2, dst in zip(src1Types, src2Types, dstTypes):
            substDict = {'targs' : "{}, {}, {}".format(src1, src2, dst),
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    def smeRdsvlInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoPstate + '''
            // dest is the 64-bit destination register
            // imm is a signed multiplier

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<uint8_t>(
                xc->tcBase());

            Dest64 = eCount * imm;
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeRdsvlOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeRdsvlDeclare.subst(iop)
        exec_output += SmeExecute.subst(iop)

    def smeSt1xInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + '''
            // imm stores the tile number as well as the vector offset. The
            // size of the fields changes based on the data type being used.
            // XOp1 stores Rn
            // GpOp stores the governing predicate register
            // WOp2 stores Rs - the vector index register
            // XOp3 stores Rm - the offset register (applied to Rn)


            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPElem>(
                            xc->tcBase());

            uint8_t offset = imm & (0xf >> (findMsbSet(sizeof(TPElem))));
            [[maybe_unused]] uint8_t tile_idx =
                imm >> (4 - findMsbSet(sizeof(TPElem)));
            [[maybe_unused]] uint8_t vec_idx = (WOp2 + offset) % eCount;

            // Calculate the address
            [[maybe_unused]] Addr EA = XOp1 + XOp3 * sizeof(TPElem);

            // Calculate the write predicate. One boolean per byte,
            // initialised to all true.
            auto wrEn = std::vector<bool>(eCount * sizeof(TPElem), true);
            for (int i = 0; i < eCount; ++i) {
                if (GpOp_x[i]) {
                    continue;
                }

                // Mark each byte of the corresponding elem as false
                for (int j = 0; j < sizeof(TPElem); ++j) {
                    wrEn[i * sizeof(TPElem) + j] = false;
                }
            }

            // Extract the data to be stored from the tile. We don't worry
            // about the predicate here as that's already handled by wrEn.
            TPElem data[MaxSmeVecLenInBytes / sizeof(TPElem)];
            if(V) {
                auto col = getTileVSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    data[i] = col[i];
                }
            } else {
                auto row = getTileHSlice<TPElem>(ZA, tile_idx, vec_idx);
                for (int i = 0; i < eCount; ++i) {
                    data[i] = row[i];
                }
            }
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeLd1xSt1xOp",
                            {'code': code, 'op_class': opClass},
                            ['IsStore', 'IsNonSpeculative'])
        header_output += SmeSt1xDeclare.subst(iop)
        exec_output += SmeSt1xExecute.subst(iop)
        exec_output += SmeSt1xInitiateAcc.subst(iop)
        exec_output += SmeSt1xCompleteAcc.subst(iop)
        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeSt1xExecDeclare.subst(substDict)

    def smeStrInst(name, Name, opClass):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoSM + '''
            // imm stores the vector offset. We do not have a tile number
            // as we target the whole accumulator array.
            // imm also stores the offset applied to the base memory access
            // register.
            // Op1 stores Rn, which is the base memory access register
            // Op2 stores Rv, which is the vector select register


            unsigned eCount = ArmStaticInst::getCurSmeVecLen<uint8_t>(
                            xc->tcBase());

            uint8_t vec_index = (WOp2 + imm) % eCount;

            auto row = getTileHSlice<uint8_t>(ZA, 0, vec_index);

            // Calculate the address
            [[maybe_unused]] Addr EA = XOp1 + imm;

            uint8_t data[MaxSmeVecLenInBytes];

            // Update data which will then by used to store the row to memory
            for (int i = 0; i < eCount; ++i) {
                data[i] = row[i];
            }
            '''

        iop = InstObjParams(name, "Sme" + Name, "SmeLdrStrOp",
                            {'code': code, 'op_class': opClass},
                            ['IsStore', 'IsNonSpeculative'])
        header_output += SmeStrDeclare.subst(iop)
        exec_output += SmeStrExecute.subst(iop)
        exec_output += SmeStrInitiateAcc.subst(iop)
        exec_output += SmeStrCompleteAcc.subst(iop)

    def smeZeroInst(name, Name, opClass, types):
        global header_output, decoder_output, exec_output
        code = smEnCheckCodeNoSM + smeZaWrite + '''
            // When zeroing tiles, we use  64-bit elements. This means
            // that we have up to eight subtiles to clear in the ZA tile.

            ZA = ZA;

            for (int i = 0; i < 8; ++i) {
                if (((imm >> i) & 0x1) == 0x1) {
                    getTile<TPElem>(ZA, i).zero();
                }
            }'''

        iop = InstObjParams(name, "Sme" + Name, "SmeZeroOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeZeroDeclare.subst(iop)
        exec_output += SmeTemplatedExecute.subst(iop)

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    # ADDHA
    addCode = '''
        for (int col = 0; col < eCount; ++col) {
            TPElem val = AA64FpOp1_x[col];

            for (int row = 0; row < eCount; ++row) {
                if (!(GpOp1_x[row] && GpOp2_x[col])) {
                    continue;
                }

                tile[col][row] += val;
            }
        }
        '''
    smeAddInst('addha', "Addha", "SimdAddOp", ['int32_t', 'int64_t'], addCode)

    # ADDSPL
    addSplCode = '''
        Dest64 = imm * ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        // Divide down to get the predicate length in bytes
        Dest64 /= 8;
        Dest64 += XOp1;
    '''
    smeAddVlInst('addspl', "Addspl", "SimdAddOp", addSplCode)

    # ADDSVL
    addSvlCode = '''
        Dest64 = imm * ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        Dest64 += XOp1;
    '''
    smeAddVlInst('addsvl', "Addsvl", "SimdAddOp", addSvlCode)

    # ADDVA
    addCode = '''
        for (int row = 0; row < eCount; ++row) {
            TPElem val = AA64FpOp1_x[row];

            for (int col = 0; col < eCount; ++col) {
                if (!(GpOp1_x[row] && GpOp2_x[col])) {
                    continue;
                }

                tile[col][row] += val;
            }
        }
        '''
    smeAddInst('addva', "Addva", "SimdAddOp", ['int32_t', 'int64_t'], addCode)

    # BFMOPA
    # BFMOPS

    # FMOPA (non-widening)
    fmopxCode = '''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        for (int j = 0; j < eCount; ++j) {
            if (!GpOp1_xd[j]) {
                continue;
            }

            TPDElem val1 = AA64FpOp1_xd[j];

            for (int i = 0; i < eCount; ++i) {
                if (!GpOp2_xd[i]) {
                    continue;
                }

                TPDElem val2 = AA64FpOp2_xd[i];

        #if %s
                val2 = fplibNeg(val2);
        #endif

                TPDElem res = fplibMul(val1, val2, fpscr);

                tile[j][i] = fplibAdd(tile[j][i],
                                      res, fpscr);
            }
        }
        '''
    smeFPOPInst('fmopa', 'Fmopa', 'MatrixOPOp', ['uint32_t', 'uint64_t'],
              ['uint32_t', 'uint64_t'], fmopxCode % "0")

    # FMOPA (widening)
    wideningFmopxCode = '''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        for (int j = 0; j < eCount; ++j) {
            if (!GpOp1_xd[j]) {
                continue;
            }
            for (int i = 0; i < eCount; ++i) {
                if (!GpOp2_xd[i]) {
                    continue;
                }

                for (int k = 0; k < 2; ++k) {
                    TPSElem temp1 = (AA64FpOp1_xd[j] >> (16 * k)) & 0xFFFF;
                    TPSElem temp2 = (AA64FpOp2_xd[j] >> (16 * k)) & 0xFFFF;
                    TPDElem val1 = fplibConvert<TPSElem, TPDElem>(temp1,
                        FPCRRounding(fpscr), fpscr);
                    TPDElem val2 = fplibConvert<TPSElem, TPDElem>(temp2,
                        FPCRRounding(fpscr), fpscr);

        #if %s
                    val2 = fplibNeg(val2);
        #endif

                    TPDElem res = fplibMul(val1, val2, fpscr);
                    tile[j][i] = fplibAdd(tile[j][i], res, fpscr);
                }
            }
        }
        '''
    smeFPOPInst('fmopa', 'FmopaWidening', 'MatrixOPOp',
              ['uint16_t'], ['uint32_t'], wideningFmopxCode % "0")

    # FMOPS (non-widening)
    smeFPOPInst('fmops', 'Fmops', 'MatrixOPOp', ['uint32_t', 'uint64_t'],
              ['uint32_t', 'uint64_t'], fmopxCode % "1")

    # FMOPS (widening)
    smeFPOPInst('fmops', 'FmopsWidening', 'MatrixOPOp',
              ['uint16_t'], ['uint32_t'], wideningFmopxCode % "1")

    
    # FTMOPA (non-widening, TMOP sparse outer product)
    #
    # Types:
    #   - Half-precision variant:  TPDElem = uint16_t
    #   - Single-precision variant: TPDElem = uint32_t
    #
    # imm layout (from decode):
    #   [ 2:0]  za_tile   (ZAda)
    #   [ 4:3]  index     (i2)
    #   [ 9:5]  zn_base   (multi-vector group index)
    #   [14:10] zm
    #   [19:15] zk
    #
    ftmopaCode = r'''
        FPSCR fpscr = (FPSCR)Fpscr;

        // Unpack imm
        const uint64_t raw   = imm;
        const uint8_t zaTile = (raw >> 0) & 0x7;
        const uint8_t index  = (raw >> 3) & 0x3;
        const uint8_t znBase = (raw >> 5) & 0x1F;  // multi-vector group index
        const uint8_t zmIdx  = (raw >> 10) & 0x1F;
        const uint8_t zkIdx  = (raw >> 15) & 0x1F;

        // View ZA tile as TPDElem
        auto tile = getTile<TPDElem>(ZA, zaTile);

        // dim = VL / esize  (eCount already gives us VL / sizeof(TPDElem))
        const unsigned dim    = eCount;
        const unsigned csize  = 2 * dim;          // (VL*2)/esize
        const unsigned segBase = index * csize;   // starting bit of ctrl segment

        // --- Debug trace for FTMOPA execution ---
        DPRINTF(Arm,
            "SmeFtmopa: zaTile=%u index=%u znBase=%u zmIdx=%u zkIdx=%u "
            "dim=%u segBase=%u\n",
            (unsigned)zaTile,
            (unsigned)index,
            (unsigned)znBase,
            (unsigned)zmIdx,
            (unsigned)zkIdx,
            (unsigned)dim,
            (unsigned)segBase);

        // --- Read Zk (control vector) ---
        ArmISA::VecRegContainer zk;
        auto zkRegId = ArmISA::vecRegClass[zkIdx];
        xc->tcBase()->getReg(zkRegId, &zk);
        const uint8_t *zkBytes = zk.as<uint8_t>();

        auto ctrlBit = [&](unsigned bitIdx) -> bool {
            unsigned byte = bitIdx / 8;
            unsigned bit  = bitIdx % 8;
            return (zkBytes[byte] >> bit) & 0x1;
        };

        // --- Read Zn1, Zn2, Zm as TPDElem arrays ---
        const uint8_t zn1Idx = (uint8_t)(2 * znBase);
        const uint8_t zn2Idx = (uint8_t)(2 * znBase + 1);

        ArmISA::VecRegContainer zn1, zn2, zm;
        auto zn1RegId = ArmISA::vecRegClass[zn1Idx];
        auto zn2RegId = ArmISA::vecRegClass[zn2Idx];
        auto zmRegId  = ArmISA::vecRegClass[zmIdx];

        xc->tcBase()->getReg(zn1RegId, &zn1);
        xc->tcBase()->getReg(zn2RegId, &zn2);
        xc->tcBase()->getReg(zmRegId,  &zm);

        const TPDElem *zn1Elems = zn1.as<TPDElem>();
        const TPDElem *zn2Elems = zn2.as<TPDElem>();
        const TPDElem *zmElems  = zm.as<TPDElem>();

        // --- Main sparse outer product loop ---
        for (unsigned row = 0; row < dim; ++row) {
            for (unsigned col = 0; col < dim; ++col) {
                // Select 1-in-2 element from {Zn1[row], Zn2[row]}
                TPDElem elem1 = (TPDElem)0;
                unsigned picked = 0;

                for (unsigned r = 0; r < 2; ++r) {
                    const unsigned bitIndex = segBase + 2 * col + r;

                    if (!picked && ctrlBit(bitIndex)) {
                        elem1 = (r == 0) ? zn1Elems[row] : zn2Elems[row];
                        picked = 1;
                    }
                }

                const TPDElem elem2 = zmElems[col];
                TPDElem sum = tile[col][row]; // same layout as FMOPA

                // ZA-targeting FP behavior: FPMulAdd_ZA(sum, elem1, elem2, FPCR)
                TPDElem prod = fplibMul(elem1, elem2, fpscr);
                TPDElem res  = fplibAdd(sum, prod, fpscr);

                // Optional fine-grain debug for first few rows/cols
                if (row < 2 && col < 2) {
                    DPRINTF(Arm,
                        "FTMOPA ZA[%u,%u]: elem1=%#x elem2=%#x "
                        "sum=%#x -> res=%#x\n",
                        (unsigned)row,
                        (unsigned)col,
                        (unsigned)elem1,
                        (unsigned)elem2,
                        (unsigned)sum,
                        (unsigned)res);
                }

                tile[col][row] = res;
            }
        }
    '''

    # Instantiate for half-precision and single-precision (non-widening)
    smeFPOPInst('ftmopa', 'Ftmopa', 'MatrixOPOp',
                ['uint16_t', 'uint32_t'],   # TPSElem (unused, but must match)
                ['uint16_t', 'uint32_t'],   # TPDElem
                ftmopaCode)

    
        # FTMOPA (widening, 2-way, FP16 -> FP32, TMOP sparse outer product)
    #
    #  - Sources: FP16 lanes in {Zn1.h, Zn2.h} and Zm.h
    #  - Destination: ZA.s (FP32)
    #  - Semantics (per element ZA[row,col]):
    #
    #        ZA[row,col] += dot( erow[0..1], ecol[0..1] )
    #
    #    where erow[0..1] come from {Zn1, Zn2} and ecol[0..1] from Zm,
    #    and 2-in-4 structure is defined by TMOP control bits in Zk.
    #
    ftmopaWideningCode = r'''
        FPSCR fpscr = (FPSCR)Fpscr;

        // --- Unpack imm (same layout as non-widening FTMOPA) ---
        const uint64_t raw    = imm;
        const uint8_t  zaTile = (raw >> 0) & 0x7;
        const uint8_t  index  = (raw >> 3) & 0x3;
        const uint8_t  znBase = (raw >> 5) & 0x1F;   // multi-vector group
        const uint8_t  zmIdx  = (raw >> 10) & 0x1F;
        const uint8_t  zkIdx  = (raw >> 15) & 0x1F;

        // ZA tile as FP32 (TPDElem is uint32_t for this widening variant)
        auto tile = getTile<TPDElem>(ZA, zaTile);

        // For widening FTMOPA:
        //
        //   - ZA is ZA.s (32-bit elements)
        //   - dim = VL / 32  (matrix is dim x dim)
        //
        // eCount is computed by smeFPOPInst as the number of TPDElem
        // elements in a vector, so here eCount == dim.
        const unsigned dim = eCount;

        // Each TMOP control segment has 4*dim bits
        // (4 bits per column: 2 positions × 2 source vectors).
        const unsigned csize   = 4 * dim;
        const unsigned segBase = index * csize;

        // --- Debug trace to confirm decode/execute wiring ---
        DPRINTF(Arm,
            "SmeFtmopaWidening: zaTile=%u index=%u znBase=%u zmIdx=%u "
            "zkIdx=%u dim=%u segBase=%u\n",
            (unsigned)zaTile,
            (unsigned)index,
            (unsigned)znBase,
            (unsigned)zmIdx,
            (unsigned)zkIdx,
            (unsigned)dim,
            (unsigned)segBase);

        // --- Read Zk (TMOP control) as bytes ---
        ArmISA::VecRegContainer zk;
        auto zkRegId = ArmISA::vecRegClass[zkIdx];
        xc->tcBase()->getReg(zkRegId, &zk);
        const uint8_t *zkBytes = zk.as<uint8_t>();

        auto ctrlBit = [&](unsigned bitIdx) -> bool {
            unsigned byte = bitIdx / 8;
            unsigned bit  = bitIdx % 8;
            return (zkBytes[byte] >> bit) & 0x1;
        };

        // --- Read Zn1, Zn2, Zm as FP16 lanes (TPSElem = uint16_t) ---
        const uint8_t zn1Idx = (uint8_t)(2 * znBase);
        const uint8_t zn2Idx = (uint8_t)(2 * znBase + 1);

        ArmISA::VecRegContainer zn1, zn2, zm;
        auto zn1RegId = ArmISA::vecRegClass[zn1Idx];
        auto zn2RegId = ArmISA::vecRegClass[zn2Idx];
        auto zmRegId  = ArmISA::vecRegClass[zmIdx];

        xc->tcBase()->getReg(zn1RegId, &zn1);
        xc->tcBase()->getReg(zn2RegId, &zn2);
        xc->tcBase()->getReg(zmRegId,  &zm);

        const TPSElem *zn1Elems = zn1.as<TPSElem>();   // FP16 bits
        const TPSElem *zn2Elems = zn2.as<TPSElem>();   // FP16 bits
        const TPSElem *zmElems  = zm.as<TPSElem>();    // FP16 bits

        // We also need FPCR rounding mode for widening conversions
        const auto rnd = FPCRRounding(fpscr);

        // --- Main sparse outer-product loop (widening) ---
        for (unsigned row = 0; row < dim; ++row) {
            // For a given row, we use two FP16 lanes per source vector:
            //   lane indices: 2*row and 2*row + 1
            const unsigned lane0 = 2 * row;
            const unsigned lane1 = 2 * row + 1;

            for (unsigned col = 0; col < dim; ++col) {
                // Columns: two FP16 lanes from Zm
                const unsigned colLane0 = 2 * col;
                const unsigned colLane1 = 2 * col + 1;

                // --- Select two FP32 row values (erow[0], erow[1]) ---
                TPDElem erow[2];

                for (unsigned e = 0; e < 2; ++e) {
                    const unsigned lane = (e == 0) ? lane0 : lane1;

                    // Pick which source vector supplies this lane:
                    //   v = 0 -> Zn1
                    //   v = 1 -> Zn2
                    //
                    // Control bits in selected segment:
                    //   bitOffset = segBase + 4*col + 2*e + v
                    TPSElem src_bits = (TPSElem)0;

                    for (unsigned v = 0; v < 2; ++v) {
                        const unsigned bitOffset =
                            segBase + 4 * col + 2 * e + v;

                        if (ctrlBit(bitOffset)) {
                            src_bits = (v == 0)
                                     ? zn1Elems[lane]
                                     : zn2Elems[lane];
                            break; // 1-in-2 for this position
                        }
                    }

                    // Widen FP16 -> FP32
                    erow[e] = fplibConvert<TPSElem, TPDElem>(
                        src_bits, rnd, fpscr);
                }

                // --- Dense column values from Zm (widened) ---
                TPSElem col_bits0 = zmElems[colLane0];
                TPSElem col_bits1 = zmElems[colLane1];

                TPDElem ecol0 = fplibConvert<TPSElem, TPDElem>(
                    col_bits0, rnd, fpscr);
                TPDElem ecol1 = fplibConvert<TPSElem, TPDElem>(
                    col_bits1, rnd, fpscr);

                // --- Accumulate dot product into ZA.s ---
                TPDElem acc = tile[col][row];

                TPDElem prod0 = fplibMul(erow[0], ecol0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                TPDElem prod1 = fplibMul(erow[1], ecol1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Optional fine trace for top-left few cells
                if (row < 2 && col < 2) {
                    DPRINTF(Arm,
                        "FTMOPA-WIDEN row=%u col=%u:\n"
                        "    FP16 src:    zn1[%u]=0x%x zn2[%u]=0x%x   zm[%u]=0x%x zm[%u]=0x%x\n"
                        "    FP32 widened: erow={0x%x,0x%x}  ecol={0x%x,0x%x}\n"
                        "    acc(before)=0x%x  acc(after)=0x%x\n",
                        row, col,
                        lane0, (unsigned)zn1Elems[lane0],
                        lane0, (unsigned)zn2Elems[lane0],
                        colLane0, (unsigned)zmElems[colLane0],
                        colLane1, (unsigned)zmElems[colLane1],
                        (unsigned)erow[0], (unsigned)erow[1],
                        (unsigned)ecol0, (unsigned)ecol1,
                        (unsigned)tile[col][row],      // BEFORE update
                        (unsigned)acc                  // AFTER update
                    );
                }

                tile[col][row] = acc;
            }
        }
    '''

    # Instantiate *widening* FTMOPA: TPSElem = uint16_t (FP16 bits),
    # TPDElem = uint32_t (FP32 bits).
    smeFPOPInst('ftmopa', 'FtmopaWidening', 'MatrixOPOp',
                ['uint16_t'], ['uint32_t'],
                ftmopaWideningCode)

    # FTMOPA (widening, 2-way, FP8 -> FP16, TMOP sparse outer product)
    #
    #   FTMOPA <ZAda>.H, {<Zn1>.B-<Zn2>.B}, <Zm>.B, <Zk>[<index>]
    #
    # Semantics (per tile element ZA[row,col].h):
    #   - Gather two FP8 row values from {Zn1, Zn2} according to TMOP control Zk
    #   - Gather two FP8 column values from Zm
    #   - Widen FP8 -> FP16, form a 2-way dot product, add to ZA[row,col]
    #
    ftmopaWideningF8Code = r'''
        FPSCR fpscr = (FPSCR)Fpscr;

        // --- Unpack imm (same layout as other FTMOPA forms) ---
        const uint64_t raw    = imm;
        const uint8_t  zaTile = (raw >> 0) & 0x7;
        const uint8_t  index  = (raw >> 3) & 0x3;
        const uint8_t  znBase = (raw >> 5) & 0x1F;   // multi-vector group
        const uint8_t  zmIdx  = (raw >> 10) & 0x1F;
        const uint8_t  zkIdx  = (raw >> 15) & 0x1F;

        // ZA tile as FP16 (TPDElem is uint16_t for this widening variant)
        auto tile = getTile<TPDElem>(ZA, zaTile);

        // For FP8->FP16 widening:
        //   - ZA is ZA.h (16-bit elements)
        //   - dim = VL / 16  (matrix is dim x dim)
        //
        // eCount is computed by smeFPOPInst as the number of TPDElem
        // elements in a vector, so here eCount == dim.
        const unsigned dim = eCount;

        // Each TMOP control segment has 4*dim bits
        // (4 bits per column: 2 source vectors x 2 row-positions)
        const unsigned csize   = 4 * dim;
        const unsigned segBase = index * csize;

        // --- Debug trace to confirm decode/execute wiring ---
        DPRINTF(Arm,
            "SmeFtmopaWideningF8: zaTile=%u index=%u znBase=%u zmIdx=%u "
            "zkIdx=%u dim=%u segBase=%u\n",
            (unsigned)zaTile,
            (unsigned)index,
            (unsigned)znBase,
            (unsigned)zmIdx,
            (unsigned)zkIdx,
            (unsigned)dim,
            (unsigned)segBase);

        // --- Read Zk (TMOP control) as bytes ---
        ArmISA::VecRegContainer zk;
        auto zkRegId = ArmISA::vecRegClass[zkIdx];
        xc->tcBase()->getReg(zkRegId, &zk);
        const uint8_t *zkBytes = zk.as<uint8_t>();

        auto ctrlBit = [&](unsigned bitIdx) -> bool {
            unsigned byte = bitIdx / 8;
            unsigned bit  = bitIdx % 8;
            return (zkBytes[byte] >> bit) & 0x1;
        };

        // --- Read Zn1, Zn2, Zm as FP8 lanes (bytes) ---
        const uint8_t zn1Idx = (uint8_t)(2 * znBase);
        const uint8_t zn2Idx = (uint8_t)(2 * znBase + 1);

        ArmISA::VecRegContainer zn1, zn2, zm;
        auto zn1RegId = ArmISA::vecRegClass[zn1Idx];
        auto zn2RegId = ArmISA::vecRegClass[zn2Idx];
        auto zmRegId  = ArmISA::vecRegClass[zmIdx];

        xc->tcBase()->getReg(zn1RegId, &zn1);
        xc->tcBase()->getReg(zn2RegId, &zn2);
        xc->tcBase()->getReg(zmRegId,  &zm);

        const uint8_t *zn1Bytes = zn1.as<uint8_t>();
        const uint8_t *zn2Bytes = zn2.as<uint8_t>();
        const uint8_t *zmBytes  = zm.as<uint8_t>();

        // Simple FP8 (byte) -> FP16 bits mapping stub:
        //   sign = 0, exponent = 15 (bias), mantissa from 8-bit code.
        // This is deliberately consistent with SmeFmopaWideningF8 so
        // tests see the same numeric behaviour.
        auto fp8_to_fp16_bits = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0;                 // preserve zero
            uint16_t mant = static_cast<uint16_t>(b & 0xFF) << 2; // 10-bit mantissa
            uint16_t exp  = 15;                   // normal exponent (not subnormal)
            return static_cast<uint16_t>((exp << 10) | mant);
        };

        auto widen = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp16_bits(b));
        };

        // --- Main sparse outer-product loop (FP8->FP16) ---
        for (unsigned row = 0; row < dim; ++row) {
            // For a given row, the FP8 layout in Zn1/2 is:
            //   lane indices: 2*row and 2*row + 1
            const unsigned lane0 = 2 * row;
            const unsigned lane1 = 2 * row + 1;

            for (unsigned col = 0; col < dim; ++col) {
                // Column-side FP8 lanes from Zm:
                //   lane indices: 2*col and 2*col + 1
                const unsigned colLane0 = 2 * col;
                const unsigned colLane1 = 2 * col + 1;

                // --- Gather two FP8 row values according to TMOP control ---
                uint8_t rowop[2] = {0, 0};
                unsigned i_sel = 0;

                for (unsigned r = 0; r < 2; ++r) {
                    const uint8_t *srcBytes = (r == 0) ? zn1Bytes : zn2Bytes;

                    for (unsigned e = 0; e < 2; ++e) {
                        const unsigned bitIndex =
                            segBase + 4 * col + 2 * r + e;
                        if (i_sel < 2 && ctrlBit(bitIndex)) {
                            unsigned lane = (e == 0) ? lane0 : lane1;
                            rowop[i_sel] = srcBytes[lane];
                            ++i_sel;
                        }
                    }
                }

                // --- Gather dense FP8 column values from Zm ---
                uint8_t colop[2];
                colop[0] = zmBytes[colLane0];
                colop[1] = zmBytes[colLane1];

                // --- Widen FP8 -> FP16 and compute 2-way dot product ---
                TPDElem acc_before = tile[col][row];
                TPDElem acc = acc_before;

                TPDElem r0 = widen(rowop[0]);
                TPDElem r1 = widen(rowop[1]);
                TPDElem c0 = widen(colop[0]);
                TPDElem c1 = widen(colop[1]);

                TPDElem prod0 = fplibMul(r0, c0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                TPDElem prod1 = fplibMul(r1, c1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Optional fine trace for top-left few cells
                if (row < 2 && col < 2) {
                    DPRINTF(Arm,
                        "FTMOPA-WIDEN-F8 row=%u col=%u:\n"
                        "    FP8 src:  rowop={0x%02x,0x%02x}  "
                        "colop={0x%02x,0x%02x}\n"
                        "    FP16 widened: r={0x%04x,0x%04x}  "
                        "c={0x%04x,0x%04x}\n"
                        "    acc(before)=0x%04x  acc(after)=0x%04x\n",
                        row, col,
                        (unsigned)rowop[0], (unsigned)rowop[1],
                        (unsigned)colop[0], (unsigned)colop[1],
                        (unsigned)r0, (unsigned)r1,
                        (unsigned)c0, (unsigned)c1,
                        (unsigned)acc_before,
                        (unsigned)acc);
                }

                tile[col][row] = acc;
            }
        }
    ''';

    # Instantiate widening FTMOPA FP8->FP16:
    #   TPSElem = uint8_t (FP8 bits), TPDElem = uint16_t (FP16 bits).
    smeFPOPInst("ftmopa", "FtmopaWideningF8", "MatrixOPOp",
                ["uint8_t"], ["uint16_t"],
                ftmopaWideningF8Code);

    # FTMOPA (widening, 4-way, FP8 -> FP32, TMOP sparse outer product)
    # FTMOPA <ZAda>.S, {<Zn1>.B-<Zn2>.B}, <Zm>.B, <Zk>[<index>]
    ftmopaWidening4WayF8F32Code = r'''
        FPSCR fpscr = (FPSCR)Fpscr;

        // --- Unpack imm (same layout as other FTMOPA forms) ---
        const uint64_t raw    = imm;
        const uint8_t  zaTile = (raw >> 0) & 0x7;
        const uint8_t  index  = (raw >> 3) & 0x3;
        const uint8_t  znBase = (raw >> 5) & 0x1F;   // multi-vector group
        const uint8_t  zmIdx  = (raw >> 10) & 0x1F;
        const uint8_t  zkIdx  = (raw >> 15) & 0x1F;

        // ZA tile as FP32 (TPDElem is uint32_t for this widening variant)
        auto tile = getTile<TPDElem>(ZA, zaTile);

        // dim = VL / 32  (matrix is dim x dim)
        // eCount (from smeFPOPInst) is exactly VL / 32 for TPDElem = uint32_t.
        const unsigned dim = eCount;

        // TMOP control:
        //   csize = VL / 4 = 8 * dim  (bits per segment)
        //   ctrl segment start = index * csize
        const unsigned csize   = 8 * dim;
        const unsigned segBase = index * csize;

        DPRINTF(Arm,
            "SmeFtmopaWidening4WayF8F32: zaTile=%u index=%u znBase=%u "
            "zmIdx=%u zkIdx=%u dim=%u segBase=%u\n",
            (unsigned)zaTile,
            (unsigned)index,
            (unsigned)znBase,
            (unsigned)zmIdx,
            (unsigned)zkIdx,
            (unsigned)dim,
            (unsigned)segBase);

        // --- Read Zk (TMOP control) as bytes ---
        ArmISA::VecRegContainer zk;
        auto zkRegId = ArmISA::vecRegClass[zkIdx];
        xc->tcBase()->getReg(zkRegId, &zk);
        const uint8_t *zkBytes = zk.as<uint8_t>();

        auto ctrlBit = [&](unsigned bitIdx) -> bool {
            unsigned byte = bitIdx / 8;
            unsigned bit  = bitIdx % 8;
            return (zkBytes[byte] >> bit) & 0x1;
        };

        // --- Read Zn1, Zn2, Zm as FP8 lanes (bytes) ---
        const uint8_t zn1Idx = (uint8_t)(2 * znBase);
        const uint8_t zn2Idx = (uint8_t)(2 * znBase + 1);

        ArmISA::VecRegContainer zn1, zn2, zm;
        auto zn1RegId = ArmISA::vecRegClass[zn1Idx];
        auto zn2RegId = ArmISA::vecRegClass[zn2Idx];
        auto zmRegId  = ArmISA::vecRegClass[zmIdx];

        xc->tcBase()->getReg(zn1RegId, &zn1);
        xc->tcBase()->getReg(zn2RegId, &zn2);
        xc->tcBase()->getReg(zmRegId,  &zm);

        const uint8_t *zn1Bytes = zn1.as<uint8_t>();
        const uint8_t *zn2Bytes = zn2.as<uint8_t>();
        const uint8_t *zmBytes  = zm.as<uint8_t>();

        // Same FP8->FP32 mapping stub as SmeFmopaWidening4WayF8F32 so
        // tests see consistent numeric behaviour.
        //
        //   sign = 0, exponent = 127 (bias), mantissa uses the 8 FP8 bits
        //   shifted into the high part of the 23-bit mantissa.
        auto fp8_to_fp32_bits = [](uint8_t b) -> uint32_t {
            if (b == 0) return 0u; // preserve zero exactly
            uint32_t mant = static_cast<uint32_t>(b & 0xFFu) << 15;
            uint32_t exp  = 127u;
            return (exp << 23) | mant;
        };

        auto widen32 = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp32_bits(b));
        };

        // --- Main sparse outer-product loop (FP8->FP32, 4-way) ---
        for (unsigned row = 0; row < dim; ++row) {

            for (unsigned col = 0; col < dim; ++col) {
                // Row and column byte indices in Zn1/2 and Zm:
                // As per ARM ASL:
                //   row bytes:   4*row + e, e=0..3
                //   column bytes:4*col + j, j=0..3
                uint8_t rowop[4] = {0, 0, 0, 0};
                uint8_t colop[4] = {0, 0, 0, 0};

                // ---- Build rowop[0..3] under TMOP 2-in-4 control ----
                //
                // For each r in {0,1} (Zn1, Zn2):
                //   Scan 4 candidates e=0..3 from bytes (4*row+e).
                //   Control bits for these are at:
                //       bitIndex = segBase + 8*col + 4*r + e
                //   Copy up to 2 bytes per r into rowop[2*r + i_sel].
                //
                for (unsigned r = 0; r < 2; ++r) {
                    const uint8_t *srcBytes = (r == 0) ? zn1Bytes : zn2Bytes;
                    unsigned i_sel = 0;

                    for (unsigned e = 0; e < 4; ++e) {
                        const unsigned bitIndex =
                            segBase + 8 * col + 4 * r + e;

                        if (i_sel < 2 && ctrlBit(bitIndex)) {
                            const unsigned lane = 4 * row + e;
                            rowop[2 * r + i_sel] = srcBytes[lane];
                            ++i_sel;
                        }
                    }
                }

                // ---- Build colop[0..3] (dense) from Zm ----
                for (unsigned j = 0; j < 4; ++j) {
                    const unsigned lane = 4 * col + j;
                    colop[j] = zmBytes[lane];
                }

                // ---- Widen FP8 -> FP32 and accumulate 4-way dot product ----
                TPDElem acc_before = tile[col][row];
                TPDElem acc = acc_before;

                for (unsigned k = 0; k < 4; ++k) {
                    TPDElem vrow = widen32(rowop[k]);
                    TPDElem vcol = widen32(colop[k]);
                    TPDElem prod = fplibMul(vrow, vcol, fpscr);
                    acc = fplibAdd(acc, prod, fpscr);
                }

                if (row < 2 && col < 2) {
                    DPRINTF(Arm,
                        "FTMOPA-WIDEN-4WAY row=%u col=%u:\n"
                        "    FP8 rowop={0x%02x,0x%02x,0x%02x,0x%02x}  "
                        "colop={0x%02x,0x%02x,0x%02x,0x%02x}\n"
                        "    acc(before)=0x%08x  acc(after)=0x%08x\n",
                        row, col,
                        (unsigned)rowop[0], (unsigned)rowop[1],
                        (unsigned)rowop[2], (unsigned)rowop[3],
                        (unsigned)colop[0], (unsigned)colop[1],
                        (unsigned)colop[2], (unsigned)colop[3],
                        (unsigned)acc_before,
                        (unsigned)acc);
                }

                tile[col][row] = acc;
            }
        }
    ''';

    # Instantiate widening FTMOPA FP8->FP32 (4-way):
    #   TPSElem = uint8_t (FP8 bits), TPDElem = uint32_t (FP32 bits).
    smeFPOPInst("ftmopa", "FtmopaWidening4WayF8F32", "MatrixOPOp",
                ["uint8_t"], ["uint32_t"],
                ftmopaWidening4WayF8F32Code);


    
    # FMOPA (widening, 2-way, FP8 -> FP16)
    # - Per-BYTE predication (p?.b)
    # - Two 8-bit lanes feed one ZA.h half (tile[j][i])
    wideningFmopxF8Code = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        // Trace once per execute so we can spot this in --debug-flags=Arm
        DPRINTF(Arm, "SmeFmopaWideningF8: ZA.h slice=%%u, eCount=%%d (fp8->fp16, 2-way)\n",
                (unsigned)imm, (int)eCount);

        // Map 0..255 -> normal FP16 in ~[1.0, ~2.0)
        // sign = 0, exponent = 15 (bias 15), mantissa = top 10 bits from the 8-bit value
        auto fp8_to_fp16_bits = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0;                 // preserve zero
            uint16_t mant = static_cast<uint16_t>(b & 0xFF) << 2; // 10-bit mantissa
            uint16_t exp  = 15;                   // normal exponent (not subnormal)
            return static_cast<uint16_t>((exp << 10) | mant);
        };

        auto mk_fp16 = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp16_bits(b));
        };

        for (int j = 0; j < eCount; ++j) {
            // NOTE: Using half-word predicate (ZA.h row) until p?.b is exposed
            if (!GpOp1_xd[j]) continue;

            for (int i = 0; i < eCount; ++i) {
                // NOTE: Using half-word predicate (ZA.h col) until p?.b is exposed
                if (!GpOp2_xd[i]) continue;

                TPDElem acc = tile[j][i];

                // Two 8-bit lanes per ZA.h half: bytes packed in AA64FpOp?_xd[*]
                for (int k = 0; k < 2; ++k) {
                    uint8_t s1 = (AA64FpOp1_xd[j] >> (8 * k)) & 0xFF; // from Zn.b
                    uint8_t s2 = (AA64FpOp2_xd[i] >> (8 * k)) & 0xFF; // from Zm.b

                    TPDElem v1 = mk_fp16(s1);
                    TPDElem v2 = mk_fp16(s2);

            #if %s
                    v2 = fplibNeg(v2);
            #endif
                    TPDElem prod = fplibMul(v1, v2, fpscr);
                    acc = fplibAdd(acc, prod, fpscr);
                }

                tile[j][i] = acc;

                // Light verification: dump a couple of cells so we see accumulation
                if (j < 2 && i < 2) {
                    DPRINTF(Arm, "ZA.h[%%d,%%d] = 0x%%04x\n", j, i, (unsigned)acc);
                }
            }
        }
    '''
    smeFPOPInst("fmopa", "FmopaWideningF8", "MatrixOPOp",
                ["uint8_t"], ["uint16_t"],
                wideningFmopxF8Code % "0")


    wideningFmopx4WayF8Code = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        // Trace once per execute so we can spot this with --debug-flags=Arm
        DPRINTF(Arm, "SmeFmopaWidening4WayF8: ZA.s slice=%u, eCount=%d (fp8->fp32, 4-way)\n",
                (unsigned)imm, (int)eCount);

        // Simple FP8 (byte) -> FP32 bits mapping stub:
        //   sign = 0, exponent = 127 (bias), mantissa places the 8 FP8 bits high in 23-bit field.
        auto fp8_to_fp32_bits = [](uint8_t b) -> uint32_t {
            if (b == 0) return 0u; // preserve zero
            uint32_t mant = static_cast<uint32_t>(b & 0xFFu) << 15; // 8 bits into high mantissa
            uint32_t exp  = 127u;                                   // normal exponent
            return (exp << 23) | mant;
        };

        auto mk_fp32 = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp32_bits(b));
        };

        for (int j = 0; j < eCount; ++j) {
            // Row gate (until per-byte p?.b exposure)
            if (!GpOp1_xd[j]) continue;

            for (int i = 0; i < eCount; ++i) {
                // Col gate (until per-byte p?.b exposure)
                if (!GpOp2_xd[i]) continue;

                TPDElem acc = tile[j][i];

                // 4-way dot product: 4 bytes from Zn.b and Zm.b form one ZA.s accumulation
                for (int k = 0; k < 4; ++k) {
                    uint8_t s1 = (AA64FpOp1_xd[j] >> (8 * k)) & 0xFF; // Zn.b
                    uint8_t s2 = (AA64FpOp2_xd[i] >> (8 * k)) & 0xFF; // Zm.b

                    TPDElem v1 = mk_fp32(s1);
                    TPDElem v2 = mk_fp32(s2);

            #if 0
                    v2 = fplibNeg(v2);
            #endif
                    TPDElem prod = fplibMul(v1, v2, fpscr);
                    acc = fplibAdd(acc, prod, fpscr);
                }

                tile[j][i] = acc;

                // Light verification
                if (j < 2 && i < 2) {
                    DPRINTF(Arm, "ZA.s[%d,%d] = 0x%08x\n", j, i, (unsigned)acc);
                }
            }
        }
    ''';

    smeFPOPInst("fmopa", "FmopaWidening4WayF8F32", "MatrixOPOp",
            ["uint8_t"], ["uint32_t"], wideningFmopx4WayF8Code)

    # FMOP4A (non-widening) Handler
    def smeFmop4aInst(name, Name, opClass, types, op):
        global header_output, decoder_output, exec_output
        code = smEnCheckCode + smeZaWrite + '''
            // imm stores the tile index (ZAda)
            // op1 is Zn (Source 1)
            // op2 is Zm (Source 2)

            unsigned eCount = ArmStaticInst::getCurSmeVecLen<TPDElem>(
                xc->tcBase());
        '''
        code += op

        iop = InstObjParams(name, "Sme" + Name, "SmeFmop4aOp",
                            {'code': code, 'op_class': opClass},
                            ['IsNonSpeculative'])
        header_output += SmeFmop4aDeclare.subst(iop)
        exec_output += SmeDualTemplatedExecute.subst(iop) 

        for type in types:
            substDict = {'targs' : type,
                         'class_name' : 'Sme' + Name}
            exec_output += SmeOpExecDeclare.subst(substDict)

    # FMOP4A (non-widening) Implementation with Debug Traces
    fmop4aCode = '''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        // Debug trace (using double backslash for safety)
        DPRINTF(Arm, "SmeFmop4a: Executing over SVL elements (eCount=%d)\\n", eCount);

        for (int j = 0; j < eCount; ++j) {
            TPDElem val1 = AA64FpOp1_xd[j]; // Zn[j]

            for (int i = 0; i < eCount; ++i) {
                TPDElem val2 = AA64FpOp2_xd[i]; // Zm[i]

                // Read current ZA value for debug
                TPDElem old_za = tile[j][i];

                // Perform Math: ZA += Zn * Zm
                TPDElem res = fplibMul(val1, val2, fpscr);
                tile[j][i] = fplibAdd(tile[j][i], res, fpscr);

                // Trace the first element (0,0) specifically
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeFmop4a[0][0]: Zn=0x%x, Zm=0x%x, OldZA=0x%x -> NewZA=0x%x\\n", val1, val2, old_za, tile[j][i]);
                }
            }
        }
    '''
    
    # Instantiate FMOP4A for float32 (TPDElem = uint32_t)
    # Note: SME2 usually treats inputs/outputs as same type for non-widening
    smeFmop4aInst('fmop4a', 'Fmop4a', 'MatrixOPOp', ['uint32_t, uint32_t'], fmop4aCode)


    # FMOP4A (widening, 4-way) Implementation
    # FMOP4A <ZAda>.S, <Zn>.B, <Zm>.B
    fmop4aWideningCode = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        // FP8 (byte) -> FP32 bits conversion stub (Reuse of existing logic)
        //   sign = 0, exponent = 127 (bias), mantissa places the 8 FP8 bits high in 23-bit field.
        auto fp8_to_fp32_bits = [](uint8_t b) -> uint32_t {
            if (b == 0) return 0u; // preserve zero
            uint32_t mant = static_cast<uint32_t>(b & 0xFFu) << 15; // 8 bits into high mantissa
            uint32_t exp  = 127u; // normal exponent
            return (exp << 23) | mant;
        };

        auto widen = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp32_bits(b));
        };

        DPRINTF(Arm, "SmeFmop4aWidening: Executing over SVL elements (eCount=%d)\n", eCount);

        // eCount is the number of 32-bit (TPDElem) elements in the vector (SVL / 4).
        // Each 32-bit element in Zn/Zm contains 4 packed FP8 values.
        for (int j = 0; j < eCount; ++j) {
            // Retrieve the j-th 32-bit container from Zn (containing 4 FP8 bytes)
            uint32_t zn_chunk = AA64FpOp1_xd[j];

            for (int i = 0; i < eCount; ++i) {
                // Retrieve the i-th 32-bit container from Zm (containing 4 FP8 bytes)
                uint32_t zm_chunk = AA64FpOp2_xd[i];

                TPDElem acc = tile[j][i];

                // 4-way accumulation
                for (int k = 0; k < 4; ++k) {
                    // Extract byte k from the 32-bit chunk
                    uint8_t n_byte = (zn_chunk >> (8 * k)) & 0xFF;
                    uint8_t m_byte = (zm_chunk >> (8 * k)) & 0xFF;

                    // Widen to FP32
                    TPDElem val1 = widen(n_byte);
                    TPDElem val2 = widen(m_byte);

                    // Multiply and Accumulate
                    TPDElem res = fplibMul(val1, val2, fpscr);
                    acc = fplibAdd(acc, res, fpscr);
                }
                
                // Write back accumulator
                tile[j][i] = acc;
                
                // Optional Debug Trace
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeFmop4aWidening[0][0]: Zn_chunk=0x%x, Zm_chunk=0x%x, NewZA=0x%x\n", 
                             zn_chunk, zm_chunk, acc);
                }
            }
        }
    '''

    # Instantiate FMOP4A Widening: FP8 (uint8_t) -> FP32 (uint32_t)
    smeFmop4aInst('fmop4a_widening', 'Fmop4aWidening', 'MatrixOPOp', ['uint8_t, uint32_t'], fmop4aWideningCode)

    # FMOP4A (widening, 2-way, FP16 -> FP32) Implementation
    # FMOP4A <ZAda>.S, <Zn>.H, <Zm>.H
    fmop4aWideningF16Code = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        DPRINTF(Arm, "SmeFmop4aWideningF16: Executing over SVL elements (eCount=%d)\n", eCount);

        // Access Source Registers (Zn, Zm) as FP16 (uint16_t)
        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[op2], &zm);
        const TPSElem *zn_ptr = zn.as<TPSElem>();
        const TPSElem *zm_ptr = zm.as<TPSElem>();

        // eCount is the number of 32-bit (TPDElem) elements in the vector (SVL / 4).
        // The loop iterates over the destination tile dimensions (FP32).
        for (int j = 0; j < eCount; ++j) {
            // For 2-way widening, we consume 2 FP16 elements for every 1 FP32 row.
            // Row j corresponds to Zn indices [2*j] and [2*j + 1].
            TPSElem zn0 = zn_ptr[2 * j];
            TPSElem zn1 = zn_ptr[2 * j + 1];

            // Convert inputs to FP32
            TPDElem val_n0 = fplibConvert<TPSElem, TPDElem>(zn0, rnd, fpscr);
            TPDElem val_n1 = fplibConvert<TPSElem, TPDElem>(zn1, rnd, fpscr);

            for (int i = 0; i < eCount; ++i) {
                // Column i corresponds to Zm indices [2*i] and [2*i + 1].
                TPSElem zm0 = zm_ptr[2 * i];
                TPSElem zm1 = zm_ptr[2 * i + 1];

                // Convert inputs to FP32
                TPDElem val_m0 = fplibConvert<TPSElem, TPDElem>(zm0, rnd, fpscr);
                TPDElem val_m1 = fplibConvert<TPSElem, TPDElem>(zm1, rnd, fpscr);

                TPDElem acc = tile[j][i];

                // Accumulate first product
                TPDElem prod0 = fplibMul(val_n0, val_m0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                // Accumulate second product
                TPDElem prod1 = fplibMul(val_n1, val_m1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Write back
                tile[j][i] = acc;

                // Optional Debug Trace for top-left element
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeFmop4aWideningF16[0][0]: Zn={0x%x, 0x%x}, Zm={0x%x, 0x%x}, NewZA=0x%x\n", 
                             zn0, zn1, zm0, zm1, acc);
                }
            }
        }
    '''

    # Instantiate FMOP4A Widening: FP16 (uint16_t) -> FP32 (uint32_t)
    # Note: We pass the template types explicitly as a single string pair for the targs substitution
    smeFmop4aInst('fmop4a_widening_f16', 'Fmop4aWideningF16', 'MatrixOPOp', ['uint16_t, uint32_t'], fmop4aWideningF16Code)


    # FMOP4A (widening, 2-way, FP8 -> FP16) Implementation
    # FMOP4A <ZAda>.H, <Zn>.B, <Zm>.B
    fmop4aWideningF8ToF16Code = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;
        
        // Debug Trace
        DPRINTF(Arm, "SmeFmop4aWideningF8ToF16: Executing over SVL/2 elements (eCount=%d)\n", eCount);

        // FP8 (byte) -> FP16 bits conversion stub (Reuse of existing logic)
        // sign = 0, exponent = 15 (bias), mantissa from 8-bit code.
        auto fp8_to_fp16_bits = [](uint8_t b) -> uint16_t {
            if (b == 0) return 0; // preserve zero
            uint16_t mant = static_cast<uint16_t>(b & 0xFF) << 2; // 10-bit mantissa
            uint16_t exp  = 15; // normal exponent (not subnormal)
            return static_cast<uint16_t>((exp << 10) | mant);
        };

        auto widen = [&](uint8_t b) -> TPDElem {
            return static_cast<TPDElem>(fp8_to_fp16_bits(b));
        };

        // Access Source Registers (Zn, Zm) as FP8 (uint8_t)
        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[op2], &zm);
        const uint8_t *zn_ptr = zn.as<uint8_t>();
        const uint8_t *zm_ptr = zm.as<uint8_t>();

        // eCount is the number of 16-bit (TPDElem) elements in the vector (SVL / 2).
        // The loop iterates over the destination tile dimensions (FP16).
        for (int j = 0; j < eCount; ++j) {
            // For 2-way widening, we consume 2 FP8 elements for every 1 FP16 row.
            // Row j corresponds to Zn indices [2*j] and [2*j + 1].
            uint8_t n0 = zn_ptr[2 * j];
            uint8_t n1 = zn_ptr[2 * j + 1];

            // Convert inputs to FP16
            TPDElem val_n0 = widen(n0);
            TPDElem val_n1 = widen(n1);

            for (int i = 0; i < eCount; ++i) {
                // Column i corresponds to Zm indices [2*i] and [2*i + 1].
                uint8_t m0 = zm_ptr[2 * i];
                uint8_t m1 = zm_ptr[2 * i + 1];

                // Convert inputs to FP16
                TPDElem val_m0 = widen(m0);
                TPDElem val_m1 = widen(m1);

                TPDElem acc = tile[j][i];

                // Accumulate first product (n0 * m0)
                TPDElem prod0 = fplibMul(val_n0, val_m0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                // Accumulate second product (n1 * m1)
                TPDElem prod1 = fplibMul(val_n1, val_m1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Write back
                tile[j][i] = acc;

                // Optional Debug Trace for top-left element
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeFmop4aWideningF8ToF16[0][0]: Zn={0x%x, 0x%x}, Zm={0x%x, 0x%x}, NewZA=0x%x\n", 
                             n0, n1, m0, m1, acc);
                }
            }
        }
    '''

    # Instantiate FMOP4A Widening: FP8 (uint8_t) -> FP16 (uint16_t)
    smeFmop4aInst('fmop4a_widening_f8_f16', 'Fmop4aWideningF8ToF16', 'MatrixOPOp', 
                  ['uint8_t, uint16_t'], fmop4aWideningF8ToF16Code)


    # BFMOP4A (Non-widening / BFloat16) Implementation
    # BFMOP4A <ZAda>.S, <Zn>.H, <Zm>.H
    # Zm: 3 bits, Zn: 3 bits, ZAda: 1 bit
    bfmop4aCode = r'''
        auto tile = getTile<TPDElem>(ZA, imm);
        FPSCR fpscr = (FPSCR) Fpscr;

        DPRINTF(Arm, "SmeBfmop4a: Executing over SVL elements (eCount=%d)\n", eCount);

        // Helper: Convert BFloat16 (uint16_t) to FP32 (uint32_t)
        // BF16 is top 16 bits of FP32.
        auto bf16_to_fp32 = [](uint16_t b) -> uint32_t {
            return static_cast<uint32_t>(b) << 16;
        };

        // Access Source Registers (Zn, Zm) as uint16_t (BF16)
        ArmISA::VecRegContainer zn, zm;
        xc->tcBase()->getReg(ArmISA::vecRegClass[op1], &zn);
        xc->tcBase()->getReg(ArmISA::vecRegClass[op2], &zm);
        const uint16_t *zn_ptr = zn.as<uint16_t>();
        const uint16_t *zm_ptr = zm.as<uint16_t>();

        // eCount is the dimension of the FP32 tile (SVL / 4).
        // Since input is BF16 (16-bit) and output is FP32 (32-bit),
        // we perform a 2-way dot product.
        // One FP32 row 'j' consumes two BF16 rows: [2*j] and [2*j+1]

        for (int j = 0; j < eCount; ++j) {
            // Get inputs for Row j from Zn (2 elements)
            uint32_t n0 = bf16_to_fp32(zn_ptr[2 * j]);
            uint32_t n1 = bf16_to_fp32(zn_ptr[2 * j + 1]);

            for (int i = 0; i < eCount; ++i) {
                // Get inputs for Column i from Zm (2 elements)
                uint32_t m0 = bf16_to_fp32(zm_ptr[2 * i]);
                uint32_t m1 = bf16_to_fp32(zm_ptr[2 * i + 1]);

                TPDElem acc = tile[j][i];

                // 2-way Dot Product Accumulation
                // acc += n0 * m0
                TPDElem prod0 = fplibMul(n0, m0, fpscr);
                acc = fplibAdd(acc, prod0, fpscr);

                // acc += n1 * m1
                TPDElem prod1 = fplibMul(n1, m1, fpscr);
                acc = fplibAdd(acc, prod1, fpscr);

                // Write back
                tile[j][i] = acc;

                // Optional Debug Trace
                if (j == 0 && i == 0) {
                     DPRINTF(Arm, "SmeBfmop4a[0][0]: Zn_bf16={0x%x, 0x%x}, Zm_bf16={0x%x, 0x%x}, NewZA=0x%x\n",
                             zn_ptr[2*j], zn_ptr[2*j+1],
                             zm_ptr[2*i], zm_ptr[2*i+1], acc);
                }
            }
        }
    '''

    # Instantiate BFMOP4A:
    #   TPSElem (Source) = uint16_t (representing BF16)
    #   TPDElem (Dest)   = uint32_t (FP32)
    smeFmop4aInst('bfmop4a', 'Bfmop4a', 'MatrixOPOp', ['uint16_t, uint32_t'], bfmop4aCode)


    # LD1B
    smeLd1xInst('ld1b', 'Ld1b', 'MemReadOp', ['uint8_t'])

    # LD1D
    smeLd1xInst('ld1d', 'Ld1d', 'MemReadOp', ['uint64_t'])

    # LD1H
    smeLd1xInst('ld1h', 'Ld1h', 'MemReadOp', ['uint16_t'])

    # LD1Q
    smeLd1xInst('ld1q', 'Ld1q', 'MemReadOp', ['__uint128_t'])

    # LD1W
    smeLd1xInst('ld1w', 'Ld1w', 'MemReadOp', ['uint32_t'])

    # LDR
    smeLdrInst("ldr", "Ldr", 'MemReadOp')

    # MOV (tile to vector) - ALIAS; see MOVA
    # MOV (vector to tile) - ALIAS; see MOVA
    # MOVA (tile to vector)
    smeMovaExtractInst("mova", "MovaExtract", 'MatrixMovOp',
                      ["uint8_t", "uint16_t", "uint32_t", "uint64_t",
                      "__uint128_t"])

    # MOVA (vector to tile)
    smeMovaInsertInst("mova", "MovaInsert", 'MatrixMovOp',
                      ["uint8_t", "uint16_t", "uint32_t", "uint64_t",
                      "__uint128_t"])

    # MOVA (vector to tile, two registers) — FEAT_SME2
    smeMovaVecToTile2RegsInst("mova", "MovaVecToTile2Regs", "MatrixMovOp")

    # SCVTF (multi-vector, 2-reg and 4-reg) — FEAT_SME2
    scvtfCode = r'''
        // SME2 multi-vector SCVTF: signed int32 lanes -> FP32 (result bits in Z regs)
        FPSCR fpscr = (FPSCR)Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        // imm layout (as you described / assumed in smeCvtMvInst):
        //   [ 4:0]  d_group
        //   [ 9:5]  n_group
        //   [11:10] nreg_code   (0 => 2 regs, else 4 regs)
        const uint32_t raw = (uint32_t)imm;
        const uint32_t d_group   = (raw >> 0) & 0x1F;
        const uint32_t n_group   = (raw >> 5) & 0x1F;
        const uint32_t nreg_code = (raw >> 10) & 0x3;
        const uint32_t nreg      = (nreg_code == 0) ? 2 : 4;

        // Expand group indices to actual Z register indices
        const uint32_t zd_base = d_group * nreg;
        const uint32_t zn_base = n_group * nreg;

        // Number of 32-bit lanes in the current SME vector length
        const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements = VL_bytes / 4;

        for (uint32_t r = 0; r < nreg; ++r) {
            const uint32_t zn_idx = zn_base + r;
            const uint32_t zd_idx = zd_base + r;

            ArmISA::VecRegContainer zn, zd;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_idx], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);

            const int32_t *in  = (const int32_t*)zn.as<uint8_t>();
            uint32_t *out      = (uint32_t*)zd.as<uint8_t>();

            for (uint32_t e = 0; e < elements; ++e) {
                int64_t s  = (int64_t)in[e];     // preserve sign
                uint64_t op = (uint64_t)s;       // pass as 64-bit payload
                out[e] = ArmISA::fplibFixedToFP<uint32_t>(op, 0, false, rnd, fpscr);
            }


            xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
        }
    '''

    # UCVTF (multi-vector, 2-reg and 4-reg) — FEAT_SME2
    ucvtfCode = r'''
        // SME2 multi-vector UCVTF: unsigned int32 lanes -> FP32 (result bits in Z regs)
        FPSCR fpscr = (FPSCR)Fpscr;
        const auto rnd = FPCRRounding(fpscr);

        // Imm layout:
        //   [ 4:0]  d_group (Zd)
        //   [ 9:5]  n_group (Zn - now correctly just the 4-bit field)
        //   [11:10] nreg_code
        const uint32_t raw = (uint32_t)imm;
        const uint32_t d_group   = (raw >> 0) & 0x1F;
        const uint32_t n_group   = (raw >> 5) & 0x1F;
        const uint32_t nreg_code = (raw >> 10) & 0x3;
        const uint32_t nreg      = (nreg_code == 0) ? 2 : 4;

        // Calculate base register indices
        // Logic: The instruction field contains GroupIndex.
        // For 2-reg, Register = Field * 2. For 4-reg, Register = Field * 4.
        // Since we extracted the raw field into n_group/d_group:
        const uint32_t zd_base = d_group * nreg;
        const uint32_t zn_base = n_group * nreg;

        const uint32_t VL_bytes = ArmStaticInst::getCurSmeVecLen<uint8_t>(xc->tcBase());
        const uint32_t elements = VL_bytes / 4;

        for (uint32_t r = 0; r < nreg; ++r) {
            const uint32_t zn_idx = zn_base + r;
            const uint32_t zd_idx = zd_base + r;

            ArmISA::VecRegContainer zn, zd;
            xc->tcBase()->getReg(ArmISA::vecRegClass[zn_idx], &zn);
            xc->tcBase()->getReg(ArmISA::vecRegClass[zd_idx], &zd);
            
            // Treat input as unsigned 32-bit integers
            const uint32_t *in  = (const uint32_t*)zn.as<uint8_t>();
            uint32_t *out       = (uint32_t*)zd.as<uint8_t>();

            for (uint32_t e = 0; e < elements; ++e) {
                // Zero-extend 32-bit unsigned to 64-bit for conversion
                uint64_t op = (uint64_t)in[e];
                
                // fplibFixedToFP: 3rd arg 'unsigned' = true
                out[e] = ArmISA::fplibFixedToFP<uint32_t>(op, 0, true, rnd, fpscr);
            }

            xc->tcBase()->setReg(ArmISA::vecRegClass[zd_idx], &zd);
        }
    '''

    smeCvtMvInst("ucvtf", "UcvtfMv", "SimdFloatCvtOp", ucvtfCode)

    
    # SCVTF (multi-vector, 2-reg and 4-reg) — FEAT_SME2
    smeCvtMvInst("scvtf", "ScvtfMv", "SimdFloatCvtOp", scvtfCode)

    # RDSVL
    smeRdsvlInst('rdsvl', 'Rdsvl', 'SimdAddOp')

    # SMOPA
    intMopxCode = '''
        auto tile = getTile<TPDElem>(ZA, imm);

        size_t shift = 8 * sizeof(TPS1Elem);
        size_t mask = (1 << shift) - 1;

        for (int j = 0; j < eCount; ++j) {
            for (int i = 0; i < eCount; ++i) {
                for (int k = 0; k < 4; ++k) {
                    if (!GpOp1_xs1[4 * j + k]) {
                        continue;
                    }

                    if (!GpOp2_xs2[4 * i + k]) {
                        continue;
                    }

                    TPS1Elem temp1 =
                        (TPS1Elem)(AA64FpOp1_xd[j] >> (shift * k)) & mask;
                    TPS2Elem temp2 =
                        (TPS2Elem)(AA64FpOp2_xd[i] >> (shift * k)) & mask;

                    tile[j][i] %s= (TPDElem)temp1 * (TPDElem)temp2;
                }
            }
        }
        '''
    smeIntOPInst('smopa', 'Smopa', 'MatrixOPOp', ['int8_t', 'int16_t'],
                 ['int8_t', 'int16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "+")

    # SMOPS
    smeIntOPInst('smops', 'Smops', 'MatrixOPOp', ['int8_t', 'int16_t'],
                 ['int8_t', 'int16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "-")

    # SMSTART
    smstartSmstopCode = '''
        // Bit 0 of imm determines if we are setting or clearing
        // (smstart vs smstop)
        // Bit 1 means that we are applying this to SM
        // Bit 2 means that we are applying this to ZA
        bool new_state    = imm & 0x1;
        bool sm_affected  = imm & 0x2;
        bool za_affected  = imm & 0x4;
        bool old_sm_state = Svcr & 0x1;
        bool old_za_state = Svcr & 0x2;

        bool sm_changed = sm_affected && old_sm_state != new_state;
        bool za_changed = za_affected && old_za_state != new_state;

        if (sm_changed) {
            // We need to zero the SVE Z, P, FFR registers on SM change. Also,
            // set FPSR to a default value. Note that we use the max SVE len
            // instead of the actual vector length.
            //
            // For the Z, P registers we are directly setting these to zero
            // without going through the ISA parser (which generates the
            // dependencies) as otherwise the O3 CPU can deadlock when there
            // are too few free physical registers. We therefore rely on this
            // instruction being a barrier (IsSerialiseAfter).

            // Z Registers, including special and interleave registers
            ArmISA::VecRegContainer zeroed_z_reg;
            zeroed_z_reg.zero();

            for (int reg_idx = 0; reg_idx < NumVecRegs; ++reg_idx) {
                auto reg_id = ArmISA::vecRegClass[reg_idx];
                xc->tcBase()->setReg(reg_id, &zeroed_z_reg);
            }

            // P Registers, including the FFR
            ArmISA::VecPredRegContainer zeroed_p_reg;
            zeroed_p_reg.reset();

            for (int reg_idx = 0; reg_idx < NumVecPredRegs; ++reg_idx) {
                auto reg_id = ArmISA::vecPredRegClass[reg_idx];
                xc->tcBase()->setReg(reg_id, &zeroed_p_reg);
            }

            // FPSR
            Fpsr = 0x0800009f;
        }

        if (za_changed) {
            // ZA write
            ZA = ZA;
            ZA.zero();
        }

        // Now that we've handled the zeroing of the appropriate registers,
        // we update the pstate accordingly.

        if (sm_changed) {
            if (new_state == 1) {
                Svcr = Svcr | 0x1; // Set SM
            } else {
                Svcr = Svcr & ~(uint64_t)0x1; // Clear SM
            }
        }

        if (za_changed) {
            if (new_state == 1) {
                Svcr = Svcr | 0x2; // Set ZA
            } else {
                Svcr = Svcr & ~(uint64_t)0x2; // Clear ZA
            }
        }
    '''

    smeMsrInst('smstart', 'Smstart', 'IntAluOp',
               smstartSmstopCode)

    # SMSTOP
    smeMsrInst('smstop', 'Smstop', 'IntAluOp',
               smstartSmstopCode)

    # ST1B
    smeSt1xInst('st1b', 'St1b', 'MemWriteOp', ['uint8_t'])

    # ST1D
    smeSt1xInst('st1d', 'St1d', 'MemWriteOp', ['uint64_t'])

    # ST1H
    smeSt1xInst('st1h', 'St1h', 'MemWriteOp', ['uint16_t'])

    # ST1Q
    smeSt1xInst('st1q', 'St1q', 'MemWriteOp', ['__uint128_t'])

    # ST1W
    smeSt1xInst('st1w', 'St1w', 'MemWriteOp', ['uint32_t'])

    # STR
    smeStrInst("str", "Str", "MemWriteOp")

    # SUMOPA
    smeIntOPInst('sumopa', 'Sumopa', 'MatrixOPOp', ['int8_t', 'int16_t'],
                 ['uint8_t', 'uint16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "+")

    # SUMOPS
    smeIntOPInst('sumops', 'Sumops', 'MatrixOPOp', ['int8_t', 'int16_t'],
                 ['uint8_t', 'uint16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "-")

    # UMOPA
    smeIntOPInst('umopa', 'Umopa', 'MatrixOPOp', ['uint8_t', 'uint16_t'],
                 ['uint8_t', 'uint16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "+")

    # UMOPS
    smeIntOPInst('umops', 'Umops', 'MatrixOPOp', ['uint8_t', 'uint16_t'],
                 ['uint8_t', 'uint16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "-")

    # USMOPA
    smeIntOPInst('usmopa', 'Usmopa', 'MatrixOPOp', ['uint8_t', 'uint16_t'],
                 ['int8_t', 'int16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "+")

    # USMOPS
    smeIntOPInst('usmops', 'Usmops', 'MatrixOPOp', ['uint8_t', 'uint16_t'],
                 ['int8_t', 'int16_t'], ['int32_t', 'int64_t'],
                 intMopxCode % "-")

    # ZERO
    smeZeroInst("zero", "Zero", "MatrixOp", ["uint64_t"])

}};